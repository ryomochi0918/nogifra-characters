flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e1 --> c3{"③:②のアピール対象の<br/>残りHP割合が50%以下か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率が1.5倍になる"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに5回、450%のアピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:このスキルでライバルが<br/>1名以上リタイアしたか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes(再実行は最大1回まで)<br/>⑤を発動する前に行った合計アピールの<br/>10%分を固定値として上乗せし再実行"| c3
    c5 -->|"No"| finish(("終了")):::startend
