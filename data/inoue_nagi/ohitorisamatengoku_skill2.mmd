flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a0["①実行:このスキル中、<br/>自身の命中率を+20%する"]:::effect --> c1{"③:対象の残りHP割合が<br/>50%以下か"}:::cond
    c1 -->|"Yes"| c2a{"④:自身のエフォートが<br/>対象のエフォート以上か"}:::cond
    c1 -->|"No"| c2b{"④:自身のエフォートが<br/>対象のエフォート以上か"}:::cond
    c2a -->|"Yes"| a1["②実行:450%のアピールを<br/>行う(倍率2倍×1.5倍)"]:::action --> loop1
    c2a -->|"No"| a2["②実行:450%のアピールを<br/>行う(倍率2倍)"]:::action --> loop1
    c2b -->|"Yes"| a3["②実行:450%のアピールを<br/>行う(倍率1.5倍)"]:::action --> loop1
    c2b -->|"No"| a4["②実行:450%のアピールを<br/>行う"]:::action --> loop1
    loop1{"5回<br/>すべて完了?"}:::cond
    loop1 -->|"No、次の回へ"| c1
    loop1 -->|"Yes"| c3{"⑤:このスキルでライバルが<br/>1名以上リタイアしたか"}:::cond
    c3 -->|"Yes"| a5["それまでの合計アピールの<br/>10%分を固定値として上乗せし、<br/>再度②を実行する<br/>(再実行は最大1回まで)"]:::action --> finish(("終了")):::startend
    c3 -->|"No"| finish
