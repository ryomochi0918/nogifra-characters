flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を<br/>2つ解除する"]:::effect
    c2 -->|"No"| a1["①実行:ライバル4名を100%の確率で<br/>3ターンの間「空腹」状態にし、<br/>自身の最大アピールの30%を<br/>固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:味方フロントの「光輝」状態の<br/>ターン数が9ターン以上か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c3 -->|"Yes(再実行は最大1回まで)"| c2
    c3 -->|"No"| e4["④:自身と自身以外の残りHP割合が<br/>最も低い味方2名を4ターンの間<br/>「陽動」状態にし、HPをこのスキルで<br/>行った合計アピールの30%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
