flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"②:自身の「希望」状態の<br/>ターン数が5ターン以上か"}:::cond
    c1 -->|"No"| a1["①実行:味方フロントの<br/>「希望」状態の合計ターン数×<br/>自身のエフォート0.5倍の固定値<br/>(上限7.5倍)を上乗せした400%の<br/>アピールを行う"]:::action --> a4
    c1 -->|"Yes"| c2{"③:自身の「希望」状態の<br/>ターン数が7ターン以上か"}:::cond
    c2 -->|"Yes"| a2["①実行:上記と同じ倍率で<br/>アピールを行い、対象の<br/>バフ・アゲ効果を2つ解除する"]:::action --> a4
    c2 -->|"No"| a3["①実行:上記と同じ倍率で<br/>アピールを行い、対象の<br/>バフ・アゲ効果を1つ解除する"]:::action --> a4
    a4["④実行:自身のHPを①で<br/>行った直前のアピールの30%分<br/>回復する"]:::action --> loop1{"6回<br/>すべて完了?"}:::cond
    loop1 -->|"No、次の回へ"| c1
    loop1 -->|"Yes"| finish(("終了")):::startend
