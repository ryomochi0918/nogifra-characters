flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の「希望」状態のターン数が<br/>5ターン以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| c3{"③:自身の「希望」状態のターン数が<br/>7ターン以上か<br/>(②の各効果前)"}:::cond
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに6回、味方フロントの<br/>「希望」状態の合計ターン数×自身の<br/>エフォートの0.5倍の固定値を<br/>上乗せした400%のアピールを行う<br/>(固定値倍率は上限7.5倍まで)"]:::action
    c3 -->|"Yes"| e3["②のバフ・アゲ効果解除数が<br/>1つ増加する"]:::effect
    c3 -->|"No"| e2["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    e3 --> e2
    e2 --> a1
    a1 --> e4["④:自身のHPを①で行った直前の<br/>アピールの30%分回復する<br/>(①の各アピール後)"]:::effect
    e4 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
