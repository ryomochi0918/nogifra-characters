flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の対象の<br/>サンクス以上か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①の各効果中のみ自身の<br/>サゲ効果耐性貫通を+20%する"]:::effect
    c2 -->|"No"| e1["①:最大アピールが最も高い<br/>ライバル3名のバフ・アゲ効果を<br/>2つ解除し、100%の確率で2ターンの<br/>間「雑音」状態にする"]:::effect
    e2 --> e1
    e1 --> lc1{"①の効果<br/>対象3名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:自身のサンクスが③の<br/>アピール対象のサンクス以上か<br/>(③の各アピール前)"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:最大アピールが最も高い<br/>ライバルに4回、自身のサンクスの<br/>1.5倍を固定値として上乗せした600%の<br/>アピールを行う(「雑音」状態ではない<br/>ライバルを優先的に選択する)"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>4回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c4
