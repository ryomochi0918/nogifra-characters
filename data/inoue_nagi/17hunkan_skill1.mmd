flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"②:自身のサンクスが<br/>①の対象のサンクス以上か"}:::cond
    c1 -->|"Yes"| a1["①実行+②:バフ・アゲ効果を<br/>2つ解除し、100%の確率で<br/>2ターンの間「雑音」状態にする<br/>(この効果中のみ自身のサゲ効果<br/>耐性貫通+20%)"]:::action --> loop1{"対象3名<br/>すべて完了?"}:::cond
    c1 -->|"No"| a2["①実行:バフ・アゲ効果を<br/>2つ解除し、100%の確率で<br/>2ターンの間「雑音」状態にする"]:::action --> loop1
    loop1 -->|"No、次の対象へ"| c1
    loop1 -->|"Yes"| c2{"④:自身のサンクスが<br/>③のアピール対象のサンクス以上か"}:::cond
    c2 -->|"Yes"| a3["③実行(強化):自身のサンクスの<br/>1.5倍を固定値として上乗せした<br/>600%のアピールを行う<br/>(倍率2倍、「雑音」状態ではない<br/>ライバルを優先)"]:::action --> loop2{"4回<br/>すべて完了?"}:::cond
    c2 -->|"No"| a4["③実行(通常):自身のサンクスの<br/>1.5倍を固定値として上乗せした<br/>600%のアピールを行う<br/>(「雑音」状態ではないライバルを<br/>優先)"]:::action --> loop2
    loop2 -->|"No、次の回へ"| c2
    loop2 -->|"Yes"| finish(("終了")):::startend
