flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c0{"②:自身の「躍動」状態の<br/>ターン数が5ターン以上か"}:::cond
    c0 -->|"Yes"| a0["①実行(強化):このスキル中、<br/>自身の会心率を+40%する"]:::effect --> c1
    c0 -->|"No"| a0b["①実行(通常):このスキル中、<br/>自身の会心率を+20%する"]:::effect --> c1
    c1{"④:自身のサンクスが<br/>対象のサンクス以上か"}:::cond
    c1 -->|"Yes"| a1["③実行(強化):自身のサンクスの<br/>3倍を固定値として上乗せした<br/>600%のアピールを行い、<br/>対象のバフ・アゲ効果を<br/>1つ解除する"]:::action --> loop1{"5回<br/>すべて完了?"}:::cond
    c1 -->|"No"| a2["③実行(通常):自身のサンクスの<br/>3倍を固定値として上乗せした<br/>600%のアピールを行う"]:::action --> loop1
    loop1 -->|"No、次の回へ"| c1
    loop1 -->|"Yes"| c2{"⑤:③のアピールで会心<br/>アピールが3回以上<br/>発生したか"}:::cond
    c2 -->|"Yes"| a3["再度③を実行する<br/>(再実行は最大1回まで)"]:::action --> a4
    c2 -->|"No"| a4["⑥実行:自身のHPをこのスキルで<br/>行った合計アピールの20%分<br/>回復する"]:::action --> finish(("終了")):::startend
