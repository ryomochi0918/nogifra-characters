flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の「躍動」状態のターン数が<br/>5ターン以上か"}:::cond
    c2 -->|"Yes"| e2["①による会心率の増加倍率が40%になる"]:::effect
    c2 -->|"No"| e1["①:このスキル中、自身の<br/>会心率を+20%する"]:::effect
    e2 --> e1
    e1 --> c4{"④:自身のサンクスが③の<br/>アピール対象のサンクス以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c4 -->|"No"| a3["③実行:残りHP割合が最も低い<br/>ライバルに5回、自身のサンクスの<br/>3倍を固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>5回すべて完了?"}:::cond
    lc3 -->|"Yes"| c5{"⑤:③のアピールで会心アピールが<br/>3回以上発生しているか"}:::cond
    lc3 -->|"No、次の回へ"| c4
    c5 -->|"Yes(再実行は最大1回まで)"| c4
    c5 -->|"No"| e6["⑥:自身のHPをこのスキルで行った<br/>合計アピールの20%分回復する"]:::effect
    e6 --> finish(("終了")):::startend
