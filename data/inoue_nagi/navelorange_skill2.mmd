flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>①のアピール対象の<br/>残りHP割合以上か"}:::cond
    c2 -->|"Yes"| c3{"③:ライブ中に自身のスキル2<br/>「美味すぎて震える。」が<br/>2回以上発動していたか"}:::cond
    c3 -->|"Yes"| e3["①の各アピール中のみ自身の会心率を+20%し、<br/>①による「衰弱」状態の効果倍率が2%増加<br/>(③により1%から2%に変更)"]:::effect --> c4
    c3 -->|"No"| e2["①の各アピール中のみ自身の会心率を+20%し、<br/>①による「衰弱」状態の効果倍率が1%増加"]:::effect --> c4
    c2 -->|"No"| c4{"④:①のアピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    c4 -->|"Yes"| e4["①のアピールに<br/>「対象が受けているデバフ・サゲ効果状態の種類数×<br/>対象のHP上限0.5%分」を固定値として上乗せ<br/>(固定値の最大倍率はアピール対象のHP上限の2%分まで)"]:::effect --> a1
    c4 -->|"No"| a1["①実行:<br/>ライバルへ基本1250%のアピールを行い、<br/>100%の確率で3ターンの間<br/>「衰弱」状態にする"]:::action
    a1 --> lc1{"①のアピール<br/>3回すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c5{"⑤:①のアピールで<br/>ライバルがリタイアしなかったか"}:::cond
    c5 -->|"Yes(再実行、最大1回まで)"| c2
    c5 -->|"No"| a6["⑥実行:<br/>残りHP割合が最も低い味方3名を<br/>3ターンの間「勇気」状態にする<br/>(⑤の再実行が発動した場合は⑤の後)"]:::action
    a6 --> finish(("終了")):::startend
