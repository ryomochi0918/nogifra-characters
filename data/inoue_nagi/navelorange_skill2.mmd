flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| c3{"③:ライブ中に自身のスキル2<br/>「美味すぎて震える。」が<br/>2回以上発動していたか<br/>(②の各効果前)"}:::cond
    c2 -->|"No"| c4{"④:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②による「衰弱」状態の効果倍率の<br/>増加を1%から2%に変更する"]:::effect
    c3 -->|"No"| e2["①の各アピール中のみ自身の<br/>会心率を+20%し、①による「衰弱」<br/>状態の効果倍率が1%増加する"]:::effect
    e3 --> e2
    e2 --> c4
    c4 -->|"Yes"| e4["①のアピールに「①の<br/>アピール対象が受けている<br/>デバフ・サゲ効果状態の種類数×①の<br/>アピール対象のHP上限0.5%分」を<br/>固定値として上乗せする(固定値の<br/>最大倍率はアピール対象の<br/>HP上限の2%分まで)"]:::effect
    c4 -->|"No"| a1["①実行:ライバル3名に1250%の<br/>アピールを行い、100%の確率で<br/>3ターンの間「衰弱」状態にする"]:::action
    e4 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c5 -->|"Yes(再実行は最大1回まで)"| c2
    c5 -->|"No"| e6["⑥:残りHP割合が最も低い味方3名を<br/>3ターンの間「勇気」状態にする"]:::effect
    e6 --> finish(("終了")):::startend
