flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:最大アピールが最も高い<br/>ライバル3名のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    e1 --> c2{"②:自身のスマイルが①の効果対象の<br/>スマイル以上か<br/>(①の各効果後)"}:::cond
    c2 -->|"Yes"| e2["①の効果対象を100%の確率で<br/>3ターンの間「空腹」状態にする"]:::effect
    c2 -->|"No"| lc1{"①の効果<br/>対象3名すべて完了?"}:::cond
    e2 --> lc1
    lc1 -->|"Yes"| c4{"④:③のアピール対象が「空腹」状態か<br/>(③の各アピール前)"}:::cond
    lc1 -->|"No、次の対象へ"| e1
    c4 -->|"Yes"| e4["③のアピールにアピール対象のHP上限の<br/>2%分を固定値として上乗せする"]:::effect
    c4 -->|"No"| c5{"⑤:③のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(③の各アピール前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["③の各アピール中のみ自身の<br/>命中率を+15%する"]:::effect
    c5 -->|"No"| a3["③実行:ライバルに3回、650%の<br/>アピールを行う"]:::action
    e5 --> a3
    a3 --> lc3{"③のアピール<br/>3回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c4
