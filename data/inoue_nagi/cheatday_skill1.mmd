flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:最大アピールが最も高い<br/>味方4名のデバフ・サゲ効果を<br/>1つ解除し、2ターンの間<br/>「集中」状態にする"]:::action --> c1{"②:対象は<br/>デバフ・サゲ効果状態<br/>ではないか"}:::cond
    c1 -->|"Yes"| a2["②実行:対象を2ターンの間<br/>「勇気」状態にする"]:::effect --> loop1{"対象4名<br/>すべて完了?"}:::cond
    c1 -->|"No"| loop1
    loop1 -->|"No、次の対象へ"| a1
    loop1 -->|"Yes"| c2{"④:味方フロントの<br/>デバフ・サゲ効果状態の<br/>メンバーが3名以下か"}:::cond
    c2 -->|"Yes"| a3["③実行(強化):最大アピールが<br/>最も高い味方3名を2ターンの間<br/>「豪運」状態にする<br/>(効果倍率2倍)"]:::effect --> a5
    c2 -->|"No"| a4["③実行(通常):最大アピールが<br/>最も高い味方3名を2ターンの間<br/>「豪運」状態にする"]:::effect --> a5
    a5["⑤実行:残りHP割合が最も低い<br/>味方3名のHPを自身のアピール力の<br/>80%分回復する<br/>(会心率に応じて会心回復)"]:::action --> finish(("終了")):::startend
