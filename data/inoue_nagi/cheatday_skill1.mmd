flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:最大アピールが最も高い味方4名の<br/>デバフ・サゲ効果を1つ解除し、<br/>2ターンの間「集中」状態にする"]:::effect
    e1 --> c2{"②:①の効果対象が<br/>デバフ・サゲ効果状態ではないか<br/>(①の各効果後)"}:::cond
    c2 -->|"Yes"| e2["①の効果対象を2ターンの間「勇気」<br/>状態にする"]:::effect
    c2 -->|"No"| lc1{"①の効果<br/>対象4名すべて完了?"}:::cond
    e2 --> lc1
    lc1 -->|"Yes"| c4{"④:味方フロントに居る<br/>デバフ・サゲ効果状態の<br/>メンバーが3名以下か"}:::cond
    lc1 -->|"No、次の対象へ"| e1
    c4 -->|"Yes"| e4["③による「豪運」状態の<br/>効果倍率が2倍になる"]:::effect
    c4 -->|"No"| e3["③:最大アピールが最も高い味方3名を<br/>2ターンの間「豪運」状態にする"]:::effect
    e4 --> e3
    e3 --> e5["⑤:残りHP割合が最も低い味方3名の<br/>HPを自身のアピール力の80%分回復する<br/>(会心率に応じて会心回復が発生する)"]:::effect
    e5 --> finish(("終了")):::startend
