flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身のデバフ・サゲ効果を<br/>全て解除する"]:::effect
    e1 --> a2["②実行:残りHP割合が最も低い<br/>ライバル5名にライブ中に発動した<br/>自身のスキル2「のぎのなぎ」の<br/>回数×50%の倍率を上乗せした、100%の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)<br/>(初回スキル発動時の②による<br/>アピール倍率は150%となる)"]:::action
    a2 --> e3["③:残りHP割合が最も高い<br/>ライバル3名を100%の確率で2ターンの<br/>間「アピール力ダウン」状態にする"]:::effect
    e3 --> e4["④:自身のHPを②のアピールで行った<br/>合計アピールの40%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
