flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身の「根性」状態のターン数が<br/>9ターン以上か"}:::cond
    c1 -->|"Yes"| e1["自身のデバフ・サゲ効果を<br/>全て解除する"]:::effect
    c1 -->|"No"| c3{"③:②のアピール対象が特殊状態か<br/>(②の各アピール前)"}:::cond
    e1 --> c3
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が3倍になる"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルに3回、自身のエフォートの<br/>3倍を固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"Yes"| c4{"④:②のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c4 -->|"Yes(再実行は最大3回まで)"| c3
    c4 -->|"No"| finish(("終了")):::startend
