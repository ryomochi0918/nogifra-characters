flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c0{"①:自身の「根性」状態の<br/>ターン数が9ターン以上か"}:::cond
    c0 -->|"Yes"| a0["①実行:自身のデバフ・サゲ効果を<br/>全て解除する"]:::action --> c1
    c0 -->|"No"| c1{"③:対象が特殊状態か"}:::cond
    c1 -->|"Yes"| a1["②実行(強化):自身のエフォートの<br/>3倍を固定値として上乗せした<br/>1000%のアピールを行う<br/>(倍率3倍)"]:::action --> loop1{"3回<br/>すべて完了?"}:::cond
    c1 -->|"No"| a2["②実行(通常):自身のエフォートの<br/>3倍を固定値として上乗せした<br/>1000%のアピールを行う"]:::action --> loop1
    loop1 -->|"No、次の回へ"| c1
    loop1 -->|"Yes"| c2{"④:②のアピールで<br/>ライバルがリタイア<br/>しなかったか"}:::cond
    c2 -->|"Yes"| a3["再度②を実行する<br/>(再実行は最大3回まで)"]:::action --> finish(("終了")):::startend
    c2 -->|"No"| finish
