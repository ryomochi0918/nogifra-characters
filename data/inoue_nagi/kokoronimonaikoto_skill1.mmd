flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル4名に自身のスマイルの<br/>4倍を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    a1 --> c3{"③:自身の「光輝」状態のターン数が<br/>7ターン以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに3回、自身のスマイルの<br/>2.5倍を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"Yes"| e4["④:自身を3ターンの間「遮音」<br/>状態にし、自身のHPをこのスキルで<br/>行った合計アピールの40%分回復する"]:::effect
    lc2 -->|"No、次の回へ"| c3
    e4 --> finish(("終了")):::startend
