flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["このアピール中のみ、自身の<br/>リフレクト耐性を+20%する"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル3名に自身のエフォートの<br/>2.5倍を固定値として上乗せした<br/>700%のアピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc1 -->|"Yes"| rr{"③の再実行による<br/>①のアピールか"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    rr -->|"No"| c3{"③:自身の「希望」状態の<br/>ターン数が4ターン以上か"}:::cond
    rr -->|"Yes"| c4{"④:味方フロントの「希望」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    c3 -->|"Yes(③による再実行は最大1回まで)"| c2
    c3 -->|"No"| finish(("終了")):::startend
    c4 -->|"Yes(④による再実行は最大1回まで)"| c2
    c4 -->|"No"| finish
