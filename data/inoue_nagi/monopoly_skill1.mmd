flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"②:自身のエフォートが<br/>対象のエフォート以上か"}:::cond
    c1 -->|"Yes"| a1["①実行(強化):自身のエフォート<br/>の2.5倍を固定値として上乗せした<br/>700%のアピールを行う<br/>(このアピール中、自身の<br/>リフレクト耐性+20%)"]:::action --> loop1{"対象3名<br/>すべて完了?"}:::cond
    c1 -->|"No"| a2["①実行(通常):自身のエフォート<br/>の2.5倍を固定値として上乗せした<br/>700%のアピールを行う"]:::action --> loop1
    loop1 -->|"No、次の対象へ"| c1
    loop1 -->|"Yes"| c2{"③:自身の「希望」状態の<br/>ターン数が4ターン以上か"}:::cond
    c2 -->|"Yes"| a3["③により再度①を実行する<br/>(③による再実行は最大1回まで)"]:::action --> c3
    c2 -->|"No"| finish(("終了")):::startend
    c3{"④:味方フロントの<br/>「希望」状態の合計ターン数が<br/>7ターン以上か"}:::cond
    c3 -->|"Yes"| a4["④により再度①を実行する<br/>(④による再実行は最大1回まで)"]:::action --> finish
    c3 -->|"No"| finish
