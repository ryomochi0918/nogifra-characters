flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a0["①実行:このスキル中、<br/>自身の会心率を+30%する"]:::effect --> c1{"③:対象の残りHP割合が<br/>50%以上か"}:::cond
    c1 -->|"Yes"| a1["②実行(強化):自身の最大<br/>アピールの30%を固定値として<br/>上乗せした550%のアピールを<br/>行う(倍率2倍)"]:::action --> loop1{"5回<br/>すべて完了?"}:::cond
    c1 -->|"No"| a2["②実行(通常):自身の最大<br/>アピールの30%を固定値として<br/>上乗せした550%のアピールを<br/>行う"]:::action --> loop1
    loop1 -->|"No、次の回へ"| c1
    loop1 -->|"Yes"| c2{"④:自身の「根性」状態の<br/>ターン数が10ターン以上か"}:::cond
    c2 -->|"Yes"| a3["④実行:残りHP割合が最も高い<br/>ライバル2名に②で行った合計<br/>アピールの60%分のアピールを<br/>行う(ディフェンス、<br/>フィジカルを無視)"]:::action --> a5
    c2 -->|"No"| a5["⑤実行:自身と自身以外の<br/>最大アピールが最も高い味方1名を<br/>3ターンの間「声援」状態にする"]:::effect --> finish(("終了")):::startend
