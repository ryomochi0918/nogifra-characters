flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+30%する"]:::effect
    e1 --> c3{"③:②のアピール対象の<br/>残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルに5回、自身の最大アピールの<br/>30%を固定値として上乗せした550%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"Yes"| c4{"④:自身の「根性」状態のターン数が<br/>10ターン以上か"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c4 -->|"Yes"| a4["④実行:残りHP割合が最も<br/>高いライバル2名に②で<br/>行った合計アピールの60%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c4 -->|"No"| e5["⑤:自身と自身以外の最大アピールが<br/>最も高い味方1名を3ターンの間<br/>「声援」状態にする"]:::effect
    a4 --> e5
    e5 --> finish(("終了")):::startend
