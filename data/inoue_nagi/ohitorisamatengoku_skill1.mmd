flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①/②:自身がアピール力アップ状態<br/>ではないか"}:::cond
    c1 -->|"Yes"| e1["①:自身を3ターンの間<br/>「アピール力アップ」状態にする"]:::effect
    c1 -->|"No"| e2["②:自身を3ターンの間<br/>「円陣」状態にする"]:::effect
    e1 --> c4{"④:③のアピール対象の<br/>残りHP割合が50%以上か<br/>(③の各アピール前)"}:::cond
    e2 --> c4
    c4 -->|"Yes"| e4["③のアピール倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:残りHP割合が最も高い<br/>ライバルに4回、350%のアピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>4回すべて完了?"}:::cond
    lc3 -->|"Yes"| c5{"⑤:③のアピールで<br/>ライバルがリタイアしなかったか"}:::cond
    lc3 -->|"No、次の回へ"| c4
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も高い<br/>ライバル4名に自身の最大アピールの30%を<br/>固定値として上乗せした870%の<br/>アピールを行う"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
