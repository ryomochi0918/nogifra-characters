flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身が受けている<br/>バフ・アゲ効果状態が2種類以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピールに対象のHP上限の<br/>0.5%分を固定値として上乗せ"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>最大アピールが最も高いライバルへ<br/>基本820%+固定値 自身のサンクス×3"]:::action
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c4{"④:自身の残りHP割合が<br/>30%未満か"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が3倍に"]:::effect --> a3
    c4 -->|"No"| a3["③実行:<br/>残りHP割合が最も低いライバルへ<br/>基本1500%+固定値 自身のサンクス×4"]:::action
    a3 --> lc3{"③のアピール<br/>2回すべて完了?"}:::cond
    lc3 -->|"No、次の回へ"| c4
    lc3 -->|"Yes"| c5{"⑤:③のアピールで<br/>ライバルがリタイアしなかったか"}:::cond
    c5 -->|"Yes(再実行、最大1回まで)"| c4
    c5 -->|"No"| finish(("終了")):::startend
