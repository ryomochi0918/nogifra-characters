flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方フロントに居る<br/>デバフ・サゲ効果状態の<br/>メンバーが3名以下か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに4回、<br/>自身の残りHPの10%分を<br/>固定値として上乗せした440%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:自身と自身以外の残りHP割合が<br/>最も低い味方2名のデバフ・サゲ効果を<br/>1つ解除し、HPを①で行った<br/>合計アピールの30%分回復する"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e3 --> e4["④:自身と自身以外の最大アピールが<br/>最も高い味方1名を3ターンの間<br/>「防音」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
