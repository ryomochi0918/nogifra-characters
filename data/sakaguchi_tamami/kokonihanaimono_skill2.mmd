flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②/③:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["②:①のアピールは<br/>必ず会心アピールになる"]:::effect
    c2 -->|"No"| e3["③:アピール倍率が2倍になる"]:::effect
    e2 --> a1["①実行:残りHP割合が最も高い<br/>ライバル3名に2回、600%のアピールを<br/>行う(2回目以降のアピールは<br/>対象を選び直す)"]:::action
    e3 --> a1
    a1 --> e4["④:①のアピール対象を100%の確率で<br/>3ターンの間「嫉妬」状態にする<br/>(①の各アピール後)"]:::effect
    e4 --> lc1{"①のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc1 -->|"Yes"| lc1n{"①のアピール<br/>2回すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1n -->|"Yes"| e5["⑤:自身のHPを①で行った<br/>合計アピールの50%分回復し、自身を<br/>4ターンの間「反響」状態にする"]:::effect
    lc1n -->|"No、次の回へ"| c2
    e5 --> finish(("終了")):::startend
