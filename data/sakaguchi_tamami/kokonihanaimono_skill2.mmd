flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピールは必ず<br/>会心アピールになる"]:::effect --> a1
    c2 -->|"No(③:未満の場合)"| e3["③:アピール倍率が2倍になる"]:::effect --> a1
    a1["①実行:残りHP割合が最も高い<br/>ライバル3名へ600%のアピール<br/>(2回目以降のアピールは<br/>対象を選び直す)"]:::action --> e4["④:①のアピール対象を100%の確率で<br/>3ターンの間「嫉妬」状態にする"]:::effect --> lc1
    lc1{"①のアピール(3名に2回)<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| e5["⑤:自身のHPを①で行った合計<br/>アピールの50%分回復し、自身を<br/>4ターンの間「反響」状態にする"]:::effect --> finish(("終了")):::startend
