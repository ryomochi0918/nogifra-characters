flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル4名に自身の「重奏」<br/>状態の重ねがけ回数×600%の倍率を<br/>上乗せした、600%のアピールを<br/>行う(初回スキル発動時の倍率は<br/>600%となる)"]:::action
    a1 --> c2{"②:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c2 -->|"Yes(②による再実行は最大1回まで)"| a1
    c2 -->|"No"| a3["③実行:ライバルに3回、自身の<br/>「重奏」状態の重ねがけ回数×600%の<br/>倍率を上乗せした、600%の<br/>アピールを行う"]:::action
    a3 --> c4{"④:③のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c4 -->|"Yes(④による再実行は最大1回まで)"| a3
    c4 -->|"No"| e5["⑤:自身を「重奏」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
