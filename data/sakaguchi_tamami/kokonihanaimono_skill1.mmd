flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル6名へ、自身の最大アピールの<br/>20%分を固定値として上乗せした<br/>600%のアピール"]:::action --> c3
    c3{"③:①のアピール対象の<br/>残りHP割合が50%以下か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象を100%の確率で<br/>1ターンの間「転倒」状態にする"]:::effect --> lc1
    c3 -->|"No"| lc1{"①のアピール6回すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| c4{"④:ライバルチームのフロントに居る<br/>「転倒」状態のメンバーの人数が<br/>「転倒」状態ではないメンバーの<br/>人数以下か"}:::cond
    c4 -->|"Yes"| a4["再度①を実行する<br/>(再実行は最大1回まで)"]:::action --> e5
    c4 -->|"No"| e5["⑤:自身のHPを①で行った合計<br/>アピールの20%分回復し、自身を<br/>2ターンの間「回避率アップ」状態にする<br/>(④の再実行が発動した場合は④の終了後)"]:::effect --> finish(("終了")):::startend
