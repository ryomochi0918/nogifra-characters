flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の「重奏」状態の<br/>重ねがけ回数が2回以上か"}:::cond
    c2 -->|"Yes"| e2["①による「勇気」状態の<br/>効果倍率が2倍になる"]:::effect --> e1
    c2 -->|"No"| e1["①効果:自身を4ターンの間<br/>「勇気」状態にする"]:::effect --> c5a
    c5a{"⑤:アピール対象の残りHP割合が<br/>70%未満か(対象ごとに判定)"}:::cond
    c5a -->|"Yes"| e5a["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a3
    c5a -->|"No"| a3["③実行:ライバルへ、自身の最大<br/>アピールの20%を固定値として<br/>上乗せした480%のアピール"]:::action --> lc3
    lc3{"③のアピール3回すべて完了?"}:::cond
    lc3 -->|"No、次の回へ"| c5a
    lc3 -->|"Yes"| c4{"④:自身が「重奏」状態か"}:::cond
    c4 -->|"No"| finish(("終了")):::startend
    c4 -->|"Yes"| c5b{"⑤:アピール対象の残りHP割合が<br/>70%未満か(対象ごとに判定)"}:::cond
    c5b -->|"Yes"| e5b["④のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a4
    c5b -->|"No"| a4["④実行:ライバルへ、自身の最大<br/>アピールの20%を固定値として<br/>上乗せした960%のアピール"]:::action --> lc4
    lc4{"④のアピール(「重奏」状態の<br/>重ねがけ回数×2回、<br/>追加回数は最大6回まで)<br/>すべて完了?"}:::cond
    lc4 -->|"No、次の回へ"| c5b
    lc4 -->|"Yes"| finish
