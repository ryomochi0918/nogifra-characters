flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の「重奏」状態の<br/>重ねがけ回数が2回以上か"}:::cond
    c2 -->|"Yes"| e2["①による「勇気」状態の<br/>効果倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:自身を4ターンの間「勇気」<br/>状態にする"]:::effect
    e2 --> e1
    e1 --> c5{"⑤:アピール対象の<br/>残りHP割合が70%未満か<br/>(③の各アピール前)"}:::cond
    c5 -->|"Yes"| e5["アピール倍率と固定値倍率が2倍になる"]:::effect
    c5 -->|"No"| a3["③実行:ライバルに3回、<br/>自身の最大アピールの20%を<br/>固定値として上乗せした480%の<br/>アピールを行う"]:::action
    e5 --> a3
    a3 --> lc3{"③のアピール<br/>3回すべて完了?"}:::cond
    lc3 -->|"Yes"| c4{"④:自身が「重奏」状態か"}:::cond
    lc3 -->|"No、次の回へ"| c5
    c4 -->|"Yes"| c5_2{"⑤:アピール対象の<br/>残りHP割合が70%未満か<br/>(④の各アピール前)"}:::cond
    c4 -->|"No"| finish(("終了")):::startend
    c5_2 -->|"Yes"| e5_2["アピール倍率と固定値倍率が2倍になる"]:::effect
    c5_2 -->|"No"| a4["④実行:ライバルに自身の<br/>「重奏」状態の重ねがけ回数×2を<br/>アピール回数として、<br/>自身の最大アピールの20%を<br/>固定値として上乗せした960%の<br/>アピールを行う(アピールの<br/>追加回数は最大6回まで)"]:::action
    e5_2 --> a4
    a4 --> lc4{"④のアピール<br/>回数分すべて完了?"}:::cond
    lc4 -->|"Yes"| finish
    lc4 -->|"No、次の回へ"| c5_2
