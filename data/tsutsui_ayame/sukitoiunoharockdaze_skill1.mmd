flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:残りHP割合が最も高い<br/>ライバル4名を100%の確率で2ターンの<br/>間「嫉妬」状態にし、自身のHP上限の<br/>10%を固定値として上乗せした550%の<br/>アピールを行う"]:::action
    a1 --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール後)"}:::cond
    c2 -->|"Yes"| a2["②実行:①のアピール対象に<br/>自身のHP上限の10%を<br/>固定値として上乗せした550%の<br/>アピールを行う"]:::action
    c2 -->|"No"| c3{"③:①と同じ対象の<br/>残りHP割合が70%以下か<br/>(①の各アピール後)"}:::cond
    a2 --> c3
    c3 -->|"Yes"| a3["③実行:自身のHP上限の10%を<br/>固定値として上乗せした550%の<br/>アピールを行う"]:::action
    c3 -->|"No"| lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    a3 --> lc1
    lc1 -->|"Yes"| e4["④:自身を3ターンの間「反響」<br/>状態にする"]:::effect
    lc1 -->|"No、次の対象へ"| a1
    e4 --> finish(("終了")):::startend
