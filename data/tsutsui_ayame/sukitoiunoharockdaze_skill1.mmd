flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:残りHP割合が最も高い<br/>ライバル4名を100%の確率で2ターンの間<br/>「嫉妬」状態にし、自身のHP上限の10%を<br/>固定値として上乗せした<br/>550%のアピール"]:::action --> c2
    c2{"②:自身の残りHP割合が①のアピール<br/>対象の残りHP割合以上か<br/>(①の各アピール後)"}:::cond
    c2 -->|"Yes"| a2["①のアピール対象へ自身のHP上限の10%を<br/>固定値として上乗せした550%の<br/>追加アピール"]:::action --> c3
    c2 -->|"No"| c3{"③:①と同じ対象の残りHP割合が<br/>70%以下か<br/>(①の各アピール後。②による追加アピールが<br/>発動した場合は②の後)"}:::cond
    c3 -->|"Yes"| a3["自身のHP上限の10%を<br/>固定値として上乗せした550%の<br/>追加アピール"]:::action --> lc1
    c3 -->|"No"| lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| a1
    lc1 -->|"Yes"| a4["④実行:自身を3ターンの間<br/>「反響」状態にする"]:::action --> finish(("終了")):::startend
