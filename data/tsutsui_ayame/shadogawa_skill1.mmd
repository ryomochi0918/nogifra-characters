flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:残りHP割合が最も低い<br/>ライバルへ5回、自身のサンクスの3倍を<br/>固定値として上乗せした<br/>400%のアピール"]:::action --> e2["自身のHPを①の直前のアピールの<br/>50%分回復する"]:::effect --> lc1
    lc1{"①のアピール5回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| a1
    lc1 -->|"Yes"| c3{"③:味方チームのフロント人数が<br/>ライバルチームのフロント人数以下、<br/>またはライバルチームのフロント<br/>人数が3名以上か"}:::cond
    c3 -->|"Yes"| c4{"④:③のアピール対象が<br/>デバフ・サゲ効果状態ではないか"}:::cond
    c4 -->|"Yes"| e4["100%の確率で2ターンの間<br/>「空腹」と「嫉妬」状態にする"]:::effect --> c5
    c4 -->|"No"| c5{"⑤:③のアピール対象の残りHP割合が<br/>50%以上か"}:::cond
    c5 -->|"Yes"| e5["③のアピール倍率と固定値倍率を<br/>2倍にする"]:::effect --> a3
    c5 -->|"No"| a3["残りHP割合が最も高いライバル4名の<br/>バフ・アゲ効果を1つ解除し、自身の<br/>サンクスの4倍を固定値として<br/>上乗せした600%のアピール"]:::action --> finish(("終了")):::startend
    c3 -->|"No"| finish
