flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:残りHP割合が最も低い<br/>ライバルに5回、自身のサンクスの<br/>3倍を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    a1 --> e2["②:自身のHPを①で行った直前の<br/>アピールの50%分回復する<br/>(①の各アピール後)"]:::effect
    e2 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:味方チームのフロント人数が<br/>ライバルチームのフロント人数以下<br/>またはライバルチームの<br/>フロント人数が3名以上か"}:::cond
    lc1 -->|"No、次の回へ"| a1
    c3 -->|"Yes"| c4{"④:③のアピール対象が<br/>デバフ・サゲ効果状態ではないか<br/>(③の各アピール前)"}:::cond
    c3 -->|"No"| finish(("終了")):::startend
    c4 -->|"Yes"| e4["100%の確率で2ターンの間「空腹」<br/>と「嫉妬」状態にする"]:::effect
    c4 -->|"No"| c5{"⑤:③のアピール対象の<br/>残りHP割合が50%以上か<br/>(③の各アピール前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["③のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect
    c5 -->|"No"| a3["③実行:残りHP割合が最も高い<br/>ライバル4名のバフ・アゲ効果を<br/>1つ解除し、自身のサンクスの4倍を<br/>固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e5 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc3 -->|"Yes"| finish
    lc3 -->|"No、次の対象へ"| c4
