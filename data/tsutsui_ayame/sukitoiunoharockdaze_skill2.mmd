flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象の<br/>残りHP割合が50%未満か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①の回復倍率が1.5倍になり、<br/>①による「聖域」状態のターン数が<br/>4ターンになる"]:::effect
    c2 -->|"No"| e1["①:自身と自身以外の残りHP割合が<br/>最も低い味方2名のHPを自身の<br/>HP上限の50%分回復し、3ターンの間<br/>「聖域」状態にする"]:::effect
    e2 --> e1
    e1 --> lc1{"①の効果<br/>対象3名すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:残りHP割合が80%以上の味方を<br/>4ターンの間「興奮」状態にする<br/>(効果人数は最大6名)"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e3 --> finish(("終了")):::startend
