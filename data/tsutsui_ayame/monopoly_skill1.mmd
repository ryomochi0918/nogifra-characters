flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のバイタリティが①のアピール<br/>対象のバイタリティ以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル6名へ<br/>600%のアピール"]:::action --> a3["③実行:自身のHPを①で行った合計<br/>アピールの40%分回復し、2ターンの間<br/>「声援」状態にする"]:::action --> c5
    c5{"⑤:自身の残りHP割合が<br/>50%以上か"}:::cond
    c5 -->|"Yes"| e5["④の「反響」状態のリフレクト倍率が<br/>2倍になる"]:::effect --> a4
    c5 -->|"No"| a4["④実行:自身を4ターンの間<br/>「反響」状態にする"]:::action --> finish(("終了")):::startend
