flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>デバフ・サゲ効果耐性貫通を+20%する"]:::effect
    e1 --> a2["②実行:ライバル5名に400%の<br/>アピールを行い、100%の確率で<br/>3ターンの間「アピール力ダウン」<br/>状態にする"]:::action
    a2 --> c4{"④:ライバルチームの<br/>フロント人数が4名以上か"}:::cond
    c4 -->|"Yes"| e4["③の効果対象のバフ・アゲ効果を<br/>2つ解除する"]:::effect
    c4 -->|"No"| e3["③:最大アピールが最も高い<br/>ライバル1名を100%の確率で3ターンの<br/>間「執着」状態と1ターンの間<br/>「落胆」状態にする"]:::effect
    e4 --> e3
    e3 --> a5["⑤実行:ライバルに4回、<br/>自身のエフォートの2.5倍を<br/>固定値として上乗せした760%の<br/>アピールを行う"]:::action
    a5 --> c6{"⑥:⑤のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c6 -->|"Yes(再実行は最大1回まで)"| a5
    c6 -->|"No"| finish(("終了")):::startend
