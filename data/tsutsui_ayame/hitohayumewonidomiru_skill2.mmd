flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:このスキル中、自身が特殊状態か"}:::cond
    c1 -->|"Yes"| e1["自身の命中率を+30%する"]:::effect
    c1 -->|"No"| c3{"③:②のアピール対象が「混乱」状態か<br/>(②の各アピール前)"}:::cond
    e1 --> c3
    c3 -->|"Yes"| e3["必ず会心アピールになる"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに2回、<br/>アピール対象のHP上限2.5%分を<br/>固定値として上乗せした1500%の<br/>アピールを行い、100%の確率で<br/>3ターンの間「心労」状態にする"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>2回すべて完了?"}:::cond
    lc2 -->|"Yes"| e4["④:残りHP割合が最も低い味方2名の<br/>HPを②で行った合計アピールの<br/>20%分回復し、4ターンの間「堅忍」<br/>状態にする"]:::effect
    lc2 -->|"No、次の回へ"| c3
    e4 --> finish(("終了")):::startend
