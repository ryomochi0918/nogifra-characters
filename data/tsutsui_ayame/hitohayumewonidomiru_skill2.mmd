flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1
    c1{"①:自身が特殊状態か"}:::cond
    c1 -->|"Yes"| e1["このスキル中、自身の<br/>命中率を+30%する"]:::effect --> c3
    c1 -->|"No"| c3{"③:②のアピール対象が<br/>「混乱」状態か"}:::cond
    c3 -->|"Yes"| e3["必ず会心アピールになる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバルへ2回、アピール対象の<br/>HP上限2.5%分を固定値として上乗せした<br/>1500%のアピールを行い、100%の<br/>確率で3ターンの間「心労」状態にする"]:::action --> a4["④実行:残りHP割合が最も低い<br/>味方2名のHPを②で行った合計<br/>アピールの20%分回復し、4ターンの間<br/>「堅忍」状態にする"]:::action --> finish(("終了")):::startend
