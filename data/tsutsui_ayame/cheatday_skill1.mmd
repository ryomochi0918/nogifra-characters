flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①の効果対象の残りHP割合が<br/>50%以上か(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①による「機敏」状態の<br/>アピール力増加倍率が1.5倍になり、<br/>命中率増加倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>味方2名を3ターンの間<br/>「機敏」状態にする"]:::action
    a1 --> c3{"③:①の効果対象がデバフ・サゲ<br/>効果状態ではないか(①の各効果後)"}:::cond
    c3 -->|"Yes"| e3["①の効果対象を3ターンの間<br/>「集中」状態にする"]:::effect --> lc1
    c3 -->|"No"| lc1{"①の効果<br/>対象2名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| a4["④実行:残りHP割合が最も低い<br/>味方3名のデバフ・サゲ効果を1つ解除し、<br/>HPを自身のHP上限の30%分<br/>回復する"]:::action
    a4 --> a5["⑤実行:④の効果対象を3ターンの間<br/>「勇気」状態にする"]:::action
    a5 --> lc4{"④の効果<br/>対象3名すべて完了?"}:::cond
    lc4 -->|"No、次の対象へ"| a4
    lc4 -->|"Yes"| finish(("終了")):::startend
