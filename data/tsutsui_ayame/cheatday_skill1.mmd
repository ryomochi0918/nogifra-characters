flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象の<br/>残りHP割合が50%以上か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①による「機敏」状態の<br/>アピール力増加倍率が1.5倍になり、<br/>命中率増加倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:最大アピールが最も高い味方2名を<br/>3ターンの間「機敏」状態にする"]:::effect
    e2 --> e1
    e1 --> c3{"③:①の効果対象が<br/>デバフ・サゲ効果状態ではないか<br/>(①の各効果後)"}:::cond
    c3 -->|"Yes"| e3["①の効果対象を3ターンの間「集中」<br/>状態にする"]:::effect
    c3 -->|"No"| lc1{"①の効果<br/>対象2名すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| e4["④:残りHP割合が最も低い味方3名の<br/>デバフ・サゲ効果を1つ解除し、<br/>HPを自身のHP上限の30%分回復する"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e4 --> e5["⑤:④の効果対象を3ターンの間<br/>「勇気」状態にする<br/>(④の各効果後)"]:::effect
    e5 --> lc4{"④の効果<br/>対象3名すべて完了?"}:::cond
    lc4 -->|"Yes"| finish(("終了")):::startend
    lc4 -->|"No、次の対象へ"| e4
