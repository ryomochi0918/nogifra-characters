flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身の残りHP割合が①のアピール<br/>対象の残りHP割合以上か"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果解除数が1つ<br/>増加し、アピール倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバルへ、バフ・アゲ効果<br/>状態を1つ解除し、500%のアピール"]:::action --> e4a["自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect --> lc1
    lc1{"①のアピール4回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| a3["③実行:残りHP割合が最も高い<br/>ライバル1名へ、ライブ中に発動した<br/>自身のスキル1・スキル2で行った合計<br/>アピールの30%分のアピール<br/>(ディフェンス、メンタルを無視)"]:::action --> e4b["自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect --> c5
    c5{"⑤:自身の残りHP割合が<br/>50%以上か"}:::cond
    c5 -->|"Yes"| a5["自身を4ターンの間<br/>「神気」状態にする"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
