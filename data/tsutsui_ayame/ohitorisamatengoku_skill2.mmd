flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果解除数が<br/>1つ増加し、アピール倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに4回、<br/>バフ・アゲ効果状態を1つ解除し、<br/>500%のアピールを行う"]:::action
    e2 --> a1
    a1 --> e4["④:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する<br/>(①の各アピール後)"]:::effect
    e4 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| a3["③実行:残りHP割合が最も高い<br/>ライバル1名にライブ中に発動した<br/>自身のスキル1「エリート社員」と<br/>スキル2「ウクレレなんてあるんかーい」<br/>で行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    lc1 -->|"No、次の回へ"| c2
    a3 --> e4_2["④:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する<br/>(③の各アピール後)"]:::effect
    e4_2 --> c5{"⑤:自身の残りHP割合が50%以上か"}:::cond
    c5 -->|"Yes"| e5["自身を4ターンの間「神気」<br/>状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
