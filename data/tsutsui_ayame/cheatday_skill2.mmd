flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の命中率と<br/>デバフ耐性貫通を+15%する"]:::effect
    e1 --> c3{"③:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ①に<br/>よる命中率とデバフ耐性貫通の<br/>増加倍率が30%になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル5名を100%の確率で<br/>2ターンの間「フィジカルダウン」<br/>と「メンタルダウン」状態にし、<br/>700%のアピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc2 -->|"Yes"| e4["④:最大アピールが最も高い<br/>味方2名のデバフ・サゲ効果を<br/>1つ解除し、HPをこのスキルで行った<br/>合計アピールの50%分回復する"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e4 --> finish(("終了")):::startend
