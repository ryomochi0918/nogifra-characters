flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+30%する"]:::effect
    e1 --> e2["②:残りHP割合が最も低い<br/>ライバル3名を100%の確率で4ターンの<br/>間「混乱」状態にする"]:::effect
    e2 --> c4{"④:③のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>2種類以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:ライバルに4回、<br/>アピール対象のHP上限0.6%分の<br/>固定値を上乗せした650%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>4回すべて完了?"}:::cond
    lc3 -->|"Yes"| e5["⑤:残りHP割合が最も低い味方3名の<br/>HPを③で行った合計アピールの<br/>30%分回復する"]:::effect
    lc3 -->|"No、次の回へ"| c4
    e5 --> finish(("終了")):::startend
