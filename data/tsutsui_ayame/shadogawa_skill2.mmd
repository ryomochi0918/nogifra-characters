flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が「空腹」<br/>状態ではないかつ「嫉妬」<br/>状態ではないか<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象を100%の確率で<br/>2ターンの間「空腹」と「嫉妬」<br/>状態にする"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル4名に自身のサンクスの<br/>4倍を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:①のアピール対象の残りHP割合が<br/>30%以下または自身のサンクスが<br/>①のアピール対象のサンクス以上か<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| a3["③実行:同じアピール対象に2800%の<br/>アピールを行う"]:::action
    c3 -->|"No"| lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    a3 --> lc1
    lc1 -->|"Yes"| c4{"④:このスキルでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| finish(("終了")):::startend
