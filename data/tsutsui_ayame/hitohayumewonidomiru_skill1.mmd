flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身のサンクスの<br/>3倍を固定値として上乗せする"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が「混乱」状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①の各アピール中のみ、<br/>アピール対象の最大アピールの<br/>300%分、自身のアピール力を<br/>上昇させる(上昇可能なアピール力は<br/>自身の最大アピールの750%まで)"]:::effect
    c3 -->|"No"| a1["①実行:ライバルに7回、400%の<br/>アピールを行い、100%の確率で<br/>3ターンの間「混乱」状態にする"]:::action
    e3 --> a1
    a1 --> c4{"④:このスキル中に1度でもアピールの<br/>失敗またはアピールが0だったか<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["このスキルによる残りのアピールは<br/>必ず命中する"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>7回すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
