flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のサンクスが①のアピール<br/>対象のサンクス以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身のサンクスの<br/>3倍を固定値として上乗せする"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>「混乱」状態か"}:::cond
    c3 -->|"Yes"| e3["①の各アピール中のみ、対象の最大<br/>アピールの300%分自身のアピール力を<br/>上昇(上限は自身の最大アピールの<br/>750%まで)"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバルへ400%のアピールを<br/>行い、100%の確率で3ターンの間<br/>「混乱」状態にする"]:::action --> c4
    c4{"④:このスキル中に1度でも<br/>アピールの失敗またはアピールが<br/>0だったか"}:::cond
    c4 -->|"Yes"| e4["このスキルによる残りのアピールは<br/>必ず命中する"]:::effect --> lc1
    c4 -->|"No"| lc1{"①のアピール7回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| finish(("終了")):::startend
