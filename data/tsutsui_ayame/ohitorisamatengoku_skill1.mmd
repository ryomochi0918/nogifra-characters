flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3
    c3{"③:自身のスマイルが①のアピール<br/>対象のスマイル以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバル4名へ、自身の<br/>スマイルの1.5倍を固定値として<br/>上乗せした300%のアピール"]:::action --> c3b
    c3b{"③:自身のスマイルが②のアピール<br/>対象のスマイル以上か"}:::cond
    c3b -->|"Yes"| e3b["②のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a2
    c3b -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルへ3回、自身のスマイルの<br/>1.5倍を固定値として上乗せした<br/>800%のアピール"]:::action --> c4
    c4{"④:②の直前のアピールでライバルが<br/>リタイアしたか"}:::cond
    c4 -->|"Yes"| a4["ライバル1名へこのスキルで行った<br/>合計アピールの50%分のアピール<br/>(ディフェンス、メンタルを無視)"]:::action --> lc1
    c4 -->|"No"| lc1{"②のアピール3回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c3b
    lc1 -->|"Yes"| a5["⑤実行:自身のHPをこのスキルで<br/>行った合計アピールの20%分<br/>回復する"]:::action --> finish(("終了")):::startend
