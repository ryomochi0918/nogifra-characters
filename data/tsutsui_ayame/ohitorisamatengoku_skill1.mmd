flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③:自身のスマイルが①の<br/>各アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:ライバル4名に自身のスマイルの<br/>1.5倍を固定値として上乗せした300%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c3_2{"③:自身のスマイルが②の<br/>各アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    lc1 -->|"No、次の対象へ"| c3
    c3_2 -->|"Yes"| e3_2["②の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3_2 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに3回、自身のスマイルの<br/>1.5倍を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e3_2 --> a2
    a2 --> c4{"④:②で行った直前のアピールで<br/>ライバルがリタイアしたか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| a4["④実行:ライバル1名にこのスキルで<br/>行った合計アピールの50%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    c4 -->|"No"| lc2{"②のアピール<br/>3回すべて完了?"}:::cond
    a4 --> lc2
    lc2 -->|"Yes"| e5["⑤:自身のHPをこのスキルで行った<br/>合計アピールの20%分回復する"]:::effect
    lc2 -->|"No、次の回へ"| c3_2
    e5 --> finish(("終了")):::startend
