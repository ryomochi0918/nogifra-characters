flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身のリフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:自身の残りHP割合が<br/>②の対象の残りHP割合以上か"}:::cond

    c3 -->|"Yes"| e3["②の対象のバフ・アゲ効果を1つ解除<br/>②の固定値倍率が2倍に"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身のエフォートが<br/>②の対象のエフォート以上か"}:::cond

    c4 -->|"Yes"| e4["②のアピールに自身の最大アピールの70%を固定値として上乗せ<br/>②のアピール倍率を2倍に"]:::effect --> a2
    c4 -->|"No"| a2["②実行:<br/>最大アピールが最も高いライバルへ<br/>基本430%+固定値 エフォート×3"]:::action

    a2 --> lc{"②のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| c5{"⑤:②でリタイアした人数が<br/>1名以下か"}:::cond
    c5 -->|"Yes"| a5["最大アピールが最も高いライバルへ2回アピール<br/>②の合計アピールの50%<br/>※Def,Phy無視"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
