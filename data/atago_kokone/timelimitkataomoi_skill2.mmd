flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除し、②の固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピールに自身の最大アピールの<br/>70%分を固定値として上乗せし、<br/>②のアピール倍率を2倍にする"]:::effect
    c4 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルに6回、自身のエフォートの<br/>3倍を固定値として上乗せした430%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:②のアピールでリタイアした<br/>人数が1名以下か"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes"| a5["⑤実行:最大アピールが最も<br/>高いライバルに2回、②で<br/>行った合計アピールの50%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
