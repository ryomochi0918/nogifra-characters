flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象の<br/>残りHP割合が50%以下か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①のデバフ・サゲ効果解除数を<br/>全てに変更する"]:::effect
    c2 -->|"No"| e1["①:味方6名のデバフ・サゲ効果を<br/>1つ解除する"]:::effect
    e2 --> e1
    e1 --> lc1{"①の効果<br/>対象6名すべて完了?"}:::cond
    lc1 -->|"Yes"| e4["④:①で解除したデバフ・サゲ効果の<br/>数が1つ毎に、③のアピール回数が<br/>1回増加する(アピールの追加回数は<br/>最大で8回まで)"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e4 --> c5{"⑤:自身のバイタリティが③の<br/>アピール対象のバイタリティ以上か<br/>(③の各アピール前)"}:::cond
    c5 -->|"Yes"| e5["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c5 -->|"No"| a3["③実行:ライバルに5回、<br/>自身のサンクスの3倍を<br/>固定値として上乗せした300%の<br/>アピールを行う"]:::action
    e5 --> a3
    a3 --> lc3{"③のアピール<br/>5回(+④の追加分)すべて完了?"}:::cond
    lc3 -->|"Yes"| e6["⑥:味方6名のHPを③で行った<br/>合計アピールの30%分回復する"]:::effect
    lc3 -->|"No、次の回へ"| c5
    e6 --> c8{"⑧:③のアピールでライバルが<br/>リタイアしたか"}:::cond
    c8 -->|"Yes"| e8["⑦による「神気」状態の<br/>アピール力増加倍率が2倍になる"]:::effect
    c8 -->|"No"| e7["⑦:最大アピールが最も高い味方3名を<br/>3ターンの間「神気」状態にする"]:::effect
    e8 --> e7
    e7 --> finish(("終了")):::startend
