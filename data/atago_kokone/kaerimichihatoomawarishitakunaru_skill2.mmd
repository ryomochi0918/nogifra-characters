flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②①の各効果前:<br/>①の効果対象の残りHP割合が50%以下?<br/>(対象ごとに判定)"}:::cond
    c2 -- "Yes" --> e2["①のデバフ・サゲ効果解除数を<br/>全てに変更する"]:::effect
    c2 -- "No" --> s1
    e2 --> s1["①味方6名のデバフ・サゲ効果を<br/>1つ解除する<br/>(②成立の対象は全て解除)"]:::effect

    s1 --> c4{"④③のアピール前:<br/>①で解除したデバフ・サゲ効果の数が<br/>1つ以上ある?"}:::cond
    c4 -- "Yes" --> e4["①で解除したデバフ・サゲ効果の数が<br/>1つ毎に、③のアピール回数が1回増加する<br/>(アピールの追加回数は最大で8回まで)"]:::effect
    c4 -- "No" --> s3start
    e4 --> s3start["③①の効果後、ライバルに<br/>5回(+④の追加回数)アピールを開始"]:::effect

    s3start --> c5{"⑤③の各アピール前:<br/>自身のバイタリティが③のアピール対象の<br/>バイタリティ以上?"}:::cond
    c5 -- "Yes" --> e5["③のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect
    c5 -- "No" --> atk
    e5 --> atk["③アピール実行:<br/>自身のサンクスの3倍を固定値として<br/>上乗せした300%のアピールを行う"]:::action

    atk --> loop{"③のアピール5回(+④の追加回数)<br/>すべて完了?"}:::cond
    loop -- "No、次の回へ" --> c5
    loop -- "Yes" --> s6["⑥③のアピールが全て終了後、<br/>味方6名のHPを③で行った<br/>合計アピールの30%分回復する"]:::effect

    s6 --> c8{"⑧⑦の効果前:<br/>③のアピールでライバルが<br/>リタイアした?"}:::cond
    c8 -- "Yes" --> e8["⑦による「神気」状態の<br/>アピール力増加倍率が2倍になる"]:::effect
    c8 -- "No" --> s7
    e8 --> s7["⑦⑥の効果後、最大アピールが最も高い<br/>味方3名を3ターンの間<br/>「神気」状態にする"]:::effect
    s7 --> finish(("終了")):::startend
