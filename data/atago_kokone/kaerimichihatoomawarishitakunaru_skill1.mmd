flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> s1["①自身を3ターンの間<br/>「脚光」状態にする"]:::effect
    s1 --> s2["②①の効果後、味方6名の<br/>デバフ・サゲ効果を1つ解除する"]:::effect
    s2 --> c4{"④③のアピール前:<br/>②で解除したデバフ・サゲ効果の数が<br/>1つ以上ある?"}:::cond
    c4 -- "Yes" --> e4["②で解除したデバフ・サゲ効果の数が<br/>1つ毎に、③のアピール回数が1回増加する<br/>(アピールの追加回数は最大で6回まで)"]:::effect
    c4 -- "No" --> s3start
    e4 --> s3start["③②の効果後、ライバルに<br/>4回(+④の追加回数)アピールを開始"]:::effect

    s3start --> atk["③アピール実行:<br/>自身のサンクスの3.5倍を固定値として<br/>上乗せした200%のアピールを行う"]:::action
    atk --> loop{"③のアピール4回(+④の追加回数)<br/>すべて完了?"}:::cond
    loop -- "No、次の回へ" --> atk
    loop -- "Yes" --> s5["⑤③のアピールが全て終了後、<br/>残りHP割合が最も低い味方1名のHPを<br/>③で行った合計アピールの500%分回復する"]:::effect
    s5 --> finish(("終了")):::startend
