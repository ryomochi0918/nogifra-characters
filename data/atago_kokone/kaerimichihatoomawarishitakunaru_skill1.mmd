flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間「脚光」<br/>状態にする"]:::effect
    e1 --> e2["②:味方6名のデバフ・サゲ効果を<br/>1つ解除する"]:::effect
    e2 --> e4["④:②で解除したデバフ・サゲ効果の<br/>数が1つ毎に、③のアピール回数が<br/>1回増加する(アピールの追加回数は<br/>最大で6回まで)"]:::effect
    e4 --> a3["③実行:ライバルに4回、<br/>自身のサンクスの3.5倍を<br/>固定値として上乗せした200%の<br/>アピールを行う"]:::action
    a3 --> e5["⑤:残りHP割合が最も低い味方1名の<br/>HPを③で行った合計アピールの<br/>500%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
