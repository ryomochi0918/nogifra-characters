flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身の命中率とデバフ効果耐性貫通を<br/>+20%する"]:::effect
    e1 --> c3{"③:味方フロントのバフ・アゲ効果・<br/>特殊状態の合計数が20以上か"}:::cond
    c3 -->|"Yes"| e3["②の対象人数が+1<br/>(最大1名まで)"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身の残りHP割合が<br/>②の対象の残りHP割合以上か"}:::cond
    c4 -->|"Yes"| e4["対象を100%の確率で2ターンの間<br/>「フィジカルダウン」+「メンタルダウン」に、<br/>②のアピール倍率を2倍に"]:::effect --> a2
    c4 -->|"No"| a2["②実行:<br/>残りHP割合が最も高いライバルへ<br/>バフ・アゲ効果を1つ解除+600%のアピール"]:::action
    a2 --> lc{"②の対象<br/>すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c4
    lc -->|"Yes"| e5["⑤:残りHP割合が最も低い味方3名の<br/>デバフ・サゲ効果を1つ解除し、<br/>HPを合計アピールの50%分回復、<br/>3ターンの間「勇気」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
