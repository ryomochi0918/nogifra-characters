flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の命中率と<br/>デバフ効果耐性貫通を+20%する"]:::effect
    e1 --> c3{"③:味方フロントの<br/>バフ・アゲ効果・特殊状態の<br/>合計数が20以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象が1名増加する<br/>(増加人数は最大で1名まで)"]:::effect
    c3 -->|"No"| c4{"④:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール対象を100%の確率で<br/>2ターンの間「フィジカルダウン」<br/>と「メンタルダウン」状態にし、<br/>②のアピール倍率を2倍にする"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル4名のバフ・アゲ効果を<br/>1つ解除し、600%のアピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>対象すべて完了?"}:::cond
    lc2 -->|"Yes"| e5["⑤:残りHP割合が最も低い味方3名の<br/>デバフ・サゲ効果を1つ解除し、<br/>HPをこのスキルで行った<br/>合計アピールの50%分回復し、<br/>3ターンの間「勇気」状態にする"]:::effect
    lc2 -->|"No、次の対象へ"| c4
    e5 --> finish(("終了")):::startend
