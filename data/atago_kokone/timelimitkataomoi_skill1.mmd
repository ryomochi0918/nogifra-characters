flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間<br/>「アピールブースト(感謝)」<br/>状態にする"]:::effect
    e1 --> c3{"③:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:ライバルチームの<br/>フロント人数が3名以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに5回、自身のエフォートの<br/>2倍を固定値として上乗せした480%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> e5["⑤:自身のHPを直前のアピールの<br/>30%分回復する<br/>(②の各アピール後)"]:::effect
    e5 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"Yes"| c6{"⑥:②のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c6 -->|"Yes(再実行は最大1回まで)"| c3
    c6 -->|"No"| finish(("終了")):::startend
