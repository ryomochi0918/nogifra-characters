flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間<br/>「アピールブースト(感謝)」状態にする"]:::effect
    e1 --> c3{"③:自身のエフォートが<br/>②の対象のエフォート以上か"}:::cond

    c3 -->|"Yes"| e3["②の倍率と固定値倍率が2倍に"]:::effect --> c4
    c3 -->|"No"| c4{"④:ライバルチームのフロント人数が<br/>3名以上か"}:::cond

    c4 -->|"Yes"| e4["②の対象のバフ・アゲ効果を1つ解除"]:::effect --> a2
    c4 -->|"No"| a2["②実行:<br/>残りHP割合が最も低いライバルへ<br/>基本480%+固定値 エフォート×2"]:::action

    a2 --> e5["⑤:自身のHPを直前アピールの30%分回復"]:::effect
    e5 --> lc{"②のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| c6{"⑥:②でライバルが<br/>リタイアしなかったか<br/>(かつ再実行がまだの場合)"}:::cond
    c6 -->|"Yes(再実行は最大1回まで)"| c3
    c6 -->|"No"| finish(("終了")):::startend
