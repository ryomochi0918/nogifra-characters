flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>バフ・アゲ効果状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を1つ解除し、<br/>①のアピール倍率と固定値倍率を2倍にする"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象がバフ・アゲ効果<br/>状態ではない、または特殊状態か"}:::cond
    c3 -->|"Yes"| e3["①のアピールに「①のアピール前の自身の<br/>「円陣」状態ターン数×自身の最大アピールの5%」を<br/>固定値として加算する(②③による固定値上限は70%まで)"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバルへ、自身の最大アピールの20%を<br/>固定値として上乗せした420%のアピール"]:::action --> lc{"①の対象4名<br/>すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| c4{"④:自身の「円陣」状態のターン数が<br/>6ターン以上か"}:::cond
    c4 -->|"Yes"| a1b["①を再実行する<br/>(4名へ再度アピール、再実行は最大1回まで)"]:::action --> c5{"⑤:自身の「円陣」状態のターン数が<br/>9ターン以上か"}:::cond
    c4 -->|"No"| finish(("終了")):::startend
    c5 -->|"Yes"| a1c["①を再実行する<br/>(4名へ再度アピール、再実行は最大1回まで)"]:::action --> finish
    c5 -->|"No"| finish
