flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+30%、<br/>リフレクト耐性を+50%する"]:::effect
    e1 --> c3{"③:味方フロントの「独占」状態の<br/>合計ターン数が6ターン以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに8回、<br/>自身のサンクスの2倍を<br/>固定値として上乗せした320%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> e4["④:②のアピール対象を100%の<br/>確率で2ターンの間「命中率ダウン」<br/>状態にする<br/>(②の各アピール後)"]:::effect
    e4 --> lc2{"②のアピール<br/>8回すべて完了?"}:::cond
    lc2 -->|"Yes"| e5["⑤:自身のHPを②で行った<br/>合計アピールの30%分回復する"]:::effect
    lc2 -->|"No、次の回へ"| c3
    e5 --> finish(("終了")):::startend
