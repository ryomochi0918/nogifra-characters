flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+30%、<br/>リフレクト耐性を+50%する"]:::effect --> c3{"③:味方フロントの「独占」状態の<br/>合計ターン数が6ターン以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバルへ、自身のサンクスの2倍を<br/>固定値として上乗せした320%のアピール"]:::action --> e4["④:②の対象を100%の確率で<br/>2ターンの間「命中率ダウン」状態にする"]:::effect --> lc{"②のアピール8回<br/>すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| e5["⑤:自身のHPを②で行った合計アピールの<br/>30%分回復する"]:::effect --> finish(("終了")):::startend
