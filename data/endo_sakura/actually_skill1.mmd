flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%未満か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ自身の<br/>リフレクト耐性を+40%する"]:::effect
    c2 -->|"No"| a1["①実行:ライバル4名に自身の残りHPの<br/>24%を固定値として上乗せした780%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④/⑤:自身の残りHP割合が50%以上か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["④:②による「魅了」状態を「決心」<br/>状態に変更する"]:::effect
    c4 -->|"No"| e5["⑤:自身以外の味方2名を3ターンの<br/>間「反響」状態にする"]:::effect
    e4 --> e3["③:自身のHPをHP上限の30%分回復し、<br/>4ターンの間「反響」と「魅了」<br/>状態にする"]:::effect
    e5 --> e3
    e3 --> finish(("終了")):::startend
