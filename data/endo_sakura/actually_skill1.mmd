flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル1名へ、自身の残りHPの<br/>24%を固定値として上乗せした<br/>780%のアピール"]:::action --> c2{"②:自身の残りHP割合が<br/>50%未満か"}:::cond
    c2 -->|"Yes"| e2["①のアピール中のみ自身の<br/>リフレクト耐性を+40%する"]:::effect --> lc{"①のアピール4名<br/>すべて完了?"}:::cond
    c2 -->|"No"| lc
    lc -->|"No、次の対象へ"| a1
    lc -->|"Yes"| c4{"④/⑤:自身の残りHP割合が<br/>50%以上か"}:::cond
    c4 -->|"Yes(50%以上)"| a3a["③実行:自身のHPをHP上限の30%分回復し、<br/>4ターンの間「反響」状態にする<br/>(④により「魅了」は「決心」に変更)"]:::action --> finish(("終了")):::startend
    c4 -->|"No(50%未満)"| a3b["③実行:自身のHPをHP上限の30%分回復し、<br/>4ターンの間「反響」と「魅了」状態にする"]:::action --> e5["⑤:自身以外の味方2名を<br/>3ターンの間「反響」状態にする"]:::effect --> finish
