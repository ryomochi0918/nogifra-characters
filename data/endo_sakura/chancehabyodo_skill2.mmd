flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身の命中率を+20%する"]:::effect --> c3{"③:②のアピール対象が<br/>「心労」状態か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身の残りHP割合が②のアピール対象の<br/>残りHP割合以上、または自身の「光輝」状態の<br/>ターン数が9ターン以上か"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c4 -->|"No"| a2["②実行:残りHP割合が最も低いライバルへ、<br/>自身の最大アピール30%を固定値として<br/>上乗せした350%のアピール"]:::action --> lc{"②のアピール6回<br/>すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| c5{"⑤:味方フロントの「光輝」状態の<br/>合計ターン数が12ターン以上か"}:::cond
    c5 -->|"Yes"| a5["残りHP割合が最も低いライバルへ、<br/>②で行った合計アピールの20%分のアピール<br/>(ディフェンス、フィジカルを無視、2回)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
