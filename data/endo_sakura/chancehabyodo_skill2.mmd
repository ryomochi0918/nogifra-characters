flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e1 --> c3{"③:②のアピール対象が「心労」状態か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上または<br/>自身の「光輝」状態のターン数が<br/>9ターン以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も低いライバルに<br/>6回、自身の最大アピール30%を<br/>固定値として上乗せした350%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:味方フロントの「光輝」状態の<br/>合計ターン数が12ターン以上か"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も<br/>低いライバルに2回、②で<br/>行った合計アピールの20%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
