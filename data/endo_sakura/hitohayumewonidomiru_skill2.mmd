flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の命中率と<br/>会心率を+20%する"]:::effect --> c3{"③:自身の「希望」状態の<br/>ターン数が8ターン以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c4
    c3 -->|"No"| c4{"④:②のアピール対象が受けている<br/>特殊状態の種類数が2種類以上か"}:::cond
    c4 -->|"Yes"| e4["このアピール中のみ①による命中率の<br/>増加倍率が40%になり、②のアピール回数が<br/>1回増加する(追加回数は最大3回まで)"]:::effect --> a2
    c4 -->|"No"| a2["②実行:最大アピールが最も高いライバルへ、<br/>自身の最大アピールの20%を固定値として上乗せした<br/>300~900%のアピール(対象の残りHP割合が<br/>高いほど倍率上昇)"]:::action --> lc{"②のアピール6回<br/>(+④による追加分)すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| c5{"⑤:②のアピールでリタイアした<br/>ライバルが1名以下か"}:::cond
    c5 -->|"Yes"| a5["残りHP割合が最も低いライバル1名へ、<br/>②で行った合計アピールの30%分のアピール<br/>(ディフェンス、フィジカルを無視)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
