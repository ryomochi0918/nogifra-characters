flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の命中率と<br/>会心率を+20%する"]:::effect
    e1 --> c3{"③:自身の「希望」状態のターン数が<br/>8ターン以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:②のアピール対象が受けている<br/>特殊状態の種類数が2種類以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②の各アピール中のみ①による<br/>命中率の増加倍率が40%になり、<br/>②のアピール回数が1回増加する<br/>(アピールの追加回数は最大で3回まで)"]:::effect
    c4 -->|"No"| a2["②実行:最大アピールが<br/>最も高いライバルに6回、<br/>自身の最大アピールの20%を<br/>固定値として上乗せした300~900%の<br/>アピールを行う(アピール対象の<br/>残りHP割合が高いほど倍率が高くなる)"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>6回(+④の追加分)すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:②のアピールでリタイアした<br/>ライバルが1名以下か"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も<br/>低いライバル1名に②で<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
