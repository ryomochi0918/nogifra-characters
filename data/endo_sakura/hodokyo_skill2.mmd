flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③:②の効果対象が<br/>バフ・アゲ効果状態ではないまたは<br/>特殊状態か<br/>(②の各効果前)"}:::cond
    c3 -->|"Yes"| e3["①のアピールに「①のアピール前の自身の<br/>「円陣」状態ターン数×自身の最大アピールの5%」を<br/>固定値として加算する<br/>(②と③の効果による固定値の最大倍率は<br/>70%まで)"]:::effect
    c3 -->|"No"| c2{"②:①のアピール対象が<br/>バフ・アゲ効果状態か<br/>(①の各アピール前)"}:::cond
    e3 --> c2
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を<br/>1つ解除し、①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect
    c2 -->|"No"| a1["①実行:ライバル4名に自身の最大アピールの<br/>20%を固定値として上乗せした<br/>420%のアピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| r4{"④の再実行による<br/>①のアピールか"}:::cond
    lc1 -->|"No、次の対象へ"| c3
    r4 -->|"No"| c4{"④:自身の「円陣」状態の<br/>ターン数が6ターン以上か"}:::cond
    r4 -->|"Yes"| c5{"⑤:自身の「円陣」状態の<br/>ターン数が9ターン以上か"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c3
    c4 -->|"No"| finish(("終了")):::startend
    c5 -->|"Yes(再実行は最大1回まで)"| c3
    c5 -->|"No"| finish
