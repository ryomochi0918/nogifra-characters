flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+30%、<br/>会心アピールを+50%する"]:::effect
    e1 --> a2["②実行:ライバル6名に2回、<br/>600~1200%のアピールを行う<br/>(2回目以降のアピールは対象を<br/>選び直す、このスキルを発動する<br/>前のフロントとサポートの<br/>リタイアしていない味方の人数が<br/>多いほど倍率が増加し、人数が6名の<br/>時点で最大倍率になる)"]:::action
    a2 --> c4{"④:味方フロントの「独占」状態の<br/>合計ターン数が8ターン以上か"}:::cond
    c4 -->|"Yes"| e4["③の効果対象を4ターンの間<br/>「回避率アップ」状態にする"]:::effect
    c4 -->|"No"| e3["③:自身と自身以外の残りHP割合の<br/>最も低い味方3名のHPを②で行った<br/>合計アピールの30%分回復する"]:::effect
    e4 --> e3
    e3 --> finish(("終了")):::startend
