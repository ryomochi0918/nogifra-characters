flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身の状態に応じて②か③の<br/>効果どちらかを適用する"]:::effect
    e1 --> c2{"②/③:自身の残りHP割合が50%以上か"}:::cond
    c2 -->|"Yes"| e2["②:自身を4ターンの間「集音」<br/>状態にする"]:::effect
    c2 -->|"No"| e3["③:自身を4ターンの間「静音」<br/>状態にする"]:::effect
    e2 --> c5{"⑤:自身のサンクスが④の<br/>アピール対象のサンクス以上か<br/>(④の各アピール前)"}:::cond
    e3 --> c5
    c5 -->|"Yes"| e5["④のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c5 -->|"No"| c6{"⑥:ライバルチームの<br/>フロント人数が4名以上か<br/>(④の各アピール前)"}:::cond
    e5 --> c6
    c6 -->|"Yes"| e6["④のアピール対象の<br/>バフ・アゲ効果を1つ解除し、<br/>④の各アピール中のみ自身の<br/>命中率を+20%する"]:::effect
    c6 -->|"No"| a4["④実行:最大アピールが最も高い<br/>ライバルに4回、自身のサンクスの<br/>4倍を固定値として上乗せした850%の<br/>アピールを行う"]:::action
    e6 --> a4
    a4 --> lc4{"④のアピール<br/>4回すべて完了?"}:::cond
    lc4 -->|"Yes"| e7["⑦:自身のHPを④で行った<br/>合計アピールの30%分回復する"]:::effect
    lc4 -->|"No、次の回へ"| c5
    e7 --> finish(("終了")):::startend
