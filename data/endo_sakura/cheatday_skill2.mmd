flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:最大アピールが最も高い<br/>ライバル4名にアピール対象が<br/>受けている「デバフ・サゲ効果状態の<br/>種類数+1」×自身の残りHPの10%を<br/>固定値として上乗せした800%の<br/>アピールを行う"]:::action
    a1 --> e2["②:自身と自身以外の残りHP割合が<br/>最も低い味方1名を3ターンの間<br/>「聖域」状態にする"]:::effect
    e2 --> c4{"④:自身のスマイルが③の<br/>アピール対象のスマイル以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:残りHP割合が最も低いライバルに<br/>4回、③の開始前に自身が受けている<br/>「バフ・アゲ効果・特殊状態の<br/>合計種類数+1」×自身の残りHPの<br/>10%を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> e5["⑤:自身のHPを直前のアピールの<br/>30%分回復する<br/>(③の各アピール後)"]:::effect
    e5 --> lc3{"③のアピール<br/>4回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c4
