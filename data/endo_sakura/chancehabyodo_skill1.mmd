flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:残りHP割合が最も低い<br/>ライバルに4回、自身のサンクスの<br/>2倍を固定値として上乗せした480%の<br/>アピールを行う"]:::action
    a1 --> c2{"②:自身の「光輝」状態の<br/>合計ターン数が7ターン以上か<br/>(①の各アピール後)"}:::cond
    c2 -->|"Yes"| e2["自身のHPを①で行った直前の<br/>アピールの30%分回復する"]:::effect
    c2 -->|"No"| lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    e2 --> lc1
    lc1 -->|"Yes"| a3["③実行:残りHP割合が最も高い<br/>ライバル4名に「①のアピールで<br/>発生した会心アピールの回数×自身の<br/>サンクス」を加算した自身のサンクスの<br/>3倍を固定値として上乗せした480%の<br/>アピールを行う(③の効果に<br/>よる加算を含めたサンクスの<br/>最大倍率は7倍まで)"]:::action
    lc1 -->|"No、次の回へ"| a1
    a3 --> c4{"④:このスキルによって会心アピールが<br/>2回以上発生しているか<br/>(③の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["③のアピール対象を100%の確率で<br/>3ターンの間「心労」状態にする"]:::effect
    c4 -->|"No"| lc3{"③のアピール<br/>ライバル4名すべて完了?"}:::cond
    e4 --> lc3
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の対象へ"| a3
