flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:残りHP割合が最も低いライバルへ、<br/>自身のサンクスの2倍を固定値として<br/>上乗せした480%のアピール"]:::action --> c2{"②:自身の「光輝」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    c2 -->|"Yes"| e2["自身のHPを①で行った直前の<br/>アピールの30%分回復する"]:::effect --> lc1{"①のアピール4回<br/>すべて完了?"}:::cond
    c2 -->|"No"| lc1
    lc1 -->|"No、次の回へ"| a1
    lc1 -->|"Yes"| a3["③実行:残りHP割合が最も高いライバル4名へ、<br/>「①の会心アピール回数×自身のサンクス」を加算した<br/>自身のサンクスの3倍を固定値として上乗せした<br/>480%のアピール(加算込みサンクス倍率は最大7倍まで)"]:::action --> c4{"④:このスキルで会心アピールが<br/>2回以上発生したか"}:::cond
    c4 -->|"Yes"| e4["③のアピール対象を100%の確率で<br/>3ターンの間「心労」状態にする"]:::effect --> finish(("終了")):::startend
    c4 -->|"No"| finish
