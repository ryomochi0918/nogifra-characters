flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>サゲ効果耐性貫通を+20%する"]:::effect
    e1 --> c3{"③:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["自身の残りSPの70倍を<br/>固定値として上乗せする"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル4名を100%の確率で<br/>2ターンの間「嫉妬」状態にし、<br/>770%のアピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:④の効果対象の<br/>残りHP割合が50%未満か<br/>(④の各効果前)"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c5 -->|"Yes"| e5["④の効果対象のHPを自身の<br/>アピール力の100%分回復する<br/>(会心率に応じて会心回復が発生する)"]:::effect
    c5 -->|"No"| e4["④:味方6名を2ターンの間「柔軟」<br/>状態にする"]:::effect
    e5 --> e4
    e4 --> lc4{"④の効果<br/>対象6名すべて完了?"}:::cond
    lc4 -->|"Yes"| e6["⑥:デバフ・サゲ効果状態の<br/>ライバル1名につき、最大アピールが<br/>最も高いライバルを100%の確率で<br/>1ターンの間「落胆」状態にする<br/>(最大で4名を対象とする)"]:::effect
    lc4 -->|"No、次の対象へ"| c5
    e6 --> finish(("終了")):::startend
