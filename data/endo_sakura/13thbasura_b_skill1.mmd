flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール対象の<br/>バフ・アゲ効果を1つ解除し、<br/>①による「フィジカルダウン」と<br/>「メンタルダウン」状態の効果倍率が<br/>1.5倍になる"]:::effect
    c3 -->|"No"| a1["①実行:ライバル4名を100%の確率で<br/>2ターンの間「フィジカルダウン」<br/>と「メンタルダウン」状態にし、<br/>1000%のアピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①の各アピール前に自身の<br/>残りHP割合が①のアピール対象の<br/>残りHP割合以上である事が<br/>3回以上発生したか"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["最大アピールが最も高いライバル2名を<br/>100%の確率で1ターンの間「雑音」<br/>状態にする"]:::effect
    c4 -->|"No"| finish(("終了")):::startend
    e4 --> finish
