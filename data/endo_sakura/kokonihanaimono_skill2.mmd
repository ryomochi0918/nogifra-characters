flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象が<br/>デバフ・サゲ効果状態か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①の効果対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル2名を100%の確率で2ターンの間<br/>「回避率ダウン」状態にし、1500%のアピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>対象すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:②の効果によるバフ・アゲ効果の<br/>解除が1度も発生しなかったか"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c3 -->|"Yes(増加人数は最大で1名まで)<br/>①のアピール対象が1名増加する"| c2
    c3 -->|"No"| c4{"④:①のアピールで<br/>ライバルがリタイアしなかったか"}:::cond
    c4 -->|"Yes(再実行は最大2回まで)<br/>再実行毎に③による<br/>アピール対象増加効果と<br/>発生条件はリセットされる"| c2
    c4 -->|"No"| finish(("終了")):::startend
