flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>サゲ効果耐性貫通を+30%する"]:::effect
    e1 --> c3{"③:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象が1名増加する<br/>(増加人数は最大で2名まで)"]:::effect
    c3 -->|"No"| c4{"④:②の対象の残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル3名を100%の確率で<br/>3ターンの間「空腹」状態にし、<br/>自身の最大アピールの25%を<br/>固定値として上乗せした700%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>対象すべて完了?"}:::cond
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の対象へ"| c3
