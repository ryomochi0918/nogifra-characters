flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身のサゲ効果耐性貫通を<br/>+30%する"]:::effect --> c3{"③:自身のスマイルが②の対象の<br/>スマイル以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象が1名増加する<br/>(増加人数は最大2名まで)"]:::effect --> c4
    c3 -->|"No"| c4{"④:②の対象の残りHP割合が<br/>50%以上か"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率が2倍になる"]:::effect --> a2
    c4 -->|"No"| a2["②実行:ライバル1名を100%の確率で<br/>3ターンの間「空腹」状態にし、<br/>自身の最大アピールの25%を固定値として<br/>上乗せした700%のアピール"]:::action --> lc{"②のアピール対象<br/>すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c3
    lc -->|"Yes"| finish(("終了")):::startend
