flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方フロントの「円陣」状態の<br/>合計ターン数が4ターン以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が2倍になり、<br/>①の各アピール中のみリフレクト耐性を+25%する"]:::effect --> c3
    c2 -->|"No"| c3{"③:味方フロントの「円陣」状態の<br/>合計ターン数が6ターン以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピールに自身の最大アピールの30%を<br/>固定値として上乗せする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:残りHP割合が最も高いライバルへ、<br/>自身のエフォートの4倍を固定値として<br/>上乗せした400%のアピール"]:::action --> lc1{"①のアピール6回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c5{"⑤:味方フロントの「円陣」状態の<br/>合計ターン数が5ターン以上か"}:::cond
    c5 -->|"Yes"| e5["④のアピール倍率が2倍になり、<br/>「円陣」合計ターン数5ターン毎に④の<br/>アピール対象が1名増加する<br/>(対象増加は最大2名まで)"]:::effect --> a4
    c5 -->|"No"| a4["④実行:ライバル1名へ、①で行った合計<br/>アピールの20%分のアピール<br/>(ディフェンス、フィジカルを無視)"]:::action --> a6["⑥実行:残りHP割合が最も低いライバル1名の<br/>バフ・アゲ効果を1つ解除し、このスキルで行った<br/>合計アピールの50%分のアピール<br/>(ディフェンス、フィジカルを無視)"]:::action --> finish(("終了")):::startend
