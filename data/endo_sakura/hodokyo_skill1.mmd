flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方フロントの「円陣」状態の<br/>合計ターン数が4ターン以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>2倍になり、①の各アピール中のみ、<br/>リフレクト耐性を+25%する"]:::effect
    c2 -->|"No"| c3{"③:味方フロントの「円陣」状態の<br/>合計ターン数が6ターン以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピールに自身の最大アピールの<br/>30%を固定値として上乗せする"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに6回、自身のエフォートの<br/>4倍を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:味方フロントの「円陣」状態の<br/>合計ターン数が5ターン以上か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c5 -->|"Yes"| e5["④のアピール倍率が2倍になり、<br/>味方フロントの「円陣」状態の<br/>合計ターン数が5ターン毎に<br/>④のアピール対象が1名増加する<br/>(アピール対象の増加は最大で2名まで)"]:::effect
    c5 -->|"No"| a4["④実行:ライバル1名に①で<br/>行った合計アピールの20%分の<br/>アピールを行う(ディフェンスと<br/>フィジカルを無視する)"]:::action
    e5 --> a4
    a4 --> a6["⑥実行:残りHP割合が最も低い<br/>ライバル1名のバフ・アゲ効果を<br/>1つ解除し、このスキルで<br/>行った合計アピールの50%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    a6 --> finish(("終了")):::startend
