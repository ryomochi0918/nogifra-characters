flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の残りSPの<br/>50倍を固定値として上乗せする"]:::effect
    c2 -->|"No"| c3{"③:自身の残りHP割合が50%未満か<br/>(②の効果後)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル4名を100%の確率で<br/>3ターンの間「嫉妬」状態にし、<br/>800%のアピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:自身が「残響」状態か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["自身と自身以外の最大アピールが最も<br/>高い味方1名のデバフ・サゲ効果を<br/>全て解除し、HPを自身のHP上限の<br/>50%分回復する"]:::effect
    c4 -->|"No"| finish(("終了")):::startend
    e4 --> finish
