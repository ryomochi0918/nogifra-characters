flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果状態ではないか"}:::cond
    c2 -->|"Yes"| e2["①による「軽快」状態の<br/>アピール力増加倍率が1.5倍になる"]:::effect
    c2 -->|"No"| e1["①:自身を2ターンの間「軽快」<br/>状態にする"]:::effect
    e2 --> e1
    e1 --> c4{"④:自身のサンクスが③の<br/>アピール対象のサンクス以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c4 -->|"No"| a3["③実行:最大アピールが最も高い<br/>ライバル4名に自身のサンクスの<br/>4倍を固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> c5{"⑤:③のアピール対象の<br/>残りHP割合50%以上または③の<br/>アピール対象がバフ・アゲ効果状態か<br/>(③の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["③のアピール対象を100%の確率で<br/>2ターンの間「命中率ダウン」<br/>状態にする"]:::effect
    c5 -->|"No"| lc3{"③のアピール<br/>ライバル4名すべて完了?"}:::cond
    e5 --> lc3
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の対象へ"| c4
