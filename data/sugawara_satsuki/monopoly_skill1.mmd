flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール対象がデバフ・サゲ<br/>効果状態か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["該当対象への①のアピールは<br/>必ず会心アピールになる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル6名のバフ・アゲ効果を<br/>1つ解除し、自身のスマイルの3倍を<br/>固定値として上乗せした530%の<br/>アピールを行い、100%の確率で<br/>4ターンの間「心労」状態にする"]:::action --> c3
    c3{"③:①のアピールで1度でも<br/>会心アピールが発生したか"}:::cond
    c3 -->|"Yes"| e3["このスキル中、自身の命中率と<br/>サゲ効果耐性貫通を+20%する"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身の「光輝」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    c4 -->|"Yes"| a4["残りHP割合が最も低いライバルへ2回、<br/>自身の最大アピールの30%を固定値<br/>として上乗せした600%のアピール"]:::action --> finish(("終了")):::startend
    c4 -->|"No"| finish
