flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:自身を1ターンの間「アピール<br/>力アップ」状態と3ターンの間<br/>「臨機」状態にする"]:::action --> c3
    c3{"③:自身のスマイルが②のアピール<br/>対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除し、②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル2名へ2回、自身のスマイルの<br/>4倍を固定値として上乗せした<br/>880%のアピール"]:::action
    a2 --> lc2n{"②のアピール<br/>対象1名に2回すべて完了?"}:::cond
    lc2n -->|"No、次の回へ"| c3
    lc2n -->|"Yes"| lc2{"②のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2 -->|"Yes"| c4{"④:②のアピールでリタイアした<br/>ライバルが1名以下か"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c3
    c4 -->|"No"| a5["⑤実行:自身のHPをこのスキルで<br/>行った合計アピールの20%分<br/>回復する"]:::action --> a6["⑥実行:自身の「アピール力アップ」<br/>状態を解除する"]:::action --> finish(("終了")):::startend
