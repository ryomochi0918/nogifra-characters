flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のエフォートが①のアピール<br/>対象のエフォート以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身が受けているバフ・アゲ<br/>効果状態の種類数が3種類以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率が1.5倍になる"]:::effect --> a1
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルへ、自身の最大アピールの<br/>30%を固定値として上乗せした<br/>400%のアピール"]:::action --> c4
    c4{"④:①のアピール対象が<br/>リタイアしたか"}:::cond
    c4 -->|"Yes"| e4["①のアピール回数が1回増加する<br/>(追加回数は最大1回まで)"]:::effect --> lc1
    c4 -->|"No"| lc1{"①のアピールが全て完了?<br/>(基本4回、④で最大+1回)"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| a5["⑤実行:残りHP割合が最も高い<br/>ライバルへ1回、①で会心アピールが<br/>発生した回数×200%の倍率を<br/>上乗せした400%のアピール"]:::action --> finish(("終了")):::startend
