flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身が受けている<br/>バフ・アゲ効果状態の種類数が<br/>3種類以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率が1.5倍になる"]:::effect
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに4回、自身の最大アピールの<br/>30%を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> c4{"④:①のアピール対象がリタイアしたか<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["①のアピール回数が1回増加する<br/>(アピールの追加回数は最大で1回まで)"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>4回(+④の追加分)すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| a5["⑤実行:残りHP割合が最も高い<br/>ライバルに1回、①のアピールで<br/>会心アピールが発生した<br/>回数×200%の倍率を上乗せした、<br/>400%のアピールを行う"]:::action
    lc1 -->|"No、次の回へ"| c2
    a5 --> finish(("終了")):::startend
