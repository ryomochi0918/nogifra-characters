flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:残りHP割合が最も低い<br/>ライバル1名のバフ・アゲ効果を<br/>全て解除し、自身の最大アピールの<br/>30%を固定値として上乗せした1300%の<br/>アピールを行う"]:::action
    a1 --> c2{"②:①のアピールが失敗または<br/>アピールが0だったか"}:::cond
    c2 -->|"Yes(再実行は最大2回まで)"| a1
    c2 -->|"No"| c3{"③:①のアピールでアピール対象が<br/>リタイアしたまたは①のアピールで<br/>アピール対象の残りHP割合が<br/>30%未満に1度でもなったか"}:::cond
    c3 -->|"Yes"| e3["自身を2ターンの間「熱血」<br/>状態にする"]:::effect
    c3 -->|"No"| a4["④実行:ライバル3名に<br/>自身の最大アピールの20%を<br/>固定値として上乗せした450%の<br/>アピールを行う"]:::action
    e3 --> a4
    a4 --> e5["⑤:自身のHPを自身のアピール力の<br/>50%分回復する(会心率に<br/>応じて会心回復が発生)"]:::effect
    e5 --> finish(("終了")):::startend
