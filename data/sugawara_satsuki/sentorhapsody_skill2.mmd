flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、<br/>リフレクト耐性を+50%する"]:::effect --> c3
    c3{"③:自身の残りHP割合が100%、または<br/>②のアピール対象がデバフ・サゲ<br/>効果状態か"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ自身の会心率と<br/>命中率を+30%する"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身の残りHP割合が<br/>50%以上か"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率が3倍になる"]:::effect --> c5
    c4 -->|"No"| c5{"⑤:②のアピール対象がバフ・アゲ<br/>効果状態ではないか"}:::cond
    c5 -->|"Yes"| e5["②の固定値倍率が3倍になる"]:::effect --> a2
    c5 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルへ、自身のサンクスの2倍を<br/>固定値として上乗せした<br/>500%のアピール"]:::action --> c6
    c6{"⑥:②のアピールで<br/>会心アピールが発生したか"}:::cond
    c6 -->|"Yes"| e6["②のアピール回数を1回増加する<br/>(追加回数は最大3回まで)"]:::effect --> lc1
    c6 -->|"No"| lc1{"②のアピールが全て完了?<br/>(基本3回、⑥で最大+3回)"}:::cond
    lc1 -->|"No、次の回へ"| c3
    lc1 -->|"Yes"| finish(("終了")):::startend
