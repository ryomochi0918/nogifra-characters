flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>リフレクト耐性を+50%する"]:::effect
    e1 --> c3{"③:自身の残りHP割合が100%<br/>または②のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ、自身の<br/>会心率と命中率を+30%する"]:::effect
    c3 -->|"No"| c4{"④:自身の残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率が3倍になる"]:::effect
    c4 -->|"No"| c5{"⑤:②のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(②の各アピール前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["②の固定値倍率が3倍になる"]:::effect
    c5 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルに3回、自身のサンクスの<br/>2倍を固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e5 --> a2
    a2 --> c6{"⑥:②のアピールで会心アピールが<br/>発生したか<br/>(②の各アピール後)"}:::cond
    c6 -->|"Yes"| e6["②のアピール回数を1回増加する<br/>(アピールの追加回数は最大で3回まで)"]:::effect
    c6 -->|"No"| lc2{"②のアピール<br/>3回(+⑥の追加分)すべて完了?"}:::cond
    e6 --> lc2
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
