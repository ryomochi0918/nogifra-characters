flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身がバフ・アゲ効果<br/>状態か"}:::cond
    c2 -->|"Yes"| e2["①の「聡明」状態の会心率<br/>増加倍率が1.5倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:自身を2ターンの間<br/>「聡明」状態にし、このスキル中、<br/>自身のデバフ耐性貫通を<br/>+20%する"]:::action --> c4
    c4{"④:自身のエフォートが③のアピール<br/>対象のエフォート以上か"}:::cond
    c4 -->|"Yes"| e4["③のアピールに対象のHP上限の<br/>1%を固定値として上乗せする"]:::effect --> a3
    c4 -->|"No"| a3["③実行:残りHP割合が最も高い<br/>ライバル5名へ100%の確率で<br/>3ターンの間「フィジカルダウン」と<br/>「メンタルダウン」状態にし、<br/>440%のアピール"]:::action --> c5
    c5{"⑤:③のアピールで会心アピールが<br/>2回以上発生したか"}:::cond
    c5 -->|"Yes"| e5["自身を2ターンの間<br/>「興奮」状態にする"]:::effect --> a6
    c5 -->|"No"| a6["⑥実行:残りHP割合が最も高い<br/>ライバルへ1回、③で行った合計<br/>アピールの20%分のアピール<br/>(ディフェンス、フィジカルを無視)"]:::action --> finish(("終了")):::startend
