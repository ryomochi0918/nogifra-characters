flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果状態か"}:::cond
    c2 -->|"Yes"| e2["①による「聡明」状態の<br/>会心率増加倍率を1.5倍にする"]:::effect
    c2 -->|"No"| e1["①:自身を2ターンの間「聡明」<br/>状態にし、このスキル中、自身の<br/>デバフ耐性貫通を+20%する"]:::effect
    e2 --> e1
    e1 --> c4{"④:自身のエフォートが③の<br/>アピール対象のエフォート以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピールに③のアピール対象の<br/>HP上限の1%を固定値として上乗せする"]:::effect
    c4 -->|"No"| a3["③実行:残りHP割合が最も高い<br/>ライバル5名を100%の確率で<br/>3ターンの間「フィジカルダウン」<br/>と「メンタルダウン」状態にし、<br/>440%のアピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc3 -->|"Yes"| c5{"⑤:③のアピールで会心アピールが<br/>2回以上発生したか"}:::cond
    lc3 -->|"No、次の対象へ"| c4
    c5 -->|"Yes"| e5["自身を2ターンの間「興奮」<br/>状態にする"]:::effect
    c5 -->|"No"| a6["⑥実行:残りHP割合が最も<br/>高いライバルに1回、③で<br/>行った合計アピールの20%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    e5 --> a6
    a6 --> finish(("終了")):::startend
