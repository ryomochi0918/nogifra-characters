flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を1ターンの間<br/>「アピール力アップ」状態にする"]:::effect
    e1 --> a2["②実行:残りHP割合が最も低い<br/>ライバルに4回、自身のスマイルの4倍を<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    a2 --> c4{"④:自身のスマイルが③の<br/>アピール対象のスマイル以上か"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| c5{"⑤:自身の「瞑想」状態の<br/>合計ターン数が6ターン以上か"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["③のアピールに自身のSP上限の200倍を<br/>固定値として上乗せする"]:::effect
    c5 -->|"No"| a3["③実行:最大アピールが最も高いライバルに<br/>1回、自身の「瞑想」状態のターン数×<br/>自身のスマイルの0.5倍を固定値として<br/>上乗せした800%のアピールを行う"]:::action
    e5 --> a3
    a3 --> c6{"⑥:③のアピールでライバルが<br/>リタイアしたまたは③のアピール対象の<br/>残りHP割合が40%以上か<br/>(③のアピール後)"}:::cond
    c6 -->|"Yes"| e6["③のアピール回数が1回増加する<br/>(アピールの追加回数は最大で3回まで)"]:::effect
    c6 -->|"No"| lc3{"③のアピール<br/>1回(+⑥の追加分)すべて完了?"}:::cond
    e6 --> lc3
    lc3 -->|"Yes"| e7["⑦:自身の「アピール力アップ」状態を<br/>解除する"]:::effect
    lc3 -->|"No、次の回へ"| a3
    e7 --> finish(("終了")):::startend
