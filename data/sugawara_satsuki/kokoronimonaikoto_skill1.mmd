flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>サゲ効果耐性貫通を+40%する"]:::effect --> c3
    c3{"③:自身のサンクスが②の各アピール<br/>対象のサンクス以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピールに自身のHP上限の<br/>15%を固定値として上乗せする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバル4名へ100%の確率で<br/>3ターンの間「嫉妬」状態にし、<br/>800%のアピール"]:::action --> a4["④実行:自身と自身以外の最大アピールが<br/>最も高い味方1名を3ターンの間<br/>「反響」状態にする"]:::action --> c6
    c6{"⑥:「嫉妬」状態のライバルが<br/>フロントに2名以上居るか"}:::cond
    c6 -->|"Yes"| e6["⑤のアピール倍率が2倍になる"]:::effect --> a5
    c6 -->|"No"| a5["⑤実行:残りHP割合が最も高い<br/>ライバル1名へ②で行った合計<br/>アピールの20%分のアピール<br/>(ディフェンス、フィジカルを無視)"]:::action --> finish(("終了")):::startend
