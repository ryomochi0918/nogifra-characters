flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>サゲ効果耐性貫通を+40%する"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>各アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピールに自身のHP上限の15%を<br/>固定値として上乗せする"]:::effect
    c3 -->|"No"| a2["②実行:ライバル4名を100%の確率で<br/>3ターンの間「嫉妬」状態にし、<br/>800%のアピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| e4["④:自身と自身以外の最大アピールが<br/>最も高い味方1名を3ターンの間<br/>「反響」状態にする"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e4 --> c6{"⑥:「嫉妬」状態のライバルが<br/>フロントに2名以上居るか"}:::cond
    c6 -->|"Yes"| e6["⑤のアピール倍率が2倍になる"]:::effect
    c6 -->|"No"| a5["⑤実行:残りHP割合が最も<br/>高いライバル1名に②で<br/>行った合計アピールの20%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    e6 --> a5
    a5 --> finish(("終了")):::startend
