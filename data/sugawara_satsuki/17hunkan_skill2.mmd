flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の固定値倍率とアピール倍率が<br/>2倍になる"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| a1["①実行:ライバル4名に2回、<br/>自身のエフォートの1.5倍を<br/>固定値として上乗せした550%の<br/>アピールを行う(2回目以降の<br/>アピールは対象を選び直す)"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| lc1n{"①のアピール<br/>2回すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1n -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしたか"}:::cond
    lc1n -->|"No、次の回へ"| c2
    c4 -->|"Yes"| a4["④実行:残りHP割合が最も<br/>高いライバル1名に①で<br/>行った合計アピールの20%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c4 -->|"No"| finish(("終了")):::startend
    a4 --> finish
