flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のエフォートが①のアピール<br/>対象のエフォート以上か"}:::cond
    c2 -->|"Yes"| e2["①の固定値倍率とアピール倍率が<br/>2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象の残りHP割合が<br/>50%以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバル4名へ2回、自身の<br/>エフォートの1.5倍を固定値として<br/>上乗せした550%のアピール<br/>(2回目以降は対象を選び直す)"]:::action --> c4
    c4{"④:①のアピールでライバルが<br/>リタイアしたか"}:::cond
    c4 -->|"Yes"| a4["残りHP割合が最も高いライバル1名へ<br/>①で行った合計アピールの20%分の<br/>アピール(ディフェンス、フィジカルを無視)"]:::action --> finish(("終了")):::startend
    c4 -->|"No"| finish
