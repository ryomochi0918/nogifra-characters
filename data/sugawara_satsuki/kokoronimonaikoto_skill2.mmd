flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象が「嫉妬」状態か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果の解除数が<br/>1つ増加する"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>バフ・アゲ効果ではないか<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:ライバル6名のバフ・アゲ効果を<br/>1つ解除し、自身のサンクスの3倍を<br/>固定値として上乗せした900%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| e4["④:自身と自身以外の最大アピールが<br/>最も高い味方2名のHPを①で行った<br/>合計アピールの50%分回復する"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e4 --> finish(("終了")):::startend
