flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①の効果対象が<br/>「嫉妬」状態か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["該当対象への①のバフ・アゲ効果の<br/>解除数が1つ増加する"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>バフ・アゲ効果ではないか"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバル6名のバフ・アゲ効果を<br/>1つ解除し、自身のサンクスの3倍を<br/>固定値として上乗せした<br/>900%のアピール"]:::action --> a4["④実行:自身と自身以外の最大アピールが<br/>最も高い味方2名のHPを①で行った<br/>合計アピールの50%分回復する"]:::action --> finish(("終了")):::startend
