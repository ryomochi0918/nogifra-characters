flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e4["④:このスキル中、ライバルを<br/>リタイアさせる度に、このスキル中の<br/>自身の会心率を「このスキル中に<br/>リタイアさせた回数×30%」分増加する<br/>(会心率の増加上限は+90%まで)"]:::effect
    e4 --> a1["①実行:残りHP割合が最も低い<br/>ライバルに8回、自身の最大アピールの<br/>20%を固定値として上乗せした360%の<br/>アピールを行う"]:::action
    a1 --> c2{"②:自身の残りHP割合が50%未満か<br/>(①の各アピール後)"}:::cond
    c2 -->|"Yes"| e2["自身のHPを①で行った直前の<br/>アピールの50%分回復する"]:::effect
    c2 -->|"No"| lc1{"①のアピール<br/>8回すべて完了?"}:::cond
    e2 --> lc1
    lc1 -->|"Yes"| c3{"③:①のアピールでライバルが<br/>1名以上リタイアしたか"}:::cond
    lc1 -->|"No、次の回へ"| a1
    c3 -->|"Yes"| a3["③実行:ライバル3名に<br/>自身の最大アピールの20%を<br/>固定値として上乗せした360%の<br/>アピールを行う"]:::action
    c3 -->|"No"| finish(("終了")):::startend
    a3 --> finish
