flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が「心労」状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と固定値が<br/>1.5倍になる"]:::effect
    c3 -->|"No"| a1["①実行:ライバル6名に自身のスマイルの<br/>2倍を固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> e4["④:①のアピール対象を100%の確率で<br/>3ターンの間「心労」状態にする<br/>(①の各アピール後)"]:::effect
    e4 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| e5["⑤:自身を3ターンの間「勇気」<br/>状態と「遮音」状態にする"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e5 --> finish(("終了")):::startend
