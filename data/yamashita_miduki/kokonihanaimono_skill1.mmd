flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>50%以上か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:①のアピール対象が<br/>「心労」状態か(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値が1.5倍になる"]:::effect --> a1
    c3 -->|"No"| a1
    a1["①実行:ライバル6名に自身の<br/>スマイルの2倍を固定値として<br/>上乗せした600%のアピールを行う"]:::action --> e4
    e4["①の各アピール後、アピール対象を<br/>100%の確率で3ターンの間<br/>「心労」状態にする(対象ごとに判定)"]:::effect --> e5
    e5["⑤効果:自身を3ターンの間<br/>「勇気」状態と「遮音」状態にする"]:::effect --> finish(("終了")):::startend
