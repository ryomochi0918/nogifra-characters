flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身の残りHP割合が50%<br/>以上、または自身の残りHP割合が<br/>①のアピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:①のアピール対象がバフ・アゲ<br/>効果・特殊状態か(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバル2名へ2回、自身の最大アピールの<br/>20%を固定値として上乗せした<br/>400%のアピール"]:::action
    a1 --> lc1n{"①のアピール<br/>対象1名に2回すべて完了?<br/>(④の再実行時は3回)"}:::cond
    lc1n -->|"No、次の回へ"| c2
    lc1n -->|"Yes"| lc1{"①のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| c4
    c4{"④:①のアピール対象に特殊状態の<br/>メンバーが居たか"}:::cond
    c4 -->|"Yes(①のアピール回数を1回増加させ再実行、<br/>追加回数と再実行は最大1回まで)"| c2
    c4 -->|"No"| finish(("終了")):::startend
