flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を2ターンの間「倍音」<br/>状態にする"]:::effect
    e1 --> e2["②:最大アピールが最も高い<br/>ライバル2名に、対象の状態に<br/>応じて③〜⑤のアピールを行う"]:::effect
    e2 --> c3{"③:②のアピール対象が<br/>バフ・アゲ効果状態か"}:::cond
    c3 -->|"Yes"| a3["③実行:②のアピール対象に2回、<br/>自身のスマイルの10倍を<br/>固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    c3 -->|"No"| c4{"④:(③のアピールが発生した<br/>場合は③の後)②のアピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    a3 --> c4
    c4 -->|"Yes"| a4["④実行:②のアピール対象に2回、<br/>②のアピール対象のバフ・アゲ効果を<br/>1つ解除し、自身の最大アピールの<br/>50%を固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    c4 -->|"No"| c5{"⑤:(③、④のアピールが発生した<br/>場合は③、④の後)②のアピール対象が<br/>特殊状態か"}:::cond
    a4 --> c5
    c5 -->|"Yes"| a5["⑤実行:②のアピール対象に2回、<br/>自身のスマイルの12倍を<br/>固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    c5 -->|"No"| lc2{"②のアピール<br/>ライバル2名すべて完了?"}:::cond
    a5 --> lc2
    lc2 -->|"Yes"| c6{"⑥:②のアピールが発生しなかったか"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c6 -->|"Yes"| a6["⑥実行:最大アピールが最も高い<br/>ライバル2名に3回、自身のスマイルの<br/>12倍を固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    c6 -->|"No"| finish(("終了")):::startend
    a6 --> finish
