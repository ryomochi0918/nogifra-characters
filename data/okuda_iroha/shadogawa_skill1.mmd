flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:ライバルチームの<br/>フロント人数が4名以下か"}:::cond
    c2 -->|"Yes"| e2["①による命中率の増加倍率が40%になる"]:::effect
    c2 -->|"No"| e1["①:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e2 --> e1
    e1 --> c4{"④:③のアピール対象の<br/>残りHP割合が50%以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③の固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:残りHP割合が最も高いライバルに<br/>3回、アピール対象の残りHPの6%分を<br/>固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>3回すべて完了?"}:::cond
    lc3 -->|"Yes"| c6{"⑥:自身の残りHP割合が50%以下か"}:::cond
    lc3 -->|"No、次の回へ"| c4
    c6 -->|"Yes"| e6["⑤による「華麗」状態のディフェンスの<br/>増加倍率が1.5倍になる"]:::effect
    c6 -->|"No"| e5["⑤:自身以外のHP上限が最も高い<br/>味方2名を2ターンの間「華麗」<br/>状態にする"]:::effect
    e6 --> e5
    e5 --> finish(("終了")):::startend
