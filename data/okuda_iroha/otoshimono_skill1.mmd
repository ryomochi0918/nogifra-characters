flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の対象の残りHP割合が50%未満か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①の効果対象のデバフ・サゲ効果を<br/>1つ解除する"]:::effect
    c2 -->|"No"| c3{"③:ライブ中に自身のスキル1<br/>「恋々」が2回以上発動したか<br/>(①の各効果前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①の効果対象を2ターンの間「興奮」<br/>状態にする"]:::effect
    c3 -->|"No"| e1["①:最大アピールが最も高い味方2名を<br/>2ターンの間「アピール力アップ」<br/>状態にし、HPを自身のアピール力の<br/>80%分回復する(会心率に<br/>応じて会心回復が発生)"]:::effect
    e3 --> e1
    e1 --> lc1{"①の効果<br/>対象2名すべて完了?"}:::cond
    lc1 -->|"Yes"| a4["④実行:最大アピールが最も高い<br/>ライバル1名に1520%のアピールを行う"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a4 --> c5{"⑤:ライブ中に自身のスキル1<br/>「恋々」の発動が1回以下、または<br/>自身の「声援」状態のターン数が<br/>4ターン以上か"}:::cond
    c5 -->|"Yes"| e5["味方6名を2ターンの間<br/>「アピールガード(努力)」状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
