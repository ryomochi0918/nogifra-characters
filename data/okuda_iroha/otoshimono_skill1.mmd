flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:対象の残りHP割合が<br/>50%未満か"}:::cond
    c2 -->|"Yes"| e2["対象のデバフ・サゲ効果を<br/>1つ解除する"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:ライブ中に自身のスキル1<br/>「恋々」が2回以上発動したか"}:::cond
    c3 -->|"Yes"| e3["対象を2ターンの間<br/>「興奮」状態にする"]:::effect --> e1
    c3 -->|"No"| e1["①効果:最大アピールが最も高い<br/>味方2名を2ターンの間「アピール力アップ」<br/>状態にし、HPを自身のアピール力の80%<br/>分回復する(会心率に応じて<br/>会心回復が発生)"]:::effect --> a4["④実行:最大アピールが最も高い<br/>ライバル1名へ1520%のアピール"]:::action --> c5
    c5{"⑤:ライブ中に自身のスキル1<br/>「恋々」の発動が1回以下、または<br/>自身の「声援」状態のターン数が<br/>4ターン以上か"}:::cond
    c5 -->|"Yes"| e5["味方6名を2ターンの間<br/>「アピールガード(努力)」状態にする"]:::effect --> finish(("終了")):::startend
    c5 -->|"No"| finish
