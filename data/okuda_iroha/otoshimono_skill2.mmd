flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になり、<br/>バフ・アゲ効果の解除数が2つ増加する"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル5名のバフ・アゲ効果を<br/>2つ解除し、620%のアピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:残りHP割合が最も低い味方2名の<br/>HPを①で行った合計アピールの<br/>40%分回復する"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e3 --> c5{"⑤:自身の「声援」状態のターン数が<br/>5ターン以上か"}:::cond
    c5 -->|"Yes"| e5["④の効果対象が1名増加する"]:::effect
    c5 -->|"No"| e4["④:最大アピールが最も高い味方1名を<br/>3ターンの間「堅忍」状態にする"]:::effect
    e5 --> e4
    e4 --> finish(("終了")):::startend
