flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身の残りHP割合が<br/>対象の残りHP割合以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になり、<br/>バフ・アゲ効果の解除数が<br/>2つ増加する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル5名のバフ・アゲ効果を<br/>2つ解除し、620%のアピール"]:::action --> loop1
    loop1{"①を5名分実行したか"}:::cond
    loop1 -->|"No、次の対象へ"| c2
    loop1 -->|"Yes"| e3["③実行:残りHP割合が最も低い<br/>味方2名のHPを①の合計アピールの<br/>40%分回復する"]:::effect --> c5
    c5{"⑤:自身の「声援」状態の<br/>ターン数が5ターン以上か"}:::cond
    c5 -->|"Yes"| e5["④の効果対象が<br/>1名増加する"]:::effect --> e4
    c5 -->|"No"| e4["④実行:最大アピールが最も高い<br/>味方1名を3ターンの間<br/>「堅忍」状態にする"]:::effect --> finish(("終了")):::startend
