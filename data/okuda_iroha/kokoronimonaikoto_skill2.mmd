flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の「円陣」状態のターン数が<br/>7ターン以上か"}:::cond
    c2 -->|"Yes"| e2["①による命中率と会心率の<br/>増加倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:このスキル中、自身の命中率と<br/>会心率を+15%する"]:::effect
    e2 --> e1
    e1 --> c4{"④:自身の「円陣」状態のターン数が<br/>9ターン以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③の各アピールにアピール対象の<br/>HP減少分の8%を固定値として上乗せする<br/>(固定値の上乗せは自身の<br/>最大アピールの400%まで)"]:::effect
    c4 -->|"No"| a3["③実行:残りHP割合が最も高い<br/>ライバルに6回、自身の最大アピールの<br/>30%を固定値として上乗せした460%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> c5{"⑤:アピール対象が「衰弱」状態か<br/>(③の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["対象を100%の確率で3ターンの間<br/>「心労」状態にする"]:::effect
    c5 -->|"No"| lc3{"③のアピール<br/>6回すべて完了?"}:::cond
    e5 --> lc3
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c4
