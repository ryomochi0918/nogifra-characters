flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身の「円陣」状態の<br/>ターン数が7ターン以上か"}:::cond
    c2 -->|"Yes"| e2["①の命中率と会心率の<br/>増加倍率が2倍になる"]:::effect --> e1
    c2 -->|"No"| e1["①効果:このスキル中、自身の<br/>命中率と会心率を+15%する"]:::effect --> c4
    c4{"④:自身の「円陣」状態の<br/>ターン数が9ターン以上か"}:::cond
    c4 -->|"Yes"| e4["③のアピールにアピール対象の<br/>HP減少分の8%を固定値として<br/>上乗せする(上限は最大アピールの<br/>400%まで)"]:::effect --> a3
    c4 -->|"No"| a3["③実行:残りHP割合が最も高い<br/>ライバルへ6回、自身の最大アピールの<br/>30%を固定値として上乗せした<br/>460%のアピール"]:::action --> c5
    c5{"⑤:対象が「衰弱」<br/>状態か"}:::cond
    c5 -->|"Yes"| e5["対象を100%の確率で<br/>3ターンの間「心労」状態にする"]:::effect --> loop1
    c5 -->|"No"| loop1
    loop1{"③を6回実行したか"}:::cond
    loop1 -->|"No、次の回へ"| c4
    loop1 -->|"Yes"| finish(("終了")):::startend
