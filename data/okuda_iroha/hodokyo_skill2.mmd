flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:ライバルチームの<br/>フロント人数が4名以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象が1名増加する<br/>(増加人数は最大で1名まで)"]:::effect
    c2 -->|"No"| c3{"③:自身のバイタリティが<br/>①のアピール対象の<br/>バイタリティ以上だったか<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| c4{"④:③の効果対象が特殊状態か<br/>(③の各効果前)"}:::cond
    c3 -->|"No"| a1["①実行:最大アピールが最も<br/>高いライバル2名に自身の<br/>リフレクト×自身のHP上限の20%を<br/>固定値として上乗せした1800%の<br/>アピールを行う"]:::action
    c4 -->|"Yes"| e4["③によるバフ・アゲ効果の解除数を<br/>全て解除に変更する"]:::effect
    c4 -->|"No"| e3["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    e4 --> e3
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>対象すべて完了?"}:::cond
    lc1 -->|"Yes"| e5["⑤:自身のHPを①で行った<br/>合計アピールの50%分回復し、<br/>2ターンの間「奏響」状態にする"]:::effect
    lc1 -->|"No、次の対象へ"| c3
    e5 --> finish(("終了")):::startend
