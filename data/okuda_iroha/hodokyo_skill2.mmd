flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:ライバルチームのフロント<br/>人数が4名以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象が1名増加する<br/>(増加人数は最大1名まで)"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:自身のバイタリティが<br/>対象のバイタリティ以上か"}:::cond
    c3 -->|"Yes"| c4
    c3 -->|"No"| a1
    c4{"④:③の対象が<br/>特殊状態か"}:::cond
    c4 -->|"Yes"| e4["①のバフ・アゲ効果の<br/>解除数を全て解除に変更する"]:::effect --> a1
    c4 -->|"No"| e3["対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect --> a1
    a1["①実行:最大アピールが最も高い<br/>ライバル2名へ自身のリフレクト×自身の<br/>HP上限の20%を固定値として上乗せした<br/>1800%のアピール"]:::action --> loop1
    loop1{"①を対象分実行したか"}:::cond
    loop1 -->|"No、次の対象へ"| c3
    loop1 -->|"Yes"| e5["⑤実行:自身のHPを①の合計<br/>アピールの50%分回復し、2ターンの間<br/>「奏響」状態にする"]:::effect --> finish(("終了")):::startend
