flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:<br/>最大アピールが最も高いライバル3名の<br/>バフ・アゲ効果を1つ解除する<br/>(対象ごとに判定)"]:::action
    a1 --> c2{"②:①の各効果後、自身のスマイルが<br/>①の効果対象のスマイル以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①の効果対象を100%の確率で<br/>3ターンの間「空腹」状態にする"]:::effect --> lc1
    c2 -->|"No"| lc1{"①の効果対象<br/>3名すべて終了?"}:::cond
    lc1 -->|"No、次の対象へ"| a1
    lc1 -->|"Yes"| c4{"④:③のアピール対象が<br/>「空腹」状態か"}:::cond
    c4 -->|"Yes"| e4["③のアピールにアピール対象の<br/>HP上限の2%分を固定値として上乗せする"]:::effect --> c5
    c4 -->|"No"| c5{"⑤:③のアピール対象が<br/>バフ・アゲ効果状態ではないか"}:::cond
    c5 -->|"Yes"| e5["③の各アピール中のみ<br/>自身の命中率を+15%する"]:::effect --> a3
    c5 -->|"No"| a3["③実行:<br/>ライバルへ650%のアピールを行う"]:::action
    a3 --> lc2{"③のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"No、次の回へ"| c4
    lc2 -->|"Yes"| finish(("終了")):::startend
