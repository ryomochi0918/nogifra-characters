flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身の残りHP割合が<br/>対象の残りHP割合以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が<br/>2倍になる"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:自身のエフォートが<br/>対象のエフォート以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる<br/>(③による最大12800%、<br/>②と同時発生時は最大25600%)"]:::effect --> c4
    c3 -->|"No"| c4
    c4{"④:①の対象が<br/>「緊張」状態か"}:::cond
    c4 -->|"Yes"| e4["①のアピール中のみ自身の<br/>命中率を+30%する"]:::effect --> a1
    c4 -->|"No"| a1["①実行:ライバルへ400%のアピール"]:::action --> loop1
    loop1{"①を5回実行したか"}:::cond
    loop1 -->|"No、次の回へ"| c2
    loop1 -->|"Yes"| finish(("終了")):::startend
