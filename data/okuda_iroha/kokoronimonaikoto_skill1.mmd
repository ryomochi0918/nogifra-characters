flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル4名に600%の<br/>アピールを行い、100%の確率で<br/>3ターンの間「衰弱」状態にする"]:::action
    a1 --> c3{"③:自身の「円陣」状態のターン数が<br/>3ターン以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルに3回、自身のスマイルの<br/>2倍を固定値として上乗せした300%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"Yes"| c4{"④:自身の「円陣」状態のターン数が<br/>5ターン以上か"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c4 -->|"Yes(再実行は最大1回まで)"| c3
    c4 -->|"No"| finish(("終了")):::startend
