flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:味方6名のHPを自身のHP上限の<br/>40%分回復する"]:::effect
    e1 --> e3["③:②のアピール対象を100%の確率で<br/>4ターンの間「ディフェンスダウン」<br/>状態にする<br/>(②の各アピール前)"]:::effect
    e3 --> a2["②実行:ライバル4名に自身のサンクスの<br/>3倍を固定値として上乗せした600%の<br/>アピールを行う"]:::action
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| c4{"④:ライブ中に自身のスキル2<br/>「いろはーと」が2回以上発動したか"}:::cond
    lc2 -->|"No、次の対象へ"| e3
    c4 -->|"Yes(再実行は最大1回まで)"| e3
    c4 -->|"No"| finish(("終了")):::startend
