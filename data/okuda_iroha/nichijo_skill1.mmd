flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル4名に500%の<br/>アピールを行う"]:::action
    a1 --> e2["②:①のアピール対象を100%の確率で<br/>3ターンの間「アピール力ダウン」<br/>状態にする<br/>(①の各アピール後)"]:::effect
    e2 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:残りHP割合が最も低い味方4名の<br/>デバフ・サゲ効果状態を1つ解除し、<br/>HPをこのスキルで行った<br/>合計アピールの50%分回復し、<br/>2ターンの間「ディフェンスアップ」<br/>状態にする"]:::effect
    lc1 -->|"No、次の対象へ"| a1
    e3 --> e4["④:味方6名を2ターンの間<br/>「アピールガード(笑顔)」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
