flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:最大アピールが最も高い味方2名の<br/>デバフ・サゲ効果を全て解除し、<br/>HPを対象のHP上限の70%分回復する"]:::effect
    e1 --> e2["②:残りHP割合が最も低い味方3名の<br/>デバフ・サゲ効果を2つ解除し、HPを<br/>自身のアピール力の140%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect
    e2 --> c4{"④:③の効果対象が<br/>デバフ・サゲ効果状態ではないか<br/>(③の各効果前)"}:::cond
    c4 -->|"Yes"| e4["③による「回避率アップ」状態を<br/>「軽快」状態に変更する"]:::effect
    c4 -->|"No"| e3["③:味方6名を3ターンの間<br/>「回避率アップ」状態にする"]:::effect
    e4 --> e3
    e3 --> lc3{"③の効果<br/>対象6名すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の対象へ"| c4
