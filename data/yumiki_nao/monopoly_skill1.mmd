flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル4名に700%の<br/>アピールを行う"]:::action
    a1 --> c3{"③:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(②の各効果前)"}:::cond
    c3 -->|"Yes"| e3["②による「落胆」状態の<br/>確率を+10%し、②の効果中のみ自身の<br/>サゲ効果耐性貫通を+20%する"]:::effect
    c3 -->|"No"| c4{"④:直前のアピールが会心アピールか<br/>(②の各効果前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②による「落胆」状態の<br/>確率を+10%し、②の効果中のみ自身の<br/>サゲ効果耐性貫通を+20%する"]:::effect
    c4 -->|"No"| e2["②:①のアピール対象を80%の確率で<br/>1ターンの間「落胆」状態にする<br/>(①の各アピール後)"]:::effect
    e4 --> e2
    e2 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:ライバルチームのフロントに居る<br/>「落胆」状態のメンバーが2名以下か"}:::cond
    lc1 -->|"No、次の対象へ"| a1
    c5 -->|"Yes"| e5["「落胆」状態ではないライバル1名を<br/>100%の確率で1ターンの間「落胆」<br/>状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
