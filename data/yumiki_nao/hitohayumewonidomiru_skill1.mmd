flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>効果対象の残りHP割合以上か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①によるバフ・アゲ効果の解除数を<br/>2つ増加する"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["100%の確率で2ターンの間<br/>「フィジカルダウン」と<br/>「メンタルダウン」状態にする"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル5名のバフ・アゲ効果を<br/>1つ解除し、700%のアピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc1 -->|"Yes"| e4["④:自身のHPを①で行った<br/>合計アピールの50%分回復する"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e4 --> finish(("終了")):::startend
