flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>2種類以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| e3["③:①の各アピール中のみ自身の<br/>命中率を+「①のアピールで<br/>アピールの失敗またはアピールが<br/>0だった回数×15%」する(命中率の<br/>上限は+60%まで)<br/>(①の各アピール前)"]:::effect
    e2 --> c2b{"②:①のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か<br/>(①の各アピール前)"}:::cond
    c2b -->|"Yes"| e2b["①のアピール対象を100%の確率で<br/>2ターンの間「ディフェンスダウン」<br/>状態にし、①のアピール倍率が<br/>2倍になる(②の効果による①の<br/>アピール倍率の最大は3000%)"]:::effect
    c2b -->|"No"| e3
    e2b --> e3
    e3 --> a1["①実行:ライバルに7回、<br/>自身のサンクスの3.5倍を<br/>固定値として上乗せした750%の<br/>アピールを行う"]:::action
    a1 --> lc1{"①のアピール<br/>7回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:味方チームのフロント人数が<br/>ライバルチームのフロント人数以上か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| finish(("終了")):::startend
