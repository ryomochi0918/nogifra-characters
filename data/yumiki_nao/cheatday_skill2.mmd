flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率と<br/>固定値の上限値が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身がバフ・アゲ効果状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①の固定値の上限値が2倍になり、<br/>①の各アピール中のみ自身の<br/>命中率を+20%する(③の効果に<br/>よる①の固定値の上限値は自身の<br/>最大アピールの800%まで、②の効果が<br/>同時に発生した場合は1600%まで)"]:::effect
    c3 -->|"No"| c4{"④/⑤:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["④:①のアピールに①のアピール対象の<br/>残りHPの2%分の固定値を上乗せする"]:::effect
    c4 -->|"No"| e5["⑤:①の各アピール中のみ自身の<br/>会心率と会心アピールを+50%する"]:::effect
    e4 --> a1["①実行:残りHP割合が最も高いライバルに<br/>6回、アピール対象のHP減少分の<br/>8%を固定値として上乗せした300%の<br/>アピールを行う(①の固定値の上限値は<br/>自身の最大アピールの400%まで)"]:::action
    e5 --> a1
    a1 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
