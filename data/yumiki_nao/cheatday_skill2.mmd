flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値<br/>倍率と固定値の上限値が<br/>2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身がバフ・アゲ<br/>効果状態か"}:::cond
    c3 -->|"Yes"| e3["①の固定値の上限値が2倍に<br/>なり、①の各アピール中のみ<br/>自身の命中率を+20%する<br/>(③の効果による①の固定値の<br/>上限値は自身の最大アピール<br/>の800%まで、②の効果が<br/>同時に発生した場合は<br/>1600%まで)"]:::effect --> c4
    c3 -->|"No"| c4{"④:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["①のアピールに①のアピール<br/>対象の残りHPの2%分の<br/>固定値を上乗せする"]:::effect --> a1
    c4 -->|"No"| c5{"⑤:①のアピール対象の<br/>残りHP割合が50%未満か<br/>(対象ごとに判定)"}:::cond
    c5 -->|"Yes"| e5["①の各アピール中のみ自身の<br/>会心率と会心アピールを<br/>+50%する"]:::effect --> a1
    c5 -->|"No"| a1
    a1["①実行:残りHP割合が最も<br/>高いライバルへ、アピール対象の<br/>HP減少分の8%を固定値として<br/>上乗せした300%のアピール<br/>(①の固定値の上限値は自身の<br/>最大アピールの400%まで)"]:::action
    a1 --> lc1{"①のアピール6回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| finish(("終了")):::startend
