flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間「保護」<br/>状態にする"]:::effect
    e1 --> c3{"③:味方チームのフロント人数が<br/>5名以上か"}:::cond
    c3 -->|"Yes"| e3["②による「会心アピール耐性アップ」<br/>と「アピールガード(感謝)」状態の<br/>効果倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:ライブ中に自身のスキル2<br/>「迷探偵・弓木」が1回以上発動したか"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②による「会心アピール耐性アップ」<br/>状態の効果倍率が2倍になる"]:::effect
    c4 -->|"No"| e2["②:自身以外の味方5名を2ターンの<br/>間「会心アピール耐性アップ」と<br/>「アピールガード(感謝)」状態にする"]:::effect
    e4 --> e2
    e2 --> a5["⑤実行:ライバル6名に自身のサンクスの<br/>2倍を固定値として上乗せした900%の<br/>アピールを行う"]:::action
    a5 --> e6["⑥:残りHP割合が最も低い味方3名の<br/>デバフ・サゲ効果を2つ解除し、<br/>HPを自身のHP上限の40%分回復する"]:::effect
    e6 --> finish(("終了")):::startend
