flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>デバフ・サゲ効果耐性貫通を<br/>+30%する"]:::effect --> c5a
    c5a{"⑤:②のアピール対象が<br/>「雑音」状態か<br/>(対象ごとに判定)"}:::cond
    c5a -->|"Yes"| e5a["④の効果対象を100%の<br/>確率で2ターンの間<br/>「ディフェンスダウン」<br/>状態にする"]:::effect --> e4a
    c5a -->|"No"| e4a["④:②のアピール対象を100%の<br/>確率で2ターンの間<br/>「雑音」状態にする"]:::effect --> a2
    a2["②実行:ライバル3名へ、<br/>自身のスマイルを固定値として<br/>上乗せした600%のアピール"]:::action --> lc2{"②のアピール3名<br/>すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c5a
    lc2 -->|"Yes"| c5b{"⑤:③のアピール対象が<br/>「雑音」状態か<br/>(対象ごとに判定)"}:::cond
    c5b -->|"Yes"| e5b["④の効果対象を100%の<br/>確率で2ターンの間<br/>「ディフェンスダウン」<br/>状態にする"]:::effect --> e4b
    c5b -->|"No"| e4b["④:③のアピール対象を100%の<br/>確率で2ターンの間<br/>「雑音」状態にする"]:::effect --> a3
    a3["③実行:ライバルへ、自身の<br/>スマイルを固定値として<br/>上乗せした600%のアピール"]:::action --> lc3{"③のアピール2回<br/>すべて完了?"}:::cond
    lc3 -->|"No、次の回へ"| c5b
    lc3 -->|"Yes"| finish(("終了")):::startend
