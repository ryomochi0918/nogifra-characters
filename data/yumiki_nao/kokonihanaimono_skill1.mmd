flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>デバフ・サゲ効果耐性貫通を+30%する"]:::effect
    e1 --> c5{"⑤:④の効果対象が「雑音」状態か<br/>(④各効果前)"}:::cond
    c5 -->|"Yes"| e5["④の効果対象を100%の確率で<br/>2ターンの間「ディフェンスダウン」<br/>状態にする"]:::effect
    c5 -->|"No"| e4["④:アピール対象を100%の確率で<br/>2ターンの間「雑音」状態にする<br/>(②の各アピール前)"]:::effect
    e5 --> e4
    e4 --> a2["②実行:ライバル3名に自身のスマイルを<br/>固定値として上乗せした600%の<br/>アピールを行う"]:::action
    a2 --> lc2{"②のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc2 -->|"Yes"| c5_2{"⑤:④の効果対象が「雑音」状態か<br/>(④各効果前)"}:::cond
    lc2 -->|"No、次の対象へ"| c5
    c5_2 -->|"Yes"| e5_2["④の効果対象を100%の確率で<br/>2ターンの間「ディフェンスダウン」<br/>状態にする"]:::effect
    c5_2 -->|"No"| e4_2["④:アピール対象を100%の確率で<br/>2ターンの間「雑音」状態にする<br/>(③の各アピール前)"]:::effect
    e5_2 --> e4_2
    e4_2 --> a3["③実行:ライバルに2回、自身の<br/>スマイルを固定値として上乗せした600%の<br/>アピールを行う"]:::action
    a3 --> lc3{"③のアピール<br/>2回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c5_2
