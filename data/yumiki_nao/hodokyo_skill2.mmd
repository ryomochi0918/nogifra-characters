flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が受けて<br/>いるデバフ・サゲ効果状態の<br/>種類数が2種類以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値<br/>倍率と固定値の上限が<br/>2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバルへ、アピール<br/>対象のHP減少分の6%を<br/>固定値として上乗せした<br/>1100%のアピール<br/>(固定値の上乗せは自身の<br/>最大アピールの750%まで)"]:::action
    a1 --> lc1{"①のアピール2回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c3{"③:①のアピールでライバル<br/>がリタイアしなかったか"}:::cond
    c3 -->|"Yes"| a3["再度①を実行<br/>(再実行は最大2回まで)"]:::action --> e4
    c3 -->|"No"| e4["④:自身と自身以外の残り<br/>HP割合が最も低い味方1名の<br/>HPを①で行った合計アピール<br/>の25%分回復し、3ターンの<br/>間「陽動」状態にする<br/>(③の再実行が発動した<br/>場合は③の終了後)"]:::effect --> c5
    c5{"⑤:味方チームのフロント<br/>人数がライバルチームの<br/>フロント人数以上か"}:::cond
    c5 -->|"Yes"| e5["自身を3ターンの間<br/>「熱意」状態にする"]:::effect --> finish(("終了")):::startend
    c5 -->|"No"| finish
