flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>2種類以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率と<br/>固定値の上限が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに2回、<br/>アピール対象のHP減少分の6%を<br/>固定値として上乗せした1100%の<br/>アピールを行う(固定値の上乗せは<br/>自身の最大アピールの750%まで)"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>2回すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c3 -->|"Yes(再実行は最大2回まで)"| c2
    c3 -->|"No"| e4["④:自身と自身以外の残りHP割合が<br/>最も低い味方1名のHPを①で行った<br/>合計アピールの25%分回復し、<br/>3ターンの間「陽動」状態にする"]:::effect
    e4 --> c5{"⑤:味方チームのフロント人数が<br/>ライバルチームのフロント人数以上か"}:::cond
    c5 -->|"Yes"| e5["自身を3ターンの間「熱意」<br/>状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
