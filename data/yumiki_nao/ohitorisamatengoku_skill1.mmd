flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①の各効果中のみ自身の<br/>サゲ効果耐性貫通を+20%する"]:::effect
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに4回、100%の確率で<br/>3ターンの間「空腹」状態にし、<br/>800%のアピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:自身の残りHP割合が80%以上か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c3 -->|"Yes"| e3["自身を4ターンの間「翻弄」<br/>状態にする"]:::effect
    c3 -->|"No"| finish(("終了")):::startend
    e3 --> finish
