flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①の各効果中のみ自身の<br/>サゲ効果耐性貫通を+20%する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:最大アピールが最も<br/>高いライバルへ4回、100%の<br/>確率で3ターンの間<br/>「空腹」状態にし、<br/>800%のアピール"]:::action --> lc1{"①のアピール4回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c3{"③:自身の残りHP割合が<br/>80%以上か"}:::cond
    c3 -->|"Yes"| e3["自身を4ターンの間<br/>「翻弄」状態にする"]:::effect --> finish(("終了")):::startend
    c3 -->|"No"| finish
