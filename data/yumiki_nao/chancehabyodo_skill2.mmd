flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+20%する"]:::effect --> c3
    c3{"③:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c4
    c3 -->|"No"| c4{"④:②のアピール対象が<br/>特殊状態か(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["②の各アピール中のみ①による<br/>会心率の増加倍率が40%になり、<br/>②のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect --> a2
    c4 -->|"No"| a2["②実行:残りHP割合が最も<br/>低いライバルへ、自身の最大<br/>アピールの20%を固定値として<br/>上乗せした400%のアピール"]:::action
    a2 --> lc1{"②のアピール5回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c3
    lc1 -->|"Yes"| c5{"⑤:②のアピールで会心<br/>アピールが2回以上発生したか"}:::cond
    c5 -->|"Yes"| a5["再度②を実行<br/>(再実行は最大1回まで)"]:::action --> e6
    c5 -->|"No"| e6["⑥:自身のHPをこのスキルで<br/>行った合計アピールの30%分<br/>回復する<br/>(⑤の再実行が発動した<br/>場合は⑤の後)"]:::effect --> finish(("終了")):::startend
