flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect --> c3
    c3{"③:②のアピール対象の残りHP<br/>割合が50%以上か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c4
    c3 -->|"No"| c4{"④:②のアピール対象が<br/>特殊状態か(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c4 -->|"No"| a2["②実行:最大アピールが最も<br/>高いライバルへ、自身のエフォート<br/>の3倍を固定値として上乗せ<br/>した420%のアピール"]:::action
    a2 --> lc1{"②のアピール6回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c3
    lc1 -->|"Yes"| c5{"⑤:このスキルでリタイア<br/>したライバルが1名以下か"}:::cond
    c5 -->|"Yes"| a5["残りHP割合が最も低いライバル<br/>へ2回、②で行った合計アピール<br/>の50%分のアピール<br/>(ディフェンス、フィジカルを無視する)"]:::action --> e6
    c5 -->|"No"| e6["⑥:自身を4ターンの間<br/>「堅忍」状態にする<br/>(⑤のアピールが発動した<br/>場合は⑤の後)"]:::effect --> finish(("終了")):::startend
