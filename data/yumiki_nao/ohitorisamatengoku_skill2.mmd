flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象を100%の確率で<br/>3ターンの間「嫉妬」状態にし、<br/>①の各アピール中のみ自身の<br/>命中率を+30%する"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに2回、<br/>アピール対象のHP上限3.5%分の<br/>固定値を上乗せした2000%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> e3["③:残りHP割合が最も低い味方2名の<br/>HPを①で行った合計アピールの<br/>40%分回復する<br/>(①の各アピール後)"]:::effect
    e3 --> lc1{"①のアピール<br/>2回すべて完了?"}:::cond
    lc1 -->|"Yes"| a4["④実行:残りHP割合が最も高い<br/>ライバルに2回、このスキルで<br/>行った合計アピール25%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc1 -->|"No、次の回へ"| c2
    a4 --> finish(("終了")):::startend
