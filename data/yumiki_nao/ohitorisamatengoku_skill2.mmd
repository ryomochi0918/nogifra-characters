flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象を100%の<br/>確率で3ターンの間「嫉妬」<br/>状態にし、①の各アピール<br/>中のみ自身の命中率を<br/>+30%する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバルへ、アピール<br/>対象のHP上限3.5%分の<br/>固定値を上乗せした<br/>2000%のアピール"]:::action --> e3
    e3["③:残りHP割合が最も低い<br/>味方2名のHPを①で行った<br/>合計アピールの40%分<br/>回復する"]:::effect --> lc1{"①のアピール2回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| a4["④実行:残りHP割合が最も<br/>高いライバルへ2回、この<br/>スキルで行った合計アピール<br/>25%分のアピール<br/>(ディフェンス、フィジカルを<br/>無視する)"]:::action --> finish(("終了")):::startend
