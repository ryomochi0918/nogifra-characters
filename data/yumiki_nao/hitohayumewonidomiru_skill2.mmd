%% 注: 元画像(hitohayumewonidomiru_skill1.png)がスクロール末尾で切れており、[⑤]以降に続きの文章が存在する可能性がある(未確認)。再撮影での確認が必要。
flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:ライバルチームのフロント<br/>にデバフ・サゲ効果状態の<br/>メンバーが4名以上居るか"}:::cond
    c1 -->|"Yes"| e1["このスキル中、自身の<br/>命中率を+25%する"]:::effect --> c4a
    c1 -->|"No"| c4a{"④:②のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(対象ごとに判定)"}:::cond
    c4a -->|"Yes"| e4a["②のアピール倍率が<br/>2倍になる"]:::effect --> c5a
    c4a -->|"No"| c5a{"⑤:②のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(対象ごとに判定)"}:::cond
    c5a -->|"Yes"| e5a["②のアピールが必ず<br/>会心アピールになる"]:::effect --> a2
    c5a -->|"No"| a2["②実行:残りHP割合が最も<br/>低いライバル4名へ、<br/>800%のアピール<br/>(①の条件を満たさない<br/>場合でも発動)"]:::action
    a2 --> lc2{"②のアピール4名<br/>すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c4a
    lc2 -->|"Yes"| c4b{"④:③のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(対象ごとに判定)"}:::cond
    c4b -->|"Yes"| e4b["③のアピール倍率が<br/>2倍になる"]:::effect --> c5b
    c4b -->|"No"| c5b{"⑤:③のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(対象ごとに判定)"}:::cond
    c5b -->|"Yes"| e5b["③のアピールが必ず<br/>会心アピールになる"]:::effect --> a3
    c5b -->|"No"| a3["③実行:ライバルへ、<br/>800%のアピール"]:::action
    a3 --> lc3{"③のアピール4回<br/>すべて完了?"}:::cond
    lc3 -->|"No、次の回へ"| c4b
    lc3 -->|"Yes"| finish(("終了")):::startend
