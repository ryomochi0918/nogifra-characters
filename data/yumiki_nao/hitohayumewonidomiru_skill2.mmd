flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:ライバルチームのフロントに<br/>デバフ・サゲ効果状態のメンバーが<br/>4名以上居るか"}:::cond
    c1 -->|"Yes"| e1["このスキル中、自身の命中率を+25%する"]:::effect
    c1 -->|"No"| c4{"④:②の各アピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(②の各アピール前)"}:::cond
    e1 --> c4
    c4 -->|"Yes"| e4["②の各アピール倍率が2倍になる"]:::effect
    c4 -->|"No"| c5{"⑤:②の各アピール対象が<br/>デバフ・サゲ効果状態か<br/>(②の各アピール前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["②の各アピールが<br/>必ず会心アピールになる"]:::effect
    c5 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバル4名に800%のアピールを行う"]:::action
    e5 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| c4_2{"④:③の各アピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(③の各アピール前)"}:::cond
    lc2 -->|"No、次の対象へ"| c4
    c4_2 -->|"Yes"| e4_2["③の各アピール倍率が2倍になる"]:::effect
    c4_2 -->|"No"| c5_2{"⑤:③の各アピール対象が<br/>デバフ・サゲ効果状態か<br/>(③の各アピール前)"}:::cond
    e4_2 --> c5_2
    c5_2 -->|"Yes"| e5_2["③の各アピールが<br/>必ず会心アピールになる"]:::effect
    c5_2 -->|"No"| a3["③実行:ライバルに4回、800%の<br/>アピールを行う"]:::action
    e5_2 --> a3
    a3 --> lc3{"③のアピール<br/>4回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c4_2
