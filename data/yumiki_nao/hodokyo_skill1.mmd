flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+30%する"]:::effect
    e1 --> e2["②:自身と自身以外の最大<br/>アピールが最も高い味方2名を<br/>2ターンの間「機敏」状態にする"]:::effect
    e2 --> a3["③実行:残りHP割合が最も<br/>高いライバル5名へ、<br/>300%のアピール"]:::action
    a3 --> e4["④:③のアピール対象を100%の<br/>確率で3ターンの間<br/>「混乱」状態にする<br/>(対象ごとに判定)"]:::effect
    e4 --> lc3{"③のアピール5名<br/>すべて完了?"}:::cond
    lc3 -->|"No、次の対象へ"| a3
    lc3 -->|"Yes"| c6{"⑥:③のアピールで会心<br/>アピールが発生したか<br/>(⑤の効果前に判定)"}:::cond
    c6 -->|"Yes"| e6["会心アピールが発生した回数分<br/>⑤の対象人数が1名増加する<br/>(増加人数は最大で5名まで)"]:::effect --> a5
    c6 -->|"No"| a5["⑤実行:残りHP割合が最も<br/>低い味方1名のデバフ・<br/>サゲ効果を1つ解除し、<br/>2ターンの間「舞踏」状態にする"]:::action --> finish(("終了")):::startend
