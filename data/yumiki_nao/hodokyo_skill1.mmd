flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+30%する"]:::effect
    e1 --> e2["②:自身と自身以外の最大アピールが<br/>最も高い味方2名を2ターンの間<br/>「機敏」状態にする"]:::effect
    e2 --> a3["③実行:残りHP割合が最も高い<br/>ライバル5名に300%のアピールを行う"]:::action
    a3 --> e4["④:③のアピール対象を100%の確率で<br/>3ターンの間「混乱」状態にする<br/>(③の各アピール後)"]:::effect
    e4 --> lc3{"③のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc3 -->|"Yes"| c6{"⑥:③のアピールで会心アピールが<br/>発生したか"}:::cond
    lc3 -->|"No、次の対象へ"| a3
    c6 -->|"Yes"| e6["会心アピールが発生した回数分⑤の<br/>対象人数が1名増加する(増加人数は<br/>最大で5名まで)"]:::effect
    c6 -->|"No"| e5["⑤:残りHP割合が最も低い味方1名の<br/>デバフ・サゲ効果を1つ解除し、<br/>2ターンの間「舞踏」状態にする"]:::effect
    e6 --> e5
    e5 --> finish(("終了")):::startend
