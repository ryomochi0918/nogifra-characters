flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間「興奮」<br/>状態にし、このスキル中のみ、<br/>自身のリフレクト耐性を+25%する"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| a2["②実行:ライバル4名に自身のサンクスの<br/>4倍を固定値として上乗せした740%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| c4{"④:自身のサンクスが②の<br/>アピール対象のサンクス以上だった<br/>回数が2回以上か"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c4 -->|"Yes"| a4["④実行:残りHP割合が最も低い<br/>ライバル4名に自身のサンクスの<br/>4倍を固定値として上乗せした740%の<br/>アピールを行う"]:::action
    c4 -->|"No"| c5{"⑤:このスキル中、自身のサンクスが<br/>アピール対象のサンクス以上だった<br/>回数が4回以上か"}:::cond
    a4 --> c5
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバルに2回、このスキルで行った<br/>合計アピールの40%分のアピールを行う<br/>(ディフェンス・フィジカルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
