flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のバイタリティが①の<br/>アピール対象のバイタリティ以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率と<br/>固定値の上限が1.5倍になる"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに4回、「このスキルが<br/>発動する前に自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>合計種類数×自身の残りHPの4%」<br/>を固定値として上乗せした700%の<br/>アピールを行う(固定値の上乗せは<br/>自身の残りHPの20%まで)"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:最大アピールが最も高い<br/>味方2名のデバフ・サゲ効果を<br/>2つ解除し、HPをこのスキルで行った<br/>合計アピールの40%分回復する"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e3 --> c4{"④:フロントの自身以外の味方全員が<br/>「声援」状態か"}:::cond
    c4 -->|"Yes(この効果は発動しない)"| finish
    c4 -->|"No"| e4["「声援」状態ではない自身以外の<br/>最大アピールが最も高い味方2名を<br/>2ターンの間「声援」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
