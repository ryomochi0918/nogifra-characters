flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のバイタリティが①の<br/>アピール対象のバイタリティ以上か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になり、<br/>①による「空腹」状態の<br/>効果倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバル6名を100%の確率で<br/>2ターンの間「空腹」状態にし、<br/>800%のアピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:自身の「根性」状態のターン数が<br/>7ターン以上か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c3 -->|"Yes"| c4{"④:自身の「根性」状態のターン数が<br/>9ターン以上か"}:::cond
    c3 -->|"No"| finish(("終了")):::startend
    c4 -->|"Yes"| e4["③による「情熱」状態のアピール力と<br/>会心アピールの効果倍率が1.5倍になる"]:::effect
    c4 -->|"No"| e3["自身を2ターンの間「情熱」<br/>状態にする"]:::effect
    e4 --> e3
    e3 --> finish
