flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["①の倍率が2倍に<br/>(上限は倍率800%/固定値2倍、<br/>③と同時成立時は倍率1600%/固定値4倍)"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のバイタリティが<br/>対象のバイタリティ以上か"}:::cond
    c3 -->|"Yes"| e3["①の倍率が2倍に<br/>(上限は倍率800%/固定値2倍、<br/>②と同時成立時は倍率1600%/固定値4倍)"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>ライバルへ基本400%+<br/>固定値 自身の最大アピール×15%"]:::action
    a1 --> c4{"④:①のアピールが失敗、<br/>またはアピール量が0だったか"}:::cond
    c4 -->|"Yes"| e4["①のアピール回数を+1<br/>(追加は最大2回まで)"]:::effect --> lc
    c4 -->|"No"| lc{"①のアピール<br/>(追加分含め)すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c5{"⑤:自身の「希望」状態の<br/>ターン数が10ターン以上か<br/>(かつ再実行がまだの場合)"}:::cond
    c5 -->|"Yes(再実行は最大1回、④の追加回数はリセット)"| c2
    c5 -->|"No"| finish(("終了")):::startend
