flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身のバイタリティが①の<br/>アピール対象のバイタリティ以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と固定値倍率が<br/>2倍になる(②による①のアピール倍率の<br/>最大は800%、固定値倍率は2倍まで、<br/>②の効果が同時に発動した<br/>場合はアピール倍率1600%、<br/>固定値倍率4倍まで)"]:::effect
    c3 -->|"No"| a1["①実行:ライバルに5回、<br/>自身の最大アピールの15%を<br/>固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> c4{"④:①のアピールで失敗または<br/>アピールが0だったか<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["①のアピール回数を1回増加する<br/>(アピールの追加回数は最大で2回まで)"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>5回(+④の追加分)すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| c5{"⑤:自身の「希望」状態のターン数が<br/>10ターン以上か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c5 -->|"Yes(再実行は最大1回まで、再実行時に<br/>④によるアピール回数の追加は<br/>リセットされる)"| c2
    c5 -->|"No"| finish(("終了")):::startend
