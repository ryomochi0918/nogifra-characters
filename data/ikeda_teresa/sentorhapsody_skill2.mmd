flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:このスキルが発動する前、<br/>自身がバフ・アゲ効果状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル4名に自身の最大アピールの<br/>20%を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールでリタイアした<br/>ライバルが1名以下か"}:::cond
    lc1 -->|"No、次の対象へ"| c3
    c4 -->|"Yes(再実行は最大1回まで)"| c3
    c4 -->|"No"| c5{"⑤:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c5 -->|"Yes(再実行は最大1回まで)<br/>①の固定値倍率を2倍にして再実行"| c3
    c5 -->|"No"| finish(("終了")):::startend
