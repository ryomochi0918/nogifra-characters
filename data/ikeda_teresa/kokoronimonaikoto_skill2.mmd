flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身と自身以外の<br/>残りHP割合が最も低い味方2名に<br/>対してデバフ・サゲ効果を<br/>全て解除し、HPを自身のHP上限の<br/>40%分回復する"]:::effect
    e1 --> c4{"④:自身の残りHP割合が50%未満か<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②の各アピール中のみ自身の<br/>リフレクト耐性を+50%する"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル3名に自身の残りHPの10%を<br/>固定値として上乗せした700%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc2 -->|"Yes"| c4_2{"④:自身の残りHP割合が50%未満か<br/>(③の各アピール前)"}:::cond
    lc2 -->|"No、次の対象へ"| c4
    c4_2 -->|"Yes"| e4_2["③の各アピール中のみ自身の<br/>リフレクト耐性を+50%する"]:::effect
    c4_2 -->|"No"| a3["③実行:残りHP割合が最も低い<br/>ライバルに2回、自身の残りHPの<br/>10%を固定値として上乗せした700%の<br/>アピールを行う"]:::action
    e4_2 --> a3
    a3 --> lc3{"③のアピール<br/>2回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c4_2
