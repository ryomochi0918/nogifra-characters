flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:<br/>自身と自身以外の残りHP割合が最も低い<br/>味方2名のデバフ・サゲ効果を全解除、<br/>HPをHP上限の40%分回復"]:::action
    a1 --> c4{"④:自身の残りHP割合が<br/>50%未満か<br/>(②と③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②と③の各アピール中のみ<br/>自身のリフレクト耐性を+50%"]:::effect --> a2
    c4 -->|"No"| a2["②実行:<br/>残りHP割合が最も高いライバル3名へ<br/>基本700%+固定値 自身の残りHP×10%"]:::action
    a2 --> lc2{"②のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c4
    lc2 -->|"Yes"| c4b{"④:自身の残りHP割合が<br/>50%未満か<br/>(②と③の各アピール前)"}:::cond
    c4b -->|"Yes"| e4b["②と③の各アピール中のみ<br/>自身のリフレクト耐性を+50%"]:::effect --> a3
    c4b -->|"No"| a3["③実行:<br/>残りHP割合が最も低いライバルへ2回<br/>基本700%+固定値 自身の残りHP×10%"]:::action
    a3 --> lc3{"③のアピール<br/>2回すべて完了?"}:::cond
    lc3 -->|"No、次の回へ"| c4b
    lc3 -->|"Yes"| finish(("終了")):::startend
