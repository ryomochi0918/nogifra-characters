flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:このスキルが発動する前の<br/>味方チームのフロント人数が<br/>5名以上か"}:::cond
    c2 -->|"Yes"| e2["①の固定値倍率が2倍になり、<br/>①の各アピール中のみ<br/>自身の命中率を+30%する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバルへ、アピール対象のHP上限0.5%分を<br/>固定値として上乗せした<br/>700%のアピール"]:::action
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| a3["③実行:<br/>ライバル5名を100%の確率で<br/>3ターンの間「緊張」状態にする"]:::action
    a3 --> c4{"④:③の効果対象の<br/>残りHP割合が75%未満か<br/>(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["③の効果対象を100%の確率で<br/>3ターンの間「嫉妬」状態にする"]:::effect --> finish
    c4 -->|"No"| finish(("終了")):::startend
