flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:最大アピールが最も高い味方4名の<br/>HPを自身のアピール力の180%分回復し<br/>(会心率に応じて会心回復が発生)、<br/>2ターンの間「軽快」と「勇気」<br/>状態にする"]:::effect
    e1 --> e2["②:自身の状態に応じて③か④の<br/>効果どちらかを適用する"]:::effect
    e2 --> c3{"③/④:自身が「勇気」状態か"}:::cond
    c3 -->|"Yes"| e3["③:残りHP割合が最も高い<br/>ライバル1名を100%の確率で3ターンの<br/>間「執着」状態にする"]:::effect
    c3 -->|"No"| e4["④:自身を2ターンの間「勇気」<br/>状態にする"]:::effect
    e3 --> finish(("終了")):::startend
    e4 --> finish
