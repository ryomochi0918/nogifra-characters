flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身のリフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:対象の残りHP割合が<br/>50%以上か"}:::cond
    c3 -->|"Yes"| e3["②の倍率と固定値倍率が2倍に"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>残りHP割合が最も高いライバルへ<br/>基本650%+固定値 自身のエフォート×3"]:::action
    a2 --> c4{"④:②のアピールで<br/>ライバルがリタイアしたか"}:::cond
    c4 -->|"Yes"| e4["自身を2ターンの間<br/>「倍音」状態にする"]:::effect --> lc
    c4 -->|"No"| lc{"②のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c3
    lc -->|"Yes"| a5["⑤実行:<br/>ライバル2名へ<br/>②の合計アピール50%<br/>(Def・Phy無視)"]:::action
    a5 --> c6{"⑥:自身の「希望」の<br/>ターン数が8ターン以上か<br/>(かつ再実行がまだの場合)"}:::cond
    c6 -->|"Yes(再実行は最大1回まで)"| a5
    c6 -->|"No"| e7["⑦:自身を2ターンの間<br/>「機敏」状態にする"]:::effect --> finish(("終了")):::startend
