flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:②のアピール対象の残りHP割合が<br/>50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルに4回、自身のエフォートの3倍を<br/>固定値として上乗せした650%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールによって<br/>ライバルがリタイアしたか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["自身を2ターンの間<br/>「倍音」状態にする"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| a5["⑤実行:ライバル2名に②のアピールで<br/>行った合計アピールの50%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc2 -->|"No、次の回へ"| c3
    a5 --> c6{"⑥:自身の「希望」のターン数が<br/>8ターン以上か"}:::cond
    c6 -->|"Yes(再実行は最大1回まで)"| a5
    c6 -->|"No"| e7["⑦:自身を2ターンの間<br/>「機敏」状態にする"]:::effect
    e7 --> finish(("終了")):::startend
