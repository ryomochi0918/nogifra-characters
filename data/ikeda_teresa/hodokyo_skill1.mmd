flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["①の「翻弄」状態のディフェンスと<br/>フィジカルの増加倍率が1.5倍になる"]:::effect
    c2 -->|"No"| e1["①:自身と自身以外のHP上限が最も高い<br/>味方1名を2ターンの間「翻弄」状態にする"]:::effect
    e2 --> e1
    e1 --> a3["③実行:ライバル4名に自身のスマイルの<br/>3倍を固定値として上乗せした<br/>600%のアピールを行う"]:::action
    a3 --> e4["④:③の各アピール前に自身のスマイルが<br/>③のアピール対象のスマイル以上だった回数を<br/>対象人数として、最大アピールが最も高い味方を<br/>2ターンの間「集中」状態にし、<br/>デバフ・サゲ効果を1つ解除する"]:::effect
    e4 --> e5["⑤:残りHP割合が最も低い味方3名の<br/>デバフ・サゲ効果を1つ解除し、<br/>HPを自身のHP上限の30%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
