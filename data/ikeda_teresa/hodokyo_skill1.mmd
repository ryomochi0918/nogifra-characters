flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["①の「翻弄」状態のディフェンスと<br/>フィジカルの増加倍率が1.5倍になる"]:::effect --> e1
    c2 -->|"No"| e1["①実行:<br/>自身と自身以外のHP上限が最も高い味方1名を<br/>2ターンの間「翻弄」状態にする"]:::effect
    e1 --> a3["③実行:<br/>ライバル4名へ、自身のスマイルの3倍を<br/>固定値として上乗せした600%のアピール"]:::action
    a3 --> e4["④実行:<br/>自身のスマイルが対象のスマイル以上だった回数を<br/>対象人数として、最大アピールが最も高い味方を<br/>2ターンの間「集中」状態にし、デバフ・サゲ効果を1つ解除"]:::effect
    e4 --> e5["⑤実行:<br/>残りHP割合が最も低い味方3名の<br/>デバフ・サゲ効果を1つ解除し、<br/>HPを自身のHP上限の30%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
