flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+30%する"]:::effect
    e1 --> c3{"③:②のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の固定値倍率が2倍になり、<br/>②の各アピール中のみ自身の<br/>会心率を+20%する"]:::effect
    c3 -->|"No"| c4{"④:このスキルが発動する前の自身の<br/>残りHP割合が80%以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②の固定値倍率が1.5倍になる"]:::effect
    c4 -->|"No"| a2["②実行:ライバルに4回、アピール対象の<br/>HP上限0.5%分を固定値として上乗せした<br/>650%のアピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"Yes"| a5["⑤実行:「緊張」状態のライバル全員に②で<br/>行った合計アピールの50%分のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action
    lc2 -->|"No、次の回へ"| c3
    a5 --> e6["⑥:⑤のアピール対象を100%の確率で<br/>3ターンの間「心労」状態にする<br/>(⑤の各アピール後)"]:::effect
    e6 --> lc5{"⑤のアピール<br/>対象すべて完了?"}:::cond
    lc5 -->|"Yes"| finish(("終了")):::startend
    lc5 -->|"No、次の対象へ"| a5
