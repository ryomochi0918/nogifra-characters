flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身の命中率を+30%する"]:::effect
    e1 --> c3{"③:②のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か"}:::cond
    c3 -->|"Yes"| e3["②の固定値倍率が2倍になり、<br/>②の各アピール中のみ<br/>自身の会心率を+20%する"]:::effect --> c4
    c3 -->|"No"| c4{"④:このスキルが発動する前の<br/>自身の残りHP割合が<br/>80%以上か"}:::cond
    c4 -->|"Yes"| e4["②の固定値倍率が1.5倍になる"]:::effect --> a2
    c4 -->|"No"| a2["②実行:<br/>ライバルへ、アピール対象のHP上限0.5%分を<br/>固定値として上乗せした<br/>650%のアピール"]:::action
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"No、次の回へ"| c3
    lc2 -->|"Yes"| a5["⑤実行:<br/>「緊張」状態のライバル全員に<br/>②で行った合計アピールの50%分のアピール<br/>(ディフェンス、フィジカルを無視する)"]:::action
    a5 --> a6["⑥実行:<br/>⑤のアピール対象を100%の確率で<br/>3ターンの間「心労」状態にする<br/>(⑤の各アピール後)"]:::action
    a6 --> finish(("終了")):::startend
