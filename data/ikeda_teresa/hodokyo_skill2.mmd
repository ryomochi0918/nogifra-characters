flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e1 --> c3{"③:②のアピール対象の<br/>残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| c4{"④:自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>合計種類数が②のアピール対象が<br/>受けているバフ・アゲ効果・特殊状態の<br/>合計種類数以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["①の命中率の増加割合と②の<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も高いライバルに<br/>5回、アピール対象の残りHPの0.7%を<br/>固定値として上乗せした440%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"Yes"| e5["⑤:自身と最大アピールが最も<br/>高い味方2名を②の合計アピールの<br/>30%分回復し、3ターンの間「静謐」<br/>状態にする"]:::effect
    lc2 -->|"No、次の回へ"| c3
    e5 --> finish(("終了")):::startend
