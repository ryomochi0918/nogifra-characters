flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:ライブ中に自身のスキル1<br/>「自分に厳しく、人に優しく」が<br/>2回以上発動していたか"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の残りHPの75%を<br/>固定値として上乗せする"]:::effect
    c2 -->|"No"| a1["①実行:ライバル2名に2000%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> e3["③:自身のHPを自身のHP上限の<br/>30%分回復し、2ターンの間「反響」<br/>状態にする"]:::effect
    e3 --> c5{"⑤:自身のHP上限が④の効果対象の<br/>HP上限以上か<br/>(④の各効果前)"}:::cond
    c5 -->|"Yes"| e5["④の効果対象のデバフ・サゲ効果を<br/>1つ解除し2ターンの間「反響」<br/>状態にする"]:::effect
    c5 -->|"No"| e4["④:自身以外の味方5名のHPを自身の<br/>HP上限の30%分回復する"]:::effect
    e5 --> e4
    e4 --> lc4{"④の効果<br/>対象5名すべて完了?"}:::cond
    lc4 -->|"Yes"| finish(("終了")):::startend
    lc4 -->|"No、次の対象へ"| c5
