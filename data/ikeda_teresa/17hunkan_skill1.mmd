flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象が「空腹」状態か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①による「空腹」状態の効果倍率が<br/>1.5倍になる"]:::effect
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバル4名のバフ・アゲ効果を<br/>1つ解除し、100%の確率で3ターンの<br/>間「空腹」状態にし、800%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| a3["③実行:最大アピールが<br/>最も低いライバル1名に①で<br/>行った合計アピールの50%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a3 --> finish(("終了")):::startend
