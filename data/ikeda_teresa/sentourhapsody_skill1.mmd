flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身の会心率を+25%する"]:::effect
    e1 --> c2{"②:自身の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["自身を3ターンの間<br/>「夢中」状態にする"]:::effect --> c4
    c2 -->|"No"| c4{"④:自身のサンクスが<br/>対象のサンクス以上か"}:::cond
    c4 -->|"Yes"| e4["③の倍率と固定値倍率が2倍に"]:::effect --> a3
    c4 -->|"No"| a3["③実行:<br/>残りHP割合が最も低いライバルへ<br/>基本400%+固定値 自身のサンクス×4"]:::action
    a3 --> c5{"⑤:③のアピールで<br/>会心アピールが発生したか"}:::cond
    c5 -->|"Yes"| e5["対象のバフ・アゲ効果を<br/>2つ解除"]:::effect --> lc
    c5 -->|"No"| lc{"③のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c4
    lc -->|"Yes"| finish(("終了")):::startend
