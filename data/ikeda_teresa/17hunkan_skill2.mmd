flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:ライバルチームのフロントに<br/>「空腹」状態のメンバーが<br/>3名以上居るか"}:::cond
    c2 -->|"Yes"| e2["①の効果倍率が<br/>2倍になる"]:::effect --> e1
    c2 -->|"No"| e1["①実行:<br/>このスキル中、自身の命中率を<br/>+20%する"]:::effect
    e1 --> c4{"④:③のアピール対象が<br/>「空腹」状態か"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率が<br/>3倍になる"]:::effect --> a3
    c4 -->|"No"| a3["③実行:<br/>最大アピールが最も低いライバルへ<br/>600%のアピール"]:::action
    a3 --> lc{"③のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c4
    lc -->|"Yes"| c5{"⑤:③のアピールで「空腹」状態の<br/>ライバルに2回以上<br/>アピールを行ったか"}:::cond
    c5 -->|"Yes(再実行は最大1回まで)"| c4
    c5 -->|"No"| finish(("終了")):::startend
