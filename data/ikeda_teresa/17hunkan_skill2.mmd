flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:ライバルチームのフロントに<br/>「空腹」状態のメンバーが<br/>3名以上居るか"}:::cond
    c2 -->|"Yes"| e2["①の効果倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e2 --> e1
    e1 --> c4{"④:③のアピール対象が「空腹」状態か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率が3倍になる"]:::effect
    c4 -->|"No"| a3["③実行:最大アピールが最も低い<br/>ライバルに5回、600%のアピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>5回すべて完了?"}:::cond
    lc3 -->|"Yes"| c5{"⑤:③のアピールで「空腹」状態の<br/>ライバルに2回以上アピールを行ったか"}:::cond
    lc3 -->|"No、次の回へ"| c4
    c5 -->|"Yes(再実行は最大1回まで)"| c4
    c5 -->|"No"| finish(("終了")):::startend
