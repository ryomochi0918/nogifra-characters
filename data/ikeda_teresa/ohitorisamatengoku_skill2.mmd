flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身のリフレクト耐性を+50%する"]:::effect
    e1 --> a2["②実行:<br/>残りHP割合が最も高いライバルへ<br/>バフ・アゲ効果を3つ解除+<br/>基本880%+固定値 自身のサンクス×4.5"]:::action
    a2 --> c3{"③:このスキル中に<br/>失敗/0ダメージが2回以上発生したか"}:::cond
    c3 -->|"Yes"| e3["以降のこのスキルの<br/>アピールは必ず命中"]:::effect --> lc
    c3 -->|"No"| lc{"②の対象<br/>4名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| a2
    lc -->|"Yes"| c4{"④:味方フロントにバフ・アゲ状態の<br/>味方が3名以上か<br/>(かつ再実行がまだの場合)"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| a2
    c4 -->|"No"| a5["⑤実行:<br/>残りHP割合が最も低いライバル1名へ<br/>このスキルの合計アピールの30%<br/>(Def・Phy無視)"]:::action
    a5 --> finish(("終了")):::startend
