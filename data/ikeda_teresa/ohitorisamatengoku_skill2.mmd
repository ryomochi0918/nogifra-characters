flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+50%する"]:::effect
    e1 --> a2["②実行:残りHP割合が最も高い<br/>ライバル4名のバフ・アゲ効果を<br/>3つ解除し、自身のサンクスの4.5倍を<br/>固定値として上乗せした880%の<br/>アピールを行う"]:::action
    a2 --> c3{"③:このスキル中にアピールの<br/>失敗またはアピールが0である事が<br/>2回以上発生したか<br/>(②の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["このスキルによる残りのアピールは<br/>必ず命中する"]:::effect
    c3 -->|"No"| lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    e3 --> lc2
    lc2 -->|"Yes"| c4{"④:味方フロントにバフ・アゲ効果状態の<br/>味方が3名以上居るか"}:::cond
    lc2 -->|"No、次の対象へ"| a2
    c4 -->|"Yes(再実行は最大1回まで)"| a2
    c4 -->|"No"| a5["⑤実行:残りHP割合が最も低い<br/>ライバル1名にこのスキルで<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    a5 --> finish(("終了")):::startend
