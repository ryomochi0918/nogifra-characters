flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身が受けている<br/>バフ・アゲ効果状態の種類数が<br/>3種類以上か"}:::cond
    c2 -->|"Yes"| e2["①による命中率と会心率の<br/>増加倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:このスキル中、自身の命中率と<br/>会心率を+20%する"]:::effect
    e2 --> e1
    e1 --> a3["③実行:ライバルに4回、680%の<br/>アピールを行う"]:::action
    a3 --> c4{"④:③のアピールで会心アピールが<br/>発生したか<br/>(③の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["③のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c4 -->|"No"| lc3{"③のアピール<br/>4回すべて完了?"}:::cond
    e4 --> lc3
    lc3 -->|"Yes"| c5{"⑤:③のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc3 -->|"No、次の回へ"| a3
    c5 -->|"Yes(再実行は最大1回まで)"| a3
    c5 -->|"No"| finish(("終了")):::startend
