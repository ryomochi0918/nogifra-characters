flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①実行:このスキル中、<br/>自身の命中率を「自身が受けている<br/>バフ・アゲ効果・特殊状態の種類数<br/>×10%」分増加する<br/>(増加上限は40%まで)"]:::effect
    e1 --> loop{"②のアピール8回<br/>すべて完了?"}:::cond
    loop -->|"No、次の回へ"| c3{"③:②のアピール対象が<br/>心労状態か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:残りHP割合が<br/>最も高いライバルへ<br/>自身の最大アピールの15%を<br/>固定値として上乗せした<br/>300%のアピール"]:::action
    a2 --> e4["②のアピール対象を100%の<br/>確率で3ターンの間<br/>「心労」状態にする"]:::effect
    e4 --> loop
    loop -->|"Yes"| finish(("終了")):::startend
