flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を「自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>種類数×10%」分増加する(命中率の<br/>増加上限は40%まで)"]:::effect
    e1 --> c3{"③:②の各アピール対象が心労状態か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルに8回、自身の最大アピールの<br/>15%を固定値として上乗せした300%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> e4["④:②の各アピール対象を100%の確率で<br/>3ターンの間「心労」状態にする<br/>(②の各アピール後)"]:::effect
    e4 --> lc2{"②のアピール<br/>8回すべて完了?"}:::cond
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
