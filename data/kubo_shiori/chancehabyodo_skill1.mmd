flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> loop{"①のアピール6回<br/>すべて完了?"}:::cond
    loop -->|"No、次の回へ"| c2{"②:自身の残りHP割合が<br/>①のアピール対象の残りHP割合<br/>以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象の<br/>バフ・アゲ効果を2つ解除し、<br/>①のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が<br/>最も低いライバルへ<br/>自身のエフォートを固定値として<br/>上乗せした300%のアピール"]:::action
    a1 --> e3["③実行:自身のデバフ・サゲ<br/>効果を1つ解除し、自身のHPを<br/>①で行った直前のアピールの<br/>50%分回復する"]:::effect
    e3 --> loop
    loop -->|"Yes"| c5{"⑤:④の効果対象が<br/>すでに「声援」状態か"}:::cond
    c5 -->|"Yes"| e4b["④実行:自身と自身以外の<br/>残りHP割合が最も低い味方1名を<br/>3ターンの間「陽動」状態にし、<br/>HPを①で行った合計アピールの<br/>50%分回復する<br/>(⑤の効果により変更)"]:::effect --> finish
    c5 -->|"No"| e4a["④実行:自身と自身以外の<br/>残りHP割合が最も低い味方1名を<br/>3ターンの間「声援」状態にし、<br/>HPを①で行った合計アピールの<br/>50%分回復する"]:::effect --> finish
    finish(("終了")):::startend
