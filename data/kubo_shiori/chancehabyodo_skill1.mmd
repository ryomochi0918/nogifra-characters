flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アグ効果を<br/>2つ解除し、①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに6回、自身のエフォートを<br/>固定値として上乗せした300%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> e3["③:自身のデバフ・サゲ効果を<br/>1つ解除し、自身のHPを①で行った<br/>直前のアピールの50%分回復する<br/>(①の各アピール後)"]:::effect
    e3 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:④の効果対象が「声援」状態か<br/>(④の各効果前)"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c5 -->|"Yes"| e5["④による「声援」状態を「陽動」<br/>状態に変更する"]:::effect
    c5 -->|"No"| e4["④:自身と自身以外の残りHP割合が<br/>最も低い味方1名を3ターンの間<br/>「声援」状態にし、HPを①で行った<br/>合計アピールの50%分回復する"]:::effect
    e5 --> e4
    e4 --> lc4{"④の効果<br/>対象2名すべて完了?"}:::cond
    lc4 -->|"Yes"| finish(("終了")):::startend
    lc4 -->|"No、次の対象へ"| c5
