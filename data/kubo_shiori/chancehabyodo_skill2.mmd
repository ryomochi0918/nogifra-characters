flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが<br/>①のアピール対象のエフォート<br/>以上か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果解除数を<br/>2つ追加し、①のアピール倍率が<br/>2倍になり、①の各アピール中のみ<br/>自身のリフレクト耐性を+20%する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル6名の<br/>バフ・アゲ効果を1つ解除し、<br/>650%のアピール"]:::action
    a1 --> c3{"③:①のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象を80%の<br/>確率で2ターンの間<br/>「雑音」状態にする"]:::effect --> c4
    c3 -->|"No"| c4{"④:①のアピール対象が<br/>「雑音」状態か(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["①のアピール対象を100%の<br/>確率で2ターンの間<br/>「嫉妬」状態にする"]:::effect --> a5
    c4 -->|"No"| a5["⑤実行:バフ・アゲ効果状態ではなく<br/>「雑音」状態ではない<br/>ライバルチームのフロントの<br/>ライバルへ220%のアピール<br/>(ディフェンス、フィジカルを無視、<br/>最大6名)"]:::action
    a5 --> c6{"⑥:ライバルチームのフロントに<br/>居る「雑音」状態のメンバーが<br/>3名以下か"}:::cond
    c6 -->|"Yes"| e6["⑥の効果中のみ自身の<br/>サゲ効果耐性貫通を+20%し、<br/>「雑音」状態ではないライバル1名を<br/>100%の確率で2ターンの間<br/>「雑音」状態にする"]:::effect --> finish
    c6 -->|"No"| finish
    finish(("終了")):::startend
