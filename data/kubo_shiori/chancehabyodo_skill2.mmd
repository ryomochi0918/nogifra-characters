flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果解除数を2つ追加し、<br/>①のアピール倍率が2倍になり、<br/>①の各アピール中のみ、自身の<br/>リフレクト耐性を+20%する"]:::effect
    c2 -->|"No"| a1["①実行:ライバル6名のバフ・アゲ効果を<br/>1つ解除し、650%のアピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:①のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象を80%の確率で<br/>2ターンの間「雑音」状態にする"]:::effect
    c3 -->|"No"| c4{"④:①のアピール対象が<br/>「雑音」状態か<br/>(③の各効果後)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["①のアピール対象を100%の確率で<br/>2ターンの間「嫉妬」状態にする"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| a5["⑤実行:ライバルチームのフロントに居る<br/>バフ・アゲ効果状態ではなく、<br/>「雑音」状態ではないライバルに<br/>220%のアピールを行う<br/>(ディフェンス、フィジカルを無視する、<br/>最大6名を対象にする)"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a5 --> c6{"⑥:ライバルチームのフロントに居る<br/>「雑音」状態のメンバーが3名以下か"}:::cond
    c6 -->|"Yes"| e6["⑥の効果中のみ、自身のサゲ効果耐性貫通を<br/>+20%し、「雑音」状態ではない<br/>ライバル1名を100%の確率で2ターンの間<br/>「雑音」状態にする"]:::effect
    c6 -->|"No"| finish(("終了")):::startend
    e6 --> finish
