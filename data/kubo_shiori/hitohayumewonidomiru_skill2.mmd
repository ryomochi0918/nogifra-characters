flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身のディフェンスの<br/>100%分の固定値を上乗せし、<br/>①による「嫉妬」状態のターン数を<br/>4ターンにする"]:::effect
    c2 -->|"No"| a1["①実行:ライバル6名に750%の<br/>アピールを行い、100%の確率で<br/>2ターンの間「嫉妬」状態にする"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:自身と自身以外の残りHP割合が<br/>最も低い味方2名のデバフ・サゲ効果を<br/>1つ解除し、HPを①で行った<br/>合計アピールの50%分回復する"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e3 --> finish(("終了")):::startend
