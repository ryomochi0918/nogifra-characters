flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①実行:このスキル中、<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> loop{"②のアピール8回<br/>すべて完了?"}:::cond
    loop -->|"No、次の回へ"| c3{"③:ライバルチームの<br/>フロント人数が4名以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象の<br/>バフ・アゲ効果を1つ解除する"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身のスマイルが<br/>②のアピール対象のスマイル<br/>以上か"}:::cond
    c4 -->|"Yes"| e4["「自身の「希望」状態の<br/>ターン数×自身のスマイルの0.5倍」<br/>を固定値として上乗せする"]:::effect --> c5
    c4 -->|"No"| c5{"⑤:自身の「希望」状態の<br/>ターン数が5ターン以上か"}:::cond
    c5 -->|"Yes"| e5["②のアピール倍率と④の<br/>固定値倍率が2倍になる<br/>(④の固定値倍率は<br/>上限10倍まで)"]:::effect --> a2
    c5 -->|"No"| a2["②実行:残りHP割合が<br/>最も低いライバルへ<br/>500%のアピール"]:::action
    a2 --> loop
    loop -->|"Yes"| c6{"⑥:②のアピールで<br/>ライバルがリタイアしなかったか"}:::cond
    c6 -->|"Yes"| a6["最大アピールが最も高い<br/>ライバルに2回、自身のスマイルの<br/>10倍を固定値として上乗せした<br/>1000%のアピール"]:::action --> finish
    c6 -->|"No"| finish
    finish(("終了")):::startend
