flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:ライバルチームの<br/>フロント人数が4名以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| c4{"④:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["「自身の「希望」状態の<br/>ターン数×自身のスマイルの0.5倍」<br/>を固定値として上乗せする"]:::effect
    c4 -->|"No"| c5{"⑤:自身の「希望」状態のターン数が<br/>5ターン以上か<br/>(②の各アピール前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["②のアピール倍率と④の固定値倍率が<br/>2倍になる(⑤の効果を含めた④の<br/>固定値倍率は上限10倍まで)"]:::effect
    c5 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに8回、500%のアピールを行う"]:::action
    e5 --> a2
    a2 --> lc2{"②のアピール<br/>8回すべて完了?"}:::cond
    lc2 -->|"Yes"| c6{"⑥:②のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c6 -->|"Yes"| a6["⑥実行:最大アピールが最も高い<br/>ライバルに2回、自身のスマイルの<br/>10倍を固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    c6 -->|"No"| finish(("終了")):::startend
    a6 --> finish
