flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> loop{"①のアピール5回<br/>すべて完了?"}:::cond
    loop -->|"No、次の回へ"| c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象の<br/>バフ・アゲ効果を2つ解除する"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身の残りHP割合が<br/>50%以下か"}:::cond
    c4 -->|"Yes"| e4["①の各アピール中のみ<br/>リフレクト耐性を+50%する"]:::effect --> a1
    c4 -->|"No"| a1["①実行:残りHP割合が<br/>最も高いライバルへ<br/>自身のエフォートを固定値として<br/>上乗せした460%のアピール"]:::action
    a1 --> loop
    loop -->|"Yes"| a5["⑤実行:残りHP割合が<br/>最も高いライバル1名に<br/>①で行った合計アピールの<br/>40%分のアピール<br/>(ディフェンス、フィジカルを無視する)"]:::action
    a5 --> finish(("終了")):::startend
