flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール対象のバフ・アゲ効果を<br/>2つ解除する"]:::effect
    c3 -->|"No"| c4{"④:自身の残りHP割合が50%以下か<br/>(①の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["①の各アピール中のみリフレクト耐性を<br/>+50%する"]:::effect
    c4 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに5回、自身のエフォートを<br/>固定値として上乗せした460%の<br/>アピールを行う"]:::action
    e4 --> a1
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| a5["⑤実行:残りHP割合が最も<br/>高いライバル1名に①で<br/>行った合計アピールの40%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc1 -->|"No、次の回へ"| c2
    a5 --> finish(("終了")):::startend
