flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:このスキルが発動する前の<br/>自身の「希望」状態のターン数が<br/>6ターン以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル4名に自身の最大アピールの<br/>50%を固定値として上乗せした480%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:このスキルでリタイアした<br/>ライバルが1名以下か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| a4["④実行:残りHP割合が最も低い<br/>ライバルに3回、自身のSP上限の<br/>200倍のアピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    c4 -->|"No"| e5["⑤:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復し、<br/>残りHP割合が最も低い味方4名を<br/>3ターンの間「勇気」状態にする"]:::effect
    a4 --> e5
    e5 --> finish(("終了")):::startend
