flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが<br/>①のアピール対象のスマイル<br/>以上か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:このスキルが発動する前の<br/>自身の「希望」状態のターン数が<br/>6ターン以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象の<br/>バフ・アゲ効果を1つ解除する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:残りHP割合が<br/>最も低いライバル4名へ<br/>自身の最大アピールの50%を<br/>固定値として上乗せした<br/>480%のアピール"]:::action
    a1 --> c4{"④:このスキルでリタイアした<br/>ライバルが1名以下か"}:::cond
    c4 -->|"Yes"| a4["残りHP割合が最も低い<br/>ライバルに3回、自身のSP上限の<br/>200倍のアピール<br/>(ディフェンス、メンタルを無視する)"]:::action --> a5
    c4 -->|"No"| a5["⑤実行:自身のHPを<br/>このスキルで行った合計アピールの<br/>30%分回復し、残りHP割合が<br/>最も低い味方4名を3ターンの間<br/>「勇気」状態にする"]:::effect
    a5 --> finish(("終了")):::startend
