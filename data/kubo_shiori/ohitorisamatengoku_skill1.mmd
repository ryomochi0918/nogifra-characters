flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がすでに<br/>「全開」状態か"}:::cond
    c2 -->|"Yes"| e2["①による「全開」状態の<br/>アピール力増加倍率が1.5倍になり、<br/>自身を3ターンの間<br/>「熱血」状態にする"]:::effect --> e1
    c2 -->|"No"| e1["①実行:自身を3ターンの間<br/>「全開」にする"]:::effect
    e1 --> a3["③実行:ライバル3名へ<br/>1100%のアピール"]:::action
    a3 --> a4["④実行:ライバルに2回、<br/>550%のアピール"]:::action
    a4 --> e5["⑤実行:自身のHPを<br/>自身のアピール力の50%分回復する<br/>(会心率に応じて<br/>会心回復が発生)"]:::effect
    e5 --> finish(("終了")):::startend
