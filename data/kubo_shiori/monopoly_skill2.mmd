flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>アピール対象の残りHP割合<br/>以上か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>上乗せ倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル4名へ<br/>ライブ中に発動した自身の<br/>スキル2「交差点」の回数×1500%の<br/>倍率を上乗せした100%のアピール<br/>(初回発動時は1600%となる)"]:::action
    a1 --> e3["③実行:自身のHPをこのスキルで<br/>行った合計アピールの<br/>30%分回復する"]:::effect
    e3 --> c4{"④:①のアピールで<br/>リタイアした人数が1名以下か<br/>(再実行は最大1回まで)"}:::cond
    c4 -->|"Yes"| a1b["①再実行:ライバル4名へ<br/>ライブ中に発動した自身の<br/>スキル2「交差点」の回数×1500%の<br/>倍率を上乗せした100%のアピール"]:::action --> c5
    c4 -->|"No"| c5{"⑤:自身が「反響」状態か"}:::cond
    c5 -->|"Yes"| e5["自身の「反響」状態とデバフ・サゲ<br/>効果を全て解除し、3ターンの間<br/>「残響」状態にする"]:::effect --> finish
    c5 -->|"No"| finish
    finish(("終了")):::startend
