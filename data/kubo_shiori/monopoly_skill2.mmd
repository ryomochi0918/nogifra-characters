flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合がアピール対象の<br/>残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>上乗せ倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバル4名にライブ中に<br/>発動した自身のスキル2「交差点」<br/>の回数×1500%の倍率を上乗せした、<br/>100%のアピールを行う<br/>(初回スキル発動時の①による倍率は<br/>1600%となる)"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e3 --> c4{"④:①のアピールでリタイアした<br/>人数が1名以下か"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| c5{"⑤:自身が「反響」状態か"}:::cond
    c5 -->|"Yes"| e5["自身の「反響」状態と<br/>デバフ・サゲ効果を全て解除し、<br/>3ターンの間「残響」状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
