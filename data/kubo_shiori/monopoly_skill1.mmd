flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のHP上限が<br/>アピール対象のHP上限<br/>以上か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身の残りHP割合が<br/>アピール対象の残りHP割合<br/>以上か(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["アピール対象のバフ・アゲ<br/>効果を1つ解除する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバル4名へ<br/>自身のHP上限の15%を<br/>固定値として上乗せした<br/>800%のアピール"]:::action
    a1 --> e4["④実行:自身と自身以外の<br/>最大アピールが最も高い味方2名を<br/>2ターンの間「反響」状態にし、<br/>HPを①で行った合計アピールの<br/>20%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
