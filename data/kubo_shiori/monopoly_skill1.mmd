flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のHP上限がアピール対象の<br/>HP上限以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身の残りHP割合がアピール対象の<br/>残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["バフ・アグ効果を1つ解除する"]:::effect
    c3 -->|"No"| a1["①実行:ライバル4名に自身のHP上限の<br/>15%を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| e4["④:自身と自身以外の最大アピールが<br/>最も高い味方2名を2ターンの間<br/>「反響」状態にし、HPを①で行った<br/>合計アピールの20%分回復する"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e4 --> finish(("終了")):::startend
