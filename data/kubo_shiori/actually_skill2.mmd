flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①実行:自身のデバフ・サゲ<br/>効果を全て解除し、3ターンの間<br/>「興奮」状態にする"]:::effect
    e1 --> c2{"②:自身の残りHP割合が<br/>70%未満か"}:::cond
    c2 -->|"Yes"| e2["自身のHPを自身のHP上限の<br/>40%分回復する"]:::effect --> loop3
    c2 -->|"No"| loop3{"③のアピール3回<br/>すべて完了?"}:::cond
    loop3 -->|"No、次の回へ"| a3["③実行:ライバルへ<br/>400~1200%のアピール<br/>(自身の残りHP割合が<br/>高いほど倍率が高くなる)"]:::action
    a3 --> a4["④実行:残りHP割合が<br/>最も低いライバル2名に<br/>自身の最大アピールの40%を<br/>固定値として上乗せした<br/>400%のアピール"]:::action
    a4 --> loop3
    loop3 -->|"Yes"| finish(("終了")):::startend
