flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身のデバフ・サゲ効果を<br/>全て解除し、3ターンの間「興奮」<br/>状態にする"]:::effect
    e1 --> c2{"②:自身の残りHP割合が70%未満か"}:::cond
    c2 -->|"Yes"| e2["自身のHPを自身のHP上限の<br/>40%分回復する"]:::effect
    c2 -->|"No"| a3["③実行:ライバルに3回、400~1200%の<br/>アピールを行う(自身の残りHP割合が<br/>高いほど倍率が高くなる)"]:::action
    e2 --> a3
    a3 --> a4["④実行:残りHP割合が最も低い<br/>ライバル2名に自身の最大アピールの<br/>40%を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    a4 --> lc3{"③のアピール<br/>3回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| a3
