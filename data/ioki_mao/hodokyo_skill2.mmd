flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方フロントの「不屈」状態の<br/>合計ターン数が3ターン以上か"}:::cond
    c2 -->|"Yes"| e2["①の倍率と固定値倍率が2倍に"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>残りHP割合が最も低いライバルへ<br/>基本420%+固定値 エフォート×4.5"]:::action
    a1 --> lc{"①のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c3{"③:①のアピールで<br/>リタイアしたライバルがいたか<br/>(かつ再実行がまだの場合)"}:::cond
    c3 -->|"Yes(再実行は最大1回まで)"| c2
    c3 -->|"No"| e5["⑤:このスキルでリタイアさせた人数×10%分、<br/>④の合計アピール参照割合を加算<br/>(上限40%)"]:::effect
    e5 --> a4["④実行:<br/>残りHP割合が最も高いライバル1名へ<br/>①の合計アピールの参照割合分のアピール<br/>(Def・Phy無視)"]:::action
    a4 --> finish(("終了")):::startend
