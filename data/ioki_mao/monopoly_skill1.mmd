flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3a{"③:自身のサンクスが<br/>①の対象のサンクス以上か"}:::cond
    c3a -->|"Yes"| e3a["①の倍率と固定値倍率が2倍に"]:::effect --> a1
    c3a -->|"No"| a1["①実行:<br/>ライバルへ基本780%+<br/>固定値 自身のサンクス×2.5"]:::action
    a1 --> lc1{"①の対象<br/>4名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c3a
    lc1 -->|"Yes"| c3b{"③:自身のサンクスが<br/>②の対象のサンクス以上か"}:::cond
    c3b -->|"Yes"| e3b["②の倍率と固定値倍率が2倍に"]:::effect --> a2
    c3b -->|"No"| a2["②実行:<br/>残りHP割合が最も低いライバルへ<br/>基本780%+固定値 自身の最大アピール×25%"]:::action
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"No、次の回へ"| c3b
    lc2 -->|"Yes"| e4["④:自身を2ターンの間「追走」状態にし、<br/>自身のHPをHP上限の25%分回復"]:::effect
    e4 --> finish(("終了")):::startend
