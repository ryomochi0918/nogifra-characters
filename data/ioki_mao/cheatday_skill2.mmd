flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身の命中率とサゲ効果耐性貫通を+25%する"]:::effect
    e1 --> c3{"③:ライバルチームのフロント人数が<br/>3名以下、または対象が既に<br/>「衰弱」状態か"}:::cond
    c3 -->|"Yes"| e3["対象のHP上限2%分の<br/>固定値を上乗せ"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>ライバルを100%の確率で3ターンの間<br/>「衰弱」状態にし、450%のアピール"]:::action
    a2 --> lc{"②の対象<br/>4名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c3
    lc -->|"Yes"| e4["④:自身と最大アピールが最も高い味方1名の<br/>HPを合計アピールの20%分回復し、<br/>自身を2ターンの間「陽動」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
