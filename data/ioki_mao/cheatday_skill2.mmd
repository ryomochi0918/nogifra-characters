flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の命中率と<br/>サゲ効果耐性貫通を+25%する"]:::effect
    e1 --> c3{"③:ライバルチームのフロント人数が<br/>3名以下または②のアピール対象が<br/>「衰弱」状態か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["アピール対象のHP上限2%分の<br/>固定値を上乗せする"]:::effect
    c3 -->|"No"| a2["②実行:ライバル4名を100%の確率で<br/>3ターンの間「衰弱」状態にし、<br/>450%のアピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| e4["④:自身と自身以外の最大アピールが<br/>最も高い味方1名のHPを②で行った<br/>合計アピールの20%分回復し、自身を<br/>2ターンの間「陽動」状態にする"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e4 --> finish(("終了")):::startend
