flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに5回、自身のスマイルの<br/>3倍を固定値として上乗せした480%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:自身の残りHP割合が50%未満か<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["自身のHPを①で行った直前の<br/>アピールの30%分回復する"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| a4["④実行:残りHP割合が最も<br/>高いライバル1名に①で行った<br/>合計アピール50%分のアピールを行う<br/>(ディフェンス、メンタルを無視する)"]:::action
    lc1 -->|"No、次の回へ"| c2
    a4 --> c5{"⑤:ライバルチームの<br/>フロントメンバーが2人以上居るか"}:::cond
    c5 -->|"Yes(再実行は最大1回まで)"| a4
    c5 -->|"No"| c6{"⑥:自身の「翻弄」状態のターン数が<br/>3ターン以上か"}:::cond
    c6 -->|"Yes"| e6["自身を3ターンの間「神気」<br/>状態にする"]:::effect
    c6 -->|"No"| finish(("終了")):::startend
    e6 --> finish
