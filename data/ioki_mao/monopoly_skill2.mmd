flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身が「残響」状態か"}:::cond
    c1 -->|"Yes"| e1["自身を3ターンの間「奏響」<br/>状態にする"]:::effect
    c1 -->|"No"| c3{"③:自身の残りHP割合が70%以上か<br/>(②の各アピール前)"}:::cond
    e1 --> c3
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルに5回、自身の最大アピールの<br/>35%を固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> e4["④:自身のHPを②で行った直前の<br/>アピールの25%分回復する<br/>(②の各アピール後)"]:::effect
    e4 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:自身が「残響」状態ではない<br/>または自身の「残響」状態の<br/>ターン数が5ターン以上か"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes(再実行は最大1回まで)<br/>自身を3ターンの間「旋回」<br/>状態にして再実行"| c3
    c5 -->|"No"| finish(("終了")):::startend
