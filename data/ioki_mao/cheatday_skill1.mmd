flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:ライブ中に自身のスキル1<br/>「全然覚えないです」が<br/>2回以上発動したか"}:::cond
    c2 -->|"Yes"| e2["①の「決心」状態の効果倍率を<br/>1.5倍にする"]:::effect
    c2 -->|"No"| e1["①:自身を2ターンの間「決心」<br/>状態にする"]:::effect
    e2 --> e1
    e1 --> c4{"④:自身のHP上限が③のアピール対象の<br/>HP上限以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c4 -->|"No"| c5{"⑤:自身の残りHP割合が50%以上か<br/>(③の各アピール前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["③のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect
    c5 -->|"No"| a3["③実行:ライバル4名に自身のスマイルの<br/>2.5倍を固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e5 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc3 -->|"Yes"| c6{"⑥:ライバルチームの<br/>フロント人数が4名以上か"}:::cond
    lc3 -->|"No、次の対象へ"| c4
    c6 -->|"Yes"| e6["自身を2ターンの間「円陣」状態にし、<br/>HPを自身のHP上限の50%分回復する"]:::effect
    c6 -->|"No"| finish(("終了")):::startend
    e6 --> finish
