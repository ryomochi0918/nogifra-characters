flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+50%、命中率を+15%する"]:::effect
    e1 --> c5{"⑤:アピール対象の<br/>残りHP割合が50%未満か<br/>(②の各アピール前)"}:::cond
    c5 -->|"Yes"| e5["②の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c5 -->|"No"| a2["②実行:ライバルに3回、<br/>アピール対象のHP上限1.2%分を<br/>固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e5 --> a2
    a2 --> lc2{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"Yes"| a3["③実行:ライバル1名に②で<br/>行ったアピールの合計30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc2 -->|"No、次の回へ"| c5
    a3 --> c5_2{"⑤:アピール対象の<br/>残りHP割合が50%未満か<br/>(④の各アピール前)"}:::cond
    c5_2 -->|"Yes"| e5_2["④の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c5_2 -->|"No"| a4["④実行:ライバル2名に<br/>アピール対象のHP上限1.2%分を<br/>固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e5_2 --> a4
    a4 --> lc4{"④のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc4 -->|"Yes"| finish(("終了")):::startend
    lc4 -->|"No、次の対象へ"| c5_2
