flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3a{"③:自身のスマイルが<br/>①の対象のスマイル以上か"}:::cond
    c3a -->|"Yes"| e3a["①の倍率と固定値倍率が2倍に"]:::effect --> a1
    c3a -->|"No"| a1["①実行:<br/>ライバルへ基本400%+<br/>固定値 自身の最大アピール×30%"]:::action
    a1 --> lc1{"①の対象<br/>4名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c3a
    lc1 -->|"Yes"| c3b{"③:自身のスマイルが<br/>②の対象のスマイル以上か"}:::cond
    c3b -->|"Yes"| e3b["②の倍率と固定値倍率が2倍に"]:::effect --> a2
    c3b -->|"No"| a2["②実行:<br/>残りHP割合が最も低いライバルへ<br/>基本400%+固定値 自身の最大アピール×30%"]:::action
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"No、次の回へ"| c3b
    lc2 -->|"Yes"| e4["④:自身のHPを<br/>このスキルの合計アピールの30%分回復"]:::effect
    e4 --> c5{"⑤:自身の「翻弄」状態のターン数が<br/>4ターン以上か"}:::cond
    c5 -->|"Yes"| e5["自身以外の残りHP割合が最も低い味方4名のHPを<br/>このスキルの合計アピールの30%分回復"]:::effect --> finish
    c5 -->|"No"| finish(("終了")):::startend
