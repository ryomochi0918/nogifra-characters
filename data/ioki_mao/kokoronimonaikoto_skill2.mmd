flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:命中値が最も高いライバルに<br/>4回、自身のエフォートの3倍を<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    a1 --> c2{"②:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c2 -->|"Yes"| a2["②実行:ライバル6名に自身の<br/>エフォート5倍のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action
    c2 -->|"No"| e3["③:命中値が最も高いライバル3名を<br/>100%の確率で2ターンの間<br/>「命中率ダウン」状態にする"]:::effect
    a2 --> e3
    e3 --> e4["④:自身のHPをこのスキルで行った<br/>合計アピールの20%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
