flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を2ターンの間「倍音」<br/>状態にする"]:::effect
    e1 --> c3{"③:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル4名のバフ・アゲ効果を<br/>1つ解除し、自身のエフォートの<br/>4倍を固定値として上乗せした850%の<br/>アピールを行う(バフ・アゲ効果状態の<br/>ライバルを優先的に選択する)"]:::action
    e3 --> a2
    a2 --> c4{"④:②でバフ・アゲ効果の解除に<br/>成功したか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| a4["④実行:②のアピール対象に<br/>自身のエフォートの8倍を<br/>固定値として上乗せした1700%の<br/>アピールを行う"]:::action
    c4 -->|"No"| lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    a4 --> lc2
    lc2 -->|"Yes"| c6{"⑥:②でバフ・アゲ効果の解除に<br/>成功した回数が2回以上か"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c6 -->|"Yes"| e6["⑤による「声援」状態の受ける<br/>アピールの低下倍率が1.5倍になる"]:::effect
    c6 -->|"No"| e5["⑤:自身のHPをこのスキルで行った<br/>合計アピールの25%分回復し、<br/>3ターンの間「声援」状態にする"]:::effect
    e6 --> e5
    e5 --> finish(("終了")):::startend
