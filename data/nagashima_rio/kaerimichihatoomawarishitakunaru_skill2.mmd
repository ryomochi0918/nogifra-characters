flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の命中率と<br/>会心率を+30%する"]:::effect
    e1 --> c3{"③:②のアピール対象が<br/>「回避率ダウン」状態か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除し、②のアピールの<br/>アピール倍率と固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル4名に自身の残りHPの10%分を<br/>固定値として上乗せした750%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| e4["④:「回避率ダウン」状態のライバルの<br/>「回避率ダウン」状態を解除する"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e4 --> a5["⑤実行:残りHP割合が最も低い<br/>ライバル2名に「④で解除した<br/>「回避率ダウン」状態の<br/>数×アピール対象のHP上限の0.8%分」<br/>を固定値として上乗せした750%の<br/>アピールを行う(固定値の最大倍率は<br/>アピール対象のHP上限の4%分まで)"]:::action
    a5 --> e6["⑥:⑤のアピール対象を100%の<br/>確率で2ターンの間「心労」と<br/>「回避率ダウン」状態にする<br/>(⑤の各アピール後)"]:::effect
    e6 --> lc5{"⑤のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc5 -->|"Yes"| finish(("終了")):::startend
    lc5 -->|"No、次の対象へ"| a5
