flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率と会心率を+30%する"]:::effect
    e1 --> c3

    c3{"③:②のアピール対象が<br/>「回避率ダウン」状態か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を1つ解除し、<br/>②のアピールのアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>最大アピールが最も高いライバル4名へ<br/>基本750%+固定値 自身の残りHPの10%分<br/>のアピール"]:::action

    a2 --> lc{"②のアピール<br/>対象4名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c3
    lc -->|"Yes"| e4["④:②のアピールが全て終了後、<br/>「回避率ダウン」状態のライバルの<br/>「回避率ダウン」状態を解除する"]:::effect

    e4 --> a5["⑤実行:④の効果が全て終了後、<br/>残りHP割合が最も低いライバル2名へ<br/>基本750%+固定値「④で解除した<br/>「回避率ダウン」状態の数×アピール対象の<br/>HP上限の0.8%分」のアピール<br/>(固定値の最大倍率はアピール対象の<br/>HP上限の4%分まで)"]:::action
    a5 --> e6["⑥:⑤の各アピール後、⑤のアピール対象を<br/>100%の確率で2ターンの間<br/>「心労」と「回避率ダウン」状態にする"]:::effect
    e6 --> finish(("終了")):::startend
