flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のリフレクトが①の<br/>アピール対象のリフレクト以上だったか<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールにリフレクト×自身の<br/>HP上限の30%を固定値として上乗せする"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに5回、600%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象を100%の確率で<br/>2ターンの間「嫉妬」状態にする"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| c4{"④:自身が「反響」状態または<br/>「残響」状態か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes"| e4["自身を3ターンの間「奏響」<br/>状態にする"]:::effect
    c4 -->|"No"| finish(("終了")):::startend
    e4 --> finish
