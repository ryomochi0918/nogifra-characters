flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:自身を3ターンの間<br/>「興奮」状態にする"]:::action --> c3
    c3{"③:②のアピール対象の残りHP割合が<br/>50%以上か(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["このスキル中のみ自身の<br/>命中率を+20%する"]:::effect --> a2
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル2名へ1500%のアピールを行い、<br/>100%の確率で2ターンの間<br/>「ディフェンスダウン」状態にする"]:::action --> c4
    c4{"④:②のアピールでアピールの失敗または<br/>アピールが0だったか(②の各アピール後)"}:::cond
    c4 -->|"Yes"| a4["②のアピール対象に2000%のアピール"]:::action --> lc2
    c4 -->|"No"| lc2{"②のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2 -->|"Yes"| a5["⑤実行:ライバル4名へこのスキルで<br/>行った合計アピールの30%分のアピール<br/>(ディフェンス、フィジカルを無視)"]:::action --> finish(("終了")):::startend
