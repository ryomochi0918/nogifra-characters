flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間「興奮」<br/>状態にする"]:::effect
    e1 --> c3{"③:②のアピール対象の<br/>残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["このスキル中のみ自身の<br/>命中率を+20%する"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル2名に1500%のアピールを<br/>行い、100%の確率で2ターンの間<br/>「ディフェンスダウン」状態にする"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールでアピールの失敗<br/>またはアピールが0だったか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| a4["④実行:②のアピール対象に2000%の<br/>アピールを行う"]:::action
    c4 -->|"No"| lc2{"②のアピール<br/>ライバル2名すべて完了?"}:::cond
    a4 --> lc2
    lc2 -->|"Yes"| a5["⑤実行:ライバル4名にこのスキルで<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc2 -->|"No、次の対象へ"| c3
    a5 --> finish(("終了")):::startend
