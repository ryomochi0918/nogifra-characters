flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+20%する"]:::effect
    e1 --> c3{"③:自身がバフ・アゲ効果状態か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が3倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに4回、750%のアピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピール対象の残りHP割合が<br/>50%以上またはリタイアしなかったか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["②のアピール回数が1回増加する<br/>(アピールの追加回数は最大で3回まで)"]:::effect
    c4 -->|"No"| c5{"⑤:②のアピールでアピールの<br/>失敗またはアピールが0である事が<br/>3回以上発生したか<br/>(②の各アピール後)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["このスキルによる残りのアピールは<br/>必ず命中する"]:::effect
    c5 -->|"No"| lc2{"②のアピール<br/>4回(+④の追加分)すべて完了?"}:::cond
    e5 --> lc2
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
