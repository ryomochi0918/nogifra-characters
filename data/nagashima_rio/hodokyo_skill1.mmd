flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のバイタリティが①のアピール<br/>対象のバイタリティ以上か"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果解除数を<br/>1つ追加する"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身の残りHP割合が①のアピール<br/>対象の残りHP割合未満か"}:::cond
    c3 -->|"Yes"| e3["①のアピールに自身の低下した<br/>HPの15%分を固定値として<br/>上乗せする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバル4名のバフ・アゲ効果を<br/>1つ解除し、1000%のアピール"]:::action --> e4["自身のHPを自身のHP上限の<br/>30%分回復する"]:::effect --> c56
    c56{"自身が「反響」状態か"}:::cond
    c56 -->|"Yes(⑤)"| a5["自身の「反響」状態を解除し、<br/>自身を4ターンの間<br/>「残響」状態にする"]:::action --> finish(("終了")):::startend
    c56 -->|"No(⑥)"| a6["自身と自身以外の最大アピールが<br/>最も高い味方1名を4ターンの間<br/>「反響」状態にする"]:::action --> finish
