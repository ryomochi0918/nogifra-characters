flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のバイタリティが①の<br/>アピール対象のバイタリティ以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果解除数を<br/>1つ追加する"]:::effect
    c2 -->|"No"| c3{"③:自身の残りHP割合が①の<br/>アピール対象の残りHP割合未満か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピールに自身の低下したHPの<br/>15%分を固定値として上乗せする"]:::effect
    c3 -->|"No"| a1["①実行:ライバル4名のバフ・アゲ効果を<br/>1つ解除し、1000%のアピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| e4["④:自身のHPを自身のHP上限の<br/>30%分回復し、自身の状態に応じて⑤<br/>または⑥の効果を発動する"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e4 --> c5{"⑤/⑥:自身が「反響」状態か"}:::cond
    c5 -->|"Yes"| e5["⑤:自身の「反響」状態を解除し、<br/>自身を4ターンの間「残響」<br/>状態にする"]:::effect
    c5 -->|"No"| e6["⑥:自身と自身以外の最大アピールが<br/>最も高い味方1名を4ターンの間<br/>「反響」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
    e6 --> finish
