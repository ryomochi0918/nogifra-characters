flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のバイタリティが①の<br/>アピール対象のバイタリティ以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と「空腹」の<br/>効果倍率が2倍に"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバルへ100%の確率で2ターンの間<br/>「空腹」状態にし、800%のアピール"]:::action
    a1 --> lc{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| c3{"③:自身の「根性」状態の<br/>ターン数が7ターン以上か"}:::cond
    c3 -->|"No"| finish(("終了")):::startend
    c3 -->|"Yes"| c4{"④:自身の「根性」状態の<br/>ターン数が9ターン以上か"}:::cond
    c4 -->|"Yes"| e4["③で付与する「情熱」状態の<br/>アピール力・会心アピールの<br/>効果倍率が1.5倍に"]:::effect --> e3
    c4 -->|"No"| e3["③実行:自身を2ターンの間<br/>「情熱」状態にする"]:::effect
    e3 --> finish
