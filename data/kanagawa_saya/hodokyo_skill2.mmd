flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバル6名に自身のスマイルの<br/>3倍を固定値として上乗せした700%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:ライバルチームの<br/>フロント人数が4名以下か<br/>(③の各効果前)"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["③の効果対象を2ターンの間「興奮」<br/>状態にし、回復倍率が2倍になる"]:::effect
    c4 -->|"No"| e3["③:残りHP割合が最も低い味方3名の<br/>デバフ・サゲ効果を2つ解除し、<br/>HPを①で行った合計アピールの<br/>20%分回復する"]:::effect
    e4 --> e3
    e3 --> lc3{"③の効果<br/>対象3名すべて完了?"}:::cond
    lc3 -->|"Yes"| e5["⑤:残りHP割合が最も低い味方2名を<br/>2ターンの間「堅忍」状態にする"]:::effect
    lc3 -->|"No、次の対象へ"| c4
    e5 --> finish(("終了")):::startend
