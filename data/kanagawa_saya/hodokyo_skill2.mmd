flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のスマイルが①のアピール<br/>対象のスマイル以上か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["該当対象への①のアピール倍率と<br/>固定値倍率が1.5倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル6名へ、自身の<br/>スマイルの3倍を固定値として<br/>上乗せした700%のアピール"]:::action --> c4
    c4{"④:ライバルチームのフロント人数が<br/>4名以下か"}:::cond
    c4 -->|"Yes"| e4["③の効果対象を2ターンの間<br/>「興奮」状態にし、回復倍率が<br/>2倍になる"]:::effect --> a3
    c4 -->|"No"| a3["③実行:残りHP割合が最も低い味方3名の<br/>デバフ・サゲ効果を2つ解除し、HPを<br/>①で行った合計アピールの20%分<br/>回復する"]:::action --> a5["⑤実行:残りHP割合が最も低い<br/>味方2名を2ターンの間<br/>「堅忍」状態にする"]:::action --> finish(("終了")):::startend
