flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象の<br/>残りHP割合が50%未満か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①によるデバフ・サゲ効果の解除数を<br/>1つ増加し、回復倍率が1.5倍になる"]:::effect
    c2 -->|"No"| e1["①:残りHP割合が最も低い味方4名の<br/>デバフ・サゲ効果を2つ解除し、HPを<br/>自身のアピール力の100%分回復する<br/>(会心率に応じて会心回復が発生する)"]:::effect
    e2 --> e1
    e1 --> lc1{"①の効果<br/>対象4名すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:最大アピールが最も高い味方2名を<br/>3ターンの間「夢中」状態にする"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e3 --> e4["④:味方6名を3ターンの間「勇気」<br/>状態にする"]:::effect
    e4 --> finish(("終了")):::startend
