flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①の効果対象の残りHP割合が<br/>50%未満か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①によるデバフ・サゲ効果の解除数が<br/>1つ増加し、回復倍率が1.5倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い味方4名の<br/>デバフ・サゲ効果を2つ解除し、HPを<br/>自身のアピール力の100%分回復<br/>(会心率に応じて会心回復が発生)"]:::action --> lc1
    lc1{"①の効果<br/>対象4名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| a3["③実行:最大アピールが最も高い<br/>味方2名を3ターンの間<br/>「夢中」状態にする"]:::action --> a4["④実行:味方6名を3ターンの間<br/>「勇気」状態にする"]:::action --> finish(("終了")):::startend
