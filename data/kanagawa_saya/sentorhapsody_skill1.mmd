flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル2名に1000%の<br/>アピールを行う"]:::action
    a1 --> c3{"③:①のアピールで会心アピールが<br/>発生したか"}:::cond
    c3 -->|"Yes"| e3["②の効果対象が①のアピールで<br/>発生した会心アピールの回数分、<br/>効果対象の人数が増加する"]:::effect
    c3 -->|"No"| e2["②:最大アピールが最も高い味方2名を<br/>2ターンの間「アピール力アップ」<br/>状態にし、HPを①で行った<br/>合計アピールの50%分回復する"]:::effect
    e3 --> e2
    e2 --> c4{"④:自身が「アピール力アップ」状態か"}:::cond
    c4 -->|"Yes"| a4["④実行:残りHP割合が最も低い<br/>ライバルに3回、自身の最大アピールの<br/>20%を固定値として上乗せした500%の<br/>アピールを行う"]:::action
    c4 -->|"No"| finish(("終了")):::startend
    a4 --> finish
