flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル2名へ<br/>1000%のアピール"]:::action --> c3
    c3{"③:①のアピールで<br/>会心アピールが発生したか"}:::cond
    c3 -->|"Yes"| e3["②の効果対象人数を、①で発生した<br/>会心アピールの回数分増加させる"]:::effect --> a2
    c3 -->|"No"| a2
    a2["②実行:最大アピールが最も高い味方<br/>(基本2名、③で増加)を2ターンの間<br/>「アピール力アップ」状態にし、HPを①の<br/>合計アピールの50%分回復"]:::action --> c4
    c4{"④:自身が「アピール力アップ」<br/>状態か"}:::cond
    c4 -->|"Yes"| a4["残りHP割合が最も低いライバルへ3回、<br/>自身の最大アピールの20%を固定値として<br/>上乗せした500%のアピール"]:::action --> finish(("終了")):::startend
    c4 -->|"No"| finish
