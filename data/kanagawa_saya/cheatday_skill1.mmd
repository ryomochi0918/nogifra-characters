flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身が「光輝」状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| c3{"③:味方フロントの「光輝」状態の<br/>ターン数が4ターン以上か<br/>(②の各効果前)"}:::cond
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに6回、自身のエフォートの<br/>3倍を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| e2["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    e3 --> e2
    e2 --> a1
    a1 --> c4{"④:自身の残りHP割合が50%以下<br/>または味方フロントの「光輝」<br/>状態のターン数が6ターン以上か<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["自身のHPを①で行った直前の<br/>アピールの50%分回復する"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| e5["⑤:自身を2ターンの間「防音」<br/>状態にする"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e5 --> finish(("終了")):::startend
