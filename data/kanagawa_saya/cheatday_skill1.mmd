flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身が「光輝」状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ<br/>効果を1つ解除する"]:::effect --> c3
    c2 -->|"No"| c3{"③:味方フロントの「光輝」状態の<br/>ターン数が4ターン以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a1
    c3 -->|"No"| a1["①実行:残りHP割合が最も低いライバルへ、<br/>自身のエフォートの3倍を固定値として<br/>上乗せした400%のアピール"]:::action --> c4
    c4{"④:自身の残りHP割合が50%以下、または<br/>味方フロントの「光輝」状態のターン数が<br/>6ターン以上か"}:::cond
    c4 -->|"Yes"| e4["自身のHPを①の直前のアピールの<br/>50%分回復する"]:::effect --> lc1
    c4 -->|"No"| lc1{"①のアピール6回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| a5["⑤実行:自身を2ターンの間<br/>「防音」状態にする"]:::action --> finish(("終了")):::startend
