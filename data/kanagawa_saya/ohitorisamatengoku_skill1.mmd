flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>デバフ耐性貫通を+30%する"]:::effect
    e1 --> c3{"③:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>2つ解除し、②の「フィジカルダウン」<br/>と「メンタルダウン」状態の<br/>効果倍率が1.5倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル5名を100%の確率で<br/>2ターンの間「フィジカルダウン」<br/>と「メンタルダウン」状態にし、<br/>500~1000%のアピールを行う<br/>(アピール対象の残りHP割合が<br/>高いほど倍率が高くなる)"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc2 -->|"Yes"| e4["④:自身を2ターンの間「集中」<br/>状態にする"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e4 --> finish(("終了")):::startend
