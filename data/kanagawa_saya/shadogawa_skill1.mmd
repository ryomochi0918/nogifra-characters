flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を2ターンの間「軽快」<br/>状態にする"]:::effect
    e1 --> c3{"③/④:自身の残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["③:②のアピール対象の<br/>バフ・アゲ効果を1つ解除し、②の<br/>アピールに自身の最大アピールの<br/>30%分を固定値として上乗せする"]:::effect
    c3 -->|"No"| e4["④:このスキル中、自身の会心率と<br/>リフレクト耐性を+25%する"]:::effect
    e3 --> a2["②実行:ライバル6名に400%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:自身が「回避率アップ」状態か"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c5 -->|"Yes(再実行は最大1回まで)"| c3
    c5 -->|"No"| finish(("終了")):::startend
