flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:自身を2ターンの間<br/>「軽快」状態にする"]:::effect --> c34
    c34{"③/④:自身の残りHP割合は<br/>50%以上か<br/>(②の各アピール前)"}:::cond
    c34 -->|"Yes(③)"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除し、②のアピールに自身の<br/>最大アピールの30%分を固定値として<br/>上乗せする"]:::effect --> a2
    c34 -->|"No(④)"| e4["このスキル中、自身の会心率と<br/>リフレクト耐性を+25%する"]:::effect --> a2
    a2["②実行:ライバル6名へ<br/>400%のアピール"]:::action --> lc2
    lc2{"②のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c34
    lc2 -->|"Yes"| c5{"⑤:自身が「回避率アップ」<br/>状態か"}:::cond
    c5 -->|"Yes(再実行は最大1回まで)"| c34
    c5 -->|"No"| finish(("終了")):::startend
