flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e1 --> a2["②実行:ライバル4名に2回、<br/>600%のアピールを行う(2回目以降の<br/>アピールは対象を選び直す)"]:::action
    a2 --> c4{"④:自身のサンクスが③の<br/>アピール対象のサンクス以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率が3倍になる"]:::effect
    c4 -->|"No"| a3["③実行:ライバルに2回、1300%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> c5{"⑤:③のアピール対象が<br/>リタイアしなかったか<br/>(③の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["③のアピール回数が1回増加する<br/>(アピールの追加回数は最大で2回まで)"]:::effect
    c5 -->|"No"| lc3{"③のアピール<br/>2回(+⑤の追加分)すべて完了?"}:::cond
    e5 --> lc3
    lc3 -->|"Yes"| e6["⑥:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    lc3 -->|"No、次の回へ"| c4
    e6 --> finish(("終了")):::startend
