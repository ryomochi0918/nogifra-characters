flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身がバフ・アゲ効果<br/>状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が最も低いライバルへ、<br/>自身の最大アピールの25%分を固定値<br/>として上乗せした450%のアピール"]:::action --> lc1
    lc1{"①のアピール5回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| e3["③効果:自身のHPを①で行った<br/>合計アピールの30%分回復する"]:::effect --> c45
    c45{"自身が「回避率アップ」状態か"}:::cond
    c45 -->|"Yes(④)"| a4["自身を3ターンの間<br/>「追走」状態にする"]:::action --> finish(("終了")):::startend
    c45 -->|"No(⑤)"| a5["自身を2ターンの間<br/>「回避率アップ」状態にする"]:::action --> finish
