flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに5回、自身の最大アピールの<br/>25%分を固定値として上乗せした450%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:自身のHPを①で行った<br/>合計アピールの30%分回復し、<br/>自身の状態に応じて④か⑤の<br/>効果どちらかを適用する"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e3 --> c4{"④/⑤:自身が「回避率アップ」状態か"}:::cond
    c4 -->|"Yes"| e4["④:自身を3ターンの間「追走」<br/>状態にする"]:::effect
    c4 -->|"No"| e5["⑤:自身を2ターンの間<br/>「回避率アップ」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
    e5 --> finish
