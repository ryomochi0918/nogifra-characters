flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e1 --> c3{"③:②のアピール対象の<br/>残りHP割合が50%以下か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:②のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②の各アピールにアピール対象の<br/>HP減少分の8%を固定値として上乗せする<br/>(固定値の上乗せは自身の<br/>最大アピールの500%まで)"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに5回、500%のアピールを行う"]:::action
    e4 --> a2
    a2 --> c5{"⑤:②のアピールでライバルを<br/>リタイアさせたか<br/>(度に積算)<br/>(②の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["②のアピール倍率が<br/>2倍になりアピール回数が1回増加する<br/>(⑤の効果によるアピール倍率の<br/>最大は4000%、③の効果が同時に<br/>発生した場合の最大は8000%、<br/>アピール回数の増加は最大3回まで)"]:::effect
    c5 -->|"No"| c6{"⑥:②のアピールでライバルが<br/>リタイアしなかったか<br/>(度に積算)<br/>(②の各アピール後)"}:::cond
    e5 --> c6
    c6 -->|"Yes"| e6["①の命中率を+5%増加する(⑥の<br/>効果による命中率の増加上限は+20%)"]:::effect
    c6 -->|"No"| lc2{"②のアピール<br/>5回(+⑤の追加分)すべて完了?"}:::cond
    e6 --> lc2
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
