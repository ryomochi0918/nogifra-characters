flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+25%する"]:::effect
    e1 --> c3{"③:自身の「光輝」状態のターン数が<br/>5ターン以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに5回、<br/>自身の最大アピールの25%を<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> e4["④:自身のHPを②で行った直前の<br/>アピールの50%分回復する<br/>(②の各アピール後)"]:::effect
    e4 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:味方フロントの「光輝」<br/>状態のターン数が9ターン以上<br/>または②のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes"| c6{"⑥:自身のエフォートが⑤の<br/>アピール対象のエフォート以上か<br/>(⑤の各アピール前)"}:::cond
    c5 -->|"No"| finish(("終了")):::startend
    c6 -->|"Yes"| e6["⑤のアピール倍率が2倍になり、<br/>⑤のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c6 -->|"No"| a5["⑤実行:ライバル6名に②で<br/>行った合計アピールの20%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    e6 --> a5
    a5 --> lc5{"⑤のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc5 -->|"Yes"| finish
    lc5 -->|"No、次の対象へ"| c6
