flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身の「希望」状態の<br/>ターン数が6ターン以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の固定値の上限が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに、アピール対象の<br/>HP減少分の6%を固定値として<br/>上乗せした700%のアピール<br/>(固定値の上乗せは自身の<br/>最大アピールの600%まで)"]:::action
    a1 --> c3{"③:①のアピールで会心アピールが<br/>発生したまたは自身の「希望」状態の<br/>ターン数が8ターン以上か<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["①のアピール回数が1回増加する<br/>(アピールの追加回数は最大で2回まで)"]:::effect --> lc1
    c3 -->|"No"| lc1{"①のアピール<br/>3回(③による追加分を含む)<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| e4["④効果:残りHP割合が最も低い<br/>味方2名のHPを①で行った<br/>合計アピールの20%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
