flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の「希望」状態のターン数が<br/>6ターン以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の固定値の上限が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:最大アピールが<br/>最も高いライバルに3回、<br/>アピール対象のHP減少分の6%を<br/>固定値として上乗せした700%の<br/>アピールを行う(固定値の上乗せは<br/>自身の最大アピールの600%まで)"]:::action
    e2 --> a1
    a1 --> c3{"③:①のアピールで会心アピールが<br/>発生したまたは自身の「希望」<br/>状態のターン数が8ターン以上か<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["①のアピール回数が1回増加する<br/>(アピールの追加回数は最大で2回まで)"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>3回(+③の追加分)すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| e4["④:残りHP割合が最も低い味方2名の<br/>HPを①で行った合計アピールの<br/>20%分回復する"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e4 --> finish(("終了")):::startend
