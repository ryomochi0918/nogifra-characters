flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を4ターンの間「倍音」<br/>状態にする"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:ライブ中に自身のスキル2<br/>「好きのグラデーション」が1回も<br/>発動していないか<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:ライバル4名に自身のサンクスの<br/>4倍を固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバルに2回、自身の最大アピールの<br/>40%を固定値として上乗せした1600%の<br/>アピールを行う"]:::action
    lc2 -->|"No、次の対象へ"| c3
    a5 --> c6{"⑥:⑤のアピール対象がリタイアしたか<br/>(⑤の各アピール後)"}:::cond
    c6 -->|"Yes"| e6["⑤のアピール回数が1回増加する<br/>(アピールの追加回数は最大で2回まで)"]:::effect
    c6 -->|"No"| lc5{"⑤のアピール<br/>2回(+⑥の追加分)すべて完了?"}:::cond
    e6 --> lc5
    lc5 -->|"Yes"| c7{"⑦:このスキルでライバルが<br/>リタイアしなかったかつライバルチームの<br/>フロント人数が4名以下か"}:::cond
    lc5 -->|"No、次の回へ"| a5
    c7 -->|"Yes"| a7["⑦実行:残りHP割合が最も低い<br/>ライバル1名にこのスキルで<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c7 -->|"No"| e8["⑧:自身を2ターンの間「機敏」<br/>状態にする"]:::effect
    a7 --> e8
    e8 --> finish(("終了")):::startend
