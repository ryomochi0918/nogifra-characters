flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:味方チームのフロント人数が<br/>ライバルチームのフロント人数より<br/>多いか<br/>(①の効果前)"}:::cond
    c2 -->|"Yes"| e2["①による「強運」状態の<br/>効果倍率が2倍になる"]:::effect --> e1
    c2 -->|"No"| e1["①効果:自身と自身以外の<br/>最大アピールが最も高い味方2名を<br/>3ターンの間「強運」状態にする<br/>※強運:アピール力が15〜30%上昇し、<br/>会心率が15〜30%上昇する"]:::effect
    e1 --> e3["③効果:自身と自身以外の<br/>HP上限が最も高い味方1名を<br/>3ターンの間「脚光」状態にする<br/>※脚光:受けるアピールが50%低下し、<br/>脚光状態でライバルにアピールされた場合、<br/>80%の確率でライバルを2ターンの間<br/>「アピール力ダウン」状態にする"]:::effect
    e3 --> e4["④効果:③の効果対象のHPを<br/>自身のHP上限の20%分回復する<br/>(③の各効果後)"]:::effect
    e4 --> lc3{"③の効果<br/>対象(自身と味方1名)すべて完了?"}:::cond
    lc3 -->|"No、次の対象へ"| e3
    lc3 -->|"Yes"| a5["⑤実行:残りHP割合が最も高い<br/>ライバルに、自身の最大アピールの<br/>20%を固定値として上乗せした<br/>400%のアピール"]:::action
    a5 --> lc5{"⑤のアピール<br/>3回すべて完了?"}:::cond
    lc5 -->|"No、次の回へ"| a5
    lc5 -->|"Yes"| finish(("終了")):::startend
