flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方チームのフロント人数が<br/>ライバルチームの<br/>フロント人数より多いか"}:::cond
    c2 -->|"Yes"| e2["①による「強運」状態の<br/>効果倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:自身と自身以外の最大アピールが<br/>最も高い味方2名を3ターンの間<br/>「強運」状態にする"]:::effect
    e2 --> e1
    e1 --> e3["③:自身と自身以外のHP上限が最も<br/>高い味方1名を3ターンの間「脚光」<br/>状態にする"]:::effect
    e3 --> e4["④:③の効果対象のHPを自身の<br/>HP上限の20%分回復する<br/>(③の各効果後)"]:::effect
    e4 --> lc3{"③の効果<br/>対象2名すべて完了?"}:::cond
    lc3 -->|"Yes"| a5["⑤実行:残りHP割合が最も高い<br/>ライバルに3回、自身の最大アピールの<br/>20%を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    lc3 -->|"No、次の対象へ"| e3
    a5 --> finish(("終了")):::startend
