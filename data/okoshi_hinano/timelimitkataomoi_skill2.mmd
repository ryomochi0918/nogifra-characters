flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a0["①実行:このスキル中、<br/>自身の会心率を+20%する"]:::effect --> c1{"③:自身のサンクスが<br/>対象のサンクス以上か"}:::cond
    c1 -->|"Yes"| c2a{"④:自身の「躍動」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    c1 -->|"No"| c2b{"④:自身の「躍動」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    c2a -->|"Yes"| a1["②実行(強化):自身の最大<br/>アピールの20%を固定値として<br/>上乗せした430%のアピール<br/>(倍率2倍。このアピール中、<br/>会心率30%・会心アピール+40%)"]:::action --> loop1
    c2a -->|"No"| a2["②実行:自身の最大アピールの<br/>20%を固定値として上乗せした<br/>430%のアピール(このアピール中、<br/>会心率30%・会心アピール+40%)"]:::action --> loop1
    c2b -->|"Yes"| a3["②実行(強化):自身の最大<br/>アピールの20%を固定値として<br/>上乗せした430%のアピール<br/>(倍率2倍)"]:::action --> loop1
    c2b -->|"No"| a4["②実行:自身の最大アピールの<br/>20%を固定値として上乗せした<br/>430%のアピールを行う"]:::action --> loop1
    loop1{"5回<br/>すべて完了?"}:::cond
    loop1 -->|"No、次の回へ"| c1
    loop1 -->|"Yes"| c3{"⑤:②のアピールで会心<br/>アピールが3回以上<br/>発生したか"}:::cond
    c3 -->|"Yes"| a5["再度②を実行する<br/>(再実行は最大1回まで)"]:::action --> a6
    c3 -->|"No"| a6["⑥実行:自身のHPをこのスキルで<br/>行った合計アピールの30%分<br/>回復する"]:::action --> finish(("終了")):::startend
