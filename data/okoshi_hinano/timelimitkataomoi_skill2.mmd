flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+20%する"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ①による<br/>会心率の増加倍率が30%になり、<br/>自身の会心アピールを+40%する"]:::effect
    c3 -->|"No"| c4{"④:自身の「躍動」状態の<br/>合計ターン数が7ターン以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに5回、自身の最大アピールの<br/>20%を固定値として上乗せした430%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:②のアピールで会心アピールが<br/>3回以上発生したか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes(再実行は最大1回まで)"| c3
    c5 -->|"No"| e6["⑥:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    e6 --> finish(("終了")):::startend
