flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:味方6名を2ターンの間<br/>「アピールブースト(感謝)」<br/>状態にする"]:::effect
    e1 --> c3{"③:自身の残りHP割合が50%以上か"}:::cond
    c3 -->|"Yes"| e3["②の「保護」状態の会心アピール耐性の<br/>効果倍率が1.5倍になる"]:::effect
    c3 -->|"No"| e2["②:自身を2ターンの間「保護」<br/>状態にする"]:::effect
    e3 --> e2
    e2 --> a4["④実行:最大アピールが最も高い<br/>ライバルに3回、自身の残りHPの<br/>12%を固定値として上乗せした500%の<br/>アピールを行う"]:::action
    a4 --> c5{"⑤:④のアピール対象の<br/>残りHP割合が50%以上か<br/>(④の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["④のアピール対象のバフ・アゲ効果を<br/>2つ解除する"]:::effect
    c5 -->|"No"| lc4{"④のアピール<br/>3回すべて完了?"}:::cond
    e5 --> lc4
    lc4 -->|"Yes"| c6{"⑥:ライバルチームの<br/>フロント人数が4名以上か"}:::cond
    lc4 -->|"No、次の回へ"| a4
    c6 -->|"Yes"| e6["自身を3ターンの間「決心」状態にし、<br/>HPを④で行った合計アピールの<br/>30%分回復する"]:::effect
    c6 -->|"No"| finish(("終了")):::startend
    e6 --> finish
