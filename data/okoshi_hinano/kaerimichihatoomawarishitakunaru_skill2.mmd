flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> s1["①このスキル中、自身の命中率を+30%する"]:::effect
    s1 --> s2["②①の効果後、ライバル4名に<br/>自身の最大アピールの30%を固定値として<br/>上乗せした680%のアピールを行う"]:::action

    s2 --> c3{"③②のアピールが全て終了後:<br/>②のアピールでライバルが<br/>リタイアしなかった?"}:::cond
    c3 -- "Yes" --> c3b{"再実行は最大1回まで<br/>すでに再実行済み?"}:::cond
    c3b -- "No(未実行)、再度②を実行" --> s2
    c3b -- "Yes(実行済み)" --> s4
    c3 -- "No" --> s4

    s4["④②のアピールが全て終了後<br/>(③の再実行が発動した場合は③の後)、<br/>残りHP割合が最も低い味方2名のHPを<br/>②で行った合計アピールの30%分回復し、<br/>3ターンの間「ディフェンスアップ」状態にする"]:::effect
    s4 --> finish(("終了")):::startend
