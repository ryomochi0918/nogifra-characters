flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a0["①実行:このスキル中、<br/>自身の命中率を+15%する"]:::effect --> c1{"③:自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>合計種類数が4種類以上か"}:::cond
    c1 -->|"No"| a1["②実行:対象のHP上限の1%分を<br/>固定値として上乗せした400%の<br/>アピールを行う"]:::action --> loop1{"4回<br/>すべて完了?"}:::cond
    c1 -->|"Yes"| c2{"④:対象のエフォート・<br/>サンクス・スマイルの内、<br/>サンクスが最も高いか"}:::cond
    c2 -->|"Yes"| a2["②実行(強化):対象のHP上限の<br/>1%分に加え、自身のエフォートの<br/>4倍×2.5倍を固定値として<br/>上乗せした400%のアピールを<br/>行う"]:::action --> loop1
    c2 -->|"No"| a3["②実行(強化):対象のHP上限の<br/>1%分に加え、自身のエフォートの<br/>4倍を固定値として上乗せした<br/>400%のアピールを行う"]:::action --> loop1
    loop1 -->|"No、次の回へ"| c1
    loop1 -->|"Yes"| c3{"⑤:②のアピールで失敗<br/>またはアピールが0の<br/>事が3回以上発生したか"}:::cond
    c3 -->|"Yes"| a4["残りHP割合が最も高い<br/>ライバル1名に、対象のHP上限の<br/>1%分を固定値として上乗せした<br/>400%のアピールを行う<br/>(このアピールは必ず命中する)"]:::action --> a5
    c3 -->|"No"| a5["⑥実行:自身を4ターンの間<br/>「堅忍」状態にし、自身と自身<br/>以外の最大アピールが最も高い<br/>味方1名のHPを自身のHP上限の<br/>40%分回復する"]:::effect --> finish(("終了")):::startend
