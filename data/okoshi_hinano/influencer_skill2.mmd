flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+15%する"]:::effect
    e1 --> c3{"③:自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>合計種類数が4種類以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| c4{"④:②のアピール対象のエフォート、<br/>サンクス、スマイルの内、<br/>サンクスが最も高いか<br/>(②の各アピール前)"}:::cond
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルに4回、対象のHP上限の<br/>1%分を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    c4 -->|"Yes"| e4["③の固定値倍率が2.5倍になる"]:::effect
    c4 -->|"No"| e3["②のアピールに自身のエフォートの<br/>4倍を固定値として上乗せする"]:::effect
    e4 --> e3
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:②のアピールでアピールの<br/>失敗またはアピールが0である事が<br/>3回以上発生したか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も高い<br/>ライバル1名に対象のHP上限の1%分を<br/>固定値として上乗せした400%の<br/>アピールを行う(このアピールは<br/>必ず命中する)"]:::action
    c5 -->|"No"| e6["⑥:自身を4ターンの間「堅忍」<br/>状態にし、自身と自身以外の<br/>最大アピールが最も高い味方1名の<br/>HPを自身のHP上限の40%分回復する"]:::effect
    a5 --> e6
    e6 --> finish(("終了")):::startend
