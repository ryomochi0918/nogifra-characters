flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:最大アピールが最も高い味方3名を<br/>2ターンの間「賢明」状態にする"]:::effect
    e1 --> e2["②:残りHP割合が最も低い味方2名の<br/>HPを自身のHP上限の20%分回復し、<br/>3ターンの間「堅忍」状態にする"]:::effect
    e2 --> c4{"④:ライブ中に自身のスキル2<br/>「大オチひなの。」が<br/>1回以上発動したか<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| c5{"⑤:自身のスマイルが③の<br/>アピール対象のスマイル以上か<br/>(③の各アピール前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["③の各アピール中のみ自身の<br/>命中率を+20%する"]:::effect
    c5 -->|"No"| a3["③実行:残りHP割合が最も高い<br/>ライバルに4回、アピール対象の<br/>残りHPの1%分の固定値を<br/>上乗せした760%のアピールを行う"]:::action
    e5 --> a3
    a3 --> lc3{"③のアピール<br/>4回すべて完了?"}:::cond
    lc3 -->|"Yes"| c6{"⑥:このスキル中に自身のスマイルが<br/>③のアピール対象のスマイル以上である<br/>事が2回以上発生したか"}:::cond
    lc3 -->|"No、次の回へ"| c4
    c6 -->|"Yes"| e6["最大アピールが最も高い味方3名の<br/>デバフ・サゲ効果を1つ解除する"]:::effect
    c6 -->|"No"| finish(("終了")):::startend
    e6 --> finish
