flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"②:自身のサンクスが<br/>対象のサンクス以上か"}:::cond
    c1 -->|"Yes"| c2a{"③:味方フロントの<br/>「躍動」状態の合計ターン数が<br/>6ターン以上か"}:::cond
    c1 -->|"No"| c2b{"③:味方フロントの<br/>「躍動」状態の合計ターン数が<br/>6ターン以上か"}:::cond
    c2a -->|"Yes"| a1["①実行(強化):サンクスの3.5倍<br/>を固定値として上乗せした430%<br/>のアピールを行い(倍率2倍)、<br/>対象のバフ・アゲ効果を<br/>1つ解除する"]:::action --> a5
    c2a -->|"No"| a2["①実行(強化):サンクスの3.5倍<br/>を固定値として上乗せした430%<br/>のアピールを行う(倍率2倍)"]:::action --> a5
    c2b -->|"Yes"| a3["①実行(通常):サンクスの3.5倍<br/>を固定値として上乗せした430%<br/>のアピールを行い、対象の<br/>バフ・アゲ効果を1つ解除する"]:::action --> a5
    c2b -->|"No"| a4["①実行(通常):サンクスの3.5倍<br/>を固定値として上乗せした430%<br/>のアピールを行う"]:::action --> a5
    a5["④実行:自身のHPを直前の<br/>アピールの30%分回復する"]:::action --> c3{"⑤:このアピールで<br/>会心アピールが発生したか"}:::cond
    c3 -->|"Yes"| a6["アピール回数を+1する<br/>(追加は最大2回まで)"]:::effect --> loop1{"5回(+追加分)<br/>すべて完了?"}:::cond
    c3 -->|"No"| loop1
    loop1 -->|"No、次の回へ"| c1
    loop1 -->|"Yes"| c4{"⑥:ライバルチームの<br/>フロント人数が3名以下か"}:::cond
    c4 -->|"Yes"| a7["残りHP割合が最も低い<br/>ライバル1名に1回、①で行った<br/>合計アピールの25%分のアピールを<br/>行う(ディフェンス、<br/>フィジカルを無視)"]:::action --> finish(("終了")):::startend
    c4 -->|"No"| finish
