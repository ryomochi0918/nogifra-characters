flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:味方フロントの「躍動」状態の<br/>合計ターン数が6ターン以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに5回、自身のサンクスの<br/>3.5倍を固定値として上乗せした430%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> e4["④:自身のHPを直前のアピールの<br/>30%分回復する<br/>(①の各アピール後)"]:::effect
    e4 --> c5{"⑤:①のアピールで会心アピールが<br/>発生したか<br/>(①の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["①のアピール回数が1回増加する<br/>(アピールの追加回数は最大で2回まで)"]:::effect
    c5 -->|"No"| lc1{"①のアピール<br/>5回(+⑤の追加分)すべて完了?"}:::cond
    e5 --> lc1
    lc1 -->|"Yes"| c6{"⑥:ライバルチームの<br/>フロント人数が3名以下か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c6 -->|"Yes"| a6["⑥実行:残りHP割合が最も<br/>低いライバルに1回、①で<br/>行った合計アピールの25%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c6 -->|"No"| finish(("終了")):::startend
    a6 --> finish
