flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方フロントのバフ・アゲ効果<br/>合計数がライバルフロントの<br/>合計数以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2.5倍に"]:::effect --> a1
    c2 -->|"No"| a1["①実行:最大アピール最高のライバルへ<br/>基本700%+固定値 自身の最大アピールの20%の<br/>アピールを行い、バフ・アゲ効果を1つ解除"]:::action
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| a3["③実行:バフ・アゲ効果状態ではない<br/>ライバルへ①の合計アピールの20%分の<br/>アピール(ディフェンス・フィジカル無視)"]:::action
    a3 --> e5["⑤:①と③のアピールで発生した<br/>会心アピール回数1回毎に④の対象を<br/>+1名(増加は最大2名まで)"]:::effect
    e5 --> c6{"⑥:④の効果対象が受けている<br/>バフ・アゲ効果状態の種類数が<br/>2種類以上か"}:::cond
    c6 -->|"Yes"| e6["④の「堅忍」状態を<br/>「声援」状態に変更"]:::effect --> a4
    c6 -->|"No"| a4["④実行:残りHP割合が最も低い<br/>味方2名(+⑤の増加分)を<br/>3ターンの間「堅忍」状態にする"]:::action
    a4 --> finish(("終了")):::startend
