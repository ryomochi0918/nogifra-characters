flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象が受けている<br/>バフ・アゲ効果状態の種類数が<br/>2種類以下か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①による「夢中」状態の<br/>効果倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:自身と自身以外の味方4名を<br/>3ターンの間「夢中」状態にする"]:::effect
    e2 --> e1
    e1 --> lc1{"①の効果<br/>対象5名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:③の効果対象の<br/>残りHP割合が50%以上か<br/>(③の各効果前)"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["③による「聡明」状態の効果倍率が<br/>1.5倍になる"]:::effect
    c4 -->|"No"| c5{"⑤:③の効果対象が<br/>デバフ・サゲ効果状態ではないか<br/>(③の各効果前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["③の効果対象を2ターンの間「豪運」<br/>状態にする"]:::effect
    c5 -->|"No"| e3["③:自身と自身以外の<br/>最大アピールが最も高い味方2名を<br/>2ターンの間「聡明」状態にし、<br/>デバフ・サゲ効果を1つ解除する"]:::effect
    e5 --> e3
    e3 --> lc3{"③の効果<br/>対象3名すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の対象へ"| c4
