flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+30%し、<br/>リフレクト耐性を+50%する"]:::effect --> a2
    a2["②実行:ライバルへ、自身のサンクスの<br/>2.5倍を固定値として上乗せした<br/>500%のアピール"]:::action --> c3
    c3{"③:②のアピールで会心アピールが<br/>発生しなかったか"}:::cond
    c3 -->|"Yes"| e3["②のアピール回数を1回増加する<br/>(アピールの追加回数は最大で3回まで)"]:::effect --> lc
    c3 -->|"No"| lc{"②のアピール5回(③による<br/>増加分を含む)すべて完了?"}:::cond
    lc -->|"No、次の回へ"| a2
    lc -->|"Yes"| c5{"⑤:④の効果対象が既に<br/>「回避率アップ」状態か<br/>(対象ごとに判定)"}:::cond
    c5 -->|"Yes"| e5["④による「回避率アップ」状態を<br/>「軽快」状態に変更する"]:::effect --> e4
    c5 -->|"No"| e4["④:②のアピールで会心アピールが発生した<br/>回数を人数として、味方を4ターンの間<br/>「回避率アップ」状態にし、HPを②で行った<br/>合計アピールの20%分回復する<br/>(効果対象の最大人数は5人まで)"]:::effect --> finish(("終了")):::startend
