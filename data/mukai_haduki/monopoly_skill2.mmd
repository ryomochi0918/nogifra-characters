flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+30%する"]:::effect --> e3
    e3["③:②の各アピール中のみ自身の命中率を<br/>「自身の「抱擁」状態の合計ターン数×4%」分<br/>増加する(命中率の増加上限は+40%まで)"]:::effect --> a2
    a2["②実行:ライバルへ<br/>300%のアピール"]:::action --> c4
    c4{"④:②のアピールで会心<br/>アピールが発生したか"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率が2倍になる<br/>(④の効果によるアピール倍率の<br/>上限値は4800%)"]:::effect --> c5
    c4 -->|"No"| c5{"⑤:②のアピールが会心アピールでは<br/>ない事が2回以上連続で発生したか"}:::cond
    c5 -->|"Yes"| e5["次に行う②のアピールが<br/>必ず会心アピールになる"]:::effect --> lc
    c5 -->|"No"| lc{"②のアピール6回<br/>すべて完了?"}:::cond
    lc -->|"No、次の回へ"| e3
    lc -->|"Yes"| c6{"⑥:このスキル中、会心アピールが<br/>3回以上発生した、または自身の<br/>「抱擁」状態のターン数が<br/>10ターン以上か"}:::cond
    c6 -->|"Yes"| a6["④による倍率増加を引き継いだ状態で<br/>再度②からスキルを実行<br/>(再実行は最大1回まで)"]:::action --> finish(("終了")):::startend
    c6 -->|"No"| finish
