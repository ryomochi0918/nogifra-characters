flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+30%する"]:::effect
    e1 --> e3["③:②の各アピール中のみ自身の<br/>命中率を「自身の「抱擁」状態の<br/>合計ターン数×4%」分増加する<br/>(命中率の増加上限は+40%まで)<br/>(②の各アピール前)"]:::effect
    e3 --> a2["②実行:ライバルに6回、300%の<br/>アピールを行う"]:::action
    a2 --> c4{"④:②のアピールで会心アピールが<br/>発生したか<br/>(度に積算)<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率が2倍になる<br/>(④の効果によるアピール倍率の<br/>上限値は4800%)"]:::effect
    c4 -->|"No"| c5{"⑤:②のアピールが会心アピールではない<br/>事が2回以上連続で発生したか<br/>(②の各アピール後)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["次に行う②のアピールが<br/>必ず会心アピールになる"]:::effect
    c5 -->|"No"| lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    e5 --> lc2
    lc2 -->|"Yes"| c6{"⑥:このスキル中、会心アピールが<br/>3回以上発生した、または自身の<br/>「抱擁」状態のターン数が<br/>10ターン以上か"}:::cond
    lc2 -->|"No、次の回へ"| e3
    c6 -->|"Yes(再実行は最大1回まで)<br/>④による倍率増加を引き<br/>継いだ状態で再実行"| e3
    c6 -->|"No"| finish(("終了")):::startend
