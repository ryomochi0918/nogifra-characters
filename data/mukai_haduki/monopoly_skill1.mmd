flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール対象の残りHP割合が<br/>30%以上か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のスマイルがアピール対象の<br/>スマイル以上か(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①の各アピール中のみ自身の<br/>リフレクト耐性を+20%する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバル4名へ、自身のスマイルを<br/>固定値として上乗せした500%のアピール<br/>(2回目以降のアピールは同じ対象を選ぶ)"]:::action
    a1 --> lc{"①のアピール2回<br/>すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| e4["④:自身と自身以外の残りHP割合の<br/>最も低い味方1名のHPを①で行った<br/>合計アピールの50%分回復する"]:::effect --> finish(("終了")):::startend
