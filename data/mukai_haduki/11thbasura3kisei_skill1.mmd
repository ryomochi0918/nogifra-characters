flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象がデバフ・サゲ<br/>効果状態か(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が3倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバル6名へ600%のアピール"]:::action
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| e3["③実行:<br/>自身のHPを①で行った<br/>合計アピールの40%分回復する"]:::effect
    e3 --> a4["④実行:<br/>最大アピールが最も高い<br/>ライバル1名に①で行った合計アピールの<br/>40%分のアピール<br/>(ディフェンス、メンタルを無視する)"]:::action
    a4 --> finish(("終了")):::startend
