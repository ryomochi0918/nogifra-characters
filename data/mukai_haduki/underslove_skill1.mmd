flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル4名に<br/>自身のエフォートの2.5倍を<br/>固定値として上乗せした600%の<br/>アピールを行う"]:::action
    a1 --> c3{"③/④:自身の残りHP割合が50%未満か"}:::cond
    c3 -->|"Yes"| e3["③:②による回復倍率が2倍になる"]:::effect
    c3 -->|"No"| e4["④:②による「堅忍」の<br/>効果倍率が2倍になる"]:::effect
    e3 --> e2["②:自身を4ターンの間「威圧」<br/>と「堅忍」状態にし、HPを自身の<br/>HP上限の25%分回復する"]:::effect
    e4 --> e2
    e2 --> finish(("終了")):::startend
