flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+30%し、<br/>会心アピールを+60%する"]:::effect --> c3
    c3{"③:自身のサンクスが②のアピール対象の<br/>サンクス以上か(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②のアピールに自身のサンクスの<br/>4倍を固定値として上乗せする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバルへ<br/>600%のアピール"]:::action
    a2 --> lc{"②のアピール4回<br/>すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| e4["④:残りHP割合が最も低い味方1名の<br/>デバフ・サゲ効果状態を全て解除し、<br/>HPを②で行った合計アピール50%分回復する"]:::effect --> e5
    e5["⑤:②のアピールで会心アピールが発生した<br/>回数分だけ④を再度実行する<br/>(再実行は最大4回まで)"]:::effect --> finish(("終了")):::startend
