flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象が<br/>「威圧」状態または「軽業」状態か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["「威圧」の代わりに<br/>「聖域」状態にする"]:::effect --> e1
    c2 -->|"No"| e1["①:2ターンの間「軽業」状態と<br/>「威圧」(条件成立時は「聖域」)<br/>状態にする"]:::effect
    e1 --> lc{"①の対象<br/>(自身含む3名)<br/>すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| a3["③実行:<br/>ライバル4名に670%のアピール"]:::action
    a3 --> e4["自身のHPを③で行った<br/>合計アピールの40%分回復"]:::effect
    e4 --> finish(("終了")):::startend
