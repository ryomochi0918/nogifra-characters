flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル6名に自身のサンクスの<br/>4倍を固定値として上乗せした770%の<br/>アピールを行う"]:::action
    a1 --> c3{"③:②の効果対象がバフ・アゲ効果状態か<br/>(②の各効果前)"}:::cond
    c3 -->|"Yes"| e3["②で行うデバフ・サゲ効果の解除数が<br/>1つ増加し、②の回復倍率が2倍になる"]:::effect
    c3 -->|"No"| e2["②:残りHP割合が最も低い味方2名の<br/>デバフ・サゲ効果を1つ解除し、<br/>HPを①で行った合計アピールの<br/>30%分回復する"]:::effect
    e3 --> e2
    e2 --> lc2{"②の効果<br/>対象2名すべて完了?"}:::cond
    lc2 -->|"Yes"| a4["④実行:残りHP割合が最も<br/>高いライバル1名に①で<br/>行った合計アピール30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc2 -->|"No、次の対象へ"| c3
    a4 --> finish(("終了")):::startend
