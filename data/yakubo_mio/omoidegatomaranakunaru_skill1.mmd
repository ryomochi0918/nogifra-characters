flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身のデバフ耐性貫通を+30%する"]:::effect --> c3
    c3{"③:このスキルが発動する前の味方チームの<br/>フロント人数が3名以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>ライバル6名を100%の確率で2ターンの間<br/>「フィジカルダウン」と「メンタルダウン」状態にし、<br/>550〜1900%のアピールを行う<br/>(このスキルが発動する前のライバルチームの<br/>フロント人数が少ないほど倍率が増加する)"]:::action
    a2 --> c4
    c4{"④:このスキルが発動する前の味方チームの<br/>フロント人数が4名以上か"}:::cond
    c4 -->|"Yes"| e4["②のアピール対象を100%の確率で<br/>2ターンの間「アピールカダウン」状態にする"]:::effect --> lc
    c4 -->|"No"| lc
    lc{"②のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c3
    lc -->|"Yes"| finish(("終了")):::startend
