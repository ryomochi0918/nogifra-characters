flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:味方チームのフロント人数が4名以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率と<br/>固定値の上限値が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:①のアピール対象がデバフ・サゲ効果状態か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる<br/>(③の倍率上限12000%、②と同時発生時は24000%)"]:::effect --> e4
    c3 -->|"No"| e4
    e4["④:①の各アピール中のみ自身の命中率を<br/>「対象が受けているデバフ・サゲ効果状態の<br/>種類数×10%」分増加する(増加上限40%まで)"]:::effect --> a1
    a1["①実行:<br/>ライバルへ、アピール対象のHP減少分の5%を<br/>固定値として上乗せした750%のアピールを行う<br/>(固定値の上乗せは自身の最大アピールの400%まで)"]:::action --> lc
    lc{"①のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| finish(("終了")):::startend
