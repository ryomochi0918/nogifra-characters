flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方チームのフロント人数が<br/>4名以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率と<br/>固定値の上限値が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:デバフ・サゲ効果のライバルを<br/>対象にしたか<br/>(度に積算)<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる(③の<br/>効果によるアピール倍率の最大は<br/>12000%、②の効果が同時に発生した<br/>場合の最大は24000%)"]:::effect
    c3 -->|"No"| e4["④:①の各アピール中のみ自身の<br/>命中率を「対象が受けている<br/>デバフ・サゲ効果状態の<br/>種類数×10%」分増加する(命中率の<br/>増加上限は40%まで)<br/>(①の各アピール前)"]:::effect
    e3 --> e4
    e4 --> a1["①実行:ライバルに4回、<br/>アピール対象のHP減少分の5%を<br/>固定値として上乗せした750%の<br/>アピールを行う(固定値の上乗せは<br/>自身の最大アピールの400%まで)"]:::action
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
