flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+25%する"]:::effect
    e1 --> c3{"③:②のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①によるリフレクト耐性の増加倍率が<br/>2倍になり、②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:②のアピール対象が特殊状態か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect
    c4 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルに6回、自身の最大アピールの<br/>55%を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:このスキルでライバルが<br/>リタイアしたか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes(再実行は最大1回まで)"| c3
    c5 -->|"No"| finish(("終了")):::startend
