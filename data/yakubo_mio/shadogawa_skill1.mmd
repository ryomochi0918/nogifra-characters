flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピールで特殊状態の<br/>ライバルを対象にしたか<br/>(度に積算)<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| c3{"③:①のアピール対象が<br/>特殊状態ではないか<br/>(②の効果前)"}:::cond
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに6回、バフ・アゲ効果を<br/>1つ解除し、自身のエフォートの<br/>1.5倍を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    c3 -->|"Yes"| e3["②の効果によるアピール倍率と<br/>固定値倍率の倍率増加は<br/>リセットされる"]:::effect
    c3 -->|"No"| e2["①のアピール倍率と固定値倍率が<br/>2倍になる(②の効果による<br/>アピール倍率の最大は12800%、<br/>固定値倍率の最大は48倍まで)"]:::effect
    e3 --> e2
    e2 --> a1
    a1 --> e4["④:自身のHPを①で行った直前の<br/>アピールの100%分回復する<br/>(①の各アピール後)"]:::effect
    e4 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
