flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:残りHP割合が最も低い味方4名の<br/>デバフ・サゲ効果を全て解除し、<br/>3ターンの間「堅忍」状態にする"]:::effect
    e1 --> c3{"③:②の効果対象の<br/>残りHP割合が50%未満か<br/>(②の各効果前)"}:::cond
    c3 -->|"Yes"| e3["②の効果対象のHPを自身の<br/>アピール力の100%分回復する<br/>(会心率に応じて会心回復が発生する)"]:::effect
    c3 -->|"No"| e2["②:最大アピールが最も高い味方2名を<br/>2ターンの間「集中」状態にする"]:::effect
    e3 --> e2
    e2 --> lc2{"②の効果<br/>対象2名すべて完了?"}:::cond
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の対象へ"| c3
