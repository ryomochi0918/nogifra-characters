flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:ライバルチームの<br/>フロント人数が3名以上か"}:::cond
    c2 -->|"Yes"| e2["①の会心率の増加倍率が50%になる"]:::effect
    c2 -->|"No"| e1["①:このスキル中、自身の<br/>会心率を+20%する"]:::effect
    e2 --> e1
    e1 --> a3["③実行:残りHP割合が最も高い<br/>ライバルに6回、自身のサンクスの<br/>3倍を固定値として上乗せした600%の<br/>アピールを行う"]:::action
    a3 --> c4{"④:③のアピールで会心アピールが<br/>3回以上発生したか<br/>(③の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["自身を3ターンの間「抱擁」<br/>状態にする"]:::effect
    c4 -->|"No"| lc3{"③のアピール<br/>6回すべて完了?"}:::cond
    e4 --> lc3
    lc3 -->|"Yes"| c5{"⑤:③のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc3 -->|"No、次の回へ"| a3
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバル1名に③のアピールで<br/>行った合計アピールの20%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
