flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:ライバルチームのフロント人数が3名以上か"}:::cond
    c2 -->|"Yes"| e2["①の会心率の増加倍率が50%になる"]:::effect --> e1
    c2 -->|"No"| e1
    e1["①:このスキル中、自身の会心率を+20%する"]:::effect --> a3
    a3["③実行:<br/>残りHP割合が最も高いライバルに、<br/>自身のサンクスの3倍を固定値として<br/>上乗せした600%のアピールを行う"]:::action --> c4
    c4{"④:③のアピールで会心アピールが<br/>3回以上発生したか"}:::cond
    c4 -->|"Yes"| e4["自身を3ターンの間「抱擁」状態にする"]:::effect --> lc
    c4 -->|"No"| lc
    lc{"③のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| a3
    lc -->|"Yes"| c5
    c5{"⑤:③のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c5 -->|"Yes"| a5["残りHP割合が最も低いライバル1名に<br/>③のアピールで行った合計アピールの<br/>20%分のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
