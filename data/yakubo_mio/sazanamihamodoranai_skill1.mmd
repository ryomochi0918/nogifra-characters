flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②/③:①のアピール対象の残りHP割合が<br/>50%以上か(対象ごとに判定)"}:::cond
    c2 -->|"Yes(②)"| e2["①のアピール倍率と固定値倍率が2倍になる"]:::effect --> a1
    c2 -->|"No(③)"| e3["①のアピールは必ず会心アピールになる"]:::effect --> a1
    a1["①実行:<br/>ライバル6名へ、自身の最大アピールの40%を<br/>固定値として上乗せした460%のアピールを行う"]:::action --> lc
    lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| a4["④実行:<br/>残りHP割合が最も高いライバルに、<br/>①で行った合計アピールの50%分のアピールを行う<br/>(ディフェンス、フィジカルを無視し、<br/>ライバルがリタイアするまで対象を変更せず、<br/>リタイア回復が発生した場合も対象を変更しない)"]:::action --> lc4
    lc4{"④のアピール<br/>2回すべて完了?"}:::cond
    lc4 -->|"No、次の回へ"| a4
    lc4 -->|"Yes"| finish(("終了")):::startend
