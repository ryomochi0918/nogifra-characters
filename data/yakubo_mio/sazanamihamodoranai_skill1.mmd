flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②/③:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["②:①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| e3["③:①のアピールは<br/>必ず会心アピールになる"]:::effect
    e2 --> a1["①実行:ライバル6名に<br/>自身の最大アピールの40%を<br/>固定値として上乗せした460%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| a4["④実行:残りHP割合が最も高い<br/>ライバルに2回、①で行った<br/>合計アピールの50%分のアピールを<br/>行う(ディフェンス、フィジカルを<br/>無視し、このアピールはライバルが<br/>リタイアするまで対象を変更せず、<br/>リタイア回復が発生した場合も<br/>対象を変更しない)"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a4 --> finish(("終了")):::startend
