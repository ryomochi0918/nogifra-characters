flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c4a{"④:自身のエフォートが①のアピール対象の<br/>エフォート以上か<br/>(①の各アピール前)"}:::cond
    c4a -->|"Yes"| e4a["①のアピール時のみ自身の<br/>会心率を+40%する"]:::effect
    c4a -->|"No"| a1["①実行:ライバルに2回、1800%の<br/>アピールを行う"]:::action
    e4a --> a1
    a1 --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以下か<br/>(①の各アピール後)"}:::cond
    c2 -->|"Yes"| c4b{"④:自身のエフォートが②のアピール対象の<br/>エフォート以上か<br/>(②の各アピール前)"}:::cond
    c2 -->|"No"| c3{"③:①か②のアピールで<br/>ライバルがリタイアしたか<br/>(①の各アピール後)"}:::cond
    c4b -->|"Yes"| e4b["②のアピール時のみ自身の<br/>会心率を+40%する"]:::effect
    c4b -->|"No"| a2["②実行:①の対象に180%のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action
    e4b --> a2
    a2 --> c3
    c3 -->|"Yes"| c4c{"④:自身のエフォートが③のアピール対象の<br/>エフォート以上か<br/>(③の各アピール前)"}:::cond
    c3 -->|"No"| lc1{"①のアピール<br/>2回すべて完了?"}:::cond
    c4c -->|"Yes"| e4c["③のアピール時のみ自身の<br/>会心率を+40%する"]:::effect
    c4c -->|"No"| a3["③実行:ライバル1名に180%のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action
    e4c --> a3
    a3 --> lc1
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c4a
