flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c4a
    c4a{"④:自身のエフォートが①のアピール対象の<br/>エフォート以上か"}:::cond
    c4a -->|"Yes"| e4a["①のアピール時のみ自身の会心率を+40%する"]:::effect --> a1
    c4a -->|"No"| a1
    a1["①実行:<br/>ライバルに1800%のアピールを行う"]:::action --> c2
    c2{"②:①のアピール対象の残りHP割合が50%以下か"}:::cond
    c2 -->|"No"| c3
    c2 -->|"Yes"| c4b
    c4b{"④:自身のエフォートが②のアピール対象の<br/>エフォート以上か"}:::cond
    c4b -->|"Yes"| e4b["②のアピール時のみ自身の会心率を+40%する"]:::effect --> a2
    c4b -->|"No"| a2
    a2["②実行:<br/>①の対象に180%のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action --> c3
    c3{"③:①か②のアピールでライバルがリタイアしたか"}:::cond
    c3 -->|"No"| lc
    c3 -->|"Yes"| c4c
    c4c{"④:自身のエフォートが③のアピール対象の<br/>エフォート以上か"}:::cond
    c4c -->|"Yes"| e4c["③のアピール時のみ自身の会心率を+40%する"]:::effect --> a3
    c4c -->|"No"| a3
    a3["③実行:<br/>ライバル1名に180%のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action --> lc
    lc{"①のアピール<br/>2回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c4a
    lc -->|"Yes"| finish(("終了")):::startend
