flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の命中率を+30%する"]:::effect --> c3
    c3{"③:②のアピール対象がデバフ・サゲ効果状態か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>ライバル4名へ、自身の最大アピールの30%分を<br/>固定値として上乗せした950%のアピールを行う"]:::action
    a2 --> lc{"②のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c3
    lc -->|"Yes"| e4["このアピール中のみ自身の会心率を+30%する"]:::effect --> a4
    a4["④実行:<br/>ライバル1名にこのスキルで行った合計アピールの<br/>30%分のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action --> c5
    c5{"⑤:このスキルでデバフ・サゲ効果状態の<br/>ライバルに2回以上アピールを行ったか<br/>(かつ再実行がまだの場合)"}:::cond
    c5 -->|"Yes(再実行は最大1回まで)"| e4
    c5 -->|"No"| finish(("終了")):::startend
