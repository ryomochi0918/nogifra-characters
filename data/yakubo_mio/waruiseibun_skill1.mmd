flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身と自身以外の味方3名を<br/>3ターンの間「勇気」状態にする"]:::effect --> a2
    a2["②実行:<br/>ライバル4名のバフ・アゲ効果を<br/>2つ解除する"]:::action --> c4
    c4{"④:③のアピール対象がバフ・アゲ効果状態<br/>ではないか(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率が2倍になる"]:::effect --> a3
    c4 -->|"No"| a3
    a3["③実行:<br/>②と同じ対象に600%のアピールを行う"]:::action --> lc
    lc{"③のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c4
    lc -->|"Yes"| a5["⑤実行:<br/>ライバルに、自身のスマイルの2.5倍を<br/>固定値として上乗せした400%のアピールを行う"]:::action --> lc5
    lc5{"⑤のアピール<br/>3回すべて完了?"}:::cond
    lc5 -->|"No、次の回へ"| a5
    lc5 -->|"Yes"| finish(("終了")):::startend
