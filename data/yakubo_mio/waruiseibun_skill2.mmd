flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:<br/>ライバル6名へ、自身の残りSPの60倍を<br/>上乗せした730%のアピールを行う"]:::action --> lc
    lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| a1
    lc -->|"Yes"| c2
    c2{"②:①のアピールでリタイアしたライバルが<br/>2名以下か(かつ再実行がまだの場合)"}:::cond
    c2 -->|"Yes(再実行は最大1回まで)"| a1
    c2 -->|"No"| e4
    e4["④:このスキルでライバルをリタイアさせた回数を<br/>人数として、③の効果対象が増加する<br/>(増加上限は最大4名まで)"]:::effect --> a3
    a3["③実行:<br/>残りHP割合が最も低い味方2名を<br/>3ターンの間「勇気」状態にし、<br/>デバフ・サゲ効果を全て解除し、<br/>HPを自身のアピール力の50%分回復する<br/>(会心率に応じて会心回復が発生する)"]:::action --> finish(("終了")):::startend
