flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル6名に自身の<br/>残りSPの60倍を上乗せした730%の<br/>アピールを行う"]:::action
    a1 --> c2{"②:①のアピールでリタイアした<br/>ライバルが2名以下か"}:::cond
    c2 -->|"Yes(再実行は最大1回まで)"| a1
    c2 -->|"No"| e4["④:このスキルでライバルを<br/>リタイアさせた回数を人数として、<br/>③の効果対象が増加する(効果対象の<br/>増加上限は最大4名まで)"]:::effect
    e4 --> e3["③:残りHP割合が最も低い味方2名を<br/>3ターンの間「勇気」状態にし、<br/>デバフ・サゲ効果を全て解除し、HPを<br/>自身のアピール力の50%分回復する<br/>(会心率に応じて会心回復が発生する)"]:::effect
    e3 --> finish(("終了")):::startend
