flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバル5名に自身の最大アピールの<br/>30%を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc2 -->|"Yes"| c4{"④:ライバルチームの<br/>フロント人数が3名未満か"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c4 -->|"Yes"| c5{"⑤:②のアピールでライバルが<br/>リタイアしたか"}:::cond
    c4 -->|"No"| e6["⑥:自身のHPをこのスキルで行った<br/>合計アピールの40%分回復する"]:::effect
    c5 -->|"Yes"| e5["④のアピール中のみ、自身の<br/>会心率を+50%する"]:::effect
    c5 -->|"No"| a4["④実行:残りHP割合が最も低い<br/>ライバルに2回、自身の最大アピールの<br/>60%を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e5 --> a4
    a4 --> e6
    e6 --> finish(("終了")):::startend
