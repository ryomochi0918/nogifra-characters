flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、リフレクト耐性を+30%する"]:::effect --> c3
    c3{"③:自身のサンクスが②のアピール対象の<br/>サンクス以上か(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>残りHP割合が最も低いライバル5名に<br/>自身の最大アピールの30%を固定値として<br/>上乗せした400%のアピールを行う"]:::action
    a2 --> lc{"②のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c3
    lc -->|"Yes"| c4
    c4{"④:ライバルチームのフロント人数が3名未満か"}:::cond
    c4 -->|"No"| a6
    c4 -->|"Yes"| c5
    c5{"⑤:②のアピールでライバルがリタイアしたか"}:::cond
    c5 -->|"Yes"| e5["④のアピール中のみ、自身の会心率を+50%する"]:::effect --> a4
    c5 -->|"No"| a4
    a4["④実行:<br/>残りHP割合が最も低いライバルに、<br/>自身の最大アピールの60%を固定値として<br/>上乗せした800%のアピールを行う"]:::action --> lc4
    lc4{"④のアピール<br/>2回すべて完了?"}:::cond
    lc4 -->|"No、次の回へ"| a4
    lc4 -->|"Yes"| a6
    a6["⑥:自身のHPをこのスキルで行った<br/>合計アピールの40%分回復する"]:::effect --> finish(("終了")):::startend
