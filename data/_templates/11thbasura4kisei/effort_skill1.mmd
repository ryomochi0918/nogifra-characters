flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["このアピール中のみ自身の<br/>デバフ耐性貫通を+50%し、①の<br/>アピール倍率を2倍にする"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに6回、100%の確率で<br/>2ターンの間「ディフェンスダウン」<br/>状態にし、420%のアピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:①のアピール対象の<br/>残りHP割合が50%未満か<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["自身を2ターンの間「集中」<br/>状態にし、自身のHPを①で行った<br/>直前のアピールの50%分回復する"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
