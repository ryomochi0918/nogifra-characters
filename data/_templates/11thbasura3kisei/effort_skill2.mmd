flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:残りHP割合が最も低い<br/>ライバルに4回、自身の残りHP14%分を<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    a1 --> c2{"②/③:自身の残りHP割合が50%未満か<br/>(①の各アピール後)"}:::cond
    c2 -->|"Yes"| e2["②:自身のHPを①で行った直前の<br/>アピールの40%分回復する"]:::effect
    c2 -->|"No"| e3["③:自身以外の残りHP割合が最も<br/>低い味方1名のHPを①で行った直前の<br/>アピールの40%分回復する"]:::effect
    e2 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしたか"}:::cond
    lc1 -->|"No、次の回へ"| a1
    c4 -->|"Yes(再実行は最大1回まで)"| a1
    c4 -->|"No"| finish(("終了")):::startend
