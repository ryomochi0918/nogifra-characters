flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の各アピール前、<br/>味方フロントの「軽快」状態の<br/>合計ターン数が5ターン以上か"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ<br/>自身の命中率を+30%する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>残りHP割合が最も低いライバルへ、<br/>味方フロントの「軽快」状態のターン数×200%の<br/>倍率を上乗せした400%のアピール"]:::action
    a1 --> lc{"①のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c3{"③:①のアピールが全て終了後、<br/>味方フロントの「軽快」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    c3 -->|"No"| finish(("終了")):::startend
    c3 -->|"Yes"| a3["③実行:<br/>残りHP割合が最も高いライバル1名へ、<br/>①で行った合計アピールの20%分のアピール<br/>(ディフェンス、フィジカルを無視し必ず命中する)"]:::action
    a3 --> c4{"④:③のアピール後、<br/>③のアピールでライバルが<br/>リタイアしたか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| a3
    c4 -->|"No"| finish
