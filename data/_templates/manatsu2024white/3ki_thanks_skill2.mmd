flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③:自身のサンクスが①の<br/>各アピール対象のサンクス以上か<br/>(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①の各アピール倍率が2倍になり、<br/>①の各アピール中のみ自身の<br/>命中率を+30%する"]:::effect
    c3 -->|"No"| c4{"④:①の各アピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["①の各アピール倍率が2倍になり、<br/>①の各アピール中のみ自身の<br/>会心率を+30%する"]:::effect
    c4 -->|"No"| a1["①実行:ライバル4名に600%の<br/>アピールを行う"]:::action
    e4 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c3_2{"③:自身のサンクスが②の<br/>各アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    lc1 -->|"No、次の対象へ"| c3
    c3_2 -->|"Yes"| e3_2["②の各アピール倍率が2倍になり、<br/>②の各アピール中のみ自身の<br/>命中率を+30%する"]:::effect
    c3_2 -->|"No"| c4_2{"④:②の各アピール対象が<br/>デバフ・サゲ効果状態か<br/>(②の各アピール前)"}:::cond
    e3_2 --> c4_2
    c4_2 -->|"Yes"| e4_2["②の各アピール倍率が2倍になり、<br/>②の各アピール中のみ自身の<br/>会心率を+30%する"]:::effect
    c4_2 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに4回、600%のアピールを行う"]:::action
    e4_2 --> a2
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"Yes"| a5["⑤実行:残りHP割合が最も高い<br/>ライバル1名にこのスキルで行った<br/>合計アピールの20%分のアピールを<br/>行う(ディフェンス、フィジカルを<br/>無視し必ず命中する)"]:::action
    lc2 -->|"No、次の回へ"| c3_2
    a5 --> finish(("終了")):::startend
