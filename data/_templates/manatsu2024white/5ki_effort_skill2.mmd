flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のバイタリティが①の<br/>アピール対象のバイタリティ以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象の<br/>バフ・アゲ効果を1つ解除する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>残りHP割合が最も低いライバル3名に、<br/>自身の残りHPの20%分を固定値として<br/>上乗せした700%のアピールを行う"]:::action
    a1 --> lc{"①のアピール<br/>(3名×2回)すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| a3["③実行:<br/>自身と自身以外の残りHP割合が最も低い<br/>味方1名のデバフ・サゲ効果を2つ解除し、<br/>HPをこのスキルで行った合計アピールの<br/>20%分回復する"]:::action
    a3 --> c4{"④:自身の残りHP割合が<br/>50%以上か"}:::cond
    c4 -->|"Yes"| e4["自身を4ターンの間「反響」状態にする<br/>※反響:リフレクトを+70%し、<br/>受けるアピールが40%減少する"]:::effect --> finish(("終了")):::startend
    c4 -->|"No"| finish
