flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバル4名へ、自身の最大アピールの30%を<br/>固定値として上乗せした450%のアピール<br/>(2回目以降は対象を選び直す)"]:::action
    a1 --> c3{"③:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["対象を100%の確率で2ターンの間<br/>「命中率ダウン」状態にする"]:::effect --> lc
    c3 -->|"No"| lc{"①のアピール<br/>2回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| e4["④:自身と自身以外の残りHP割合が<br/>最も低い味方1名のHPを①で行った<br/>合計アピールの30%分回復し、<br/>3ターンの間「回避率アップ」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
