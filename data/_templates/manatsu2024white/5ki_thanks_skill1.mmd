flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率とリフレクト耐性を+30%する"]:::effect
    e1 --> a2["②実行:<br/>ライバルへ5回、自身のサンクスの4倍を<br/>固定値として上乗せした420%のアピール"]:::action
    a2 --> c4{"④:②のアピールで会心アピールが<br/>2回以上発生したか"}:::cond
    c4 -->|"Yes"| e4["③の効果対象が2名増加する"]:::effect --> c5
    c4 -->|"No"| c5{"⑤:③の効果対象が既に<br/>「舞踏」状態か(対象ごとに判定)"}:::cond
    c5 -->|"Yes"| e5["対象のHPを②で行った<br/>合計アピールの50%分回復する"]:::effect --> e3
    c5 -->|"No"| e3["③:対象を3ターンの間「舞踏」状態にする<br/>(「舞踏」状態ではない味方を優先的に選択)"]:::effect
    e3 --> lc{"③の効果対象<br/>すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c5
    lc -->|"Yes"| finish(("終了")):::startend
