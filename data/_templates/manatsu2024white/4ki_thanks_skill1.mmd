flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| c3{"③:②の効果対象が<br/>既に「弱音」状態か"}:::cond
    c3 -->|"Yes"| e3["②による「弱音」状態を<br/>「緊張」状態に変更する"]:::effect --> a1
    c3 -->|"No"| e2["①のアピール対象を<br/>100%の確率で2ターンの間<br/>「弱音」状態にする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>フィジカルが最も高いライバルに<br/>600%のアピール<br/>(対象ごとに判定)"]:::action
    a1 --> lc{"①の対象<br/>5名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| finish(("終了")):::startend
