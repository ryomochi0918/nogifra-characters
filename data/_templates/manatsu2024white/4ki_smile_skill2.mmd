flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身が「軽業」状態<br/>または「聖域」状態か"}:::cond
    c2 -->|"Yes"| c3{"③:自身が「軽業」状態<br/>かつ「聖域」状態か"}:::cond
    c3 -->|"Yes"| e3["②の固定値倍率が2倍に"]:::effect --> e2
    c3 -->|"No"| e2["①のアピールに、自身が受けている<br/>バフ・アゲ効果・特殊状態の種類数×<br/>自身の残りHPの8%を<br/>固定値として上乗せする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>最大アピールが最も高いライバルに、<br/>640%のアピール"]:::action
    a1 --> e4["自身のHPを①で行った<br/>直前のアピールの50%分回復"]:::effect
    e4 --> lc{"①のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| finish(("終了")):::startend
