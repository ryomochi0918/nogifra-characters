flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル4名に2回、<br/>自身のエフォートの4倍を<br/>固定値として上乗せした390%の<br/>アピールを行う(2回目以降の<br/>アピールは対象を選び直す)"]:::action
    a1 --> c2{"②:ライバルチームの<br/>フロント人数が2名以下か"}:::cond
    c2 -->|"Yes"| a2["②実行:ライバルに2回、<br/>自身のエフォートの4倍を<br/>固定値として上乗せした390%の<br/>アピールを行う"]:::action
    c2 -->|"No"| c4{"④:ライバルチームのフロントに<br/>メンバーが居ないか"}:::cond
    a2 --> c4
    c4 -->|"Yes"| e4["③による「声援」状態の受ける<br/>アピールの低下倍率が1.5倍になる"]:::effect
    c4 -->|"No"| e3["③:自身のHPを自身のアピール力の<br/>80%分回復し(会心率に<br/>応じて会心回復が発生)、2ターンの<br/>間「声援」状態にする"]:::effect
    e4 --> e3
    e3 --> finish(("終了")):::startend
