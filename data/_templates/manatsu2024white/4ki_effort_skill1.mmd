flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:<br/>ライバルへ、自身のエフォートの4倍を<br/>固定値として上乗せした390%のアピール<br/>(対象は4名から選択、<br/>2回目以降は対象を選び直す)"]:::action
    a1 --> lc1{"①のアピール<br/>2回すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| a1
    lc1 -->|"Yes"| c2{"②:ライバルチームの<br/>フロント人数が2名以下か"}:::cond
    c2 -->|"Yes"| a2["②実行:<br/>ライバルへ、自身のエフォートの4倍を<br/>固定値として上乗せした390%のアピール"]:::action
    a2 --> lc2{"②のアピール<br/>2回すべて完了?"}:::cond
    lc2 -->|"No、次の回へ"| a2
    lc2 -->|"Yes"| c4{"④:③の効果前、<br/>ライバルチームのフロントに<br/>メンバーが居ないか"}:::cond
    c2 -->|"No"| c4
    c4 -->|"Yes"| e4["③による「声援」状態の<br/>受けるアピールの低下倍率が1.5倍に"]:::effect --> a3
    c4 -->|"No"| a3["③実行:<br/>自身のHPを自身のアピール力の80%分回復し<br/>(会心率に応じて会心回復が発生)、<br/>2ターンの間「声援」状態にする"]:::action
    a3 --> finish(("終了")):::startend
