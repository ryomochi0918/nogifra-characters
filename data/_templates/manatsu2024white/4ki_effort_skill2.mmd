flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに3回、自身のエフォートの<br/>3倍を固定値として上乗せした700%の<br/>アピールを行う(このアピールは<br/>ライバルがリタイアするまで対象を<br/>変更せず、リタイア回復が発生した<br/>場合も対象を変更しない)"]:::action
    e2 --> a1
    a1 --> c3{"③:①のアピール対象の<br/>残りHP割合が30%未満か<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| a3["③実行:①のアピール対象に<br/>自身のエフォート7倍分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c3 -->|"No"| lc1{"①のアピール<br/>3回すべて完了?"}:::cond
    a3 --> lc1
    lc1 -->|"Yes"| a4["④実行:ライバル1名にこのスキルで<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc1 -->|"No、次の回へ"| c2
    a4 --> finish(("終了")):::startend
