flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のリフレクトが①のアピール対象の<br/>リフレクト以上か"}:::cond
    c2 -->|"Yes"| e2["①の固定値倍率が2倍に"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身の残りHP割合が<br/>アピール対象の残りHP割合以上か"}:::cond
    c3 -->|"Yes"| e3["アピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>最大アピールが最も高いライバルに、<br/>自身のバイタリティの6倍を固定値として上乗せした<br/>680%のアピールを行う<br/>(このアピールはライバルがリタイアするまで対象を変更せず、<br/>リタイア回復が発生した場合も対象を変更しない)"]:::action
    a1 --> e4["自身のHPを①で行った<br/>直前のアピールの30%分回復する"]:::effect
    e4 --> lc{"①のアピール<br/>3回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| finish(("終了")):::startend
