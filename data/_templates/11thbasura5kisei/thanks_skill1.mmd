flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに4回、<br/>自身のサンクスの2.5倍を<br/>固定値として上乗せした460%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:自身の残りHP割合が50%未満か<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["自身を2ターンの間「神気」状態にし、<br/>HPを①で行った直前のアピールの<br/>50%分回復する"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
