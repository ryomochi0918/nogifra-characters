flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象の残りHP割合が<br/>50%以上か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①による「堅忍」状態の<br/>効果倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:①の効果対象の残りHP割合が<br/>50%未満か(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①による回復倍率が2倍になる"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>対象を3ターンの間「堅忍」状態にし、<br/>HPを自身のアピール力の50%分回復する<br/>(会心率に応じて会心回復が発生)"]:::action
    a1 --> lc{"①の対象<br/>3名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| a4["④実行:<br/>残りHP割合が最も高いライバル2名を<br/>100%の確率で3ターンの間「混乱」状態にし、<br/>1500%のアピールを行う"]:::action
    a4 --> finish(("終了")):::startend
