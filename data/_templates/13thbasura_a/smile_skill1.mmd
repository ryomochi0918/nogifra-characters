flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象が<br/>デバフ・サゲ効果状態ではないか<br/>(①の効果前)"}:::cond
    c2 -->|"Yes"| e2["①による状態効果の<br/>効果倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:自身と自身以外の最大アピールが<br/>最も高い味方1名を2ターンの<br/>間「アピールブースト(努力)」<br/>と「アピールブースト(感謝)」<br/>状態にする"]:::effect
    e2 --> e1
    e1 --> lc1{"①の効果<br/>対象2名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:自身のスマイルが③の<br/>アピール対象のスマイル以上か<br/>(③の各アピール前)"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["③のアピールに自身のSP上限の<br/>200倍を固定値として上乗せする"]:::effect
    c4 -->|"No"| a3["③実行:ライバル4名のバフ・アゲ効果を<br/>1つ解除し、950%のアピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の対象へ"| c4
