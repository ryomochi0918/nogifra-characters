flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+40%する"]:::effect
    e1 --> c3{"③:自身の「根性」状態のターン数が<br/>9ターン以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が3倍になる"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルに5回、自身のバイタリティを<br/>固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールで会心アピールが<br/>発生したか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["②のアピール回数を1回増加する<br/>(アピールの追加回数は最大で3回まで)"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>5回(+④の追加分)すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
