flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが<br/>対象のサンクス以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルへ、自身のサンクスの3倍を<br/>固定値として上乗せした550%のアピール"]:::action
    a1 --> a3["③実行:自身のHPを<br/>直前のアピールの20%分回復"]:::action --> loop1{"4回すべて完了?"}:::cond
    loop1 -->|"No、次の回へ"| c2
    loop1 -->|"Yes"| c4{"④:特殊状態の味方が<br/>フロントに3名以上か"}:::cond
    c4 -->|"Yes"| a4["④実行:再度①を実行<br/>(再実行は最大1回まで)"]:::action --> a5
    c4 -->|"No"| a5["⑤実行:残りHP割合が最も高い<br/>ライバルへ1回、①(④)で行った<br/>合計アピールの30%分のアピール<br/>(ディフェンス、フィジカルを無視)"]:::action --> finish(("終了")):::startend
