flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のバイタリティが<br/>アピール対象のバイタリティ以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル3名に2回、自身の残りHPの<br/>20%分を固定値として上乗せした700%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc1 -->|"Yes"| lc1n{"①のアピール<br/>2回すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1n -->|"Yes"| e3["③:自身と自身以外の残りHP割合が<br/>最も低い味方1名のデバフ・サゲ効果を<br/>2つ解除し、HPをこのスキルで行った<br/>合計アピールの20%分回復する"]:::effect
    lc1n -->|"No、次の回へ"| c2
    e3 --> c4{"④:自身の残りHP割合が50%以上か"}:::cond
    c4 -->|"Yes"| e4["自身を4ターンの間「反響」<br/>状態にする"]:::effect
    c4 -->|"No"| finish(("終了")):::startend
    e4 --> finish
