flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:デバフ・サゲ効果状態のライバルが<br/>フロントに3名以上居る、または<br/>このスキルの効果前に発動した自身のスキル1<br/>「おがワンダフル」の「アピール力アップ」状態の<br/>効果倍率が増加しているか"}:::cond
    c2 -->|"Yes"| e2["①の増加倍率が3倍になる"]:::effect
    c2 -->|"No"| e1["①:このスキル中、自身の<br/>命中率を+15%する"]:::effect
    e2 --> e1
    e1 --> a3["③実行:ライバル5名に400%の<br/>アピールを行う"]:::action
    a3 --> a4["④実行:③のアピールで1以上のアピールを<br/>行った回数×200%をアピール倍率に<br/>上乗せして③を再実行する<br/>(再実行は最大1回まで)"]:::action
    a4 --> a5["⑤実行:ライバル2名に③、④で行った<br/>合計アピールの30%分のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action
    a5 --> finish(("終了")):::startend
