flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:デバフ・サゲ効果のライバルが<br/>フロントに3名以上、または<br/>スキル1「アピールカアップ」の<br/>効果倍率が増加中か"}:::cond
    c2 -->|"Yes"| e2["①の命中率増加倍率が<br/>3倍になる"]:::effect --> e1
    c2 -->|"No"| e1["①効果:このスキル中、自身の<br/>命中率を+15%する"]:::effect --> a3["③実行:ライバル5名へ<br/>400%のアピール"]:::action
    a3 --> a4["④実行:③のアピールで1以上の<br/>アピールを行った回数×200%を<br/>倍率に上乗せして③を再実行<br/>(再実行は最大1回まで)"]:::action
    a4 --> a5["⑤実行:ライバル2名へ、③④で<br/>行った合計アピールの30%分の<br/>アピール(ディフェンス、フィジカルを無視)"]:::action --> finish(("終了")):::startend
