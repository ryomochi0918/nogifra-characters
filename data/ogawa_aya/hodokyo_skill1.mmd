flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが<br/>①の対象のエフォート以上か"}:::cond
    c2 -->|"Yes"| e2["①の倍率と固定値倍率が2倍に"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身が「平静」状態か"}:::cond
    c3 -->|"Yes"| e3["①の対象の<br/>バフ・アゲ効果を2つ解除"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>残りHP割合が最も高いライバルへ<br/>基本590%+固定値 最大アピールの35%"]:::action
    a1 --> lc{"①のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c4{"④:①のアピールで<br/>リタイアした人数が1名以下か"}:::cond
    c4 -->|"Yes"| a4["④実行:<br/>ライバル2名へ<br/>①の合計アピールの60%分のアピール<br/>(Def・Phy無視)"]:::action --> e5
    c4 -->|"No"| e5["⑤:自身を3ターンの間<br/>「威圧」状態にする<br/>(条件を満たさなくても発動)"]:::effect
    e5 --> finish(("終了")):::startend
