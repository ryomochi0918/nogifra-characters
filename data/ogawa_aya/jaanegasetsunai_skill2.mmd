flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが<br/>対象のエフォート以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルへ、自身の最大アピールの35%を<br/>固定値として上乗せした750%のアピール"]:::action --> loop1
    loop1{"2回すべて完了?"}:::cond
    loop1 -->|"No、次の回へ"| c2
    loop1 -->|"Yes"| c3{"③:①のアピールで失敗・0、<br/>またはライバルのリタイアが<br/>発生したか"}:::cond
    c3 -->|"Yes"| a3["③実行:再度①を実行<br/>(再実行は最大1回まで)"]:::action --> a4
    c3 -->|"No"| a4["④実行:残りHP割合が最も低い<br/>ライバル1名のバフ・アゲ効果を全て解除し、<br/>①で行った合計アピールの30%分のアピール<br/>(ディフェンス、フィジカルを無視)"]:::action
    a4 --> a5["⑤実行:自身のHPをHP上限の50%分<br/>回復し、3ターンの間<br/>「堅忍」状態にする"]:::action --> finish(("終了")):::startend
