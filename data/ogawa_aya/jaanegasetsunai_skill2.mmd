flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに2回、自身の最大アピールの<br/>35%を固定値として上乗せした750%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>2回すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:①のアピールで一度でもアピールの<br/>失敗またはアピールが0だった、<br/>またはライバルがリタイアしたか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c3 -->|"Yes(再実行は最大1回まで)"| c2
    c3 -->|"No"| a4["④実行:残りHP割合が最も低い<br/>ライバル1名のバフ・アゲ効果を<br/>全て解除し、①で行った<br/>合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    a4 --> e5["⑤:自身のHPを自身のHP上限の<br/>50%分回復し、3ターンの間「堅忍」<br/>状態にする"]:::effect
    e5 --> finish(("終了")):::startend
