flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+30%する"]:::effect
    e1 --> c3{"③:自身の「光輝」状態の<br/>ターン数が6ターン以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール時のみ自身の<br/>会心率を+40%する"]:::effect
    c3 -->|"No"| c4{"④:自身の「光輝」状態の<br/>ターン数が8ターン以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②の各アピールにアピール対象の<br/>HP減少分の8%を固定値として上乗せする<br/>(固定値の上乗せは自身の<br/>最大アピールの600%まで)"]:::effect
    c4 -->|"No"| a2["②実行:ライバルに4回、自身の最大アピールの<br/>60%を固定値として上乗せした700%の<br/>アピールを行い、アピール対象が「衰弱」状態の<br/>場合、100%の確率で3ターンの間<br/>「心労」状態にする"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"Yes"| c6{"⑥:②のアピールで<br/>会心アピールが発生したか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c6 -->|"Yes"| e6["「②のアピールで発生した会心アピールの<br/>回数×自身のスマイル」を⑤のアピールの<br/>固定値に加算する<br/>(⑥の効果による加算を含めたスマイルの<br/>最大倍率は7倍まで)"]:::effect
    c6 -->|"No"| a5["⑤実行:残りHP割合が最も高い<br/>ライバルに2回、自身のスマイルの3倍を<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e6 --> a5
    a5 --> finish(("終了")):::startend
