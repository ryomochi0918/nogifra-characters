flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>命中率を+30%する"]:::effect --> c3
    c3{"③:自身の「光輝」状態の<br/>ターン数が6ターン以上か"}:::cond
    c3 -->|"Yes"| e3["②の各アピール時のみ<br/>自身の会心率を+40%する"]:::effect --> c4
    c3 -->|"No"| c4
    c4{"④:自身の「光輝」状態の<br/>ターン数が8ターン以上か"}:::cond
    c4 -->|"Yes"| e4["②の各アピールに対象のHP減少分の<br/>8%を固定値として上乗せする<br/>(自身の最大アピールの600%まで)"]:::effect --> a2
    c4 -->|"No"| a2["②実行:ライバルへ4回、自身の<br/>最大アピールの60%を固定値として<br/>上乗せした700%のアピール(対象が<br/>「衰弱」状態なら100%で3ターン<br/>「心労」状態にする)"]:::action --> loop1
    loop1{"4回すべて完了?"}:::cond
    loop1 -->|"No、次の対象へ"| c3
    loop1 -->|"Yes"| c6{"⑥:②のアピールで<br/>会心アピールが発生したか"}:::cond
    c6 -->|"Yes"| e6["「②で発生した会心アピールの<br/>回数×自身のスマイル」を⑤の<br/>固定値に加算(最大7倍まで)"]:::effect --> a5
    c6 -->|"No"| a5["⑤実行:残りHP割合が最も高い<br/>ライバルへ2回、自身のスマイルの3倍を<br/>固定値として上乗せした500%のアピール"]:::action --> finish(("終了")):::startend
