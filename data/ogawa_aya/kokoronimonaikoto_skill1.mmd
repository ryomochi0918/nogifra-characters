flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身が「反響」状態ではないか"}:::cond
    c1 -->|"Yes"| e1["自身を4ターンの間「反響」<br/>状態にする"]:::effect
    c1 -->|"No"| c3{"③:自身のHP上限が②のアピール対象の<br/>HP上限以上か<br/>(②の各アピール前)"}:::cond
    e1 --> c3
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:自身の残りHP割合が70%以下に<br/>1度でもなったか<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["このスキル中、自身の会心率を+30%、<br/>会心アピールを+100%、<br/>リフレクト耐性を+30%する"]:::effect
    c4 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル4名に自身のバイタリティの<br/>2倍を固定値として上乗せした750%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| e5["⑤:自身と自身以外の残りHP割合が<br/>最も低い味方2名のHPを②で行った<br/>合計アピールの20%分回復する"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e5 --> finish(("終了")):::startend
