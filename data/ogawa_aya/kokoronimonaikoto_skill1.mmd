flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身が「反響」状態<br/>ではないか"}:::cond
    c1 -->|"Yes"| e1["自身を4ターンの間<br/>「反響」状態にする"]:::effect --> c4
    c1 -->|"No"| c4
    c4{"④:自身の残りHP割合が<br/>70%以下に1度でもなったか"}:::cond
    c4 -->|"Yes"| e4["このスキル中、自身の会心率を+30%、<br/>会心アピールを+100%、<br/>リフレクト耐性を+30%する"]:::effect --> c3
    c4 -->|"No"| c3
    c3{"③:自身のHP上限が<br/>対象のHP上限以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル4名へ、自身のバイタリティの2倍を<br/>固定値として上乗せした750%のアピール"]:::action --> loop1
    loop1{"4名すべて完了?"}:::cond
    loop1 -->|"No、次の対象へ"| c4
    loop1 -->|"Yes"| a5["⑤実行:自身と自身以外の残りHP割合が<br/>最も低い味方2名のHPを、②で行った<br/>合計アピールの20%分回復"]:::action --> finish(("終了")):::startend
