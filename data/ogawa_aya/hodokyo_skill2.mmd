flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の対象が<br/>バフ・アゲ効果状態ではないか"}:::cond
    c2 -->|"Yes"| e2["①の倍率と固定値倍率が3倍に"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身が「円陣」状態か"}:::cond
    c3 -->|"Yes"| e3["①のアピール回数が1回増加<br/>(追加回数は最大で2回まで)"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>残りHP割合が最も高いライバルへ<br/>基本750%+固定値 最大アピールの25%"]:::action
    a1 --> lc{"①のアピール<br/>4回(+③の追加分)すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c4{"④:①のアピールで自身のエフォートが<br/>①の対象のエフォート以上である事が<br/>3回以上発生したか<br/>(かつ再実行がまだの場合)"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| e4["③によるアピール回数の追加をリセット"]:::effect --> c2
    c4 -->|"No"| c5{"⑤:自身が「平静」状態か"}:::cond
    c5 -->|"Yes"| a5["⑤実行:<br/>残りHP割合が最も低いライバル1名へ<br/>①の合計アピールの40%分のアピール<br/>(Def・Phy無視)"]:::action --> c6
    c5 -->|"No"| finish(("終了")):::startend
    c6{"⑥:自身が「平静」状態か"}:::cond
    c6 -->|"Yes"| e6["残りHP割合が最も低い味方2名のHPを<br/>このスキルの合計アピールの30%分回復"]:::effect --> finish
    c6 -->|"No"| finish
