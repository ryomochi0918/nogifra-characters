flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が3倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身が「円陣」状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール回数が1回増加する<br/>(アピールの追加回数は最大で2回まで)"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに4回、自身の最大アピールの<br/>25%を固定値として上乗せした750%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>4回(+③の追加分)すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールで自身の<br/>エフォートが①のアピール対象の<br/>エフォート以上である事が<br/>3回以上発生したか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes(再実行は最大1回まで、再実行時に<br/>③によるアピール回数の追加は<br/>リセットされる)"| c2
    c4 -->|"No"| c5{"⑤:自身が「平静」状態か"}:::cond
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も<br/>低いライバル1名に①で<br/>行った合計アピールの40%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c5 -->|"No"| c6{"⑥:自身が「平静」状態か"}:::cond
    a5 --> c6
    c6 -->|"Yes"| e6["残りHP割合が最も低い味方2名の<br/>HPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    c6 -->|"No"| finish(("終了")):::startend
    e6 --> finish
