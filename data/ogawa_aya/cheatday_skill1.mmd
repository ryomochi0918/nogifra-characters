flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③:ライバルチームの<br/>フロント人数が5名以上か"}:::cond
    c3 -->|"Yes"| e3["①による「反響」または②による<br/>「残響」状態のリフレクト増加倍率が<br/>1.5倍になる"]:::effect
    c3 -->|"No"| c2{"②:①の効果対象が「反響」状態か<br/>(①の各効果前)"}:::cond
    e3 --> c2
    c2 -->|"Yes"| e2["①による「反響」状態を「残響」<br/>状態に変更する"]:::effect
    c2 -->|"No"| e1["①:自身と自身以外のリフレクトが<br/>最も高い味方1名を4ターンの間<br/>「反響」状態にする"]:::effect
    e2 --> e1
    e1 --> lc1{"①の効果<br/>対象2名すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:味方チームのフロント人数が<br/>5名以上か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c5 -->|"Yes"| e5["④の効果対象が1名増加する"]:::effect
    c5 -->|"No"| e4["④:自身以外の残りHP割合が最も<br/>低い味方3名を3ターンの間「防音」<br/>状態にする"]:::effect
    e5 --> e4
    e4 --> e6["⑥:残りHP割合が最も低い味方の<br/>HPを4回、自身のアピール力の<br/>100%分回復する(会心率に<br/>応じて会心回復が発生)"]:::effect
    e6 --> finish(("終了")):::startend
