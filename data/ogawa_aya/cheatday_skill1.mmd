flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③:ライバルチームの<br/>フロント人数が5名以上か"}:::cond
    c3 -->|"Yes"| e3["①/②による「反響」または<br/>「残響」状態のリフレクト<br/>増加倍率が1.5倍になる"]:::effect --> c2
    c3 -->|"No"| c2{"②:効果対象が既に<br/>「反響」状態か"}:::cond
    c2 -->|"Yes"| e2["①:「反響」状態を「残響」状態に<br/>変更して4ターンの間付与する"]:::effect --> c5
    c2 -->|"No"| e1["①実行:自身と自身以外の<br/>リフレクトが最も高い味方1名を<br/>4ターンの間「反響」状態にする"]:::effect --> c5
    c5{"⑤:味方チームの<br/>フロント人数が5名以上か"}:::cond
    c5 -->|"Yes"| e5["④の効果対象が4名になる"]:::effect --> e4
    c5 -->|"No"| e4["④実行:自身以外の残りHP割合が<br/>最も低い味方3名を3ターンの間<br/>「防音」状態にする"]:::effect --> a6
    a6["⑥実行:残りHP割合が最も低い味方の<br/>HPを4回、自身のアピール力の<br/>100%分回復(会心率に応じて<br/>会心回復が発生)"]:::action --> finish(("終了")):::startend
