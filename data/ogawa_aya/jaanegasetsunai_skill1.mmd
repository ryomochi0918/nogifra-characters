flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>リフレクト耐性を+20%する"]:::effect --> c3
    c3{"③:自身のエフォートが<br/>対象のエフォート以上か"}:::cond
    c3 -->|"Yes"| e3["対象のバフ・アゲ効果を1つ解除し、<br/>自身の最大アピールの30%分を<br/>固定値として上乗せする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル4名へ、自身のエフォートの3倍を<br/>固定値として上乗せした300%のアピール"]:::action --> loop1
    loop1{"4名すべて完了?"}:::cond
    loop1 -->|"No、次の対象へ"| c3
    loop1 -->|"Yes"| c4{"④:自身の残りHP割合が<br/>50%以上か"}:::cond
    c4 -->|"Yes"| a4["④実行:②のアピール倍率と固定値倍率を<br/>2倍にして再度②を実行<br/>(再実行は1回まで)"]:::action --> finish(("終了")):::startend
    c4 -->|"No"| finish
