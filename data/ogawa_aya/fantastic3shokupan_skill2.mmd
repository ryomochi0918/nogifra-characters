flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が「執着」状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象を100%の確率で<br/>1ターンの間「回避率ダウン」<br/>状態にする"]:::effect
    c2 -->|"No"| c4{"④:①のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c4
    c4 -->|"Yes"| e4["①の各アピールが<br/>必ず会心アピールになる"]:::effect
    c4 -->|"No"| a1["①実行:ライバルに4回、アピール対象が<br/>受けているデバフ・サゲ効果状態の<br/>種類数×600%の倍率を上乗せした600%の<br/>アピールを行う"]:::action
    e4 --> a1
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c3 -->|"Yes"| c4_2{"④:③のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か<br/>(③の各アピール前)"}:::cond
    c3 -->|"No"| finish(("終了")):::startend
    c4_2 -->|"Yes"| e4_2["③の各アピールが<br/>必ず会心アピールになる"]:::effect
    c4_2 -->|"No"| a3["③実行:ライバル3名に①で<br/>行った合計アピールの20%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    e4_2 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc3 -->|"Yes"| finish
    lc3 -->|"No、次の対象へ"| c4_2
