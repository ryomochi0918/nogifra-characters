flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>「執着」状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象を100%の確率で<br/>1ターンの間「回避率ダウン」状態にする"]:::effect --> c4a
    c2 -->|"No"| c4a{"④:①と③のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か"}:::cond
    c4a -->|"Yes"| e4a["①のアピールが<br/>必ず会心アピールになる"]:::effect --> a1
    c4a -->|"No"| a1["①実行:ライバルに4回、アピール対象が受けている<br/>デバフ・サゲ効果状態の種類数×600%を<br/>上乗せした600%のアピールを行う"]:::action --> loop1
    loop1{"①のアピール<br/>4回すべて完了?"}:::cond
    loop1 -->|"No、次の回へ"| c2
    loop1 -->|"Yes"| c3{"③:①のアピールで<br/>ライバルがリタイアしなかったか"}:::cond
    c3 -->|"No"| finish(("終了")):::startend
    c3 -->|"Yes"| c4b{"④:①と③のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か<br/>(①と③の各アピール前)"}:::cond
    c4b -->|"Yes"| e4b["③のアピールが<br/>必ず会心アピールになる"]:::effect --> a3
    c4b -->|"No"| a3["③実行:ライバル3名に、①で<br/>行った合計アピールの20%分の<br/>アピールを行う(ディフェンス、メンタルを無視する)"]:::action
    a3 --> lc3{"③のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc3 -->|"No、次の対象へ"| c4b
    lc3 -->|"Yes"| finish
