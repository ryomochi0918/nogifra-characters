flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>サゲ効果耐性貫通を+25%する"]:::effect
    e1 --> c3{"③:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が3倍になる"]:::effect
    c3 -->|"No"| c4{"④:②のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>2種類以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②の各アピールにアピール対象の<br/>残りHPの2%分を固定値として上乗せする"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル4名に100%の確率で<br/>3ターンの間「衰弱」状態にし、<br/>自身のスマイルの3倍を<br/>固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| c6{"⑥:自身の「光輝」状態のターン数が<br/>6ターン以上か<br/>(⑤の各アピール前)"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c6 -->|"Yes"| e6["⑤の固定値倍率が3倍になる"]:::effect
    c6 -->|"No"| a5["⑤実行:ライバルに4回、自身の<br/>スマイルを固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e6 --> a5
    a5 --> lc5{"⑤のアピール<br/>4回すべて完了?"}:::cond
    lc5 -->|"Yes"| finish(("終了")):::startend
    lc5 -->|"No、次の回へ"| c6
