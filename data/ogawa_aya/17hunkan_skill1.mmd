flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:自身の残りHP割合が50%以上か<br/>(②の各効果前)"}:::cond
    c3 -->|"Yes"| e3["②による「アピール力アップ」<br/>状態の効果倍率が1.5倍になる"]:::effect
    c3 -->|"No"| e2["②:自身と自身以外の最大アピールが<br/>最も高い味方1名を2ターンの間<br/>「アピール力アップ」状態にする"]:::effect
    e3 --> e2
    e2 --> lc2{"②の効果<br/>対象2名すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:自身のエフォートが④の<br/>アピール対象のエフォート以上か<br/>(④の各アピール前)"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c5 -->|"Yes"| e5["④のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect
    c5 -->|"No"| a4["④実行:残りHP割合が最も低い<br/>ライバルに4回、最大アピールが<br/>最も高い味方1名の最大アピールの<br/>20%を固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e5 --> a4
    a4 --> lc4{"④のアピール<br/>4回すべて完了?"}:::cond
    lc4 -->|"Yes"| finish(("終了")):::startend
    lc4 -->|"No、次の回へ"| c5
