flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect --> c3{"③:自身の残りHP割合が<br/>50%以上か"}:::cond
    c3 -->|"Yes"| e3["②の「アピールカアップ」状態の<br/>効果倍率が1.5倍になる"]:::effect --> e2
    c3 -->|"No"| e2["②実行:自身と自身以外の最大アピールが<br/>最も高い味方1名を2ターンの間<br/>「アピールカアップ」状態にする"]:::effect --> c5
    c5{"⑤:自身のエフォートが<br/>対象のエフォート以上か"}:::cond
    c5 -->|"Yes"| e5["④のアピール倍率と<br/>固定値倍率が1.5倍になる"]:::effect --> a4
    c5 -->|"No"| a4["④実行:残りHP割合が最も低いライバルへ<br/>味方1名の最大アピールの20%を<br/>固定値として上乗せした500%のアピール"]:::action --> loop1{"4回すべて完了?"}:::cond
    loop1 -->|"No、次の回へ"| c5
    loop1 -->|"Yes"| finish(("終了")):::startend
