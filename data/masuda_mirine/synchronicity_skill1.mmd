flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:<br/>自身を2ターンの間<br/>「全開」状態にする"]:::action
    a1 --> c3{"③:②のアピール対象の<br/>残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>残りHP割合が最も高いライバル4名に<br/>自身の最大アピールの20%を固定値として上乗せした<br/>700%のアピールを行う"]:::action
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2 -->|"Yes"| a4["④実行:<br/>②のアピールが全て終了後、<br/>残りHP割合が最も低いライバル1名に<br/>②で行った合計アピールの25%分のアピールを行う<br/>(ディフェンス、フィジカルを無視し必ず命中する)"]:::action --> finish(("終了")):::startend
