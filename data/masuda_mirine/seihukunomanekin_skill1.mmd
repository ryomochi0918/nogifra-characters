flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率と<br/>サゲ効果耐性貫通を+25%する"]:::effect
    e1 --> c4{"④:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②の各アピール中のみ、<br/>①の会心率とサゲ効果耐性貫通の<br/>増加倍率が40%になる"]:::effect
    c4 -->|"No"| a2["②実行:ライバル3名に600%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc2 -->|"Yes"| c4_2{"④:自身のサンクスが③の<br/>アピール対象のサンクス以上か<br/>(③の各アピール前)"}:::cond
    lc2 -->|"No、次の対象へ"| c4
    c4_2 -->|"Yes"| e4_2["③の各アピール中のみ、<br/>①の会心率とサゲ効果耐性貫通の<br/>増加倍率が40%になる"]:::effect
    c4_2 -->|"No"| a3["③実行:残りHP割合が最も高い<br/>ライバル3名に600%のアピールを行う"]:::action
    e4_2 --> a3
    a3 --> c5{"⑤:②と③のアピールで会心アピールが<br/>発生した回数が1回以上か<br/>(③の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["③のアピール対象を100%の<br/>確率で2ターンの間、<br/>サゲ効果状態にする(転倒)"]:::effect
    c5 -->|"No"| lc3{"③のアピール<br/>ライバル3名すべて完了?"}:::cond
    e5 --> c5b{"⑤:②と③のアピールで会心アピールが<br/>発生した回数が2回以上か<br/>(③の各アピール後)"}:::cond
    c5b -->|"Yes"| e5b["③のアピール対象を100%の<br/>確率で2ターンの間、<br/>サゲ効果状態にする(嫉妬)"]:::effect
    c5b -->|"No"| lc3
    e5b --> c5c{"⑤:②と③のアピールで会心アピールが<br/>発生した回数が3回以上か<br/>(③の各アピール後)"}:::cond
    c5c -->|"Yes"| e5c["③のアピール対象を100%の<br/>確率で2ターンの間、<br/>サゲ効果状態にする(空腹)"]:::effect
    c5c -->|"No"| lc3
    e5c --> lc3
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の対象へ"| c4_2
