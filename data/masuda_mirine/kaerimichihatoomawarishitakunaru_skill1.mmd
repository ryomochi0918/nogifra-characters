flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3

    c3{"③:自身のエフォートが②の対象の<br/>エフォート以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が3倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>ライバルへ基本500%+<br/>固定値 エフォート×3のアピール"]:::action

    a2 --> c5{"⑤:ライバルチームのフロント人数が<br/>3名以上か"}:::cond
    c5 -->|"Yes"| e5["④による「命中率ダウン」状態の<br/>効果倍率が2倍になる"]:::effect --> e4
    c5 -->|"No"| e4["④:ライバル1名を100%の確率で<br/>2ターンの間「命中率ダウン」状態にする"]:::effect

    e4 --> lc{"②のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| a6["⑥実行:<br/>残りHP割合が最も低いライバル2名へ、<br/>②で行った合計アピールの30%分のアピール<br/>(ディフェンス、フィジカルを無視する)"]:::action --> finish(("終了")):::startend
