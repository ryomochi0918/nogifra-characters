flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が3倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに6回、<br/>自身のエフォートの3倍を<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c5{"⑤:ライバルチームの<br/>フロント人数が3名以上か<br/>(④の効果前)"}:::cond
    c5 -->|"Yes"| e5["④による「命中率ダウン」状態の<br/>効果倍率が2倍になる"]:::effect
    c5 -->|"No"| e4["④:ライバル1名を100%の確率で<br/>2ターンの間「命中率ダウン」<br/>状態にする<br/>(②の各アピール後)"]:::effect
    e5 --> e4
    e4 --> lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    lc2 -->|"Yes"| a6["⑥実行:残りHP割合が最も<br/>低いライバル2名に②で<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc2 -->|"No、次の回へ"| c3
    a6 --> finish(("終了")):::startend
