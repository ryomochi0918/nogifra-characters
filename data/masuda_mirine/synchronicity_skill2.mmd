flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>種類数が4種類以上か"}:::cond
    c1 -->|"Yes"| e1["自身を1ターンの間「熱意」<br/>状態にする"]:::effect
    c1 -->|"No"| e3["③:自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>種類数×150%分、②のアピール倍率が<br/>上昇する(上昇倍率は最大600%まで)<br/>(②の各アピール前)"]:::effect
    e1 --> e3
    e3 --> c4{"④:自身の残りHP割合が80%以上か<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率が2倍になる(④の<br/>効果によるアピール倍率の最大は<br/>1200%、③の効果が同時に発動した<br/>場合の最大は2400%)"]:::effect
    c4 -->|"No"| c5{"⑤:自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>種類数が6種類以上か<br/>(②の各アピール前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["②の各アピール中のみ②のアピールは<br/>必ず命中する"]:::effect
    c5 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルに5回、自身の最大アピールの<br/>30%を固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e5 --> a2
    a2 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| e3
