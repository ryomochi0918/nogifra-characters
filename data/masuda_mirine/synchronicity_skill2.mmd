flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身が受けている<br/>バフ・アゲ効果・特殊状態の種類数が<br/>4種類以上か"}:::cond
    c1 -->|"Yes"| e1["自身を1ターンの間<br/>「熱意」状態にする"]:::effect --> c3
    c1 -->|"No(条件を満たさない場合でも②は発動)"| c3
    c3{"③:②の各アピール前、<br/>種類数×150%分<br/>②のアピール倍率が上昇する<br/>(上昇倍率は最大600%まで)"}:::cond
    c3 --> c4{"④:自身の残りHP割合が80%以上か<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率が2倍になる<br/>(④の最大は1200%、③と同時発動時の最大は2400%)"]:::effect --> c5
    c4 -->|"No"| c5{"⑤:自身が受けている<br/>バフ・アゲ効果・特殊状態の種類数が<br/>6種類以上か"}:::cond
    c5 -->|"Yes"| e5["②の各アピール中のみ<br/>②のアピールは必ず命中する"]:::effect --> a2
    c5 -->|"No"| a2["②実行:<br/>残りHP割合が最も高いライバルに<br/>自身の最大アピールの30%を固定値として上乗せした<br/>600%のアピールを行う"]:::action
    a2 --> loop{"②のアピール5回すべて完了?"}:::cond
    loop -->|"No、次の回へ"| c3
    loop -->|"Yes"| finish(("終了")):::startend
