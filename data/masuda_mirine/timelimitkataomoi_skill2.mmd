flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身がバフ・アゲ効果<br/>状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の残りSPの<br/>80倍を固定値として上乗せする"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のスマイルが①の対象の<br/>スマイル以上か(対象ごとに判定)"}:::cond

    c3 -->|"Yes"| e3["①の各アピール中のみ自身の命中率を<br/>+25%し、アピール倍率が2倍になる"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>残りHP割合が最も高いライバル4名の<br/>バフ・アゲ効果を1つ解除し、940%のアピール"]:::action

    a1 --> c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| c6

    c6{"⑥:⑤の効果対象の残りHP割合が<br/>50%以下か(対象ごとに判定)"}:::cond
    c6 -->|"Yes"| e6["⑤の効果対象のデバフ・サゲ効果を2つ解除し、<br/>3ターンの間「勇気」状態にする"]:::effect --> a5
    c6 -->|"No"| a5["⑤実行:<br/>自身と自身以外の残りHP割合が最も低い<br/>味方2名のHPを①で行った合計アピールの<br/>20%分回復する"]:::action --> finish(("終了")):::startend
