flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の残りSPの<br/>80倍を固定値として上乗せする"]:::effect
    c2 -->|"No"| c3{"③:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①の各アピール中のみ自身の<br/>命中率を+25%し、<br/>アピール倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル4名のバフ・アゲ効果を<br/>1つ解除し、940%のアピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の対象へ"| c3
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| c6{"⑥:⑤の効果対象の<br/>残りHP割合が50%以下か<br/>(⑤の各効果前)"}:::cond
    c6 -->|"Yes"| e6["⑤の効果対象のデバフ・サゲ効果を<br/>2つ解除し、3ターンの間「勇気」<br/>状態にする"]:::effect
    c6 -->|"No"| e5["⑤:自身と自身以外の残りHP割合が<br/>最も低い味方2名のHPを①で行った<br/>合計アピールの20%分回復する"]:::effect
    e6 --> e5
    e5 --> lc5{"⑤の効果<br/>対象3名すべて完了?"}:::cond
    lc5 -->|"Yes"| finish(("終了")):::startend
    lc5 -->|"No、次の対象へ"| c6
