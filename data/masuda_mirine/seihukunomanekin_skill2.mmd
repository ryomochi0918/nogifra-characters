flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のサンクスが①のアピール対象の<br/>サンクス以上か(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果解除数が1つ増加し、<br/>アピール倍率と固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象がデバフ・サゲ効果<br/>状態か(①の各アピール前)"}:::cond

    c3 -->|"Yes"| e3["①のバフ・アゲ効果解除数が1つ増加し、<br/>アピール倍率と固定値倍率が2倍になる"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>ライバル3名のバフ・アゲ効果を1つ解除し、<br/>基本600%+固定値 サンクス×3のアピール"]:::action

    a1 --> lc1{"①のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| a5["⑤実行:<br/>自身のHPをこのスキルで行った<br/>合計アピールの50%分回復する"]:::action --> finish(("終了")):::startend
