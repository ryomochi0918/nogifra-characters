flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+30%、<br/>会心アピールを+40%する"]:::effect
    e1 --> c3{"③:②のアピール対象が<br/>「命中率ダウン」状態か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:自身の残りHP割合が60%以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルに4回、自身のエフォートの<br/>3倍を固定値として上乗せした700%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> c5{"⑤:②のアピールで会心アピールが<br/>発生したか<br/>(②の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["②のアピール回数が1回増加する<br/>(アピールの追加回数は最大で2回まで)"]:::effect
    c5 -->|"No"| lc2{"②のアピール<br/>4回(+⑤の追加分)すべて完了?"}:::cond
    e5 --> lc2
    lc2 -->|"Yes"| a6["⑥実行:残りHP割合が最も低い<br/>ライバル1名にこのスキルで<br/>行った合計アピールの40%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc2 -->|"No、次の回へ"| c3
    a6 --> finish(("終了")):::startend
