flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+30%、<br/>会心アピールを+40%する"]:::effect
    e1 --> c3

    c3{"③:②の対象が<br/>「命中率ダウン」状態か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身の残りHP割合が<br/>60%以上か"}:::cond

    c4 -->|"Yes"| e4["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c4 -->|"No"| a2["②実行:<br/>残りHP割合が最も高いライバルへ<br/>基本700%+固定値 エフォート×3のアピール"]:::action

    a2 --> c5{"⑤:②のアピールで<br/>会心アピールが発生したか"}:::cond
    c5 -->|"Yes"| e5["②のアピール回数が1回増加する<br/>(アピールの追加回数は最大で2回まで)"]:::effect --> lc
    c5 -->|"No"| lc

    lc{"②のアピール4回<br/>(⑤による追加分を含む)<br/>すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| a6["⑥実行:<br/>残りHP割合が最も低いライバル1名へ、<br/>このスキルで行った合計アピールの40%分のアピール<br/>(ディフェンス、フィジカルを無視する)"]:::action --> finish(("終了")):::startend
