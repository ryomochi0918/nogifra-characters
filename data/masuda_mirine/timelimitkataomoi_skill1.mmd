flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方フロントの人数が4名以下か"}:::cond
    c2 -->|"Yes"| e2["①による「会心アピール耐性アップ」<br/>状態の効果倍率が1.5倍になる"]:::effect
    c2 -->|"No"| e1["①:味方6名を3ターンの間<br/>「会心アピール耐性アップ」<br/>状態にする"]:::effect
    e2 --> e1
    e1 --> c4{"④:デバフ・サゲ効果状態の味方が<br/>フロントに4名以上居るか"}:::cond
    c4 -->|"Yes"| e4["③の効果対象が1名増加する"]:::effect
    c4 -->|"No"| e3["③:最大アピールが最も高い味方1名の<br/>デバフ・サゲ効果を2つ解除し、<br/>2ターンの間「集中」状態にする"]:::effect
    e4 --> e3
    e3 --> e5["⑤:残りHP割合が最も低い味方3名の<br/>HPを自身のHP上限の30%分回復し、<br/>2ターンの間「堅忍」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
