flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル4名に自身の残りHPの10%分を<br/>固定値として上乗せした700%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①の各アピール前に自身の<br/>バイタリティが①のアピール対象の<br/>バイタリティ以上だった<br/>回数が2回以上か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["③の効果対象が1名増加する"]:::effect
    c4 -->|"No"| e3["③:自身と自身以外の残りHP割合が<br/>最も低い味方1名のデバフ・サゲ効果を<br/>2つ解除し、HPを①で行った<br/>合計アピールの40%分回復する"]:::effect
    e4 --> e3
    e3 --> e5["⑤:自身と自身以外の残りHP割合が<br/>最も低い味方1名を3ターンの間<br/>「堅忍」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
