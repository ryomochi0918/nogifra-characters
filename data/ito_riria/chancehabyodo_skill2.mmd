flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>残りHP割合が最も低いライバル4名へ、<br/>自身の残りHPの10%分を固定値として<br/>上乗せした700%のアピール"]:::action
    a1 --> c4{"④:①の各アピール前に自身のバイタリティが<br/>対象のバイタリティ以上だった回数が<br/>2回以上か"}:::cond
    c4 -->|"Yes"| e4["③の効果対象が<br/>1名増加する"]:::effect --> e3
    c4 -->|"No"| e3["③実行:<br/>自身と自身以外の残りHP割合が最も低い味方1名の<br/>デバフ・サゲ効果を2つ解除し、<br/>HPを①で行った合計アピールの40%分回復する"]:::effect
    e3 --> e5["⑤実行:<br/>自身と自身以外の残りHP割合が最も低い味方1名を<br/>3ターンの間「堅忍」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
