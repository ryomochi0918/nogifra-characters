flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身が<br/>「神気」状態か"}:::cond
    c2 -->|"Yes"| e2["①による「神気」状態を<br/>「柔軟」状態に変更する"]:::effect --> e1
    c2 -->|"No"| e1["①実行:<br/>自身を4ターンの間<br/>「神気」状態にする"]:::effect
    e1 --> a3["③実行:<br/>ライバルへ5回、自身の最大アピールの30%分の<br/>固定値を上乗せした440%のアピール"]:::action
    a3 --> e4["④実行:<br/>自身と自身以外の残りHP割合が最も低い味方1名のHPを<br/>③で行った合計アピールの40%分回復する"]:::effect
    e4 --> c5{"⑤:③のアピールで<br/>ライバルをリタイアさせたか"}:::cond
    c5 -->|"Yes(再実行は最大1回まで)"| a3
    c5 -->|"No"| finish(("終了")):::startend
