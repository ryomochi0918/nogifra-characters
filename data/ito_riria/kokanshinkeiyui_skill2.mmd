flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が70%未満か"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ<br/>自身の会心率を+20%、<br/>会心アピールを+50%"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身が受けているバフ・アゲ効果・<br/>特殊状態の種類数が2種類以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と固定値倍率と<br/>固定値の上限が2倍に"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバルへ<br/>基本600%+固定値 アピール対象のHP減少分の6%<br/>(固定値の上乗せは自身の最大アピールの600%まで)"]:::action
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c4{"④:①のアピールで<br/>ライバルがリタイアしたか"}:::cond
    c4 -->|"Yes、再度①を実行<br/>(再実行は最大1回まで)"| c2
    c4 -->|"No、または再実行済み"| c5a{"⑤:ライブ中の自身のスキル1、2の<br/>会心アピールの発生回数が3回以上か"}:::cond
    c5a -->|"Yes"| a5a["自身のHPを①で行った<br/>合計アピールの25%分回復する"]:::action
    c5a -->|"No"| finish
    a5a --> c5b{"⑤:会心アピールの発生回数が<br/>5回以上か"}:::cond
    c5b -->|"Yes"| a5b["ライバル3名に①で行った<br/>合計アピールの15%分のアピール<br/>(ディフェンス、フィジカルを無視する)"]:::action
    c5b -->|"No"| finish
    a5b --> c5c{"⑤:会心アピールの発生回数が<br/>10回以上か"}:::cond
    c5c -->|"Yes"| a5c["ライバル1名にこのスキルで行った<br/>合計アピールの50%分のアピール<br/>(ディフェンス、フィジカルを無視し<br/>必ず命中する)"]:::action
    c5c -->|"No"| finish
    a5c --> finish(("終了")):::startend
