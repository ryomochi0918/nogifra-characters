flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が70%未満か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ自身の<br/>会心率を+20%、会心アピールを+50%する"]:::effect
    c2 -->|"No"| c3{"③:自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>種類数が2種類以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と固定値倍率と<br/>固定値の上限が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:ライバルに5回、<br/>アピール対象のHP減少分の6%を<br/>固定値として上乗せした600%の<br/>アピールを行う(固定値の上乗せは<br/>自身の最大アピールの600%まで)"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしたか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| c5{"⑤:ライブ中の自身のスキル1、2の<br/>会心アピールの発生回数が3回以上か"}:::cond
    c5 -->|"Yes"| e5["自身のHPを①で行った合計アピールの<br/>25%分回復する"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> c5b{"⑤:ライブ中の自身のスキル1、2の<br/>会心アピールの発生回数が5回以上か"}:::cond
    c5b -->|"Yes"| a5b["⑤実行:ライバル3名に①で<br/>行った合計アピールの15%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c5b -->|"No"| finish
    a5b --> c5c{"⑤:ライブ中の自身のスキル1、<br/>2の会心アピールの発生回数が<br/>10回以上か"}:::cond
    c5c -->|"Yes"| a5c["⑤実行:ライバル1名にこのスキルで<br/>行った合計アピールの50%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視し必ず命中する)"]:::action
    c5c -->|"No"| finish
    a5c --> finish
