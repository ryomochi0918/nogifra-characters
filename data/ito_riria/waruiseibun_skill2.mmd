flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が70%未満か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のエフォートが<br/>①のアピール対象のエフォート以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象の<br/>バフ・アゲ効果を1つ解除し、<br/>①のアピール倍率と固定値倍率を1.5倍にする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>残りHP割合が最も低いライバルへ、<br/>100%の確率で2ターンの間<br/>「ディフェンスダウン」状態にし、<br/>自身のエフォートの1.5倍を固定値として<br/>上乗せした500%のアピール"]:::action
    a1 --> lc{"①のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| c4{"④:①のアピールで<br/>ライバルがリタイアしたか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| e5["⑤:自身のHPを①で行った<br/>合計アピールの50%分回復する"]:::effect --> finish(("終了")):::startend
