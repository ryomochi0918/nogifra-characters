flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:デバフ・サゲ効果状態のライバルが<br/>フロントに2名以上いるか"}:::cond
    c2 -->|"Yes"| e2["①の効果倍率が<br/>2倍になる"]:::effect --> e1
    c2 -->|"No"| e1["①実行:<br/>このスキル中、自身の会心率を<br/>+20%する"]:::effect
    e1 --> a3["③実行:<br/>フィジカルが最も低いライバルへ2回、<br/>700%のアピール"]:::action
    a3 --> a4["④実行:<br/>ライバル4名へ③で行った合計アピールの50%を<br/>固定値として上乗せした750%のアピールを行い、<br/>100%の確率で3ターンの間「嫉妬」状態にする"]:::action
    a4 --> c5{"⑤:このスキルでライバルが<br/>1名以上リタイアしたか"}:::cond
    c5 -->|"Yes(再実行は最大1回まで)"| a4
    c5 -->|"No"| finish(("終了")):::startend
