flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:デバフ・サゲ効果状態の<br/>ライバルがフロントに2名以上いるか"}:::cond
    c2 -->|"Yes"| e2["①の効果倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:このスキル中、自身の<br/>会心率を+20%する"]:::effect
    e2 --> e1
    e1 --> a3["③実行:フィジカルが最も低い<br/>ライバルに2回、700%のアピールを行う"]:::action
    a3 --> a4["④実行:ライバル4名に③で<br/>行った合計アピールの50%を<br/>固定値として上乗せした750%の<br/>アピールを行い、100%の確率で<br/>3ターンの間「嫉妬」状態にする"]:::action
    a4 --> c5{"⑤:このスキルでライバルが<br/>1名以上リタイアしたか"}:::cond
    c5 -->|"Yes(再実行は最大1回まで)"| a4
    c5 -->|"No"| finish(("終了")):::startend
