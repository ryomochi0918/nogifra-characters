flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:味方チームのフロント人数が<br/>4名以上か"}:::cond
    c1 -->|"Yes"| e1["自身を2ターンの間「聡明」<br/>状態にする"]:::effect
    c1 -->|"No"| c3{"③:自身の残りHP割合が70%以上か<br/>(②の各アピール前)"}:::cond
    e1 --> c3
    c3 -->|"Yes"| e3["②の各アピール中のみ自身の<br/>会心率を+20%する"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに6回、自身の残りHPの<br/>20%を固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    lc2 -->|"Yes"| e5["⑤:②のアピールで発生した<br/>会心アピール1回ごとに④の<br/>効果対象が1名増加する(増加人数は<br/>最大で2名まで)"]:::effect
    lc2 -->|"No、次の回へ"| c3
    e5 --> e4["④:自身以外の最大アピールが最も<br/>高い味方1名を2ターンの間「機敏」<br/>状態にする"]:::effect
    e4 --> finish(("終了")):::startend
