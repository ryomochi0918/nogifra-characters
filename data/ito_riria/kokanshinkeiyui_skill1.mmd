flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:味方チームのフロント人数が<br/>4名以上か"}:::cond
    c1 -->|"Yes"| e1["自身を2ターンの間<br/>「聡明」状態にする"]:::effect --> c3
    c1 -->|"No"| c3{"③:自身の残りHP割合が<br/>70%以上か"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ<br/>自身の会心率を+20%"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバルへ<br/>基本600%+固定値 自身の残りHPの20%<br/>(①の条件を満たさない場合でも発動)"]:::action
    a2 --> lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    lc2 -->|"No、次の回へ"| c3
    lc2 -->|"Yes"| c5{"⑤:②のアピールで<br/>会心アピールが発生したか"}:::cond
    c5 -->|"Yes"| e5["会心アピール1回ごとに<br/>④の効果対象が1名増加<br/>(増加人数は最大で2名まで)"]:::effect --> a4
    c5 -->|"No"| a4["④実行:自身以外の最大アピールが<br/>最も高い味方1名を2ターンの間<br/>「機敏」状態にする"]:::action
    a4 --> finish(("終了")):::startend
