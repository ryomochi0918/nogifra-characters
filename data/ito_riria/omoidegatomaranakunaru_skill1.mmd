flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身と自身以外の最大アピールが最も高い味方1名を<br/>2ターンの間「アピール力アップ」状態にし、<br/>HPを自身のアピール力の100%分回復する(会心回復あり)"]:::effect
    e1 --> c3{"③:自身のバイタリティが<br/>②のアピール対象のバイタリティ<br/>以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>ライバル4名へ、自身の最大アピールの30%を<br/>固定値として上乗せした550%のアピール"]:::action
    a2 --> e4["④実行:<br/>自身のHPを②で行った<br/>合計アピールの20%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
