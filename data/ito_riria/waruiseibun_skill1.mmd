flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:75%の確率で<br/>①のアピール対象の<br/>バフ・アゲ効果を解除するか"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象の<br/>バフ・アゲ効果を1つ解除する"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象の<br/>残りHP割合が50%以下か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率を1.5倍にする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>残りHP割合が最も高いライバルへ、<br/>自身のエフォートの3倍を固定値として<br/>上乗せした300%のアピール<br/>(対象はリタイアするまで固定、<br/>リタイア回復が発生しても対象は変更しない)"]:::action
    a1 --> c4{"④:①のアピールで<br/>ライバルがリタイアしたか"}:::cond
    c4 -->|"Yes"| e4["自身を2ターンの間<br/>「熱血」状態にする"]:::effect --> lc
    c4 -->|"No"| lc{"①のアピール<br/>8回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| e5["⑤:自身を2ターンの間<br/>「熱血」状態にする"]:::effect --> finish(("終了")):::startend
