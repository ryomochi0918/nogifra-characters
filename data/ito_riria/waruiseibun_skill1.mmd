flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e2["②:75%の確率で①のアピール対象の<br/>バフ・アゲ効果を1つ解除する<br/>(①の各アピール前)"]:::effect
    e2 --> c3{"③:①のアピール対象の<br/>残りHP割合が50%以下か<br/>(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに8回、自身のエフォートの<br/>3倍を固定値として上乗せした300%の<br/>アピールを行う(このアピールは<br/>ライバルがリタイアするまで対象を<br/>変更せず、リタイア回復が発生した<br/>場合も対象を変更しない)"]:::action
    e3 --> a1
    a1 --> c4{"④:①のアピールでライバルが<br/>リタイアしたか<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["自身を2ターンの間「熱血」<br/>状態にする"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>8回すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| e5["⑤:自身を2ターンの間「熱血」<br/>状態にする"]:::effect
    lc1 -->|"No、次の回へ"| e2
    e5 --> finish(("終了")):::startend
