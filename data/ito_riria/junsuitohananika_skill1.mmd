flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を2ターンの間「倍音」<br/>状態にする"]:::effect
    e1 --> c3{"③:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["バフ・アゲ効果を1つ解除し、<br/>②の固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルに4回、自身のスマイルの<br/>3.5倍を固定値として上乗せした750%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"Yes"| c4{"④:②のアピールでライバルが<br/>リタイアしたか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c4 -->|"Yes"| a4["④実行:残りHP割合が最も<br/>低いライバル4名に②で<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    c4 -->|"No"| e5["⑤:残りHP割合が最も低い<br/>ライバル4名を100%の確率で3ターンの<br/>間「嫉妬」状態にする"]:::effect
    a4 --> e5
    e5 --> finish(("終了")):::startend
