flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を2ターンの間<br/>「倍音」状態にする"]:::effect
    e1 --> c3{"③:自身のスマイルが<br/>②のアピール対象のスマイル以上か<br/>(対象ごとに判定)"}:::cond

    c3 -->|"Yes"| e3["バフ・アゲ効果を1つ解除し、<br/>②の固定値倍率が2倍に"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>最大アピールが最も高いライバルへ<br/>基本750%+固定値 自身のスマイル×3.5"]:::action

    a2 --> lc{"②のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| c4{"④:②のアピールで<br/>ライバルがリタイアしたか"}:::cond
    c4 -->|"Yes"| a4["④実行:<br/>残りHP割合が最も低いライバル4名に<br/>②で行った合計アピールの30%分のアピール<br/>(ディフェンス、メンタルを無視する)"]:::action --> e5
    c4 -->|"No"| e5["⑤:残りHP割合が最も低いライバル4名を<br/>100%の確率で3ターンの間<br/>「嫉妬」状態にする<br/>(条件を満たさない場合でも発動)"]:::effect
    e5 --> finish(("終了")):::startend
