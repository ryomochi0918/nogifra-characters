flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象の残りHP割合が50%以上、<br/>またはデバフ・サゲ効果状態ではないか<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①による「強運」状態の<br/>効果倍率が1.5倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:①の効果対象の<br/>残りHP割合が50%未満か<br/>(①の各効果前)"}:::cond
    c3 -->|"Yes"| e3["①のデバフ・サゲ効果状態の解除数が2つ増加し、<br/>回復倍率が2倍になる"]:::effect --> e1
    c3 -->|"No"| e1["①実行:<br/>最大アピールが最も高い味方3名のデバフ・サゲ効果を1つ解除し、<br/>2ターンの間「強運」状態にし、<br/>HPを自身のアピール力の120%分回復する(会心回復あり)"]:::effect
    e1 --> lc1{"①の効果<br/>対象3名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| e4["④実行:<br/>自身と残りHP割合が最も高い味方2名を<br/>2ターンの間「ディフェンスアップ」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
