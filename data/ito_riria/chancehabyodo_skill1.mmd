flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③④:自身が<br/>「防音」状態か"}:::cond
    c3 -->|"Yes"| e3["①によるデバフ・サゲ効果の<br/>解除数を1つ増加する"]:::effect --> e2
    c3 -->|"No"| e4["自身を4ターンの間<br/>「防音」状態にする"]:::effect --> e2
    e2["②実行:<br/>①の効果対象を4ターンの間<br/>「遮音」状態にする"]:::effect
    e2 --> e1["①実行:<br/>自身と自身以外の残りHP割合が最も低い味方1名の<br/>デバフ・サゲ効果を1つ解除し、<br/>HPを自身のHP上限の30%分回復する"]:::effect
    e1 --> c5{"⑤:①の効果対象が<br/>デバフ・サゲ効果状態<br/>ではないか"}:::cond
    c5 -->|"Yes"| e5["①の効果対象を4ターンの間<br/>「陽動」状態にする"]:::effect --> finish(("終了")):::startend
    c5 -->|"No"| finish
