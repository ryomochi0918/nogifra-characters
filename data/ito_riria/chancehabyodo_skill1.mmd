flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e2["②:①の効果対象を4ターンの間<br/>「遮音」状態にし、スキル発動前の<br/>自身の状態に応じて③か④の効果<br/>どちらかを適用する"]:::effect
    e2 --> c3{"③/④:スキル発動前の自身が<br/>「防音」状態か"}:::cond
    c3 -->|"Yes"| e3["③:①によるデバフ・サゲ効果の<br/>解除数を1つ増加する"]:::effect
    c3 -->|"No"| e4["④:自身を4ターンの間<br/>「防音」状態にする"]:::effect
    e3 --> e1["①:自身と自身以外の残りHP割合が<br/>最も低い味方1名のデバフ・サゲ効果を<br/>1つ解除し、HPを自身のHP上限の<br/>30%分回復する"]:::effect
    e4 --> e1
    e1 --> c5{"⑤:①の効果対象が<br/>デバフ・サゲ効果状態ではないか<br/>(①の各効果後)"}:::cond
    c5 -->|"Yes"| e5["①の効果対象を4ターンの間<br/>「陽動」状態にする"]:::effect
    c5 -->|"No"| lc1{"①の効果<br/>対象2名すべて完了?"}:::cond
    e5 --> lc1
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の対象へ"| e1
