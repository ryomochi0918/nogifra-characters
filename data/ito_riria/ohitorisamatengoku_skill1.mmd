flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の最大アピールの<br/>30%分の固定値を上乗せする"]:::effect
    c2 -->|"No"| a1["①実行:ライバル6名を100%の確率で<br/>3ターンの間「アピール力ダウン」<br/>状態にし、500%のアピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:①のアピール対象の<br/>残りHP割合が50%未満か<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象を100%の確率で<br/>3ターンの間「嫉妬」状態にする"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| e4["④:味方6名のHPを①で行った<br/>合計アピールの20%分回復する"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e4 --> c5{"⑤:味方チームのフロント人数が<br/>3名以上か"}:::cond
    c5 -->|"Yes"| a5["⑤実行:ライバル1名に①で<br/>行った合計アピールの50%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
