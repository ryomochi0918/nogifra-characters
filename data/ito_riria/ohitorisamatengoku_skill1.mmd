flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の最大アピールの<br/>30%分の固定値を上乗せする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバル6名を100%の確率で3ターンの間<br/>「アピール力ダウン」状態にし、500%のアピール"]:::action
    a1 --> c3{"③:①のアピール対象の<br/>残りHP割合が50%未満か"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象を100%の確率で<br/>3ターンの間「嫉妬」状態にする"]:::effect --> lc
    c3 -->|"No"| lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| e4["④実行:<br/>味方6名のHPを①で行った<br/>合計アピールの20%分回復する"]:::effect
    e4 --> c5{"⑤:味方チームのフロント人数が<br/>3名以上か"}:::cond
    c5 -->|"Yes"| a5["ライバル1名へ①で行った合計アピールの50%分<br/>(ディフェンス・メンタル無視)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
