flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果・特殊状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| c3{"③:自身の「決心」状態のターン数が<br/>4ターン以上か<br/>(②の各効果前)"}:::cond
    c2 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに5回、このスキルが発動する<br/>前の味方チームとライバルチームの<br/>フロント人数×500%の倍率を<br/>上乗せした、100%のアピールを<br/>行う(アピール倍率の上乗せは<br/>最大6000%まで)"]:::action
    c3 -->|"Yes"| e3["②のバフ・アゲ効果解除数を<br/>1つ増加する"]:::effect
    c3 -->|"No"| e2["①のアピール対象のバフ・アゲ効果を<br/>1つ解除し、100%の確率で2ターンの<br/>間「フィジカルダウン」と<br/>「メンタルダウン」状態にする"]:::effect
    e3 --> e2
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| e4["④:自身と自身以外の残りHP割合が<br/>最も低い味方1名のHPを①で行った<br/>合計アピールの20%分回復する"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e4 --> finish(("終了")):::startend
