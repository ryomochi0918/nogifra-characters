flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果・<br/>特殊状態か"}:::cond
    c2 -->|"Yes"| c3{"③:自身の「決心」状態の<br/>ターン数が4ターン以上か"}:::cond
    c3 -->|"Yes"| e3["②のバフ・アゲ効果<br/>解除数を1つ増加する"]:::effect --> e2
    c3 -->|"No"| e2["①のアピール対象のバフ・アゲ効果を1つ解除し、<br/>100%の確率で2ターンの間<br/>「フィジカルダウン」と「メンタルダウン」状態にする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>残りHP割合が最も高いライバルへ、<br/>味方とライバルのフロント人数×500%の倍率を<br/>上乗せした100%のアピール(上乗せ最大6000%)"]:::action
    a1 --> lc{"①のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| e4["④実行:<br/>自身と自身以外の残りHP割合が最も低い味方1名のHPを<br/>①で行った合計アピールの20%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
