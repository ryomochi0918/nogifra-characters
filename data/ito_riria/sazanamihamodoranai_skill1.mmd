flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["100%の確率で3ターンの間<br/>「フィジカルダウン」と<br/>「メンタルダウン」状態にする"]:::effect
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバル3名に自身の最大アピールの<br/>60%を固定値として上乗せした1200%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c4{"④:③の効果対象の<br/>残りHP割合が50%未満か<br/>(③の各効果前)"}:::cond
    c4 -->|"Yes"| e4["③による「転倒」状態の確率が<br/>100%になり、③の各効果中のみ自身の<br/>サゲ効果耐性貫通を+50%する"]:::effect
    c4 -->|"No"| e3["③:50%の確率で1ターンの間「転倒」<br/>状態にする<br/>(①の各アピール後)"]:::effect
    e4 --> e3
    e3 --> lc1{"①のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の対象へ"| c2
