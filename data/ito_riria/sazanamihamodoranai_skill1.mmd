flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが<br/>①のアピール対象のサンクス<br/>以上か"}:::cond
    c2 -->|"Yes"| e2["100%の確率で3ターンの間<br/>「フィジカルダウン」と「メンタルダウン」状態にする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>最大アピールが最も高いライバル3名へ、<br/>自身の最大アピールの60%を固定値として<br/>上乗せした1200%のアピール"]:::action
    a1 --> c4{"④:③の効果対象の<br/>残りHP割合が50%未満か"}:::cond
    c4 -->|"Yes"| e4["③による「転倒」状態の確率が100%になり、<br/>③の各効果中のみ自身のサゲ効果耐性貫通を+50%する"]:::effect --> e3
    c4 -->|"No"| e3["③実行:<br/>50%の確率で1ターンの間<br/>「転倒」状態にする"]:::effect
    e3 --> lc{"①のアピール<br/>3回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| finish(("終了")):::startend
