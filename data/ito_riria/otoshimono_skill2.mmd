flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>デバフ耐性貫通を+20%する"]:::effect
    e1 --> a2["②実行:ライバル4名のバフ・アゲ効果を<br/>1つ解除し、100%の確率で2ターンの<br/>間「フィジカルダウン」と<br/>「メンタルダウン」状態にし、<br/>400%のアピールを行う"]:::action
    a2 --> c4{"④:自身の残りHP割合が50%以上か"}:::cond
    c4 -->|"Yes"| e4["③のアピールは必ず命中する"]:::effect
    c4 -->|"No"| a3["③実行:残りHP割合が最も高い<br/>ライバル1名に最大アピールが最も高い<br/>味方3名の最大アピールの合計45%分の<br/>固定値を上乗せした1000%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> e5["⑤:残りHP割合が最も低い<br/>味方2名のHPをこのスキルで行った<br/>合計アピールの50%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
