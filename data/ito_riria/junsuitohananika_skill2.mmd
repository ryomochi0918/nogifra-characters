flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:残りHP割合が最も低い<br/>ライバル2名を2ターンの間「空腹」<br/>状態にする"]:::effect
    e1 --> c3{"③:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["バフ・アゲ効果を2つ解除し、<br/>②の固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバル2名に3回、自身のスマイルの<br/>3.5倍を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc2 -->|"Yes"| lc2n{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2n -->|"Yes"| c4{"④:②のアピールでライバルが<br/>リタイアしたか"}:::cond
    lc2n -->|"No、次の回へ"| c3
    c4 -->|"Yes(再実行は最大1回まで)"| e1
    c4 -->|"No"| finish(("終了")):::startend
