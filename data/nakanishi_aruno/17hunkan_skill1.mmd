flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の各アピール前、自身の残りHP割合が<br/>50%未満か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍に"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバル4名へ<br/>基本750%+固定値 バイタリティ×1.5"]:::action
    a1 --> lc{"①のアピール4名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| c4{"④:③の効果前、自身の残りHP割合が<br/>50%以上か"}:::cond
    c4 -->|"Yes"| e4["③による「遮音」状態の<br/>受けるアピール低下倍率が1.5倍に"]:::effect --> c5
    c4 -->|"No"| c5{"⑤:③の効果前、自身の残りHP割合が<br/>50%未満か"}:::cond
    c5 -->|"Yes"| e5["③のHP回復倍率が1.5倍に"]:::effect --> e3
    c5 -->|"No"| e3["③実行:<br/>自身を4ターンの間「遮音」状態にし、<br/>HPを自身のアピール力の80%分回復<br/>(会心率に応じて会心回復が発生)"]:::effect
    e3 --> finish(("終了")):::startend
