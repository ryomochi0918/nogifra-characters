flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%未満か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバル4名に自身の<br/>バイタリティの1.5倍を<br/>固定値として上乗せした750%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④/⑤:自身の残りHP割合が50%以上か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["④:③による「遮音」状態の受ける<br/>アピールの低下倍率が1.5倍になる"]:::effect
    c4 -->|"No"| e5["⑤:③の効果によるHP回復倍率が<br/>1.5倍になる"]:::effect
    e4 --> e3["③:自身を4ターンの間「遮音」<br/>状態にし、HPを自身のアピール力の<br/>80%分回復する(会心率に<br/>応じて会心回復が発生)"]:::effect
    e5 --> e3
    e3 --> finish(("終了")):::startend
