flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身のスマイルの<br/>4倍を固定値として上乗せする"]:::effect
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバル6名のバフ・アゲ効果を<br/>2つ解除し、700%のアピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:このスキルでバフ・アゲ効果を<br/>3つ以上解除したか"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["③の効果対象が2名増加する"]:::effect
    c4 -->|"No"| e3["③:最大アピールが最も高い味方2名を<br/>3ターンの間「興奮」状態にし、<br/>デバフ・サゲ効果を2つ解除し、HPを<br/>自身のアピール力の100%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect
    e4 --> e3
    e3 --> finish(("終了")):::startend
