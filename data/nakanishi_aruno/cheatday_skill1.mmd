flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル4名に自身の残りHPの25%を<br/>固定値として上乗せした650%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:自身を3ターンの間「魅了」<br/>状態にし、HPを自身のHP上限の<br/>20%分回復する"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e3 --> c4{"④:自身の残りHP割合が50%以上か"}:::cond
    c4 -->|"Yes"| c5{"⑤:味方チームのフロント人数が<br/>5名以下か"}:::cond
    c4 -->|"No"| finish(("終了")):::startend
    c5 -->|"Yes"| e5["④による「威圧」状態の<br/>ターン数を+1する"]:::effect
    c5 -->|"No"| e4["自身を3ターンの間「威圧」<br/>状態にする"]:::effect
    e5 --> e4
    e4 --> finish
