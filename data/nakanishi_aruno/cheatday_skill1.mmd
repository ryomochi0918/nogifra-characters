flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の残りHP割合が<br/>50%以上か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["対象のバフ・アゲ効果を<br/>1つ解除"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>残りHP割合が最も高いライバル4名へ<br/>基本650%+固定値 自身の残りHPの25%"]:::action
    a1 --> lc{"①のアピール4名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| e3["③実行:<br/>自身を3ターンの間「魅了」状態にし、<br/>HPを自身のHP上限の20%分回復"]:::effect
    e3 --> c4{"④:自身の残りHP割合が<br/>50%以上か"}:::cond
    c4 -->|"No"| finish(("終了")):::startend
    c4 -->|"Yes"| c5{"⑤:味方チームのフロント人数が<br/>5名以下か"}:::cond
    c5 -->|"Yes"| e5["④の「威圧」状態の<br/>ターン数を+1"]:::effect --> e4
    c5 -->|"No"| e4["④実行:<br/>自身を3ターンの間<br/>「威圧」状態にする"]:::effect
    e4 --> finish
