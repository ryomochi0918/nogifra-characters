flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e1 --> a2["②実行:ライバル6名に700%の<br/>アピールを行い、対象を100%の確率で<br/>3ターンの間「心労」状態にする"]:::action
    a2 --> c4{"④:③のアピール対象が「心労」状態か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:②のアピールで自身の<br/>スマイルが②のアピール対象の<br/>スマイル以上であった回数を<br/>アピール回数として、ライバルに<br/>自身の最大アピールの30%を<br/>固定値として上乗せした200%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>回数分すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c4
