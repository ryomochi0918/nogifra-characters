flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①実行:<br/>このスキル中、<br/>自身の命中率を+20%"]:::effect
    e1 --> a2["②実行:<br/>ライバル6名へ<br/>基本700%のアピールを行い、<br/>100%の確率で3ターンの間<br/>「心労」状態にする"]:::action
    a2 --> c4{"④:③のアピール対象が<br/>「心労」状態か(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が2倍に"]:::effect --> a3
    c4 -->|"No"| a3["③実行:<br/>②のアピールで自身のスマイルが<br/>対象のスマイル以上であった回数を<br/>アピール回数として、<br/>ライバルへ基本200%+固定値<br/>自身の最大アピールの30%"]:::action
    a3 --> lc{"③のアピールが<br/>算出された回数分すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c4
    lc -->|"Yes"| finish(("終了")):::startend
