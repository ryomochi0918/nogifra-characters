flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①による「雑音」状態の確率を+20%し、<br/>①の各アピール中のみ自身の<br/>サゲ効果耐性貫通を+30%する"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| a1["①実行:ライバル3名を80%の確率で<br/>2ターンの間「雑音」状態にし、<br/>自身の最大アピールの40%を<br/>固定値として上乗せした850%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc1 -->|"Yes"| a4["④実行:ライバルに4回、<br/>自身の最大アピールの20%を<br/>固定値として上乗せした600%の<br/>アピールを行う"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a4 --> c5{"⑤:ライバルチームの<br/>フロント人数が4名以下か"}:::cond
    c5 -->|"Yes"| e5["最大アピールが最も高いライバル1名を<br/>100%の確率で2ターンの間「雑音」<br/>状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
