flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが<br/>①のアピール対象のスマイル以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①による「雑音」状態の確率を+20%<br/>①の各アピール中のみ<br/>自身のサゲ効果耐性貫通を+30%"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象の<br/>バフ・アゲ効果を1つ解除"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>ライバル3名を80%の確率で2ターンの間<br/>「雑音」状態にし、<br/>基本850%+固定値 自身の最大アピールの40%<br/>のアピール"]:::action
    a1 --> lc1{"①のアピール3名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| a4["④実行:<br/>ライバルに4回、<br/>基本600%+固定値 自身の最大アピールの20%<br/>のアピール"]:::action
    a4 --> lc2{"④のアピール4回すべて完了?"}:::cond
    lc2 -->|"No、次の回へ"| a4
    lc2 -->|"Yes"| c5{"⑤:ライバルチームの<br/>フロント人数が4名以下か"}:::cond
    c5 -->|"No"| finish(("終了")):::startend
    c5 -->|"Yes"| e5["最大アピールが最も高いライバル1名を<br/>100%の確率で2ターンの間<br/>「雑音」状態にする"]:::effect
    e5 --> finish
