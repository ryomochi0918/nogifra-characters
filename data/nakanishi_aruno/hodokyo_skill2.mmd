flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が「雑音」状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c2 -->|"No"| a1["①実行:ライバル4名を50%の確率で<br/>2ターンの間「回避率ダウン」<br/>状態にし、自身のSP上限の90倍を<br/>固定値として上乗せした1100%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c3 -->|"Yes(再実行は最大1回まで)"| c2
    c3 -->|"No"| a4["④実行:残りHP割合が最も低い<br/>ライバルに4回、自身のSP上限の<br/>140倍を固定値として上乗せした580%の<br/>アピールを行う"]:::action
    a4 --> c5{"⑤:このスキルでリタイアした<br/>ライバルが1名以下か"}:::cond
    c5 -->|"Yes"| a5["⑤実行:ライバル1名にこのスキルで<br/>行った合計アピールの20%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
