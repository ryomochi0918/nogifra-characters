flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が80%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象を100%の確率で<br/>1ターンの間「執着」状態にする"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに4回、400%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:①のアピールでライバルが<br/>リタイアしなかったか<br/>(度に積算)<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる<br/>(最大6400%のアピール)"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| c4{"④:①のアピールで<br/>デバフ・サゲ効果状態のライバルに<br/>3回以上アピールしていたか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)<br/>このスキル中のみ自身の<br/>命中率を+20%し再実行"| c2
    c4 -->|"No"| finish(("終了")):::startend
