flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のバイタリティが①の<br/>アピール対象のバイタリティ以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに4回、自身の残りHP12%分を<br/>固定値として上乗せした440%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c4{"④:③の効果対象の残りHP割合が<br/>50%以上または自身が「瞑想」状態か<br/>(③の各効果前)"}:::cond
    c4 -->|"Yes"| e4["③の効果対象を3ターンの間「堅忍」<br/>状態にし、デバフ・サゲ効果を<br/>1つ解除する"]:::effect
    c4 -->|"No"| e3["③:残りHP割合が最も低い味方1名の<br/>HPを自身のHP上限の15%分回復する<br/>(①の各アピール後)"]:::effect
    e4 --> e3
    e3 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| e5["⑤:味方6名を3ターンの間<br/>「アピールガード(感謝)」状態にする"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e5 --> finish(("終了")):::startend
