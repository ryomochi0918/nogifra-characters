flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のバイタリティが<br/>①のアピール対象のバイタリティ以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率を2倍に"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>残りHP割合が最も低いライバルへ<br/>基本440%+固定値 自身の残りHP12%分"]:::action
    a1 --> c4{"④:③の効果対象の残りHP割合が<br/>50%以上または自身が<br/>「瞑想」状態か"}:::cond
    c4 -->|"Yes"| e4["③の効果対象を3ターンの間<br/>「堅忍」状態にし、<br/>デバフ・サゲ効果を1つ解除"]:::effect --> e3
    c4 -->|"No"| e3["③実行:<br/>残りHP割合が最も低い味方1名の<br/>HPを自身のHP上限の15%分回復"]:::effect
    e3 --> lc{"①のアピール4回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| e5["⑤:味方6名を3ターンの間<br/>「アピールガード(感謝)」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
