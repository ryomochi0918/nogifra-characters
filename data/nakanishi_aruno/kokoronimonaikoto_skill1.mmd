flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身が「希望」状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の最大アピールの<br/>5%×自身の「希望」状態の<br/>ターン数分の固定値を上乗せする"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と固定値倍率が<br/>2倍になる(この効果による倍率増加は<br/>②の効果を含まない)"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに5回、自身のエフォートの<br/>1.5倍を固定値として上乗せした430%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> c4{"④:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["自身のHPを①で行った直前の<br/>アピールの30%分回復する"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
