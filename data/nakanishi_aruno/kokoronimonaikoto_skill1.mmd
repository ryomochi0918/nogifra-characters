flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身が「希望」状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の最大アピールの<br/>5%×自身の「希望」状態のターン数分の<br/>固定値を上乗せ"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象の<br/>残りHP割合が50%以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と固定値倍率が2倍に<br/>(この効果による倍率増加は<br/>②の効果を含まない)"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>残りHP割合が最も高いライバルへ<br/>基本430%+固定値 自身のエフォート×1.5"]:::action
    a1 --> c4{"④:自身のエフォートが<br/>①のアピール対象のエフォート以上か"}:::cond
    c4 -->|"Yes"| e4["自身のHPを①で行った<br/>直前のアピールの30%分回復"]:::effect --> lc
    c4 -->|"No"| lc{"①のアピール5回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| finish(("終了")):::startend
