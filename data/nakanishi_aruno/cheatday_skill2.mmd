flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間<br/>「ディフェンスアップ」<br/>状態にし、このスキル中、自身の<br/>サゲ効果耐性貫通を+20%する"]:::effect
    e1 --> c3{"③:ライブ中に自身の<br/>スキル2「勝算アルノ?」が<br/>2回以上発動していたか"}:::cond
    c3 -->|"Yes"| e3["②のアピールに自身のディフェンスの<br/>100%を固定値として上乗せする"]:::effect
    c3 -->|"No"| c4{"④:ライバルチームの<br/>フロント人数が3名以下か"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率と③の<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:最大アピールが最も<br/>高いライバル3名を100%の確率で<br/>3ターンの間「混乱」状態にし、<br/>1200%のアピールを行う"]:::action
    e4 --> a2
    a2 --> e5["⑤:自身のHPを②で行った<br/>合計アピールの20%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
