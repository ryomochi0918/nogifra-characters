flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①実行:<br/>自身を3ターンの間<br/>「ディフェンスアップ」状態にし、<br/>このスキル中、自身のサゲ効果耐性貫通を+20%"]:::effect
    e1 --> c3{"③:ライブ中に自身のスキル2<br/>「勝算アルノ?」が2回以上発動済みか"}:::cond
    c3 -->|"Yes"| e3["②のアピールに自身のディフェンスの<br/>100%を固定値として上乗せ"]:::effect --> c4
    c3 -->|"No"| c4{"④:ライバルチームのフロント人数が<br/>3名以下か"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率と<br/>③の固定値倍率が2倍に"]:::effect --> a2
    c4 -->|"No"| a2["②実行:<br/>最大アピールが最も高いライバル3名を<br/>100%の確率で3ターンの間「混乱」状態にし、<br/>基本1200%のアピールを行う"]:::action
    a2 --> e5["⑤:自身のHPを②で行った<br/>合計アピールの20%分回復"]:::effect
    e5 --> finish(("終了")):::startend
