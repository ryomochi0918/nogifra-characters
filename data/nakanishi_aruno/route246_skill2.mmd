flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c4{"④:①の各アピール対象の<br/>残りHP割合が50%以下か<br/>(①の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["①の各アピール倍率が2倍になり、<br/>命中率を+20%する"]:::effect
    c4 -->|"No"| a1["①実行:ライバル4名に550%の<br/>アピールを行う"]:::action
    e4 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:①のアピールで会心アピールが発生<br/>または①のアピールで「心労」状態の<br/>ライバルを対象にした回数分だけ、<br/>②のアピールが会心アピールになる<br/>(①の各アピールにつき会心アピールの<br/>回数は1回まで増加する)<br/>(②の各アピール前)"]:::effect
    lc1 -->|"No、次の対象へ"| c4
    e3 --> c4_2{"④:②の各アピール対象の<br/>残りHP割合が50%以下か<br/>(②の各アピール前)"}:::cond
    c4_2 -->|"Yes"| e4_2["②の各アピール倍率が2倍になり、<br/>命中率を+20%する"]:::effect
    c4_2 -->|"No"| a2["②実行:ライバルに4回、550%の<br/>アピールを行う"]:::action
    e4_2 --> a2
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:このスキルでライバルを<br/>1名以上リタイアさせたか"}:::cond
    lc2 -->|"No、次の回へ"| e3
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も<br/>高いライバル1名に①と②の<br/>合計アピールの70%分のアピールを<br/>行う(ディフェンス、メンタルを<br/>無視し必ず命中する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
