flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍に"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身の残りHP割合が<br/>①のアピール対象の残りHP割合以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍に"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身の「希望」状態のターン数が<br/>6ターン以上か"}:::cond
    c4 -->|"Yes"| e4["①の各アピール中のみ<br/>自身の命中率を+20%"]:::effect --> a1
    c4 -->|"No"| a1["①実行:<br/>ライバルへ<br/>基本400%+固定値 自身の最大アピールの20%"]:::action
    a1 --> lc{"①のアピール5回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c5{"⑤:①のアピールでライバルが<br/>リタイアしなかった、または<br/>自身の「希望」状態のターン数が<br/>10ターン以上か"}:::cond
    c5 -->|"Yes"| a1b["①を再度実行<br/>(再実行は最大1回まで)"]:::action --> finish
    c5 -->|"No"| finish(("終了")):::startend
