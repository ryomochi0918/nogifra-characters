flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>デバフ耐性貫通を+25%する"]:::effect
    e1 --> c3{"③:自身のバイタリティが②の<br/>アピール対象のバイタリティ以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール時のみ①による<br/>デバフ耐性貫通の増加倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル4名に550%のアピールを<br/>行い、100%の確率で3ターンの間<br/>「アピール力ダウン」状態にする"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:自身が「瞑想」状態か"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c5 -->|"Yes"| e5["④の「声援」状態の効果倍率が<br/>1.5倍になる"]:::effect
    c5 -->|"No"| e4["④:最大アピールが最も高い味方3名の<br/>デバフ・サゲ効果を1つ解除し、<br/>2ターンの間「声援」状態にし、<br/>HPを自身のHP上限の20%分回復する"]:::effect
    e5 --> e4
    e4 --> finish(("終了")):::startend
