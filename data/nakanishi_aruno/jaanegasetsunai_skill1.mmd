flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①実行:<br/>このスキル中、<br/>自身のデバフ耐性貫通を+25%"]:::effect
    e1 --> c3{"③:自身のバイタリティが<br/>②のアピール対象のバイタリティ以上か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール時のみ<br/>①によるデバフ耐性貫通の<br/>増加倍率が2倍に"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>最大アピールが最も高いライバル4名へ<br/>基本550%のアピールを行い、<br/>100%の確率で3ターンの間<br/>「アピール力ダウン」状態にする"]:::action
    a2 --> lc{"②のアピール4名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c3
    lc -->|"Yes"| c5{"⑤:自身が「瞑想」状態か"}:::cond
    c5 -->|"Yes"| e5["④の「声援」状態の<br/>効果倍率が1.5倍に"]:::effect --> e4
    c5 -->|"No"| e4["④実行:<br/>最大アピールが最も高い味方3名の<br/>デバフ・サゲ効果を1つ解除し、<br/>2ターンの間「声援」状態にし、<br/>HPを自身のHP上限の20%分回復"]:::effect
    e4 --> finish(("終了")):::startend
