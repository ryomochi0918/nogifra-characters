flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①のアピールに自身のスマイルの<br/>3倍を固定値として上乗せする"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに3回、バフ・アゲ効果を<br/>2つ解除し、500%のアピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>3回すべて完了?"}:::cond
    lc1 -->|"Yes"| c3_2{"③:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    lc1 -->|"No、次の回へ"| c3
    c3_2 -->|"Yes"| e3_2["②のアピールに自身のスマイルの<br/>3倍を固定値として上乗せする"]:::effect
    c3_2 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに3回、バフ・アゲ効果を<br/>2つ解除し、500%のアピールを行う"]:::action
    e3_2 --> a2
    a2 --> lc2{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"Yes"| e4["④:残りHP割合が最も低い<br/>味方3名のHPをこのスキルで行った<br/>合計アピールの30%分回復し、<br/>2ターンの間「陽動」状態にする"]:::effect
    lc2 -->|"No、次の回へ"| c3_2
    e4 --> finish(("終了")):::startend
