flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③:②の対象が<br/>バフ・アゲ効果状態ではないか<br/>(②の各効果前)"}:::cond
    c3 -->|"Yes"| e3["②の対象を100%の確率で2ターンの<br/>間「空腹」状態にする"]:::effect
    c3 -->|"No"| e2["②:①のアピール対象の<br/>バフ・アゲ効果を1つ解除する<br/>(①の各アピール前)"]:::effect
    e3 --> e2
    e2 --> a1["①実行:残りHP割合が最も高い<br/>ライバル6名に自身の残りHP20%分の<br/>固定値を上乗せした550%の<br/>アピールを行う"]:::action
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| a4["④実行:残りHP割合が最も低い<br/>ライバルに2回、自身の残りHP15%分の<br/>固定値を上乗せした400%の<br/>アピールを行う"]:::action
    lc1 -->|"No、次の対象へ"| c3
    a4 --> c5{"⑤:このスキルでライバルが<br/>リタイアしたか"}:::cond
    c5 -->|"Yes"| e5["自身と自身を除いた残りHP割合が<br/>最も低い味方1名のHPを自身の<br/>アピール力の100%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
