flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:残りHP割合が最も高い<br/>ライバルに3回、自身のサンクスの<br/>2.5倍を固定値として上乗せした560%の<br/>アピールを行う"]:::action
    a1 --> a2["②実行:残りHP割合が最も低い<br/>ライバル4名に自身のサンクスの<br/>2.5倍を固定値として上乗せした560%の<br/>アピールを行う"]:::action
    a2 --> c3{"③:②のアピール対象の<br/>残りHP割合が30%未満か<br/>(②の各アピール後)"}:::cond
    c3 -->|"Yes"| a3["③実行:②と同じ対象に4000%の<br/>アピールを行う"]:::action
    c3 -->|"No"| lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    a3 --> lc2
    lc2 -->|"Yes"| e4["④:残りHP割合が最も高い<br/>ライバル3名を100%の確率で3ターンの<br/>間「命中率ダウン」状態にする"]:::effect
    lc2 -->|"No、次の対象へ"| a2
    e4 --> finish(("終了")):::startend
