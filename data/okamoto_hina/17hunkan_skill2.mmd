flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールにアピール対象の<br/>HP上限1.5%分の固定値を上乗せし、<br/>①の各アピール中のみ、自身の<br/>命中率を+20%する"]:::effect
    c2 -->|"No"| a1["①実行:ライバル4名のバフ・アゲ効果を<br/>1つ解除し、500%のアピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c3 -->|"Yes(再実行は最大1回まで)"| c2
    c3 -->|"No"| e4["④:自身と自身以外の残りHP割合が<br/>最も低い味方2名を3ターンの間<br/>「ディフェンスアップ」状態にし、<br/>①で行った合計アピールの<br/>30%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
