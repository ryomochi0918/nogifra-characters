flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"②:自身の残りHP割合が<br/>対象の残りHP割合以上か"}:::cond
    c1 -->|"Yes"| a1["①実行(強化):バフ・アゲ効果を<br/>1つ解除し、対象のHP上限1.5%分を<br/>固定値として上乗せした500%の<br/>アピール(このアピール中、<br/>自身の命中率+20%)"]:::action --> loop1{"対象4名<br/>すべて完了?"}:::cond
    c1 -->|"No"| a2["①実行(通常):バフ・アゲ効果を<br/>1つ解除し、500%のアピールを行う"]:::action --> loop1
    loop1 -->|"No、次の対象へ"| c1
    loop1 -->|"Yes"| c2{"③:①のアピールで<br/>ライバルがリタイア<br/>しなかったか"}:::cond
    c2 -->|"Yes"| a3["再度①を実行する<br/>(再実行は最大1回まで)"]:::action --> a4
    c2 -->|"No"| a4["④実行:自身と自身以外の<br/>残りHP割合が最も低い味方2名を<br/>3ターンの間「ディフェンスアップ」<br/>状態にし、①で行った合計アピールの<br/>30%分回復する"]:::action --> finish(("終了")):::startend
