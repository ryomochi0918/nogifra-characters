flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②/③:①の対象の残りHP割合が50%未満か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["②:①のデバフ・サゲ効果解除数が<br/>全て解除になり、HP回復倍率が<br/>2倍になり、①の対象を3ターンの間<br/>「堅忍」状態にする"]:::effect
    c2 -->|"No"| e3["③:①の対象を3ターンの間「集中」<br/>状態にする"]:::effect
    e2 --> e1["①:残りHP割合が最も低い味方4名の<br/>デバフ・サゲ効果を2つ解除し、HPを<br/>自身のアピール力の150%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect
    e3 --> e1
    e1 --> lc1{"①の効果<br/>対象4名すべて完了?"}:::cond
    lc1 -->|"Yes"| e4["④:自身と自身以外の残りHP割合が<br/>最も低い味方2名を3ターンの間<br/>「勇気」状態にする"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e4 --> finish(("終了")):::startend
