flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③:①の各アピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:①の各アピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(①の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["①の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a1["①実行:ライバル4名に<br/>自身の最大アピールの30%を<br/>固定値として上乗せした550%の<br/>アピールを行い、100%の確率で<br/>4ターンの間「嫉妬」状態にする"]:::action
    e4 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c3_2{"③:②の各アピール対象が<br/>デバフ・サゲ効果状態か<br/>(②の各アピール前)"}:::cond
    lc1 -->|"No、次の対象へ"| c3
    c3_2 -->|"Yes"| e3_2["②の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3_2 -->|"No"| c4_2{"④:②の各アピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(②の各アピール前)"}:::cond
    e3_2 --> c4_2
    c4_2 -->|"Yes"| e4_2["②の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4_2 -->|"No"| a2["②実行:ライバルに3回、<br/>自身の最大アピールの30%を<br/>固定値として上乗せした550%の<br/>アピールを行い、100%の確率で<br/>4ターンの間「嫉妬」状態にする"]:::action
    e4_2 --> a2
    a2 --> lc2{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3_2
