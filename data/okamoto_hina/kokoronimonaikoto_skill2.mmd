flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③:対象がデバフ・サゲ<br/>効果状態か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> c4
    c3 -->|"No"| c4{"④:対象がバフ・アゲ<br/>効果状態ではないか"}:::cond
    c4 -->|"Yes"| e4["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> a1
    c4 -->|"No"| a1["①実行:ライバル4名へ、自身の<br/>最大アピールの30%を固定値として<br/>上乗せした550%のアピールを行い、<br/>100%の確率で4ターンの間<br/>「嫉妬」状態にする"]:::action --> loop1{"ライバル4名<br/>すべて完了?"}:::cond
    loop1 -->|"No、次の対象へ"| c3
    loop1 -->|"Yes"| c3b{"③:対象がデバフ・サゲ<br/>効果状態か"}:::cond
    c3b -->|"Yes"| e3b["②のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> c4b
    c3b -->|"No"| c4b{"④:対象がバフ・アゲ<br/>効果状態ではないか"}:::cond
    c4b -->|"Yes"| e4b["②のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> a2
    c4b -->|"No"| a2["②実行:ライバルへ3回、自身の<br/>最大アピールの30%を固定値として<br/>上乗せした550%のアピールを行い、<br/>100%の確率で4ターンの間<br/>「嫉妬」状態にする"]:::action --> loop2{"3回すべて<br/>完了?"}:::cond
    loop2 -->|"No、次の回へ"| c3b
    loop2 -->|"Yes"| finish(("終了")):::startend
