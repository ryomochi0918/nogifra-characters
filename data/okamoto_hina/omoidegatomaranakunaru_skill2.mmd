flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>会心率を+25%する"]:::effect --> a2["②実行:ライバル5名へ<br/>400%のアピール"]:::action --> c4{"④:②・③のアピールで失敗<br/>またはアピールが0であることが<br/>一度でも発生したか"}:::cond
    c4 -->|"Yes"| e4["以降の②・③のアピールを<br/>必ず命中させる"]:::effect --> c5
    c4 -->|"No"| c5{"⑤:③のアピールが1以上<br/>であることが2回以上<br/>発生したか"}:::cond
    c5 -->|"Yes"| e5["③のアピール倍率を<br/>3倍にする"]:::effect --> a3
    c5 -->|"No"| a3["③実行:残りHP割合が最も低い<br/>ライバルへ700%のアピール"]:::action --> loop1{"5回すべて<br/>完了?"}:::cond
    loop1 -->|"No、次の回へ"| c4
    loop1 -->|"Yes"| finish(("終了")):::startend
