flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>会心率を+25%する"]:::effect --> c4a
    c4a{"④:②と③のアピールでアピールの失敗または<br/>アピールが0である事が一度でも発生したか<br/>(②と③の各アピール前)"}:::cond
    c4a -->|"Yes"| e4a["②と③のアピールは<br/>必ず命中する"]:::effect --> a2
    c4a -->|"No"| a2["②実行:<br/>ライバル5名へ400%のアピール"]:::action
    a2 --> lc2{"②のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c4a
    lc2 -->|"Yes"| c4b
    c4b{"④:②と③のアピールでアピールの失敗または<br/>アピールが0である事が一度でも発生したか<br/>(②と③の各アピール前)"}:::cond
    c4b -->|"Yes"| e4b["②と③のアピールは<br/>必ず命中する"]:::effect --> c5
    c4b -->|"No"| c5{"⑤:③のアピールが1以上である事が<br/>2回以上発生したか<br/>(③の各アピール前)"}:::cond
    c5 -->|"Yes"| e5["③のアピール倍率が<br/>3倍になる"]:::effect --> a3
    c5 -->|"No"| a3["③実行:残りHP割合が最も低い<br/>ライバルに5回、700%のアピール"]:::action
    a3 --> lc3{"③のアピール<br/>5回すべて完了?"}:::cond
    lc3 -->|"No、次の回へ"| c4b
    lc3 -->|"Yes"| finish(("終了")):::startend
