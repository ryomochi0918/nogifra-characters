flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+25%する"]:::effect
    e1 --> c4{"④:②と③のアピールでアピールの<br/>失敗またはアピールが0である事が<br/>一度でも発生したか<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②のアピールは必ず命中する"]:::effect
    c4 -->|"No"| a2["②実行:ライバル5名に400%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc2 -->|"Yes"| c4_2{"④:②と③のアピールでアピールの<br/>失敗またはアピールが0である事が<br/>一度でも発生したか<br/>(③の各アピール前)"}:::cond
    lc2 -->|"No、次の対象へ"| c4
    c4_2 -->|"Yes"| e4_2["③のアピールは必ず命中する"]:::effect
    c4_2 -->|"No"| c5{"⑤:③のアピールが1以上である事が<br/>2回以上発生したか<br/>(③の各アピール前)"}:::cond
    e4_2 --> c5
    c5 -->|"Yes"| e5["③のアピール倍率が3倍になる"]:::effect
    c5 -->|"No"| a3["③実行:残りHP割合が最も低い<br/>ライバルに5回、700%のアピールを行う"]:::action
    e5 --> a3
    a3 --> lc3{"③のアピール<br/>5回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c4_2
