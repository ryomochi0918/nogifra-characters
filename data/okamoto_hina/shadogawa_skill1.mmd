flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>会心率を+30%し、自身を3ターンの間<br/>「軽快」状態にする"]:::effect --> c3{"③:自身の残りHP割合が<br/>50%以上か"}:::cond
    c3 -->|"Yes"| e3["対象のバフ・アゲ効果を1つ解除し、<br/>自身のサンクスの4倍を<br/>固定値として上乗せする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルへ900%のアピール"]:::action --> loop1{"対象4名<br/>すべて完了?"}:::cond
    loop1 -->|"No、次の対象へ"| c3
    loop1 -->|"Yes"| c5{"⑤:②のアピールで<br/>会心アピールが発生したか"}:::cond
    c5 -->|"Yes"| e5["「②で発生した会心アピールの<br/>回数×自身のサンクス」を<br/>④のアピールの固定値に加算する"]:::effect --> a4
    c5 -->|"No"| a4["④実行:最大アピールが最も高い<br/>ライバル2名へ、自身のサンクスの3倍を<br/>固定値として上乗せした750%の<br/>アピール"]:::action --> finish(("終了")):::startend
