flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+30%し、自身を3ターンの<br/>間「軽快」状態にする"]:::effect
    e1 --> c3{"③:自身の残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象の<br/>バフ・アゲ効果を1つ解除し、<br/>②のアピールに自身のサンクスの<br/>4倍を固定値として上乗せする"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル4名に900%のアピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:②のアピールで会心アピールが<br/>発生したか"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c5 -->|"Yes"| e5["「②のアピールで発生した<br/>会心アピールの回数×自身のサンクス」<br/>を④のアピールの固定値に加算する"]:::effect
    c5 -->|"No"| a4["④実行:最大アピールが最も高い<br/>ライバル2名に自身のサンクスの<br/>3倍を固定値として上乗せした750%の<br/>アピールを行う"]:::action
    e5 --> a4
    a4 --> finish(("終了")):::startend
