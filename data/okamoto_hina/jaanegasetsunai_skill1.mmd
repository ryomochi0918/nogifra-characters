flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>サゲ効果耐性貫通を+20%する"]:::effect
    e1 --> a2["②実行:ライバル4名に840%の<br/>アピールを行う"]:::action
    a2 --> c4{"④:ライバルチームの<br/>フロント人数が3名以下か"}:::cond
    c4 -->|"Yes"| e4["③による「雑音」状態の確率を+20%し、<br/>①によるサゲ効果耐性貫通の<br/>増加倍率が40%になる"]:::effect
    c4 -->|"No"| e3["③:②の各アピール前に自身のスマイルが<br/>②のアピール対象のスマイル以上だった回数を<br/>対象人数として、最大アピールが最も高い<br/>ライバルを80%の確率で2ターンの間<br/>「雑音」状態にする"]:::effect
    e4 --> e3
    e3 --> c6{"⑥:⑤の効果対象の<br/>残りHP割合が50%以上か"}:::cond
    c6 -->|"Yes"| e6["⑤の効果対象のバフ・アゲ効果を<br/>全て解除する"]:::effect
    c6 -->|"No"| e5["⑤:最大アピールが最も高いライバル1名を<br/>100%の確率で2ターンの間<br/>「執着」状態にする"]:::effect
    e6 --> e5
    e5 --> finish(("終了")):::startend
