flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>対象の残りHP割合以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> c3
    c2 -->|"No"| c3{"③:対象が「雑音」状態か"}:::cond
    c3 -->|"Yes"| e3["①に自身の残りSPの40倍を<br/>固定値として上乗せする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:自身の最大アピールの20%を<br/>固定値として上乗せした480%の<br/>アピール"]:::action --> loop1{"5回すべて<br/>完了?"}:::cond
    loop1 -->|"No、次の回へ"| c2
    loop1 -->|"Yes"| c4{"④:①のアピールで<br/>リタイアしたライバルが<br/>1名以下か"}:::cond
    c4 -->|"Yes"| a4["残りHP割合が最も低い<br/>ライバルに1回、①で行った<br/>合計アピールの40%分の<br/>アピールを行う<br/>(ディフェンス、メンタルを無視)"]:::action --> a5
    c4 -->|"No"| a5["⑤実行:自身のHPをこのスキルで<br/>行った合計アピールの20%分回復し、<br/>3ターンの間「勇気」状態にする"]:::action --> finish(("終了")):::startend
