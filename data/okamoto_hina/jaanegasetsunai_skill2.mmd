flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が「雑音」状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピールに自身の残りSPの<br/>40倍を固定値として上乗せする"]:::effect
    c3 -->|"No"| a1["①実行:ライバルに5回、<br/>自身の最大アピールの20%を<br/>固定値として上乗せした480%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールでリタイアした<br/>ライバルが1名以下か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes"| a4["④実行:残りHP割合が最も<br/>低いライバルに1回、①で<br/>行った合計アピールの40%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    c4 -->|"No"| e5["⑤:自身のHPをこのスキルで行った<br/>合計アピールの20%分回復し、<br/>3ターンの間「勇気」状態にする"]:::effect
    a4 --> e5
    e5 --> finish(("終了")):::startend
