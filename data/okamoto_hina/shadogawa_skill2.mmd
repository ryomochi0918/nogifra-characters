flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身の状態に応じて②か③の<br/>効果どちらかを適用する"]:::effect
    e1 --> c2{"②/③:自身が「回避率アップ」状態か"}:::cond
    c2 -->|"Yes"| e2["②:自身の「回避率アップ」状態を<br/>解除し、自身を3ターンの間「旋回」<br/>状態にする"]:::effect
    c2 -->|"No"| e3["③:自身を2ターンの間<br/>「回避率アップ」状態にする"]:::effect
    e2 --> c5{"⑤:④のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(④の各アピール前)"}:::cond
    e3 --> c5
    c5 -->|"Yes"| e5["④のアピール倍率と<br/>固定値倍率が3倍になる"]:::effect
    c5 -->|"No"| a4["④実行:最大アピールが最も高い<br/>ライバルに6回、自身の最大アピールの<br/>25%を固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e5 --> a4
    a4 --> e6["⑥:自身のHPを直前のアピールの<br/>30%分回復する<br/>(④の各アピール後)"]:::effect
    e6 --> lc4{"④のアピール<br/>6回すべて完了?"}:::cond
    lc4 -->|"Yes"| finish(("終了")):::startend
    lc4 -->|"No、次の回へ"| c5
