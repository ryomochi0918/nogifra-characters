flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身が「回避率アップ」<br/>状態か"}:::cond
    c1 -->|"Yes"| e2["②:自身の「回避率アップ」状態を<br/>解除し、自身を3ターンの間<br/>「旋回」状態にする"]:::effect --> c5{"⑤:対象がバフ・アゲ<br/>効果状態ではないか"}:::cond
    c1 -->|"No"| e3["③:自身を2ターンの間<br/>「回避率アップ」状態にする"]:::effect --> c5
    c5 -->|"Yes"| e5["④のアピール倍率と<br/>固定値倍率を3倍にする"]:::effect --> a4
    c5 -->|"No"| a4["④実行:最大アピールが最も高い<br/>ライバルへ、自身の最大アピールの25%を<br/>固定値として上乗せした500%の<br/>アピール"]:::action --> e6["⑥:自身のHPを直前の<br/>アピールの30%分回復する"]:::effect --> loop1{"6回すべて<br/>完了?"}:::cond
    loop1 -->|"No、次の回へ"| c5
    loop1 -->|"Yes"| finish(("終了")):::startend
