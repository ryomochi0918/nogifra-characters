flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になる"]:::effect
    c2 -->|"No"| c4{"④:①の各アピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c4
    c4 -->|"Yes"| e4["①の各アピールは<br/>必ず会心アピールになる"]:::effect
    c4 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに6回、バフ・アゲ効果を<br/>1つ解除し500%のアピールを行う"]:::action
    e4 --> a1
    a1 --> c5{"⑤:①の各アピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(①の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["アピール対象を100%の確率で<br/>4ターンの間「心労」状態にする"]:::effect
    c5 -->|"No"| lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    e5 --> lc1
    lc1 -->|"Yes"| c4_2{"④:③の各アピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か<br/>(③の各アピール前)"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4_2 -->|"Yes"| e4_2["③の各アピールは<br/>必ず会心アピールになる"]:::effect
    c4_2 -->|"No"| a3["③実行:最大アピールが最も<br/>高いライバル1名にこのスキルで<br/>行った合計アピールの40%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    e4_2 --> a3
    a3 --> c5_2{"⑤:③の各アピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(③の各アピール後)"}:::cond
    c5_2 -->|"Yes"| e5_2["アピール対象を100%の確率で<br/>4ターンの間「心労」状態にする"]:::effect
    c5_2 -->|"No"| finish(("終了")):::startend
    e5_2 --> finish
