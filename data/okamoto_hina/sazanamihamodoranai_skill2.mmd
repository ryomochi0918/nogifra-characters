flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身のHPを自身のHP上限の<br/>40%分回復する"]:::effect
    e1 --> c3{"③:②のアピール対象の<br/>残りHP割合が80%以下か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに6回、350〜700%の<br/>アピールを行う(自身の残りHP割合が<br/>高いほど倍率が高くなる)"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピール対象の<br/>残りHP割合が40%以下か<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| a4["④実行:ライバル1名に自身の<br/>サンクスの4倍分のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action
    c4 -->|"No"| lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    a4 --> lc2
    lc2 -->|"Yes"| e5["⑤:最大アピールが最も高い<br/>ライバル2名を100%の確率で3ターンの<br/>間「命中率ダウン」状態にする"]:::effect
    lc2 -->|"No、次の回へ"| c3
    e5 --> finish(("終了")):::startend
