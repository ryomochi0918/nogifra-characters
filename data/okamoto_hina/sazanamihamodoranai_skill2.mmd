flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:自身のHPを自身の<br/>HP上限の40%分回復する"]:::action --> c3{"③:対象の残りHP割合が<br/>80%以下か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率を<br/>2倍にする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバルへ350〜700%の<br/>アピール(自身の残りHP割合が<br/>高いほど倍率が高くなる)"]:::action --> c4{"④:対象の残りHP割合が<br/>40%以下か"}:::cond
    c4 -->|"Yes"| a4["ライバル1名に自身のサンクスの<br/>4倍分のアピールを行う<br/>(ディフェンス、フィジカルを無視)"]:::action --> loop1
    c4 -->|"No"| loop1{"6回すべて<br/>完了?"}:::cond
    loop1 -->|"No、次の回へ"| c3
    loop1 -->|"Yes"| a5["⑤実行:最大アピールが最も高い<br/>ライバル2名を100%の確率で<br/>3ターンの間「命中率ダウン」状態にする"]:::action --> finish(("終了")):::startend
