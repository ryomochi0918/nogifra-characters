flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが<br/>対象のエフォート以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> e3
    c2 -->|"No"| e3["③:ライブ中、スキル1・スキル2で<br/>ライバルをリタイアさせた回数×<br/>自身のエフォートの2倍を固定値として<br/>上乗せする(最大6倍まで)"]:::effect --> a1["①実行:自身の最大アピールの45%を<br/>固定値として上乗せした300%の<br/>アピール"]:::action --> loop1{"5回すべて<br/>完了?"}:::cond
    loop1 -->|"No、次の回へ"| c2
    loop1 -->|"Yes"| c4{"④:フロントの特殊状態合計<br/>ターン数が15ターン以上、<br/>または①でライバルが<br/>リタイアしたか"}:::cond
    c4 -->|"Yes"| a4["再度①を実行する<br/>(再実行は1回まで)"]:::action --> a5
    c4 -->|"No"| a5["⑤実行:自身のHPをこのスキルで<br/>行った合計アピールの40%分<br/>回復する"]:::action --> finish(("終了")):::startend
