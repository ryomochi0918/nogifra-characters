flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| e3["③:ライブ中、自身が使用したスキル1<br/>「ルンバ下さい!」とスキル2「魂の<br/>叫び」でライバルをリタイアさせた<br/>回数×自身のエフォートの2倍を<br/>固定値として上乗せする(エフォートの<br/>最大倍率は6倍まで)<br/>(①の各アピール前)"]:::effect
    e2 --> e3
    e3 --> a1["①実行:ライバルに5回、<br/>自身の最大アピールの45%を<br/>固定値として上乗せした300%の<br/>アピールを行う"]:::action
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:ライバルチームのフロントの<br/>特殊状態の合計ターン数が<br/>15ターン以上または①のアピールで<br/>ライバルがリタイアしたか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| e5["⑤:自身のHPをこのスキルで行った<br/>合計アピールの40%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
