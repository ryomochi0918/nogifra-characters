flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>サゲ効果耐性貫通を+25%する"]:::effect --> c3{"③:対象がデバフ・サゲ<br/>効果状態か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率を<br/>2.5倍にする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルへ340%のアピール"]:::action --> e4["④:対象を100%の確率で<br/>3ターンの間「緊張」状態にする"]:::effect --> c5{"⑤:②のアピールが失敗<br/>またはアピールが0だったか"}:::cond
    c5 -->|"Yes"| a5["対象に850%のアピールを行う"]:::action --> loop1
    c5 -->|"No"| loop1{"6回すべて<br/>完了?"}:::cond
    loop1 -->|"No、次の回へ"| c3
    loop1 -->|"Yes"| finish(("終了")):::startend
