flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>サゲ効果耐性貫通を+25%する"]:::effect
    e1 --> c3{"③:②のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2.5倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルに6回、340%のアピールを行う"]:::action
    e3 --> a2
    a2 --> e4["④:②のアピール対象を100%の確率で<br/>3ターンの間「緊張」状態にする<br/>(②の各アピール後)"]:::effect
    e4 --> c5{"⑤:②のアピールでアピールの失敗<br/>またはアピールが0だったか<br/>(②の各アピール後)"}:::cond
    c5 -->|"Yes"| a5["⑤実行:②のアピール対象に850%の<br/>アピールを行う"]:::action
    c5 -->|"No"| lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    a5 --> lc2
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
