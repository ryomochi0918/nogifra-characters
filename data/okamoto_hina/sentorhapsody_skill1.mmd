flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+20%する"]:::effect
    e1 --> c3{"③:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| a2["②実行:ライバル4名に<br/>自身のエフォートの6倍を<br/>固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:③の効果によってバフ・アゲ効果の<br/>解除に成功したまたは②の<br/>アピール対象が特殊状態か<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| a4["④実行:②のアピール対象に<br/>自身のエフォートの12倍を<br/>固定値として上乗せした900%の<br/>アピールを行う"]:::action
    c4 -->|"No"| lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    a4 --> lc2
    lc2 -->|"Yes"| c6{"⑥:ライバルチームのフロントの<br/>特殊状態の合計ターン数が<br/>7ターン以上か"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c6 -->|"Yes"| e6["⑤のアピール倍率が2倍になる"]:::effect
    c6 -->|"No"| a5["⑤実行:残りHP割合が最も低い<br/>ライバル1名に2回、②のアピールで<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    e6 --> a5
    a5 --> finish(("終了")):::startend
