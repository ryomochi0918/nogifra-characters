flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>リフレクト耐性を+20%する"]:::effect --> c3{"③:自身のエフォートが<br/>対象のエフォート以上か"}:::cond
    c3 -->|"Yes"| e3["対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect --> a2
    c3 -->|"No"| a2["②実行:自身のエフォートの6倍を<br/>固定値として上乗せした600%の<br/>アピール"]:::action --> c4{"④:③の解除に成功、<br/>または対象が特殊状態か"}:::cond
    c4 -->|"Yes"| a4["対象に自身のエフォートの12倍を<br/>固定値として上乗せした900%の<br/>アピールを行う"]:::action --> loop1
    c4 -->|"No"| loop1{"対象4名<br/>すべて完了?"}:::cond
    loop1 -->|"No、次の対象へ"| c3
    loop1 -->|"Yes"| c6{"⑥:ライバルチームの<br/>フロントの特殊状態合計<br/>ターン数が7ターン以上か"}:::cond
    c6 -->|"Yes"| e6["⑤のアピール倍率を<br/>2倍にする"]:::effect --> a5
    c6 -->|"No"| a5["⑤実行:残りHP割合が最も低い<br/>ライバル1名に2回、②のアピールで<br/>行った合計アピールの30%分の<br/>アピールを行う<br/>(ディフェンス、フィジカルを無視)"]:::action --> finish(("終了")):::startend
