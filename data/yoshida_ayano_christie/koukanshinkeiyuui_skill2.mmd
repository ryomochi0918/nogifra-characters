flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果<br/>解除数が1つ増加する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル5名のバフ・アゲ効果を<br/>1つ解除し、自身のSP上限の150倍を<br/>固定値として上乗せした900%の<br/>アピールを行う"]:::action
    a1 --> c4{"④:①で解除した<br/>バフ・アゲ効果の数が<br/>3つ以上か"}:::cond
    c4 -->|"Yes"| e4["③の効果対象を<br/>1名増加する"]:::effect --> a3
    c4 -->|"No"| a3["③実行:残りHP割合が最も低い味方1名の<br/>HPを①で行った合計アピールの30%分<br/>回復し、3ターンの間「脚光」状態にする"]:::effect
    a3 --> e5["⑤:味方6名を3ターンの間<br/>「アピールガード(努力)」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
