flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①実行:自身を3ターンの間<br/>「音響」状態にし、このスキル中のみ<br/>自身のサゲ効果耐性貫通を+30%する"]:::effect
    e1 --> c3{"③:自身のバイタリティが②の<br/>アピール対象のバイタリティ<br/>以上か(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象を100%の確率で<br/>2ターンの間「嫉妬」状態にする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバル2名へ、自身の低下<br/>したHPの30%分を固定値として<br/>上乗せした700%のアピール<br/>(2回目以降のアピールは対象を選び直す)"]:::action
    a2 --> lc{"②のアピール<br/>2回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| c4{"④:②のアピールでライバルが<br/>リタイアしていないか<br/>(再実行は最大1回まで)"}:::cond
    c4 -->|"Yes"| c3
    c4 -->|"No"| c6{"⑥:⑤の効果前、②のアピールで<br/>ライバルがリタイアしていたか"}:::cond
    c6 -->|"Yes"| e6["⑤による「反響」状態の<br/>リフレクト倍率が1.5倍になる"]:::effect --> e5
    c6 -->|"No"| e5["⑤実行:自身のHPをこのスキルで<br/>行った合計アピールの30%分回復し、<br/>3ターンの間「反響」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
