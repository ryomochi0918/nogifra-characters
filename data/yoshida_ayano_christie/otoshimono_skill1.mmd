flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間「音響」<br/>状態にし、このスキル中のみ自身の<br/>サゲ効果耐性貫通を+30%する"]:::effect
    e1 --> c3{"③:自身のバイタリティが②の<br/>アピール対象のバイタリティ以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象を100%の確率で<br/>2ターンの間「嫉妬」状態にする"]:::effect
    c3 -->|"No"| a2["②実行:ライバル2名に2回、<br/>自身の低下したHPの30%分を<br/>固定値として上乗せした700%の<br/>アピールを行う(2回目以降の<br/>アピールは対象を選び直す)"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc2 -->|"Yes"| lc2n{"②のアピール<br/>2回すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2n -->|"Yes"| c4{"④:②のアピールでライバルが<br/>リタイアしていないか"}:::cond
    lc2n -->|"No、次の回へ"| c3
    c4 -->|"Yes(再実行は最大1回まで)"| c3
    c4 -->|"No"| c6{"⑥:②のアピールでライバルが<br/>リタイアしていたか"}:::cond
    c6 -->|"Yes"| e6["⑤による「反響」状態の<br/>リフレクト倍率が1.5倍になる"]:::effect
    c6 -->|"No"| e5["⑤:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復し、<br/>3ターンの間「反響」状態にする"]:::effect
    e6 --> e5
    e5 --> finish(("終了")):::startend
