flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象の<br/>バフ・アゲ効果状態を1つ解除する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバルへ、自身のサンクスの<br/>3倍分を固定値として上乗せした<br/>380%のアピール"]:::action
    a1 --> lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| e4["④実行:残りHP割合が最も高いライバル<br/>3名の中からバフ・アゲ効果状態では<br/>ないライバルを100%の確率で<br/>1ターンの間「転倒」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
