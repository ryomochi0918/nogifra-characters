flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身のリフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:自身の残りHP割合が②の<br/>アピール対象の残りHP割合<br/>以上か(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ<br/>自身の会心率を+30%する"]:::effect --> a2
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル4名へ、自身の最大アピールの<br/>20%を固定値として上乗せした<br/>410%のアピール"]:::action
    a2 --> c4{"④:②のアピールで<br/>会心アピールが発生したか<br/>(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| a4["②のアピール対象のバフ・アゲ効果を<br/>全て解除し、同じ対象に自身の最大<br/>アピールの40%を固定値として<br/>上乗せした820%のアピール"]:::action --> e5
    c4 -->|"No"| e5["⑤実行:自身のHPをこのスキルで<br/>行った合計アピールの30%分回復する<br/>(④が発動した場合は④の後)"]:::effect
    e5 --> finish(("終了")):::startend
