flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ自身の<br/>会心率を+30%する"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル4名に自身の最大アピールの<br/>20%を固定値として上乗せした410%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールで会心アピールが<br/>発生したか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| a4["④実行:②のアピール対象の<br/>バフ・アゲ効果を全て解除し、<br/>同じ対象に自身の最大アピールの<br/>40%を固定値として上乗せした820%の<br/>アピールを行う"]:::action
    c4 -->|"No"| lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    a4 --> lc2
    lc2 -->|"Yes"| e5["⑤:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e5 --> finish(("終了")):::startend
