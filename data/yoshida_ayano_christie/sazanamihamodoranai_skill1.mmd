flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル4名に自身のエフォートの<br/>1.5倍を固定値として上乗せした700%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象が1名増加する<br/>(増加人数は最大で2名まで)"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>対象すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| a4["④実行:①の各アピール対象の<br/>残りHP割合が50%未満または、<br/>①の各アピールにてリタイアさせた<br/>ライバルの人数をアピール回数として、<br/>ライバルに自身のエフォート5倍分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a4 --> finish(("終了")):::startend
