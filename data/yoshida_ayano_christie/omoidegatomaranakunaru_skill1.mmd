flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ<br/>自身のリフレクト耐性を+20%する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>残りHP割合が最も低いライバルへ、<br/>自身のスマイルの4倍を固定値として<br/>上乗せした基本500%のアピールを行う"]:::action
    a1 --> lc{"①のアピール5回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| e3["③実行:<br/>自身と自身以外の残りHP割合が<br/>最も低い味方1名のHPを<br/>①で行った合計アピールの50%分回復する"]:::effect
    e3 --> e4["④実行:<br/>自身を1ターンの間「円陣」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
