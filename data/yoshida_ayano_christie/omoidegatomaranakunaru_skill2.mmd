flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:<br/>最大アピールが最も高いライバル4名の<br/>バフ・アゲ効果を1つ解除し、<br/>自身の最大アピールの65%を<br/>固定値として上乗せした<br/>基本700%のアピールを行う"]:::action
    a1 --> lc1{"①のアピール4名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| a1
    lc1 -->|"Yes"| e2["②実行:<br/>最大アピールが最も高い味方3名のHPを<br/>自身のアピール力100%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect
    e2 --> c3{"③:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c3 -->|"Yes"| a3["③実行:<br/>最大アピールが最も高いライバルへ、<br/>自身の最大アピールの65%を<br/>固定値として上乗せした<br/>基本700%のアピールを行う"]:::action
    a3 --> lc3{"③のアピール4回すべて完了?"}:::cond
    lc3 -->|"No、次の回へ"| a3
    lc3 -->|"Yes"| c4{"④:このスキルでライバルが<br/>リタイアしたか"}:::cond
    c3 -->|"No"| c4
    c4 -->|"Yes"| e4["④実行:<br/>ライバル3名のバフ・アゲ効果を<br/>リタイアした人数分解除する<br/>(解除数は最大で3つまで)"]:::effect --> finish(("終了")):::startend
    c4 -->|"No"| finish
