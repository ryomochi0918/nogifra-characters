flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:最大アピールが最も高い<br/>ライバル4名のバフ・アゲ効果を<br/>1つ解除し、自身の最大アピールの<br/>65%を固定値として上乗せした700%の<br/>アピールを行う"]:::action
    a1 --> e2["②:最大アピールが最も高い味方3名の<br/>HPを自身のアピール力100%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect
    e2 --> c3{"③:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c3 -->|"Yes"| a3["③実行:最大アピールが最も高い<br/>ライバルに4回、自身の最大アピールの<br/>65%を固定値として上乗せした700%の<br/>アピールを行う"]:::action
    c3 -->|"No"| c4{"④:このスキルでライバルが<br/>リタイアしたか"}:::cond
    a3 --> c4
    c4 -->|"Yes"| e4["ライバル3名のバフ・アゲ効果を<br/>リタイアした人数分解除する<br/>(バフ・アゲ効果の解除数は<br/>最大で3つまで)"]:::effect
    c4 -->|"No"| finish(("終了")):::startend
    e4 --> finish
