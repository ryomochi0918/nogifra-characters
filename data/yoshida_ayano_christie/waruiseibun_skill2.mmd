flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象の<br/>バフ・アゲ効果を3つ解除する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル5名を100%の確率で<br/>2ターンの間「ディフェンスダウン」<br/>状態にし、700%のアピール"]:::action
    a1 --> e3["③実行:最大アピールが最も高い<br/>味方2名のHPを①で行った合計<br/>アピールの50%分回復し、<br/>2ターンの間「機敏」状態にする"]:::effect
    e3 --> finish(("終了")):::startend
