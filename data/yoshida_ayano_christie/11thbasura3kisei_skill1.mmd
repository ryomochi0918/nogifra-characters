flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身のリフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:自身の残りHP割合が<br/>70%未満か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>ライバル6名へ、自身のバイタリティの2.5倍を<br/>固定値として上乗せした600%のアピール"]:::action
    a2 --> c5{"⑤:自身が<br/>「反響」状態ではないか"}:::cond
    c5 -->|"Yes"| e5["自身を3ターンの間<br/>「反響」状態にする"]:::effect --> e4
    c5 -->|"No"| e4["④実行:<br/>自身のHPを②で行った<br/>合計アピールの30%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
