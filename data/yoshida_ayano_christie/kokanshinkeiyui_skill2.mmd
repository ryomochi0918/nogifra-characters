flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果解除数が<br/>1つ増加する"]:::effect
    c2 -->|"No"| a1["①実行:ライバル5名のバフ・アゲ効果を<br/>1つ解除し、自身のSP上限の150倍を<br/>固定値として上乗せした900%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①で解除したバフ・アゲ効果の<br/>数が3つ以上か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["③の効果対象を1名増加する"]:::effect
    c4 -->|"No"| e3["③:残りHP割合が最も低い味方1名の<br/>HPを①で行った合計アピールの<br/>30%分回復し、3ターンの間「脚光」<br/>状態にする"]:::effect
    e4 --> e3
    e3 --> e5["⑤:味方6名を3ターンの間<br/>「アピールガード(努力)」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
