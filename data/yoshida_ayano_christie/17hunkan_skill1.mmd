flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身の会心率を+20%する"]:::effect
    e1 --> c3{"③:②のアピール対象の<br/>残りHP割合が50%以上か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が<br/>2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバル5名を100%の確率で<br/>3ターンの間「空腹」状態にし、<br/>540%のアピール"]:::action
    a2 --> c4{"④:②のアピールで<br/>会心アピールが発生したか<br/>(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["②のアピール対象を100%の確率で<br/>1ターンの間「転倒」状態にする"]:::effect --> e5
    c4 -->|"No"| e5["⑤実行:自身を3ターンの間<br/>「防音」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
