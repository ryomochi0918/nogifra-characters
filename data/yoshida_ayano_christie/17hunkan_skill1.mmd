flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+20%する"]:::effect
    e1 --> c3{"③:アピール対象の<br/>残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバル5名を100%の確率で<br/>3ターンの間「空腹」状態にし、<br/>540%のアピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールで会心アピールが<br/>発生したか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["②のアピール対象を100%の確率で<br/>1ターンの間「転倒」状態にする"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>ライバル5名すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| e5["⑤:自身を3ターンの間「防音」<br/>状態にする"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e5 --> finish(("終了")):::startend
