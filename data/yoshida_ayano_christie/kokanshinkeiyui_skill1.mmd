flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象が<br/>デバフ・サゲ効果状態ではないか<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①による「集中」状態の<br/>効果倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:自身以外の最大アピールが最も<br/>高い味方4名を2ターンの間「集中」<br/>状態にし、デバフ・サゲ効果を<br/>2つ解除する"]:::effect
    e2 --> e1
    e1 --> lc1{"①の効果<br/>対象4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:味方フロントに居る<br/>デバフ・サゲ効果状態の<br/>メンバーが3名以下か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["③による「抱擁」状態の<br/>効果倍率が2倍になる"]:::effect
    c4 -->|"No"| e3["③:自身と自身以外の最大アピールが<br/>最も高い味方2名のHPを自身の<br/>HP上限の25%分回復し、3ターンの間<br/>「抱擁」状態にする"]:::effect
    e4 --> e3
    e3 --> finish(("終了")):::startend
