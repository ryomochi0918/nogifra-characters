flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象が<br/>デバフ・サゲ効果状態ではないか<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①による「集中」状態の<br/>効果倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:自身以外の最大アピールが<br/>最も高い味方4名を2ターンの間<br/>「集中」状態にし、デバフ・サゲ効果を<br/>2つ解除する"]:::effect
    a1 --> c4{"④:味方フロントに居る<br/>デバフ・サゲ効果状態のメンバーが<br/>3名以下か"}:::cond
    c4 -->|"Yes"| e4["③による「抱擁」状態の<br/>効果倍率が2倍になる"]:::effect --> a3
    c4 -->|"No"| a3["③実行:自身と自身以外の<br/>最大アピールが最も高い味方2名の<br/>HPを自身のHP上限の25%分回復し、<br/>3ターンの間「抱擁」状態にする"]:::effect
    a3 --> finish(("終了")):::startend
