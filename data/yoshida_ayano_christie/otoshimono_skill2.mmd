flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のリフレクトが①の<br/>アピール対象のリフレクト以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のバイタリティが①の<br/>アピール対象のバイタリティ<br/>以上か(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象の<br/>バフ・アゲ効果を1つ解除する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルへ、自身のバイタリティの<br/>3.5倍を固定値として上乗せした<br/>480%のアピール"]:::action
    a1 --> lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c4{"④:①のアピールでリタイアした<br/>ライバルが1名以下か"}:::cond
    c4 -->|"Yes"| a4["④実行:残りHP割合が最も低い<br/>ライバルへ、①で行った合計アピールの<br/>50%分のアピール<br/>(ディフェンス、フィジカルを無視する)"]:::action
    a4 --> lc4{"④のアピール<br/>2回すべて完了?"}:::cond
    lc4 -->|"No、次の回へ"| a4
    lc4 -->|"Yes"| e5
    c4 -->|"No"| e5["⑤実行:自身のHPを①で行った<br/>合計アピールの30%分回復する<br/>(④が発動した場合は④の後)"]:::effect
    e5 --> finish(("終了")):::startend
