flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間「軽快」<br/>状態にし、このスキル中、自身の<br/>会心率を+20%する"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①による会心率の増加倍率が40%になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに6回、自身のサンクスの<br/>3.5倍を固定値として上乗せした460%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールで会心アピールが<br/>発生したか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["自身の「軽快」状態を解除し、<br/>3ターンの間「旋回」状態にする"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| c5{"⑤:②のアピールで会心アピールが<br/>2回以上発生したか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes"| e5["このスキル中のみ自身の<br/>デバフ耐性貫通を+40%し、<br/>最大アピールが最も高い<br/>ライバル3名を100%の確率で2ターンの<br/>間「命中率ダウン」状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
