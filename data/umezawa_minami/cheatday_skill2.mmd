flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のバイタリティが①の<br/>アピール対象のバイタリティ以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:①のアピール対象の残りHP割合が<br/>50%以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピールに自身のバイタリティの<br/>4倍を固定値として上乗せする"]:::effect --> a1
    c3 -->|"No"| a1
    a1["①実行:<br/>ライバルに5回、バフ・アゲ効果を<br/>1つ解除し、460%のアピールを行う"]:::action --> c4
    c4{"④:直前のアピール対象が<br/>特殊状態だったか"}:::cond
    c4 -->|"Yes"| e4["①のアピール回数が1回増加する<br/>(アピールの追加回数は最大3回まで)"]:::effect --> e5
    c4 -->|"No"| e5
    e5["⑤:自身と自身以外の最大アピールが<br/>最も高い味方1名のデバフ・サゲ効果を<br/>2つ解除し、HPを①で行った<br/>合計アピールの30%分回復する"]:::effect --> c6
    c6{"⑥:⑤の効果対象の残りHP割合が<br/>70%未満か"}:::cond
    c6 -->|"Yes"| e6["⑤のデバフ・サゲ効果解除数が<br/>1つ増加し、3ターンの間<br/>「会心アピール耐性アップ」状態にする"]:::effect --> finish(("終了")):::startend
    c6 -->|"No"| finish
