flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①のアピール対象の<br/>サンクス以上か"}:::cond
    c2 -->|"No"| a1["①実行:<br/>フィジカルが最も高いライバル5名に<br/>600%のアピールを行う<br/>(対象ごとに判定)"]:::action
    c2 -->|"Yes"| c3{"③:①のアピール対象が既に<br/>「弱音」状態か"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象を<br/>2ターンの間「緊張」状態にする"]:::effect --> a1
    c3 -->|"No"| e2["①のアピール対象を100%の確率で<br/>2ターンの間「弱音」状態にする"]:::effect --> a1
    a1 --> lc{"①のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| finish(("終了")):::startend
