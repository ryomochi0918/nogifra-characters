flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+30%する"]:::effect
    e1 --> c3{"③:自身の最大アピールが②の<br/>アピール対象の最大アピール以上<br/>または自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も低い<br/>ライバルに6回、320%のアピールを<br/>行う(このアピールはライバルが<br/>リタイアするまで対象を変更せず、<br/>リタイア回復が発生した場合も<br/>対象を変更しない)"]:::action
    e3 --> a2
    a2 --> c4{"④:前回と同じアピール対象を<br/>選択したか<br/>(度に積算)<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率が2倍になる(④の<br/>効果によるアピール倍率の最大は<br/>10240%、③の効果が同時に発生した<br/>場合の最大は20480%)"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
