flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身の命中率を+30%する"]:::effect --> c3
    c3{"③:自身のスマイルが②のアピール対象の<br/>スマイル以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる"]:::effect --> c4
    c3 -->|"No"| c4
    c4{"④:②のアピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率が2倍になる<br/>(④の効果によるアピール倍率の最大は<br/>1200%、③の効果が同時発生した場合の<br/>最大は2400%)"]:::effect --> a2
    c4 -->|"No"| a2
    a2["②実行:<br/>残りHP割合が最も低いライバルに5回、<br/>600%のアピールを行う"]:::action --> c5
    c5{"⑤:このスキルによってライバルが<br/>リタイアしなかったか"}:::cond
    c5 -->|"Yes"| e5["②を再度実行する<br/>(再実行は最大1回まで)"]:::effect --> e6
    c5 -->|"No"| e6
    e6["⑥:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復し、<br/>自身と自身以外の残りHP割合が最も低い<br/>味方2名を4ターンの間「勇気」状態にする<br/>(⑤の再実行が発動した場合は⑤の後)"]:::effect --> finish(("終了")):::startend
