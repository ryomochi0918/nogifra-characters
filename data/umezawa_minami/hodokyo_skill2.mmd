flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+30%する"]:::effect
    e1 --> c3{"③:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:②のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率が2倍になる(④の<br/>効果によるアピール倍率の最大は<br/>1200%、③の効果が同時に発生した<br/>場合の最大は2400%)"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに5回、600%のアピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:このスキルによってライバルが<br/>リタイアしなかったか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes(再実行は最大1回まで)"| c3
    c5 -->|"No"| e6["⑥:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復し、<br/>自身と自身以外の残りHP割合が最も<br/>低い味方2名を4ターンの間「勇気」<br/>状態にする"]:::effect
    e6 --> finish(("終了")):::startend
