flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピールが会心アピールになる"]:::effect --> a1
    c2 -->|"No"| c3
    c3{"③:自身の残りHP割合が<br/>50%未満か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c3 -->|"No"| a1
    a1["①実行:<br/>ライバルに、自身のサンクスの2.5倍を<br/>固定値として上乗せした350%の<br/>アピールを行う"]:::action --> e4
    e4["④:残りHP割合が最も低い味方1名の<br/>デバフ・サゲ効果を1つ解除し、HPを①で<br/>行った直前のアピールの30%分回復する"]:::effect --> lc
    lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| e5
    e5["⑤:自身のデバフ・サゲ効果を3つ解除し、<br/>HPを①で行った合計アピールの<br/>30%分回復する"]:::effect --> finish(("終了")):::startend
