flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②/③:自身の残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["②:①のアピールが会心アピールになる"]:::effect
    c2 -->|"No"| e3["③:①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    e2 --> a1["①実行:ライバルに6回、<br/>自身のサンクスの2.5倍を<br/>固定値として上乗せした350%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> e4["④:残りHP割合が最も低い味方1名の<br/>デバフ・サゲ効果を1つ解除し、<br/>HPを①で行った直前のアピールの<br/>30%分回復する<br/>(①の各アピール後)"]:::effect
    e4 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| e5["⑤:自身のデバフ・サゲ効果を<br/>3つ解除し、HPを①で行った<br/>合計アピールの30%分回復する"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e5 --> finish(("終了")):::startend
