flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が特殊状態<br/>または①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに3回、1200%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>3回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:味方チームのフロント人数が<br/>ライバルチームのフロント人数以下か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes"| e4["③による「決心」状態の<br/>ターン数を+1する"]:::effect
    c4 -->|"No"| e3["③:自身を3ターンの間「決心」<br/>状態にする"]:::effect
    e4 --> e3
    e3 --> e5["⑤:自身の状態に応じて⑥か⑦の<br/>効果を適用する"]:::effect
    e5 --> c6{"⑥/⑦:自身が「脚光」状態ではないか"}:::cond
    c6 -->|"Yes"| e6["⑥:自身を6ターンの間「脚光」<br/>状態にする"]:::effect
    c6 -->|"No"| e7["⑦:自身と自身以外の残りHP割合が<br/>最も低い味方1名のHPを自身の<br/>HP上限の30%分回復し、4ターンの間<br/>「反響」状態にする"]:::effect
    e6 --> finish(("終了")):::startend
    e7 --> finish
