flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール対象が特殊状態、<br/>または①のアピール対象の残りHP割合が<br/>50%以上か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・<br/>アゲ効果を1つ解除する"]:::effect --> a1
    c2 -->|"No"| a1
    a1["①実行:<br/>ライバルに3回、<br/>1200%のアピールを行う"]:::action --> e3
    e3["③:自身を3ターンの間<br/>「決心」状態にする"]:::effect --> c4
    c4{"④:味方チームのフロント人数が<br/>ライバルチームのフロント人数以下か"}:::cond
    c4 -->|"Yes"| e4["③による「決心」状態の<br/>ターン数を+1する"]:::effect --> c5
    c4 -->|"No"| c5
    c5{"⑤:自身が「脚光」状態ではないか"}:::cond
    c5 -->|"Yes"| e6["⑥:自身を6ターンの間<br/>「脚光」状態にする"]:::effect --> finish(("終了")):::startend
    c5 -->|"No"| e7["⑦:自身と自身以外の残りHP割合が<br/>最も低い味方1名のHPを自身のHP上限の<br/>30%分回復し、4ターンの間<br/>「反響」状態にする"]:::effect --> finish
