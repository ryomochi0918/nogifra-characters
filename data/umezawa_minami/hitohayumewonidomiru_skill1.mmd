flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>サゲ効果耐性貫通を+30%する"]:::effect
    e1 --> c3{"③:②のアピール対象の<br/>残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| c4{"④:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["①によるサゲ効果耐性貫通の増加倍率が<br/>②のアピール中のみ1.5倍になる"]:::effect
    c4 -->|"No"| c5{"⑤:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["②のアピール対象を100%の確率で<br/>2ターンの間「雑音」状態にする"]:::effect
    c5 -->|"No"| a2["②実行:ライバル6名に<br/>自身の最大アピールの30%を<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e5 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の対象へ"| c3
