flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間「神気」<br/>状態にする"]:::effect
    e1 --> c4{"④:自身の残りHP割合がアピール対象の<br/>残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②の各アピール倍率とSPの<br/>上乗せ倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:ライバル4名に自身の<br/>残りSPの40倍を上乗せした550%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| c4_2{"④:自身の残りHP割合がアピール対象の<br/>残りHP割合以上か<br/>(③の各アピール前)"}:::cond
    lc2 -->|"No、次の対象へ"| c4
    c4_2 -->|"Yes"| e4_2["③の各アピール倍率とSPの<br/>上乗せ倍率が2倍になる"]:::effect
    c4_2 -->|"No"| a3["③実行:残りHP割合が最も低い<br/>ライバルに3回、自身の残りSPの40倍を<br/>上乗せした550%のアピールを行う"]:::action
    e4_2 --> a3
    a3 --> lc3{"③のアピール<br/>3回すべて完了?"}:::cond
    lc3 -->|"Yes"| c5{"⑤:このスキルによってライバルが<br/>1名以上リタイアしたか"}:::cond
    lc3 -->|"No、次の回へ"| c4_2
    c5 -->|"Yes"| e5["「このスキルでリタイアさせた<br/>ライバルの人数」を効果人数として、<br/>自分以外の最大アピールが最も<br/>高い味方を3ターンの間「神気」<br/>状態にする(効果人数は最大5名)"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
