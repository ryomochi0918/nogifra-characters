flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:スキル発動前の自身の「根性」<br/>状態のターン数が5ターン以上か"}:::cond
    c1 -->|"Yes"| e1["このスキル中、自身の会心率を+40%する"]:::effect
    c1 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル4名に自身のサンクスの<br/>2倍を固定値として上乗せした790%の<br/>アピールを行う"]:::action
    e1 --> a2
    a2 --> a3["③実行:②のアピールで会心アピールが<br/>発生した回数をアピール回数として、<br/>最大アピールが最も高い<br/>ライバル1名に自身の「根性」状態の<br/>ターン数×自身のサンクスの0.5倍を<br/>加算した自身のサンクス4倍分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視し、③の効果に<br/>よる加算を含めたサンクスの<br/>最大倍率は10倍まで)"]:::action
    a3 --> e4["④:自身と残りHP割合が最も低い<br/>味方1名のHPをこのスキルで行った<br/>合計アピール30%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
