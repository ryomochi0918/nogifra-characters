flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスがアピール対象の<br/>サンクス以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ自身の<br/>会心率を+20%する"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに5回、自身のサンクスの<br/>4倍を固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:①のアピールで会心アピールが<br/>発生したか<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["自身のHPを①で行った直前の<br/>アピールの50%分回復する"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| c4{"④:自身の「根性」状態のターン数が<br/>6ターン以上か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes"| a4["④実行:残りHP割合が最も<br/>低いライバル1名に、①で<br/>行った合計アピールの25%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c4 -->|"No"| e5["⑤:自身と自身以外の最大アピールが<br/>最も高い味方1名を2ターンの間<br/>「声援」状態にする"]:::effect
    a4 --> e5
    e5 --> finish(("終了")):::startend
