flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のサンクスがアピール対象の<br/>サンクス以上か"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ<br/>自身の会心率を+20%する"]:::effect --> a1
    c2 -->|"No"| a1
    a1["①実行:<br/>残りHP割合が最も低いライバルに5回、<br/>自身のサンクスの4倍を固定値として<br/>上乗せした600%のアピールを行う"]:::action --> c3
    c3{"③:①のアピールで会心アピールが<br/>発生したか"}:::cond
    c3 -->|"Yes"| e3["自身のHPを①で行った直前の<br/>アピールの50%分回復する"]:::effect --> lc
    c3 -->|"No"| lc
    lc{"①のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c4
    c4{"④:自身の「根性」状態のターン数が<br/>6ターン以上か"}:::cond
    c4 -->|"Yes"| a4["残りHP割合が最も低いライバル1名に、<br/>①で行った合計アピールの25%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action --> e5
    c4 -->|"No"| e5
    e5["⑤:自身と自身以外の最大アピールが<br/>最も高い味方1名を2ターンの間<br/>「声援」状態にする(条件を満たさない<br/>場合でも発動)"]:::effect --> finish(("終了")):::startend
