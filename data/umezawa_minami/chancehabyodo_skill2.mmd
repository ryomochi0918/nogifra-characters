flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身のHP上限が①のアピール対象の<br/>HP上限以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①の各アピール中のみ自身の<br/>リフレクト耐性を+20%する"]:::effect
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに4回、自身の最大アピールの<br/>40%を固定値として上乗せした670%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールでリタイアした<br/>人数が1名以下か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| c5{"⑤:自身が「反響」状態か"}:::cond
    c5 -->|"Yes"| e5["自身の「反響」状態と<br/>デバフ・サゲ効果を全て解除し、<br/>HPを①のアピールで行った<br/>合計アピールの60%分回復し、<br/>2ターンの間「残響」状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
