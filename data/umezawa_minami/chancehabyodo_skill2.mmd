flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身の残りHP割合が①のアピール対象の<br/>残りHP割合以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:自身のHP上限が①のアピール対象の<br/>HP上限以上か"}:::cond
    c3 -->|"Yes"| e3["①の各アピール中のみ自身の<br/>リフレクト耐性を+20%する"]:::effect --> a1
    c3 -->|"No"| a1
    a1["①実行:<br/>最大アピールが最も高いライバルに4回、<br/>自身の最大アピールの40%を固定値として<br/>上乗せした670%のアピールを行う"]:::action --> c4
    c4{"④:①のアピールでリタイアした<br/>人数が1名以下か"}:::cond
    c4 -->|"Yes"| e4["再度①を実行する<br/>(再実行は最大1回まで)"]:::effect --> c5
    c4 -->|"No"| c5
    c5{"⑤:自身が「反響」状態か<br/>(④の再実行が発動した場合は④の終了後)"}:::cond
    c5 -->|"Yes"| e5["自身の「反響」状態とデバフ・サゲ効果を<br/>全て解除し、HPを①のアピールで行った<br/>合計アピールの60%分回復し、<br/>2ターンの間「残響」状態にする"]:::effect --> finish(("終了")):::startend
    c5 -->|"No"| finish
