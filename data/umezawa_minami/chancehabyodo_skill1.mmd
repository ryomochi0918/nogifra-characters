flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のバイタリティが①の<br/>効果対象のバイタリティ以上か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①の効果対象が1名増加する<br/>(増加人数は最大で1名まで)"]:::effect
    c2 -->|"No"| e1["①:最大アピールが最も高い<br/>ライバル2名のバフ・アゲ効果を<br/>全て解除する"]:::effect
    e2 --> e1
    e1 --> lc1{"①の効果<br/>対象すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:自身と最大アピールが最も<br/>高い味方2名のデバフ・サゲ効果を<br/>全て解除し、3ターンの間「反響」<br/>状態にする"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e3 --> a4["④実行:ライバルに6回、自身のHP上限の<br/>10%を固定値として上乗せした380%の<br/>アピールを行う"]:::action
    a4 --> e5["⑤:自身と最大アピールが最も<br/>高い味方2名のHPを自身のHP上限の<br/>20%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
