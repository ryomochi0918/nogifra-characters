flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+30%し、<br/>会心アピールを+70%する"]:::effect
    e1 --> a2["②実行:ライバル6名に自身のサンクスの<br/>1.5倍を固定値として上乗せした540%の<br/>アピールを行う"]:::action
    a2 --> cr{"④の再実行による<br/>②のアピールか"}:::cond
    cr -->|"Yes"| finish(("終了")):::startend
    cr -->|"No"| e3["③:自身を4ターンの間<br/>「反響」と「円陣」状態にする"]:::effect
    e3 --> c4{"④:②のアピールで会心アピールが<br/>3回以上発生したか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| a2
    c4 -->|"No"| finish
