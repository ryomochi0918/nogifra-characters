flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が「雑音」状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①の各アピール中のみ①の<br/>アピール対象のディフェンスと<br/>メンタルを-60%する"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル6名に750%のアピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| e5["⑤:自身を4ターンの間「勇気」<br/>状態にする"]:::effect
    e5 --> finish(("終了")):::startend
