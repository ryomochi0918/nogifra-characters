flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール対象がデバフ・<br/>サゲ効果状態か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:①のアピール対象が<br/>「雑音」状態か(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①の各アピール中のみ①のアピール対象の<br/>ディフェンスとメンタルを-60%する"]:::effect --> a1
    c3 -->|"No"| a1
    a1["①実行:<br/>残りHP割合が最も低いライバル6名に<br/>750%のアピールを行う"]:::action --> c4
    c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c4 -->|"Yes"| e4["①を再度実行する<br/>(再実行は最大1回まで)"]:::effect --> e5
    c4 -->|"No"| e5
    e5["⑤:自身を4ターンの間<br/>「勇気」状態にする<br/>(④の効果が発動した場合は④の終了後)"]:::effect --> finish(("終了")):::startend
