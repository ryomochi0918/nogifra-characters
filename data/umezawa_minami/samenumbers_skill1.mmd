flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c4{"④:ライバルチームの<br/>フロント人数が3名以下か<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["アピール倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに3回、自身のサンクスを<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"Yes"| c4_2{"④:ライバルチームの<br/>フロント人数が3名以下か<br/>(③の各アピール前)"}:::cond
    lc2 -->|"No、次の回へ"| c4
    c4_2 -->|"Yes"| e4_2["アピール倍率が2倍になる"]:::effect
    c4_2 -->|"No"| a3["③実行:最大アピールが最も高い<br/>ライバル2名に自身のサンクスを<br/>固定値として上乗せした550%の<br/>アピールを行う"]:::action
    e4_2 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc3 -->|"Yes"| c5{"⑤:味方フロントの「光輝」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    lc3 -->|"No、次の対象へ"| c4_2
    c5 -->|"Yes"| e5["自身を3ターンの間「抱擁」<br/>状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
