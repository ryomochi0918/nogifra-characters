flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身のリフレクト耐性を+30%する"]:::effect --> c4a
    c4a{"④:ライバルチームのフロント人数が<br/>3名以下か(②のアピール前)"}:::cond
    c4a -->|"Yes"| e4a["アピール倍率が2倍になる"]:::effect --> a2
    c4a -->|"No"| a2
    a2["②実行:<br/>残りHP割合が最も低いライバルに3回、<br/>自身のサンクスを固定値として<br/>上乗せした500%のアピールを行う"]:::action --> c4b
    c4b{"④:ライバルチームのフロント人数が<br/>3名以下か(③のアピール前)"}:::cond
    c4b -->|"Yes"| e4b["アピール倍率が2倍になる"]:::effect --> a3
    c4b -->|"No"| a3
    a3["③実行:<br/>最大アピールが最も高いライバル2名に<br/>自身のサンクスを固定値として<br/>上乗せした550%のアピールを行う"]:::action --> c5
    c5{"⑤:味方フロントの「光輝」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    c5 -->|"Yes"| e5["自身を3ターンの間<br/>「抱擁」状態にする"]:::effect --> finish(("終了")):::startend
    c5 -->|"No"| finish
