flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+30%する"]:::effect
    e1 --> c2{"②:自身の残りHP割合が50%以上か"}:::cond
    c2 -->|"Yes"| e2["このスキル中、自身の会心率を+30%する"]:::effect
    c2 -->|"No"| c4{"④:自身のエフォートが③の<br/>アピール対象のエフォート以上か<br/>(③の各アピール前)"}:::cond
    e2 --> c4
    c4 -->|"Yes"| e4["③のアピール倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:残りHP割合が最も低い<br/>ライバルに5回、350%のアピールを行う"]:::action
    e4 --> a3
    a3 --> c5{"⑤/⑥:③のアピールでライバルが<br/>リタイアしなかったか<br/>(③の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["⑤:次に行う③のアピール倍率が<br/>2倍になる"]:::effect
    c5 -->|"No"| e6["⑥:③のアピール回数が1回増加する<br/>(アピールの追加回数は最大で3回まで)"]:::effect
    e5 --> lc3{"③のアピール<br/>5回(+⑥の追加分)すべて完了?"}:::cond
    e6 --> lc3
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c4
