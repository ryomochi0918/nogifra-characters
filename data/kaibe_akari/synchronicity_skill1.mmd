flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身の残りHP割合が<br/>①のアピール対象の<br/>残りHP割合以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバルへ<br/>自身のサンクスの3.5倍を固定値として<br/>上乗せした500%のアピール"]:::action --> c3
    c3{"③:直前のアピールで<br/>ライバルがリタイアしなかったか"}:::cond
    c3 -->|"Yes"| c4
    c3 -->|"No"| loop1
    c4{"④:自身が<br/>「強運」状態か"}:::cond
    c4 -->|"Yes"| e4["③の効果対象を<br/>自身以外の味方1名に変更し、<br/>2ターンの間「強運」状態にする<br/>※強運:アピール力+30%、会心率+20%"]:::effect --> c5
    c4 -->|"No"| e3["③実行:自身を2ターンの間<br/>「強運」状態にする<br/>※強運:アピール力+30%、会心率+20%"]:::effect --> c5
    c5{"⑤:①のアピールで<br/>ライバルがリタイアしない事が<br/>2回発生したか"}:::cond
    c5 -->|"Yes"| e5["このスキル中のみ自身の<br/>会心率を+20%、会心アピールを+30%する<br/>(会心率の増加上限は+40%、<br/>会心アピールの増加上限は+60%まで)"]:::effect --> loop1
    c5 -->|"No"| loop1
    loop1{"①のアピール5回<br/>すべて完了?"}:::cond
    loop1 -->|"No、次の回へ"| c2
    loop1 -->|"Yes"| finish(("終了")):::startend
