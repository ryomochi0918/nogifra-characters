flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに5回、<br/>自身のサンクスの3.5倍を<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:直前のアピールでライバルが<br/>リタイアしなかったか<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| c4{"④:自身が「強運」状態か<br/>(③の各効果前)"}:::cond
    c3 -->|"No"| c5{"⑤:①のアピールでライバルが<br/>リタイアしない事が2回発生したか<br/>(2回ごと)<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["③の効果対象を自身以外の<br/>味方1名に変更する"]:::effect
    c4 -->|"No"| e3["自身を2ターンの間「強運」<br/>状態にする"]:::effect
    e4 --> e3
    e3 --> c5
    c5 -->|"Yes"| e5["このスキル中のみ自身の会心率を+20%、<br/>会心アピールを+30%する(会心率の<br/>増加上限は+40%、会心アピールの<br/>増加上限は+60%まで)"]:::effect
    c5 -->|"No"| lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    e5 --> lc1
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
