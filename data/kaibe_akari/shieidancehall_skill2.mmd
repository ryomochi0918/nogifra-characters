flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が受けている<br/>バフ・アゲ効果状態の種類数が<br/>2種類以下か(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象が1名増加する<br/>(増加人数は最大で2名まで)"]:::effect --> c3
    c2 -->|"No"| c3{"③:このスキルが発動する前の<br/>自身が受けているバフ・アゲ効果状態の<br/>種類数が2種類以上か(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①による「回避率ダウン」状態の<br/>確率を+20%する"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身のスマイルが①のアピール対象の<br/>スマイル以上か(①の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["①による「回避率ダウン」の効果倍率が<br/>10%増加し、①のアピール対象の<br/>バフ・アゲ効果を1つ解除し、<br/>①のアピール倍率が2倍になる"]:::effect --> a1
    c4 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル3名を80%の確率で<br/>2ターンの間「回避率ダウン」状態にし、<br/>1200%のアピールを行う<br/>※回避率ダウン:回避率が15〜25%低下する"]:::action
    a1 --> lc1{"①のアピール<br/>対象すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>味方1名のHPを①で行った<br/>合計アピールの30%分回復する"]:::action --> finish(("終了")):::startend
