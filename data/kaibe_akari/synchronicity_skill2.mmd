flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身の残りHP割合が<br/>①のアピール対象の<br/>残りHP割合以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:自身の残りHP割合が<br/>90%以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる<br/>(最大2800%のアピール、<br/>②の効果が同時に発動した場合は<br/>最大5600%のアピール)"]:::effect --> a1
    c3 -->|"No"| a1["①実行:最大アピールが最も高いライバルへ<br/>自身の最大アピールの20%を固定値として<br/>上乗せした350%のアピール"]:::action --> e4
    e4["④:自身のHPを①で行った<br/>直前のアピールの20%分回復する"]:::effect --> loop1
    loop1{"①のアピール6回<br/>すべて完了?"}:::cond
    loop1 -->|"No、次の回へ"| c2
    loop1 -->|"Yes"| c5
    c5{"⑤:自身の「声援」状態の<br/>ターン数が7ターン以上か"}:::cond
    c5 -->|"Yes"| e5["自身以外の残りHP割合が<br/>最も低い味方2名を<br/>2ターンの間「声援」状態にする<br/>※声援:自動HP回復を+8%し、<br/>受けるアピールが60%低下し、<br/>メンタルが150%上昇する"]:::effect --> finish(("終了")):::startend
    c5 -->|"No"| finish
