flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身の残りHP割合が90%以上か<br/>(度に積算)<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる<br/>(最大2800%のアピール、<br/>②の効果が同時に発動した場合は<br/>最大5600%のアピール)"]:::effect
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに6回、自身の最大アピールの<br/>20%を固定値として上乗せした350%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> e4["④:自身のHPを①で行った直前の<br/>アピールの20%分回復する<br/>(①の各アピール後)"]:::effect
    e4 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:自身の「声援」状態のターン数が<br/>7ターン以上か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c5 -->|"Yes"| e5["自身以外の残りHP割合が最も低い<br/>味方2名を2ターンの間「声援」<br/>状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
