flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象が<br/>デバフ・サゲ効果状態ではないか<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①による「興奮」状態の<br/>効果倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:最大アピールが最も高い味方3名を<br/>3ターンの間「興奮」状態にする"]:::effect
    e2 --> e1
    e1 --> lc1{"①の効果<br/>対象3名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:自身のスマイルが③の効果対象の<br/>スマイル以上か<br/>(③の各効果前)"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["③による「フィジカルダウン」<br/>と「メンタルダウン」状態の<br/>効果倍率が2倍になる"]:::effect
    c4 -->|"No"| e3["③:ライバル5名を100%の確率で<br/>2ターンの間「フィジカルダウン」<br/>と「メンタルダウン」状態にする"]:::effect
    e4 --> e3
    e3 --> lc3{"③の効果<br/>対象5名すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の対象へ"| c4
