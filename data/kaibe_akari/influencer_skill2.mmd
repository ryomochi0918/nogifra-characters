flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:発動前に自身が受けている<br/>バフ・アゲ効果の種類数が<br/>2種類以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:①の対象がバフ・アゲ<br/>効果状態ではないか"}:::cond
    c3 -->|"Yes"| e3["①のアピールに自身の残り<br/>SPの40倍を固定値として<br/>上乗せする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバル2名へバフ・アゲ効果を1つ解除し、<br/>自身のスマイルの4倍を固定値として<br/>上乗せした640%のアピール"]:::action --> loop1
    loop1{"①を対象2名分実行したか"}:::cond
    loop1 -->|"No、次の対象へ"| c2
    loop1 -->|"Yes"| c4
    c4{"④:味方フロントの人数が<br/>ライバルのフロント人数以上か"}:::cond
    c4 -->|"Yes(①を再実行、最大1回)"| c2
    c4 -->|"No"| a5["⑤実行:自身と自身以外の<br/>残りHP割合が最も低い味方1名を<br/>3ターンの間「勇気」状態にし、<br/>HPを合計アピールの20%分回復する"]:::action --> finish(("終了")):::startend
