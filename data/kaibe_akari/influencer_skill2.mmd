flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:このスキルが発動する前に自身が<br/>受けているバフ・アゲ効果の<br/>種類数が2種類以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:①のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①のアピールに自身の残り<br/>SPの40倍を固定値として<br/>上乗せする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバル2名に2回、<br/>バフ・アゲ効果を1つ解除し、<br/>自身のスマイルの4倍を固定値として<br/>上乗せした640%のアピール"]:::action --> lc1n
    lc1n{"①のアピール<br/>対象1名に2回すべて完了?"}:::cond
    lc1n -->|"No、次の回へ"| c2
    lc1n -->|"Yes"| lc1
    lc1{"①のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| c4
    c4{"④:味方フロントの人数が<br/>ライバルのフロント人数以上か"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| a5["⑤実行:自身と自身以外の<br/>残りHP割合が最も低い味方1名を<br/>3ターンの間「勇気」状態にし、<br/>HPをこのスキルで行った<br/>合計アピールの20%分回復する"]:::action --> finish(("終了")):::startend
