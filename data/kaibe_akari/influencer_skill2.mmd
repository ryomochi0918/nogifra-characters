flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:このスキルが発動する前に<br/>自身が受けているバフ・アゲ効果の<br/>種類数が2種類以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピールに自身の残りSPの<br/>40倍を固定値として上乗せする"]:::effect
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバル2名に2回、バフ・アゲ効果を<br/>1つ解除し、自身のスマイルの4倍を<br/>固定値として上乗せした640%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc1 -->|"Yes"| lc1n{"①のアピール<br/>2回すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1n -->|"Yes"| c4{"④:味方フロントの人数がライバルの<br/>フロント人数以上か"}:::cond
    lc1n -->|"No、次の回へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| e5["⑤:自身と自身以外の残りHP割合が<br/>最も低い味方1名を3ターンの間<br/>「勇気」状態にし、HPをこのスキルで<br/>行った合計アピールの20%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
