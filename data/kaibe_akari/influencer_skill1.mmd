flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間「倍音」<br/>状態にする"]:::effect
    e1 --> c3{"③:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに4回、自身の最大アピールの<br/>40%を固定値として上乗せした580%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> e4["④:自身のHPを直前のアピールの<br/>30%分回復する<br/>(②の各アピール後)"]:::effect
    e4 --> a5["⑤実行:残りHP割合が最も高い<br/>ライバル1名にこのスキルで<br/>行った合計アピールの35%を<br/>固定値として上乗せした290%の<br/>アピールを行う(固定値の上限は<br/>自身の最大アピールの120%まで)"]:::action
    a5 --> e4_2["④:自身のHPを直前のアピールの<br/>30%分回復する<br/>(⑤の各アピール後)"]:::effect
    e4_2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"Yes"| c6{"⑥:このスキルでライバルが<br/>リタイアしていたか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c6 -->|"Yes"| e6["自身を3ターンの間「反響」<br/>状態にする"]:::effect
    c6 -->|"No"| finish(("終了")):::startend
    e6 --> finish
