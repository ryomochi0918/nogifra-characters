flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果<br/>状態ではないか"}:::cond
    c2 -->|"Yes"| e2["②効果:①による「機敏」状態の<br/>効果倍率を1.5倍にする"]:::effect --> c3
    c2 -->|"No"| c3{"③:味方フロントにデバフ・サゲ<br/>効果状態のメンバーが<br/>3名以上居るか"}:::cond
    c3 -->|"Yes"| e3["③効果:①の効果対象が<br/>1名増加する"]:::effect --> e1
    c3 -->|"No"| e1["①:最大アピールが最も高い味方3名の<br/>デバフ・サゲ効果を2つ解除し、<br/>2ターンの間「機敏」状態にする"]:::effect --> a4["④実行:残りHP割合が最も低い<br/>ライバルへ460%のアピール"]:::action --> loop4{"④のアピール4回<br/>すべて完了?"}:::cond
    loop4 -->|"No、次の回へ"| a4
    loop4 -->|"Yes"| e5["⑤:残りHP割合が最も低い味方の<br/>HPを自身のアピール力の80%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect --> loop5{"⑤の回復4回<br/>すべて完了?"}:::cond
    loop5 -->|"No、次の回へ"| e5
    loop5 -->|"Yes"| finish(("終了")):::startend
