flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果状態ではないか"}:::cond
    c2 -->|"Yes"| e2["①による「機敏」状態の効果倍率を<br/>1.5倍にする"]:::effect
    c2 -->|"No"| c3{"③:味方フロントに<br/>デバフ・サゲ効果状態のメンバーが<br/>3名以上居るか"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①の効果対象が1名増加する"]:::effect
    c3 -->|"No"| e1["①:最大アピールが最も高い味方3名の<br/>デバフ・サゲ効果を2つ解除し、<br/>2ターンの間「機敏」状態にする"]:::effect
    e3 --> e1
    e1 --> a4["④実行:残りHP割合が最も低い<br/>ライバルに4回、460%のアピールを行う"]:::action
    a4 --> e5["⑤:残りHP割合が最も低い味方に4回、<br/>HPを自身のアピール力の80%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect
    e5 --> finish(("終了")):::startend
