flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象の残りHP割合が<br/>50%以上またはバフ・アゲ効果状態の<br/>種類数が2種類未満か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①の効果対象を4ターンの間「神気」<br/>と「光華」状態にする"]:::effect
    c2 -->|"No"| c3{"③:①の効果対象の残りHP割合が<br/>50%未満または特殊状態ではないか<br/>(①の各効果前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①の効果対象を4ターンの間「堅忍」<br/>状態にする"]:::effect
    c3 -->|"No"| e1["①:HP上限が最も高い味方1名と<br/>残りHP割合が最も低い味方1名の<br/>デバフ・サゲ効果状態を全て解除し、<br/>HPを自身のHP上限の30%分回復する"]:::effect
    e3 --> e1
    e1 --> lc1{"①の効果<br/>対象2名すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:④の効果対象が<br/>デバフ・サゲ効果状態ではない<br/>または特殊状態か<br/>(④の各効果前)"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c5 -->|"Yes"| e5["④の効果中のみ自身の<br/>サゲ効果耐性貫通を+20%する"]:::effect
    c5 -->|"No"| e4["④:最大アピールが最も高い<br/>ライバル2名を100%の確率で1ターンの<br/>間「転倒」状態にする"]:::effect
    e5 --> e4
    e4 --> lc4{"④の効果<br/>対象2名すべて完了?"}:::cond
    lc4 -->|"Yes"| finish(("終了")):::startend
    lc4 -->|"No、次の対象へ"| c5
