flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象の残りHP割合が<br/>50%以上またはバフ・アゲ効果状態の<br/>種類数が2種類未満か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["②効果:①の効果対象を4ターンの間<br/>「神気」と「光華」状態にする"]:::effect --> c3
    c2 -->|"No"| c3{"③:①の効果対象の残りHP割合が<br/>50%未満または特殊状態ではないか<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["③効果:①の効果対象を<br/>4ターンの間「堅忍」状態にする"]:::effect --> e1
    c3 -->|"No"| e1["①:HP上限が最も高い味方1名と<br/>残りHP割合が最も低い味方1名の<br/>デバフ・サゲ効果状態を全て解除し、<br/>HPを自身のHP上限の30%分回復する"]:::effect --> c5{"⑤:④の効果対象がデバフ・サゲ<br/>効果状態ではないまたは特殊状態か<br/>(対象ごとに判定)"}:::cond
    c5 -->|"Yes"| e5["⑤効果:④の効果中のみ自身の<br/>サゲ効果耐性貫通を+20%する"]:::effect --> a4
    c5 -->|"No"| a4["④実行:最大アピールが最も高い<br/>ライバル2名を100%の確率で<br/>1ターンの間「転倒」状態にする"]:::action --> finish(("終了")):::startend
