flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>リフレクト耐性を+40%する"]:::effect --> c3{"③:ライバルチームの<br/>フロント人数が4名以下か"}:::cond
    c3 -->|"Yes"| e3["③効果:②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身の残りHP割合が<br/>50%以上か"}:::cond
    c4 -->|"Yes"| e4["④効果:②のアピール対象の<br/>バフ・アゲ効果を1つ解除する"]:::effect --> a2
    c4 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル2名へ、自身の最大アピールの<br/>40%を固定値として上乗せした<br/>500%のアピール"]:::action --> loop{"②のアピール2回<br/>すべて完了?"}:::cond
    loop -->|"No、次の回へ"| c3
    loop -->|"Yes"| c5{"⑤:味方フロントの「抱擁」状態の<br/>ターン数が3ターン以上か"}:::cond
    c5 -->|"Yes"| a5["⑤実行:最大アピールが最も高い<br/>ライバル2名へ、自身の最大アピールの<br/>100%を固定値として上乗せした<br/>1000%のアピール"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
