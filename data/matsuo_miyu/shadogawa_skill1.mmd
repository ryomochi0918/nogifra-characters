flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>リフレクト耐性を+40%する"]:::effect
    e1 --> c3{"③:ライバルチームの<br/>フロント人数が4名以下か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:自身の残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c4 -->|"No"| a2["②実行:最大アピールが最も<br/>高いライバル2名に2回、<br/>自身の最大アピールの40%を<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc2 -->|"Yes"| lc2n{"②のアピール<br/>2回すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2n -->|"Yes"| c5{"⑤:味方フロントの「抱擁」状態の<br/>ターン数が3ターン以上か"}:::cond
    lc2n -->|"No、次の回へ"| c3
    c5 -->|"Yes"| a5["⑤実行:最大アピールが最も高い<br/>ライバル2名に自身の最大アピールの<br/>100%を固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
