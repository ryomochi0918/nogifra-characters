flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>①のアピール対象の<br/>残りHP割合以上か"}:::cond
    c2 -->|"Yes"| e2["②効果:①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルへ、自身の残りHPの20%を<br/>固定値として上乗せした<br/>350%のアピール"]:::action --> e4a["④:自身のHPを自身の<br/>HP上限の10%分回復する"]:::effect --> c3{"③:味方フロントの「抱擁」状態が<br/>5ターン以上または自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>種類数が2種類以上か"}:::cond
    c3 -->|"Yes"| a3["③実行:最大アピールが最も高い<br/>ライバルへ、自身の残りHPの40%を<br/>固定値として上乗せした<br/>700%のアピール"]:::action --> e4b["④:自身のHPを自身の<br/>HP上限の10%分回復する"]:::effect --> loop
    c3 -->|"No"| loop{"①のアピール4回<br/>すべて完了?"}:::cond
    loop -->|"No、次の回へ"| c2
    loop -->|"Yes"| finish(("終了")):::startend
