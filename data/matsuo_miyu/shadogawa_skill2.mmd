flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに4回、自身の残りHPの<br/>20%を固定値として上乗せした350%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:味方フロントの「抱擁」状態が<br/>5ターン以上または自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>種類数が2種類以上か<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| a3["③実行:最大アピールが最も高い<br/>ライバルに自身の残りHPの40%を<br/>固定値として上乗せした700%の<br/>アピールを行う"]:::action
    c3 -->|"No"| e4_2["④:自身のHPを自身のHP上限の<br/>10%分回復する<br/>(①の各アピール後)"]:::effect
    a3 --> e4["④:自身のHPを自身のHP上限の<br/>10%分回復する<br/>(③の各アピール後)"]:::effect
    e4 --> e4_2
    e4_2 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
