flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③:自身の残りHP割合が①の<br/>各アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①の各アピール中のみアピール対象の<br/>ディフェンスとメンタルを-50%する"]:::effect
    c3 -->|"No"| a1["①実行:ライバル6名に自身の残りSPの<br/>30倍を上乗せした500%のアピールを<br/>行い、100%の確率で3ターンの間<br/>「アピール力ダウン」状態にする"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| c3_2{"③:自身の残りHP割合が②の<br/>各アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    lc1 -->|"No、次の対象へ"| c3
    c3_2 -->|"Yes"| e3_2["②の各アピール中のみアピール対象の<br/>ディフェンスとメンタルを-50%する"]:::effect
    c3_2 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバル1名に自身の残りSPの250倍を<br/>上乗せした1000%のアピールを行う"]:::action
    e3_2 --> a2
    a2 --> c4{"④:このスキルによるアピールで<br/>ライバルがリタイアしたか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c3
    c4 -->|"No"| e5["⑤:味方6名のHPをこのスキルで<br/>行った合計アピールの20%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
