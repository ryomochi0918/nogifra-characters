flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のバイタリティが<br/>①のアピール対象の<br/>バイタリティ以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["②効果:①のアピール対象を<br/>100%の確率で2ターンの間<br/>「嫉妬」状態にする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル6名へ<br/>600%のアピール"]:::action --> a3["③実行:残りHP割合が最も高い<br/>ライバル1名へ、自身の低下したHPの<br/>75%分を固定値として上乗せした<br/>600%のアピール"]:::action --> c5{"⑤:④の効果前、自身の<br/>残りHP割合が50%未満か"}:::cond
    c5 -->|"Yes"| e5["④+⑤:④による「反響」状態を<br/>「残響」状態に変更し、自身を<br/>4ターンの間「残響」状態にし、<br/>自身のHPをこのスキルで行った<br/>合計アピールの60%分回復する"]:::effect --> finish(("終了")):::startend
    c5 -->|"No"| e4["④:自身を4ターンの間<br/>「反響」状態にし、自身のHPを<br/>このスキルで行った合計アピールの<br/>60%分回復する"]:::effect --> finish
