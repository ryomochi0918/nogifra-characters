flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+40%する"]:::effect
    e1 --> a2["②実行:ライバル5名に600%の<br/>アピールを行う"]:::action
    a2 --> c5{"⑤:②と③の各アピールでアピールの<br/>失敗またはアピールが0である事が<br/>3回以上発生したか<br/>(②の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["このスキルによる残りのアピールは<br/>必ず命中する"]:::effect
    c5 -->|"No"| lc2{"②のアピール<br/>ライバル5名すべて完了?"}:::cond
    e5 --> lc2
    lc2 -->|"Yes"| a3["③実行:残りHP割合が最も<br/>低いライバルに3回、1000%の<br/>アピールを行う"]:::action
    lc2 -->|"No、次の対象へ"| a2
    a3 --> c4{"④:③のアピール対象の残りHP割合が<br/>30%以下またはリタイアしたか<br/>(③の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["③のアピール回数が1回増加し、③に<br/>よる残りのアピール倍率が2倍になる<br/>(アピールの追加回数は最大で<br/>3回まで、最大8000%のアピール)"]:::effect
    c4 -->|"No"| c5_2{"⑤:②と③の各アピールでアピールの<br/>失敗またはアピールが0である事が<br/>3回以上発生したか<br/>(③の各アピール後)"}:::cond
    e4 --> c5_2
    c5_2 -->|"Yes"| e5_2["このスキルによる残りのアピールは<br/>必ず命中する"]:::effect
    c5_2 -->|"No"| lc3{"③のアピール<br/>3回(+④の追加分)すべて完了?"}:::cond
    e5_2 --> lc3
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| a3
