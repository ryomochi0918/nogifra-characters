flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の命中率と<br/>デバフ耐性貫通を+20%する"]:::effect --> a2["②実行:残りHP割合が最も高いライバルへ、<br/>100%の確率で2ターンの間<br/>「フィジカルダウン」と「メンタルダウン」<br/>状態にし、700%のアピール"]:::action --> loop{"②のアピール4回<br/>すべて完了?"}:::cond
    loop -->|"No、次の回へ"| a2
    loop -->|"Yes"| c3{"③:②のアピールでライバルが<br/>リタイアしなかったか<br/>(再実行は最大1回まで)"}:::cond
    c3 -->|"Yes"| e3["③効果:アピール倍率を2倍にして<br/>再度②を実行する"]:::effect --> a2
    c3 -->|"No"| finish(("終了")):::startend
