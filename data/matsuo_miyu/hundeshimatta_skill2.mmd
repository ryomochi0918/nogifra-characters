flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>SP上乗せ倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール対象のバフ・アゲ効果を<br/>2つ解除する"]:::effect
    c3 -->|"No"| a1["①実行:ライバルに6回、自身の<br/>残りSPの50倍を上乗せした430%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| e4["④:自身と自身以外の残りHP割合が<br/>最も低い味方5名を①で行った<br/>合計アピール30%分回復し、<br/>3ターンの間「反響」状態にする"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e4 --> finish(("終了")):::startend
