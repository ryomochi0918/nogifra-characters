flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    c2 -->|"Yes"| e2["②効果:①のアピール倍率と<br/>SP上乗せ倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身の残りHP割合が<br/>①のアピール対象の<br/>残りHP割合以上か"}:::cond
    c3 -->|"Yes"| e3["③効果:①のアピール対象の<br/>バフ・アゲ効果を2つ解除する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバルへ、自身の残りSPの<br/>50倍を上乗せした430%のアピール"]:::action --> loop{"①のアピール6回<br/>すべて完了?"}:::cond
    loop -->|"No、次の回へ"| c2
    loop -->|"Yes"| e4["④:自身と自身以外の残りHP割合が<br/>最も低い味方5名を①で行った<br/>合計アピール30%分回復し、<br/>3ターンの間「反響」状態にする"]:::effect --> finish(("終了")):::startend
