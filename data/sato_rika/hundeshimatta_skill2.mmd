flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>会心率と命中率を+40%する"]:::effect --> c3
    c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②のアピールに自身の<br/>最大アピールの30%を<br/>固定値として上乗せする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバルへ620%のアピール<br/>(2回目以降のアピールは<br/>対象を選び直す)"]:::action
    a2 --> lc{"②のアピール<br/>(ライバル4名に2回)<br/>すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| c4{"④:②のアピールで会心アピールが<br/>2回以上発生したか"}:::cond
    c4 -->|"Yes"| a4["再度②を発動する<br/>(再実行は最大1回まで)"]:::action --> finish(("終了")):::startend
    c4 -->|"No"| finish
