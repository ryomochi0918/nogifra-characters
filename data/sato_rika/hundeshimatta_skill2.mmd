flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>会心率と命中率を+40%する"]:::effect --> c3
    c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピールに自身の<br/>最大アピールの30%を<br/>固定値として上乗せする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバル4名に2回、620%のアピール<br/>(2回目以降のアピールは<br/>対象を選び直す)"]:::action
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2 -->|"Yes"| lc2n{"②のアピール<br/>2回すべて完了?"}:::cond
    lc2n -->|"No、次の回へ"| c3
    lc2n -->|"Yes"| c4{"④:②のアピールで会心アピールが<br/>2回以上発生したか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c3
    c4 -->|"No"| finish(("終了")):::startend
