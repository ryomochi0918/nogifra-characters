flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ自身の<br/>サゲ効果耐性貫通を+30%し、①の<br/>アピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c2 -->|"No"| c3{"③:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(②の効果後)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①による「空腹」状態の効果倍率を<br/>1.5倍にする"]:::effect
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに5回、100%の確率で<br/>3ターンの間「空腹」状態にし、<br/>自身のスマイルの4倍を<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> c4{"④:①のアピール対象の残りHP割合が<br/>50%未満またはリタイアしたか<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["自身のHPを自身のアピール力の<br/>60%分回復し(会心率に応じて会心回復が<br/>発生)、自身を2ターンの間「勇気」<br/>状態にする"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| a5["⑤実行:ライバルチームに居る<br/>デバフ・サゲ効果状態のメンバーに<br/>①で行った合計アピールの40%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する、最大で6名まで)"]:::action
    lc1 -->|"No、次の回へ"| c2
    a5 --> finish(("終了")):::startend
