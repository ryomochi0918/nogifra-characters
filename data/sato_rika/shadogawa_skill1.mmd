flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を2ターンの間「光華」<br/>状態にする"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバル3名に自身のサンクスの<br/>3倍を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc2 -->|"Yes"| a4["④実行:ライバル3名に②の<br/>アピールで会心アピールが発生した<br/>回数をアピール回数として、<br/>自身のサンクスの6倍を<br/>固定値として上乗せした1600%の<br/>アピールを行う(④によるアピールは<br/>最大2回まで、2回目以降のアピールは<br/>対象を選び直す)"]:::action
    lc2 -->|"No、次の対象へ"| c3
    a4 --> e5["⑤:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
