flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の<br/>エフォートの2.5倍を<br/>固定値として上乗せする"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象の<br/>残りHP割合が50%以下か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と①の<br/>最大アピールによる<br/>固定値倍率が2倍になる"]:::effect --> a1
    c3 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルへ、自身の最大アピールの<br/>30%を固定値として上乗せした<br/>380%のアピール"]:::action
    a1 --> e4["④:①のアピール対象を100%の<br/>確率で2ターンの間<br/>「アピールカダウン」状態にする"]:::effect
    e4 --> lc{"①のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| e5["⑤:自身のHPを①で行った<br/>合計アピールの30%分回復する"]:::effect --> finish(("終了")):::startend
