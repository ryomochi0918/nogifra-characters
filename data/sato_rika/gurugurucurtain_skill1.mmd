flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身のエフォートの<br/>2.5倍を固定値として上乗せする"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象の<br/>残りHP割合が50%以下か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と①の最大アピールに<br/>よる固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに5回、自身の最大アピールの<br/>30%を固定値として上乗せした380%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> e4["④:①のアピール対象を100%の確率で<br/>2ターンの間「アピール力ダウン」<br/>状態にする<br/>(①の各アピール後)"]:::effect
    e4 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| e5["⑤:自身のHPを①で行った<br/>合計アピールの30%分回復する"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e5 --> finish(("終了")):::startend
