flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率とSPの<br/>上乗せ倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバル3名に自身の<br/>残りSPの80倍を上乗せした1000%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:③のアピール対象の<br/>残りHP割合が50%以上か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["③のアピール倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:ライバル1名に①で<br/>行った合計アピールの80%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    e4 --> a3
    a3 --> c5{"⑤:このスキルのアピールで<br/>ライバルがリタイアしたか"}:::cond
    c5 -->|"Yes"| a5["⑤実行:ライバル1名にこのスキルで<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
