flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:②のアピール対象の残りHP割合が<br/>50%以上またはこのスキル開始時の<br/>自身の「不屈」状態のターン数が<br/>5ターン以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| a2["②実行:ライバル5名に<br/>自身のエフォートの3倍を<br/>固定値として上乗せした730%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc2 -->|"Yes"| e5["⑤:④の開始前の自身の「抱擁」<br/>状態の合計ターン数が4ターン毎に<br/>④のアピール回数が1回増加する<br/>(アピールの追加回数は最大で<br/>2回まで、2回目以降のアピールは<br/>対象を選び直す)"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e5 --> a4["④実行:残りHP割合が最も低い<br/>ライバル1名に②のアピールで<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    a4 --> finish(("終了")):::startend
