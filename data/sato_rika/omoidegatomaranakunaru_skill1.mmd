flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:最大アピールが最も高い<br/>ライバルへ、自身の最大アピールの<br/>30%を固定値として上乗せした<br/>1500%のアピール"]:::action
    a1 --> lc1{"①のアピール対象<br/>2名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| a1
    lc1 -->|"Yes"| c3{"③:①のアピールによって<br/>ライバルがリタイアしたか"}:::cond
    c3 -->|"Yes"| e3["②による「熱中」状態の効果倍率が<br/>2倍になる(②と③の効果による<br/>熱中の増加量上限はスキル発動前の<br/>自身の最大アピール600%分まで)"]:::effect --> e2
    c3 -->|"No"| e2["②:自身を3ターンの間、<br/>アピール対象の最大アピールの<br/>合計30%分の上昇量を持つ<br/>「熱中」状態にする"]:::effect
    e2 --> a4["④実行:ライバルへ300%のアピール"]:::action
    a4 --> lc4{"④のアピール<br/>3回すべて完了?"}:::cond
    lc4 -->|"No、次の回へ"| a4
    lc4 -->|"Yes"| finish(("終了")):::startend
