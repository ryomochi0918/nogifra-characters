flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| c3{"③:①のアピール対象の<br/>残りHP割合が50%未満か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピールに①のアピール対象の<br/>HP減少分の6%を固定値として上乗せ<br/>(固定値の上乗せは自身の<br/>最大アピールの700%まで)"]:::effect --> a1
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルへ650%のアピールを行い、<br/>100%の確率で3ターンの間<br/>「嫉妬」状態にする"]:::action
    a1 --> c4{"④:①のアピール対象が<br/>「アピールカダウン」状態か<br/>(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["①のアピール回数が1回増加する<br/>(アピールの追加回数は<br/>最大で3回まで)"]:::effect --> lc
    c4 -->|"No"| lc{"①のアピール3回<br/>(+④による追加分)<br/>すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| e5["⑤:自身と自身以外の残りHP割合が<br/>最も低い味方1名のHPを自身の<br/>HP上限の30%分回復し、<br/>4ターンの間「堅忍」状態にする"]:::effect --> finish(("終了")):::startend
