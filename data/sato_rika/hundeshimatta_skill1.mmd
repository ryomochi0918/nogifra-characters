flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+40%する"]:::effect
    e1 --> a2["②実行:ライバル5名に550%の<br/>アピールを行う"]:::action
    a2 --> e3["③:自身を2ターンの間「神気」<br/>状態にする"]:::effect
    e3 --> c4{"④:②のアピールで会心アピールが<br/>発生したか"}:::cond
    c4 -->|"Yes"| c5{"⑤:このスキルで会心アピールが<br/>3回以上発生したか<br/>(④の各アピール前)"}:::cond
    c4 -->|"No"| finish(("終了")):::startend
    c5 -->|"Yes"| e5["④のアピールにアピール対象の<br/>HP上限1.5%分を固定値として上乗せする"]:::effect
    c5 -->|"No"| a4["④実行:ライバルに3回、550%の<br/>アピールを行う"]:::action
    e5 --> a4
    a4 --> lc4{"④のアピール<br/>3回すべて完了?"}:::cond
    lc4 -->|"Yes"| finish
    lc4 -->|"No、次の回へ"| c5
