flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>会心率を+40%する"]:::effect --> a2
    a2["②実行:ライバルへ550%のアピール"]:::action --> lc2{"②のアピール対象<br/>5名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| a2
    lc2 -->|"Yes"| e3["③:自身を2ターンの間<br/>「神気」状態にする"]:::effect
    e3 --> c4{"④:②のアピールで<br/>会心アピールが発生したか"}:::cond
    c4 -->|"No"| finish(("終了")):::startend
    c4 -->|"Yes"| c5{"⑤:このスキルで会心アピールが<br/>3回以上発生したか"}:::cond
    c5 -->|"Yes"| e5["④のアピールにアピール対象の<br/>HP上限1.5%分を固定値として<br/>上乗せする"]:::effect --> a4
    c5 -->|"No"| a4["④実行:ライバルへ550%のアピール"]:::action
    a4 --> lc4{"④のアピール<br/>3回すべて完了?"}:::cond
    lc4 -->|"No、次の回へ"| c5
    lc4 -->|"Yes"| finish
