flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の最大アピールが①の<br/>アピール対象の最大アピール以上<br/>または自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率を1.5倍にする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバルへ、自身の<br/>最大アピールの30%を固定値として<br/>上乗せした500%のアピール"]:::action
    a1 --> lc{"①のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| e3["③:味方6名のHPを①で行った<br/>合計アピールの20%分回復し、<br/>3ターンの間「堅忍」状態にする"]:::effect
    e3 --> c4{"④:①のアピールでライバルを<br/>リタイアさせた回数が<br/>2回未満だったか"}:::cond
    c4 -->|"Yes"| a4["再度①を実行する<br/>(再実行は最大1回まで)"]:::action --> finish(("終了")):::startend
    c4 -->|"No"| finish
