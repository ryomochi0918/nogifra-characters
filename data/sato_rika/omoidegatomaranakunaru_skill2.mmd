flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の最大アピールが①の<br/>アピール対象の最大アピール以上または<br/>自身のエフォートが①のアピール対象の<br/>エフォート以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率を1.5倍にする"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに5回、自身の最大アピールの<br/>30%を固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| cr{"④の再実行による<br/>①のアピールか"}:::cond
    cr -->|"Yes"| finish(("終了")):::startend
    cr -->|"No"| e3["③:味方6名のHPを①で行った<br/>合計アピールの20%分回復し、<br/>3ターンの間「堅忍」状態にする"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e3 --> c4{"④:①のアピールでライバルを<br/>リタイアさせた回数が2回未満だったか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| finish
