flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>命中率を+25%する"]:::effect --> c3
    c3{"③:自身の「抱擁」状態の<br/>ターン数が8ターン以上か"}:::cond
    c3 -->|"Yes"| e3["①による命中率の増加倍率が<br/>40%になり、②のアピール倍率が<br/>2倍になる"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率が2倍になる<br/>(④の効果によるアピール倍率の<br/>最大は8960%、③の効果が同時に<br/>発生した場合の最大は17920%)"]:::effect --> a2
    c4 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルへ560%のアピール"]:::action
    a2 --> lc{"②のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| c5{"⑤:②のアピールで<br/>リタイアしたか"}:::cond
    c5 -->|"Yes"| a5["再度②を実行する<br/>(再実行は最大1回まで、再実行時に<br/>④によるアピール倍率の<br/>倍率増加はリセットされる)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
