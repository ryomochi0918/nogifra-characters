flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③:このスキルが発動する前、<br/>自身がバフ・アゲ効果状態<br/>または残りHP割合が50%以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> e1
    c3 -->|"No"| e1["①効果:このスキル中、自身の<br/>命中率を+30%する"]:::effect
    e1 --> c4{"④:②のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["②の各アピール中のみ②の<br/>アピール対象のディフェンスと<br/>メンタルを-50%する"]:::effect --> a2
    c4 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルへ、自身の最大アピールの<br/>40%を固定値として上乗せした<br/>800%のアピール"]:::action
    a2 --> lc{"②のアピール対象<br/>4名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c4
    lc -->|"Yes"| c5{"⑤:②のアピールでライバルが<br/>リタイアしたまたはライバルチームの<br/>フロント人数が4名以上か"}:::cond
    c5 -->|"Yes"| a5["再度②を実行する<br/>(再実行は最大1回まで)"]:::action --> c6
    c5 -->|"No"| c6{"⑥:②のアピールでライバルが<br/>リタイアした人数が1名以下か<br/>(⑤の再実行が発動した場合は<br/>⑤の終了後に判定)"}:::cond
    c6 -->|"Yes"| a6["再度②を実行する<br/>(再実行は最大1回まで)"]:::action --> finish(("終了")):::startend
    c6 -->|"No"| finish
