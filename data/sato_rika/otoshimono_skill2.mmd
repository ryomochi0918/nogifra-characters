flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+30%する"]:::effect
    e1 --> c3{"③:このスキルが発動する前、<br/>自身がバフ・アゲ効果状態または<br/>残りHP割合が50%以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:②のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②の各アピール中のみ②の<br/>アピール対象のディフェンスと<br/>メンタルを-50%する"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバル4名に自身の最大アピールの<br/>40%を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:②のアピールでライバルが<br/>リタイアしたまたはライバルチームの<br/>フロント人数が4名以上か"}:::cond
    lc2 -->|"No、次の対象へ"| c4
    c5 -->|"Yes(再実行は最大1回まで)"| c4
    c5 -->|"No"| c6{"⑥:②のアピールでライバルが<br/>リタイアした人数が1名以下か"}:::cond
    c6 -->|"Yes(再実行は最大1回まで)"| c4
    c6 -->|"No"| finish(("終了")):::startend
