flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+25%する"]:::effect
    e1 --> c3{"③:自身の「抱擁」状態のターン数が<br/>8ターン以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①による命中率の増加倍率が40%になり、<br/>②のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(度に積算)<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率が2倍になる(④の<br/>効果によるアピール倍率の最大は<br/>8960%、③の効果が同時に発生した<br/>場合の最大は17920%)"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに4回、560%のアピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:②のアピールでリタイアしたか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes(再実行は最大1回まで、再実行時に<br/>④によるアピール倍率の倍率増加は<br/>リセットされる)"| c3
    c5 -->|"No"| finish(("終了")):::startend
