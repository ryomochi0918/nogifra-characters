flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>①のアピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| c3{"③:②の発動条件を満たした状態で<br/>②の効果対象が「アピールカダウン」状態か<br/>(②の各効果前)"}:::cond
    c2 -->|"No"| a1
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になり、<br/>①のアピール対象のバフ・アゲ効果状態を1つ解除する"]:::effect --> e2
    c3 -->|"No"| e2["①のアピール対象を100%の確率で<br/>3ターンの間「アピールカダウン」状態にする"]:::effect
    e2 --> a1["①実行:<br/>最大アピールが最も高いライバル3名へ<br/>900%のアピールを行う"]:::action
    a1 --> lc1{"①のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| e4["自身を3ターンの間「堅忍」状態にする"]:::effect --> finish(("終了")):::startend
