flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象の<br/>バフ・アゲ効果を2つ解除する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバルへ、自身のスマイルの<br/>2.5倍を固定値として上乗せした<br/>400%のアピール"]:::action
    a1 --> e4["④:自身のHPを直前の<br/>アピールの50%分回復する"]:::effect
    e4 --> lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| e5["⑤:自身と自身以外の最大アピールが<br/>最も高い味方1名を4ターンの間<br/>「勇気」状態にする"]:::effect --> finish(("終了")):::startend
