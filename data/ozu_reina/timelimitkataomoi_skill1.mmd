flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:ライバルチームの<br/>フロントメンバーにエフォート、<br/>サンクス、スマイルの内、<br/>エフォートが最も高いメンバーが<br/>一番多いか"}:::cond
    c1 -->|"Yes"| e1["最大アピールが最も高い味方4名を<br/>2ターンの間「アピールブースト<br/>(努力)」状態にする"]:::effect
    c1 -->|"No"| c2{"②:ライバルチームの<br/>フロントメンバーにエフォート、<br/>サンクス、スマイルの内、サンクスが<br/>最も高いメンバーが一番多いか"}:::cond
    e1 --> c2
    c2 -->|"Yes"| e2["最大アピールが最も高い味方4名を<br/>2ターンの間「アピールブースト<br/>(感謝)」状態にする"]:::effect
    c2 -->|"No"| c3{"③:ライバルチームの<br/>フロントメンバーにエフォート、<br/>サンクス、スマイルの内、スマイルが<br/>最も高いメンバーが一番多いか"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["最大アピールが最も高い味方4名を<br/>2ターンの間「アピールブースト<br/>(笑顔)」状態にする"]:::effect
    c3 -->|"No"| e4["④:最大アピールが最も高い味方2名を<br/>2ターンの間「興奮」状態にする"]:::effect
    e3 --> e4
    e4 --> finish(("終了")):::startend
