flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象の<br/>バフ・アゲ効果を1つ解除し、①の<br/>各アピール中のみ自身の命中率と<br/>サゲ効果耐性貫通を+30%する"]:::effect
    c2 -->|"No"| c3{"③:このスキルが発動する<br/>前のライバルチームの<br/>フロント人数が5名以下か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル4名を100%の確率で2ターンの<br/>間「弱音」状態にし、自身の残りSPの<br/>85倍を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| e4["④:最大アピールが最も高い味方2名を<br/>2ターンの間「豪運」状態にし、<br/>HPを①で行った合計アピールの<br/>35%分回復する"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e4 --> finish(("終了")):::startend
