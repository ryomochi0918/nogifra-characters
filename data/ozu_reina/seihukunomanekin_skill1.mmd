flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+40%する"]:::effect
    e1 --> e3["③:②の各アピール中のみ自身の<br/>会心アピールを+「②のアピールで<br/>会心アピールが発生した<br/>回数×20」%する(会心アピールの<br/>上限は+100%まで)<br/>(②の各アピール前)"]:::effect
    e3 --> a2["②実行:ライバルに6回、<br/>自身のサンクスの3倍を<br/>固定値として上乗せした430%の<br/>アピールを行う"]:::action
    a2 --> lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    lc2 -->|"Yes"| c4{"④:ライバルチームの<br/>フロント人数が5名以下か"}:::cond
    lc2 -->|"No、次の回へ"| e3
    c4 -->|"Yes"| a4["④実行:残りHP割合が最も<br/>低いライバルに2回、②で<br/>行った合計アピールの20%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c4 -->|"No"| c5{"⑤:②と④の会心アピールの<br/>発生回数が3回以上か"}:::cond
    a4 --> c5
    c5 -->|"Yes"| e5["自身のHPをこのスキルで行った<br/>合計アピールの25%分回復し、自身を<br/>3ターンの間「強運」状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> c5b{"⑤:②と④の会心アピールの<br/>発生回数が5回以上か"}:::cond
    c5b -->|"Yes"| e5b["⑤の「強運」状態の効果倍率が<br/>1.5倍になる"]:::effect
    c5b -->|"No"| finish
    e5b --> finish
