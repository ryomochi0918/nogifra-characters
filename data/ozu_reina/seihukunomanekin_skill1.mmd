flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、<br/>自身の会心率を+40%する"]:::effect --> a2["②実行:ライバルへ6回、自身の<br/>サンクスの3倍を固定値として<br/>上乗せした430%のアピール"]:::action --> e3
    e3["③効果:②の各アピール中のみ自身の<br/>会心アピールを+「②で会心アピールが<br/>発生した回数×20」%する<br/>(上限+100%まで)"]:::effect --> c4
    c4{"④:ライバルチームのフロント<br/>人数が5名以下か"}:::cond
    c4 -->|"Yes"| a4["残りHP割合が最も低い<br/>ライバルへ2回、②で行った合計<br/>アピールの20%分のアピール<br/>(ディフェンス、フィジカルを無視する)"]:::action --> c5
    c4 -->|"No"| c5
    c5{"⑤:②と④の会心アピールの<br/>発生回数は3回以上か"}:::cond
    c5 -->|"Yes"| e5a["自身のHPをこのスキルで行った<br/>合計アピールの25%分回復し、<br/>3ターンの間「強運」状態にする"]:::effect --> c5b
    c5 -->|"No"| finish(("終了")):::startend
    c5b{"⑤:②と④の会心アピールの<br/>発生回数は5回以上か"}:::cond
    c5b -->|"Yes"| e5b["⑤の「強運」状態の<br/>効果倍率が1.5倍になる"]:::effect --> finish
    c5b -->|"No"| finish
