flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:ライブ中の自身のスキル1、2の<br/>会心アピールの発生回数が6回以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の最大アピールの<br/>20%を固定値として上乗せする"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに6回、<br/>ライブ中に発動した自身のスキル2<br/>「あ!小津じゃん!!!」の回数×450%の<br/>倍率を上乗せした250%のアピールを<br/>行う(初回スキル発動時の①による<br/>倍率は700%となる)"]:::action
    e2 --> c2b{"②:ライブ中の自身のスキル1、<br/>2の会心アピールの発生回数が<br/>10回以上か<br/>(①の各アピール前)"}:::cond
    c2b -->|"Yes"| e2b["①のアピールの固定値倍率が2倍になる"]:::effect
    c2b -->|"No"| a1
    e2b --> c2c{"②:ライブ中の自身のスキル1、<br/>2の会心アピールの発生回数が<br/>14回以上か<br/>(①の各アピール前)"}:::cond
    c2c -->|"Yes"| e2c["自身以外の味方2名を2ターンの間<br/>「聡明」状態にする"]:::effect
    c2c -->|"No"| a1
    e2c --> a1
    a1 --> c3{"③:①のアピールが成功したか<br/>(度に積算)<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["次に行う①のアピール倍率が<br/>2倍になる(最大4000%のアピール、<br/>③によって①の上乗せ倍率は<br/>変化しない)"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes"| e4["自身のHPを①で行った合計アピールの<br/>30%分回復する"]:::effect
    c4 -->|"No"| finish(("終了")):::startend
    e4 --> finish
