flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身が受けている<br/>バフ・アゲ効果状態の種類数が<br/>2種類以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに①の<br/>アピール対象のHP上限の0.5%分を<br/>固定値として上乗せする"]:::effect
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに4回、自身のサンクスの<br/>3倍を固定値として上乗せした820%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:自身の残りHP割合が30%未満か<br/>(③の各アピール前)"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が3倍になる"]:::effect
    c4 -->|"No"| a3["③実行:残りHP割合が最も低い<br/>ライバルに2回、自身のサンクスの<br/>4倍を固定値として上乗せした1500%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>2回すべて完了?"}:::cond
    lc3 -->|"Yes"| c5{"⑤:③のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc3 -->|"No、次の回へ"| c4
    c5 -->|"Yes(再実行は最大1回まで)"| c4
    c5 -->|"No"| finish(("終了")):::startend
