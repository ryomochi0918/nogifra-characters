flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>デバフ・サゲ効果耐性貫通を+30%する"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに5回、500%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> e4["④:②のアピール対象を100%の確率で<br/>3ターンの間、②のアピール回数に<br/>応じたデバフ・サゲ効果状態にする<br/>(1回目:ディフェンスダウン、<br/>2回目:空腹、3回目:命中率ダウン、<br/>4回目:嫉妬、5回目:混乱※最大で<br/>5つのデバフ・サゲ効果状態にする)<br/>(②の各アピール後)"]:::effect
    e4 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:ライバルのフロント人数が3名以下か"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes(再実行は最大1回まで)"| c3
    c5 -->|"No"| finish(("終了")):::startend
