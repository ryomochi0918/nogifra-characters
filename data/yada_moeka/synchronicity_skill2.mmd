flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:自身の「光輝」状態のターン数が<br/>6ターン以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| e4["④:②のアピールに自身の「光輝」<br/>状態のターン数×自身の最大アピールの<br/>10%を固定値として上乗せする<br/>(②の各アピール前)"]:::effect
    e3 --> e4
    e4 --> a2["②実行:ライバルに6回、自身のSP上限の<br/>50倍を固定値として上乗せした520%の<br/>アピールを行う"]:::action
    a2 --> lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    lc2 -->|"Yes"| a5["⑤実行:残りHP割合が最も<br/>高いライバル2名に②で<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    lc2 -->|"No、次の回へ"| c3
    a5 --> e6["⑥:残りHP割合が最も低い味方3名を<br/>3ターンの間「勇気」状態にする"]:::effect
    e6 --> finish(("終了")):::startend
