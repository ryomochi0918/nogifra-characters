flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect --> c3
    c3{"③:自身の「光輝」状態のターン数が<br/>6ターン以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> e4
    c3 -->|"No"| e4
    e4["④:②のアピールに自身の「光輝」状態の<br/>ターン数×自身の最大アピールの10%を<br/>固定値として上乗せする"]:::effect --> a2
    a2["②実行:ライバルに6回、自身のSP上限の<br/>50倍を固定値として上乗せした<br/>520%のアピールを行う"]:::action --> lc2
    lc2{"②のアピール6回<br/>すべて完了?"}:::cond
    lc2 -->|"No、次の回へ"| c3
    lc2 -->|"Yes"| a5["⑤実行:残りHP割合が最も高い<br/>ライバル2名に②で行った合計アピールの<br/>30%分のアピールを行う<br/>(ディフェンス、メンタルを無視する)"]:::action --> a6
    a6["⑥実行:残りHP割合が最も低い<br/>味方3名を3ターンの間<br/>「勇気」状態にする"]:::action --> finish(("終了")):::startend
