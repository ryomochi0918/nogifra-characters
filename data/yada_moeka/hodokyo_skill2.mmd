flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を4ターンの間「光華」<br/>状態にする"]:::effect
    e1 --> c3{"③:自身の「平穏」状態のターン数が<br/>5ターン以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| c4{"④:自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>合計種類数が3種類以上<br/>または②のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:ライバルに6回、<br/>自身のエフォートの4.5倍を<br/>固定値として上乗せした370%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:自身の「平穏」状態のターン数が<br/>9ターン以上か"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も高い<br/>ライバル1名に自身の「平穏」<br/>状態のターン数×自身のエフォートを<br/>固定値として上乗せした740%の<br/>アピールを行う(固定値倍率は<br/>上限10倍まで)"]:::action
    c5 -->|"No"| e6["⑥:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    a5 --> e6
    e6 --> finish(("終了")):::startend
