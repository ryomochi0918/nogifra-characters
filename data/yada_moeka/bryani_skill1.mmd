flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> a2["②実行:残りHP割合が最も低い<br/>ライバル1名のバフ・アゲ効果を<br/>3つ解除し、自身の最大アピールの<br/>30%を固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    a2 --> c3{"③:②のアピール対象の残りHP割合が<br/>30%未満または②のアピールで<br/>リタイアしたか"}:::cond
    c3 -->|"Yes"| e3["自身を2ターンの間「強運」<br/>状態にする"]:::effect
    c3 -->|"No"| c5{"⑤:自身の残りHP割合が50%未満か<br/>(④の各アピール前)"}:::cond
    e3 --> c5
    c5 -->|"Yes"| e5["④の各アピール中のみ自身の<br/>会心アピールを+30%する"]:::effect
    c5 -->|"No"| c6{"⑥:このスキルでライバルが<br/>リタイアしたか<br/>(④の各アピール前)"}:::cond
    e5 --> c6
    c6 -->|"Yes"| e6["④のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c6 -->|"No"| a4["④実行:残りHP割合が最も高い<br/>ライバル3名に自身の最大アピールの<br/>20%を固定値として上乗せした300%の<br/>アピールを行う"]:::action
    e6 --> a4
    a4 --> lc4{"④のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc4 -->|"Yes"| c7{"⑦:このスキルでライバルが<br/>リタイアしたか"}:::cond
    lc4 -->|"No、次の対象へ"| c5
    c7 -->|"Yes"| e7["自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    c7 -->|"No"| finish(("終了")):::startend
    e7 --> finish
