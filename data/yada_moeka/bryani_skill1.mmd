flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect --> a2
    a2["②実行:残りHP割合が最も低いライバル1名の<br/>バフ・アゲ効果を3つ解除し、<br/>自身の最大アピールの30%を固定値として<br/>上乗せした1000%のアピールを行う"]:::action --> c3
    c3{"③:②のアピール対象の残りHP割合が<br/>30%未満または②のアピールで<br/>リタイアしたか(②のアピール後)"}:::cond
    c3 -->|"Yes"| e3["自身を2ターンの間「強運」状態にする<br/>※強運:アピール力が50%上昇し、<br/>会心率が30%上昇する"]:::effect --> c5
    c3 -->|"No(④は条件を満たさない場合でも発動)"| c5

    c5{"⑤:自身の残りHP割合が<br/>50%未満か(④の各アピール前)"}:::cond
    c5 -->|"Yes"| e5["④の各アピール中のみ<br/>自身の会心アピールを+30%する"]:::effect --> c6
    c5 -->|"No"| c6
    c6{"⑥:このスキルでライバルが<br/>リタイアしたか(④の各アピール前)"}:::cond
    c6 -->|"Yes"| e6["④のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a4
    c6 -->|"No"| a4
    a4["④実行:残りHP割合が最も高いライバル3名に<br/>自身の最大アピールの20%を固定値として<br/>上乗せした300%のアピールを行う"]:::action --> lc4
    lc4{"④のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc4 -->|"No、次の対象へ"| c5
    lc4 -->|"Yes"| c7

    c7{"⑦:このスキルでライバルが<br/>リタイアしたか<br/>(④のアピールが全て終了後)"}:::cond
    c7 -->|"Yes"| e7["自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect --> finish(("終了")):::startend
    c7 -->|"No"| finish
