flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身がバフ・アゲ効果状態か"}:::cond
    c1 -->|"Yes"| e1["このスキル中、自身の命中率を+30%する"]:::effect
    c1 -->|"No"| c3{"③:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    e1 --> c3
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| c4{"④:②のアピール対象が受けている<br/>特殊状態の種類数が2種類以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール対象のバフ・アゲ効果を<br/>1つ解除し、②のアピール倍率と<br/>固定値倍率が2.5倍になる"]:::effect
    c4 -->|"No"| a2["②実行:ライバル6名に<br/>自身のエフォートの3倍を<br/>固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:②のアピールで解除した<br/>バフ・アゲ効果の数が6つ以上か"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も<br/>低いライバル3名に②で<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
