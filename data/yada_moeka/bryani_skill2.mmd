flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1
    c1{"①:自身がバフ・アゲ効果状態か"}:::cond
    c1 -->|"Yes"| e1["このスキル中、自身の<br/>命中率を+30%する"]:::effect --> c3
    c1 -->|"No(②は条件を満たさない場合でも発動)"| c3

    c3{"③:自身のエフォートが<br/>②のアピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象の<br/>バフ・アゲ効果を1つ解除する"]:::effect --> c4
    c3 -->|"No"| c4
    c4{"④:②のアピール対象が受けている<br/>特殊状態の種類数が2種類以上か<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②のアピール対象のバフ・アゲ効果を<br/>1つ解除し、②のアピール倍率と<br/>固定値倍率が2.5倍になる"]:::effect --> a2
    c4 -->|"No"| a2
    a2["②実行:ライバル6名に自身のエフォートの<br/>3倍を固定値として上乗せした<br/>600%のアピールを行う"]:::action --> lc2
    lc2{"②のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2 -->|"Yes"| c5

    c5{"⑤:②のアピールで解除した<br/>バフ・アゲ効果の数が6つ以上か<br/>(②のアピールが全て終了後)"}:::cond
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバル3名に②で行った合計アピールの<br/>30%分のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
