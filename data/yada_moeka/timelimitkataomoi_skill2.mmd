flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+15%する"]:::effect
    e1 --> c3{"③:②のアピール対象の<br/>残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ、<br/>①による会心率の増加倍率と②の<br/>アピール倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに3回、対象が受けている<br/>デバフ・サゲ効果状態の<br/>種類数×自身のサンクスを<br/>固定値として上乗せした620%の<br/>アピールを行う(固定値の上乗せは<br/>自身のサンクスの5倍まで、<br/>デバフ・サゲ効果状態のライバルを<br/>優先的に選択)"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["②のアピール回数が1回増加する<br/>(アピール回数の増加は最大2回まで)"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>3回(+④の追加分)すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| e5["⑤:自身のアピール力の100%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect
    lc2 -->|"No、次の回へ"| c3
    e5 --> finish(("終了")):::startend
