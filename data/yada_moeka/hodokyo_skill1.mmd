flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方フロントの「平穏」状態の<br/>ターン数が5ターン以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに8回、自身の最大アピールの<br/>35%を固定値として上乗せした300%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> e3["③:自身のHPを直前のアピールの<br/>30%分回復する<br/>(①の各アピール後)"]:::effect
    e3 --> c5{"⑤:①のアピールでライバルを<br/>リタイアさせたか<br/>(①の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["回数に応じた効果が発動する<br/>(1回目:自身を2ターンの間<br/>「集中」状態にし、このスキル中、<br/>会心率+25%、2回目:自身を<br/>2ターンの間「柔軟」状態にする、<br/>3回目:1回目の「集中」状態を解除し、<br/>2ターンの間「円陣」状態にする)"]:::effect
    c5 -->|"No"| lc1{"①のアピール<br/>8回すべて完了?"}:::cond
    e5 --> lc1
    lc1 -->|"Yes"| c4{"④:①のアピールでリタイアした<br/>人数が1名以下か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes"| a4["④実行:残りHP割合が最も<br/>低いライバル1名に①で<br/>行った合計アピールの40%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c4 -->|"No"| finish(("終了")):::startend
    a4 --> c5_2{"⑤:④のアピールでライバルを<br/>リタイアさせたか<br/>(④の各アピール後)"}:::cond
    c5_2 -->|"Yes"| e5_2["回数に応じた効果が発動する<br/>(1回目:自身を2ターンの間<br/>「集中」状態にし、このスキル中、<br/>会心率+25%、2回目:自身を<br/>2ターンの間「柔軟」状態にする、<br/>3回目:1回目の「集中」状態を解除し、<br/>2ターンの間「円陣」状態にする)"]:::effect
    c5_2 -->|"No"| finish
    e5_2 --> finish
