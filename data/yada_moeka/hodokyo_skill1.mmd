flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:味方フロントの「平穏」状態の<br/>ターン数が5ターン以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルへ、自身の最大アピールの<br/>35%を固定値として上乗せした<br/>300%のアピール"]:::action --> e3["自身のHPを直前のアピールの<br/>30%分回復する"]:::effect --> lc1
    lc1{"①のアピール8回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c4{"④:①のアピールでリタイアした<br/>人数が1名以下か"}:::cond
    c4 -->|"Yes"| a4["残りHP割合が最も低いライバル1名へ<br/>①で行った合計アピールの40%分の<br/>アピール(ディフェンス、フィジカルを無視)"]:::action --> e5
    c4 -->|"No"| e5["⑤効果:①と④のアピールでライバルを<br/>リタイアさせた累計回数に応じて順に発動<br/>(1回目:自身を2ターンの間「集中」状態にし、<br/>このスキル中、会心率+25%<br/>2回目:自身を2ターンの間「柔軟」状態にする<br/>3回目:1回目の「集中」状態を解除し、<br/>2ターンの間「円陣」状態にする)"]:::effect --> finish(("終了")):::startend
