flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が特殊状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["80%の確率で①のアピール対象の<br/>特殊状態1つを1ターン減少する<br/>(ターン数が0ターンになった場合、<br/>特殊状態を解除する)"]:::effect
    c2 -->|"No"| c3{"③:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに5回、自身のスマイルの3倍を<br/>固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールで<br/>ライバルがリタイアしなかったか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| e4["最大アピールが最も高いライバル1名の<br/>バフ・アゲ効果を1つ解除する"]:::effect
    c4 -->|"No"| c5{"⑤:自身の「光輝」状態の<br/>ターン数が9ターン以上か"}:::cond
    e4 --> c2
    c5 -->|"Yes"| e5["自身のデバフ・サゲ効果を1つ解除し、<br/>自身と自身以外の味方1名のHPを<br/>このスキルで行った合計アピールの<br/>30%分回復する"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
