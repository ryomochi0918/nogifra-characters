flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール対象が<br/>特殊状態か"}:::cond
    c2 -->|"Yes"| e2["80%の確率で①のアピール対象の<br/>特殊状態1つを1ターン減少する<br/>(ターン数が0ターンになった場合、<br/>特殊状態を解除する)"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:自身のスマイルが①の<br/>アピール対象のスマイル以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c3 -->|"No"| a1
    a1["①実行:最大アピールが最も高い<br/>ライバルに5回、自身のスマイルの3倍を<br/>固定値として上乗せした600%の<br/>アピールを行う"]:::action --> lc1
    lc1{"①のアピール5回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c4
    c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c4 -->|"Yes"| e4["最大アピールが最も高いライバル1名の<br/>バフ・アゲ効果を1つ解除し、<br/>再度①を実行する(再実行は最大1回まで)"]:::effect --> c5
    c4 -->|"No"| c5
    c5{"⑤:自身の「光輝」状態のターン数が<br/>9ターン以上か<br/>(④の再実行が発動した場合は④の後)"}:::cond
    c5 -->|"Yes"| e5["自身のデバフ・サゲ効果を1つ解除し、<br/>自身と自身以外の味方1名のHPを<br/>このスキルで行った合計アピールの<br/>30%分回復する"]:::effect --> finish(("終了")):::startend
    c5 -->|"No"| finish
