flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:自身を2ターンの間<br/>「神気」状態にする"]:::action --> c3
    c3{"③:自身のエフォートが②のアピール<br/>対象のエフォート以上か"}:::cond
    c3 -->|"Yes"| e3["②の対象のバフ・アゲ効果を1つ解除し、<br/>②のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルへ3回、自身のエフォートの<br/>2倍を固定値として上乗せした<br/>1000%のアピール"]:::action --> c4
    c4{"④:ライバルチームのフロント<br/>人数が3名以下か"}:::cond
    c4 -->|"Yes"| c5{"⑤:ライバルチームのフロント<br/>人数が2名以下か"}:::cond
    c5 -->|"Yes"| e5["④のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a4
    c5 -->|"No"| a4["最大アピールが最も高いライバル2名へ<br/>自身のエフォートの3倍を固定値として<br/>上乗せした1300%のアピール"]:::action --> c6
    c4 -->|"No"| c6{"⑥:このスキルでライバルが<br/>リタイアしたか"}:::cond
    c6 -->|"Yes"| a6["自身の「神気」状態を解除し、<br/>自身を2ターンの間<br/>「円陣」状態にする"]:::action --> finish(("終了")):::startend
    c6 -->|"No"| finish
