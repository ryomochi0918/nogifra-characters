flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e2["②効果:①の「追走」の受けるアピール<br/>低下倍率と回避率の効果倍率が、ライバル<br/>チームのフロントが受けている特殊状態の<br/>種類数合計4種類毎に20%上昇する<br/>(12種類以上で最大倍率)"]:::effect --> a1["①実行:自身を4ターンの間<br/>「追走」状態にする"]:::action --> c4
    c4{"④:自身のサンクスが③のアピール<br/>対象のサンクス以上か"}:::cond
    c4 -->|"Yes"| e4["③の各効果中のみ自身の<br/>サゲ効果耐性貫通を+20%する"]:::effect --> a3
    c4 -->|"No"| a3["③実行:最大アピールが最も高い<br/>ライバル3名のバフ・アゲ効果を2つ解除し、<br/>100%の確率で2ターンの間<br/>「雑音」状態にする"]:::action --> a5["⑤実行:最大アピールが最も高い<br/>ライバルへ6回、自身のサンクスの2倍を<br/>固定値として上乗せした550%のアピール<br/>(「雑音」状態ではないライバルを<br/>優先的に選択)"]:::action --> finish(("終了")):::startend
