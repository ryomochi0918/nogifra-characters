flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e2["②:①による「追走」の受ける<br/>アピールの低下倍率と回避率の<br/>効果倍率はライバルチームの<br/>フロントが受けている特殊状態の<br/>種類数の合計が4種類毎に20%上昇する<br/>(12種類以上で最大倍率になる)"]:::effect
    e2 --> e1["①:自身を4ターンの間「追走」<br/>状態にする"]:::effect
    e1 --> c4{"④:自身のサンクスが③の<br/>アピール対象のサンクス以上か<br/>(③の各効果前)"}:::cond
    c4 -->|"Yes"| e4["③の各効果中のみ自身の<br/>サゲ効果耐性貫通を+20%する"]:::effect
    c4 -->|"No"| e3["③:最大アピールが最も高い<br/>ライバル3名のバフ・アゲ効果を<br/>2つ解除し、100%の確率で2ターンの<br/>間「雑音」状態にする"]:::effect
    e4 --> e3
    e3 --> lc3{"③の効果<br/>対象3名すべて完了?"}:::cond
    lc3 -->|"Yes"| a5["⑤実行:最大アピールが最も高い<br/>ライバルに6回、自身のサンクスの<br/>2倍を固定値として上乗せした550%の<br/>アピールを行う(「雑音」状態ではない<br/>ライバルを優先的に選択する)"]:::action
    lc3 -->|"No、次の対象へ"| c4
    a5 --> finish(("終了")):::startend
