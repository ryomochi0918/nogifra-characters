flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール対象の残りHP割合が<br/>50%以上か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["該当対象への①のアピール倍率と<br/>固定値倍率と固定値の上限が<br/>3倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル5名へ、ライブ中に発動した<br/>自身のスキル2「勝者の目つき。」の<br/>回数×自身の最大アピールの10%を<br/>固定値として上乗せした1000%の<br/>アピール(固定値の最大倍率は30%まで)"]:::action --> a3["③実行:最大アピールが最も高い<br/>ライバル3名へ100%の確率で<br/>2ターンの間「不調」状態にする"]:::action --> a4["④実行:自身のHPを自身の<br/>HP上限の30%分回復する"]:::action --> finish(("終了")):::startend
