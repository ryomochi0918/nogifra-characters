flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率と<br/>固定値の上限が3倍になる"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル5名にライブ中に発動した<br/>自身のスキル2「勝者の目つき。」<br/>の回数×自身の最大アピールの10%を<br/>固定値として上乗せした1000%の<br/>アピールを行う(固定値の<br/>最大倍率は30%まで)"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:最大アピールが最も高い<br/>ライバル3名を100%の確率で2ターンの<br/>間「不調」状態にする"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e3 --> e4["④:自身のHPを自身のHP上限の<br/>30%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
