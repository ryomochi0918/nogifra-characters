flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール対象の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を<br/>2つ解除する"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のエフォートが①のアピール<br/>対象のエフォート以上か"}:::cond
    c3 -->|"Yes"| e3["①の対象のバフ・アゲ効果を1つ解除し、<br/>①のアピール倍率と固定値倍率を<br/>2倍にする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルへ、自身の最大アピールの<br/>30%を固定値として上乗せした<br/>600%のアピール"]:::action --> lc1
    lc1{"①のアピール4回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c4{"④:①のアピールでリタイアした<br/>人数が1名以下か"}:::cond
    c4 -->|"Yes"| a4["再度①を実行(再実行は最大1回まで)"]:::action --> a5
    c4 -->|"No"| a5["⑤実行:自身のHPをこのスキルで<br/>行った合計アピールの20%分<br/>回復する"]:::action --> finish(("終了")):::startend
