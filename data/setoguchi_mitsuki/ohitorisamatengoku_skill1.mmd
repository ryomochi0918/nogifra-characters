flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身と自身以外の最大アピールが<br/>最も高い味方2名を2ターンの間<br/>「聖域」と「倍音」状態にする"]:::effect
    e1 --> a2["②実行:最大アピールが最も高い<br/>ライバル1名のバフ・アゲ効果を<br/>2つ解除し、自身の残りHPの20%を<br/>固定値として上乗せした1600%の<br/>アピールを行う"]:::action
    a2 --> c3{"③:ライバルチームのフロントの<br/>残りHP割合の合計が450%以上か"}:::cond
    c3 -->|"Yes"| a3["③実行:残りHP割合が最も高い<br/>ライバル1名のバフ・アゲ効果を<br/>2つ解除し、自身の残りHPの20%を<br/>固定値として上乗せした1600%の<br/>アピールを行う"]:::action
    c3 -->|"No"| e4["④:自身と自身以外の最大アピールが<br/>最も高い味方3名のHPを自身の<br/>HP上限の20%分回復する"]:::effect
    a3 --> e4
    e4 --> c5{"⑤:味方フロントの残りHP割合の<br/>合計が380%以上か"}:::cond
    c5 -->|"Yes"| e5["自身と最大アピールが最も高い<br/>味方2名のデバフ・サゲ効果を<br/>2つ解除する"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
