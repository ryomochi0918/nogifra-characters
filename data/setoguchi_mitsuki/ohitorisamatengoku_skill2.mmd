flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:残りHP割合が最も低い<br/>ライバルに4回、自身のHP上限の<br/>5%を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    a1 --> c2{"②:自身の「平穏」状態のターン数が<br/>8ターン以上かつ①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール後)"}:::cond
    c2 -->|"Yes"| e2["①のアピール回数が1回増加する<br/>(アピールの追加回数は最大で2回まで)"]:::effect
    c2 -->|"No"| lc1{"①のアピール<br/>4回(+②の追加分)すべて完了?"}:::cond
    e2 --> lc1
    lc1 -->|"Yes"| c3{"③:味方チームのフロントの<br/>残りHP割合の合計がライバルチームの<br/>フロントの残りHP割合の合計未満か"}:::cond
    lc1 -->|"No、次の回へ"| a1
    c3 -->|"Yes"| a3["③実行:残りHP割合が最も低い<br/>ライバルに3回、自身のHP上限の<br/>10%を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    c3 -->|"No"| e4["④:残りHP割合が最も低い味方2名の<br/>HPを自身のHP上限の40%分回復する"]:::effect
    a3 --> e4
    e4 --> c5{"⑤:ライバルチームのフロント人数が<br/>3名以上または自身の「平穏」状態の<br/>ターン数が7ターン以上か"}:::cond
    c5 -->|"Yes"| e5["残りHP割合が最も高い味方2名を<br/>3ターンの間「交響」状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
