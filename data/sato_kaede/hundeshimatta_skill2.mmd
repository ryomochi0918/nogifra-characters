flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+30%する"]:::effect
    e1 --> c4{"④:②のアピール対象の<br/>残りHP割合が50%未満か<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②の各アピールは<br/>必ず会心アピールになる"]:::effect
    c4 -->|"No"| c5{"⑤:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["②の各アピール倍率と②の<br/>固定値倍率が1.5倍になる"]:::effect
    c5 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバル1名に自身のサンクスの<br/>6倍を固定値として上乗せした1800%の<br/>アピールを行う"]:::action
    e5 --> a2
    a2 --> c3{"③:②のアピールでアピール対象が<br/>リタイアしなかったか"}:::cond
    c3 -->|"Yes"| c4_2{"④:③のアピール対象の<br/>残りHP割合が50%未満か<br/>(③の各アピール前)"}:::cond
    c3 -->|"No"| c6{"⑥:②と③のアピールでライバルが<br/>リタイアしたか"}:::cond
    c4_2 -->|"Yes"| e4_2["③の各アピールは<br/>必ず会心アピールになる"]:::effect
    c4_2 -->|"No"| c5_2{"⑤:自身の残りHP割合が③の<br/>アピール対象の残りHP割合以上か<br/>(③の各アピール前)"}:::cond
    e4_2 --> c5_2
    c5_2 -->|"Yes"| e5_2["③の各アピール倍率と②の<br/>固定値倍率が1.5倍になる"]:::effect
    c5_2 -->|"No"| a3["③実行:ライバル3名に②で<br/>行った直前のアピールの40%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    e5_2 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc3 -->|"Yes"| c6
    lc3 -->|"No、次の対象へ"| c4_2
    c6 -->|"Yes(再実行は最大1回まで)"| c4
    c6 -->|"No"| finish(("終了")):::startend
