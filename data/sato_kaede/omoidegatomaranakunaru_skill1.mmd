flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが<br/>①のアピール対象のサンクス以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバル4名に自身のサンクスの2倍を<br/>固定値として上乗せした550%のアピールを行う"]:::action
    a1 --> c3{"③:①のアピールで会心アピールが2回以上発生した、<br/>または①のアピールでリタイアした人数が2名以下か<br/>(かつ再実行がまだの場合)"}:::cond
    c3 -->|"Yes、再度①を実行<br/>(再実行は最大1回まで)"| c2
    c3 -->|"No"| e4["④:自身のHPをこのスキルで行った<br/>合計アピールの20%分回復し、<br/>2ターンの間「堅忍」状態にする"]:::effect --> finish(("終了")):::startend
