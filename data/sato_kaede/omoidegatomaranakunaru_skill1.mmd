flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバル4名に自身のサンクスの<br/>2倍を固定値として上乗せした550%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:①のアピールで会心アピールが<br/>2回以上発生した、または<br/>①のアピールでリタイアした<br/>人数が2名以下か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c3 -->|"Yes(再実行は最大1回まで)"| c2
    c3 -->|"No"| e4["④:自身のHPをこのスキルで行った<br/>合計アピールの20%分回復し、<br/>2ターンの間「堅忍」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
