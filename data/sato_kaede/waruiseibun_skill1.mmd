flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+25%、<br/>会心アピールを+80%する"]:::effect --> a2
    a2["②実行:<br/>ライバルに420%のアピールを行う"]:::action
    a2 --> lc{"②のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| a2
    lc -->|"Yes"| c3{"③:このスキルで<br/>会心アピールが発生したか"}:::cond
    c3 -->|"Yes"| e3["③:このスキルで発生した会心アピールの回数を<br/>対象人数として、最大アピールが最も高い味方の<br/>デバフ・サゲ効果を2つ解除し、<br/>HPを②で行った合計アピールの30%分回復し、<br/>2ターンの間「全開」と「勇気」状態にする"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身が<br/>バフ・アゲ効果状態か"}:::cond
    c4 -->|"Yes"| e4["自身を3ターンの間<br/>「円陣」状態にする"]:::effect --> finish(("終了")):::startend
    c4 -->|"No"| finish
