flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+25%、<br/>会心アピールを+80%する"]:::effect
    e1 --> a2["②実行:ライバルに6回、420%の<br/>アピールを行う"]:::action
    a2 --> e3["③:このスキルで発生した<br/>会心アピールの回数を対象人数として、<br/>最大アピールが最も高い味方の<br/>デバフ・サゲ効果を2つ解除し、<br/>HPを②で行った合計アピールの<br/>30%分回復し、2ターンの間「全開」<br/>と「勇気」状態にする"]:::effect
    e3 --> c4{"④:自身がバフ・アゲ効果状態か"}:::cond
    c4 -->|"Yes"| e4["自身を3ターンの間「円陣」<br/>状態にする"]:::effect
    c4 -->|"No"| finish(("終了")):::startend
    e4 --> finish
