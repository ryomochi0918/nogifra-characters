flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方フロントの「軽快」状態の<br/>合計ターン数が5ターン以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ自身の<br/>命中率を+30%する"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに4回、味方フロントの<br/>「軽快」状態のターン数×200%の倍率を<br/>上乗せした400%のアピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:味方フロントの「軽快」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c3 -->|"Yes"| a3["③実行:残りHP割合が最も<br/>高いライバル1名に①で行った<br/>合計アピールの20%分のアピールを<br/>行う(ディフェンス、フィジカルを<br/>無視し必ず命中する)"]:::action
    c3 -->|"No"| c4{"④:③のアピールでライバルが<br/>リタイアしたか"}:::cond
    a3 --> c4
    c4 -->|"Yes(再実行は最大1回まで)"| a3
    c4 -->|"No"| finish(("終了")):::startend
