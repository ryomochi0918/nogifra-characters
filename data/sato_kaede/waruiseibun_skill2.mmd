flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身の会心率を+40%する"]:::effect --> a2
    a2["②実行:<br/>ライバル6名に1000〜3000%のアピールを行う<br/>(自身の残りHP割合が低いほど倍率が高くなる)"]:::action
    a2 --> c4a{"④:②のアピールで<br/>会心アピールが発生したか<br/>(対象ごとに判定)"}:::cond
    c4a -->|"Yes"| e4a["②のアピール対象の<br/>バフ・アゲ効果を2つ解除する"]:::effect --> c3
    c4a -->|"No"| c3{"③:②のアピールで<br/>会心アピールが発生したか"}:::cond
    c3 -->|"Yes"| a3["③実行:<br/>ライバル1名に自身の最大アピールの30%を<br/>固定値として上乗せした1000%のアピールを行う"]:::action
    a3 --> c4b{"④:③のアピールで<br/>会心アピールが発生したか"}:::cond
    c4b -->|"Yes"| e4b["③のアピール対象の<br/>バフ・アゲ効果を2つ解除する"]:::effect --> lc3
    c4b -->|"No"| lc3{"③のアピールを<br/>②で発生した会心アピールの回数分<br/>すべて完了?"}:::cond
    lc3 -->|"No、次の回へ"| a3
    lc3 -->|"Yes"| e5
    c3 -->|"No"| e5["⑤:自身と自身以外の残りHP割合が<br/>最も低い味方1名のHPを<br/>このスキルで行った合計アピールの<br/>40%分回復する"]:::effect --> finish(("終了")):::startend
