flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+40%する"]:::effect
    e1 --> a2["②実行:ライバル6名に1000〜3000%の<br/>アピールを行う(自身の残りHP割合が<br/>低いほど倍率が高くなる)"]:::action
    a2 --> c4a{"④:②のアピールで会心アピールが<br/>発生したか<br/>(②の各アピール後)"}:::cond
    c4a -->|"Yes"| e4a["②のアピール対象のバフ・アゲ効果を<br/>2つ解除する"]:::effect
    c4a -->|"No"| lc2{"②のアピール<br/>ライバル6名すべて完了?"}:::cond
    e4a --> lc2
    lc2 -->|"Yes"| a3["③実行:②のアピールによって発生した<br/>会心アピールの回数をアピール回数として、<br/>ライバル1名に自身の最大アピールの<br/>30%を固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    lc2 -->|"No、次の対象へ"| a2
    a3 --> c4b{"④:③のアピールで会心アピールが<br/>発生したか<br/>(③の各アピール後)"}:::cond
    c4b -->|"Yes"| e4b["③のアピール対象のバフ・アゲ効果を<br/>2つ解除する"]:::effect
    c4b -->|"No"| lc3{"③のアピール<br/>回数分すべて完了?"}:::cond
    e4b --> lc3
    lc3 -->|"Yes"| e5["⑤:自身と自身以外の残りHP割合が<br/>最も低い味方1名のHPをこのスキルで行った<br/>合計アピールの40%分回復する"]:::effect
    lc3 -->|"No、次の回へ"| a3
    e5 --> finish(("終了")):::startend
