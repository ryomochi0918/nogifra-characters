flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身の命中率を+30%し、<br/>リフレクト耐性を+50%する"]:::effect
    e1 --> c4{"④:②のアピール対象の<br/>残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②の各アピールが<br/>必ず会心アピールになる"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル1名に自身のサンクスの<br/>6倍を固定値として上乗せした1800%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> c3{"③:②のアピールでアピール対象が<br/>リタイアしたか"}:::cond
    c3 -->|"Yes"| c4_2{"④:③のアピール対象の<br/>残りHP割合が50%以上か<br/>(③の各アピール前)"}:::cond
    c3 -->|"No"| c5{"⑤:②のアピールでアピール対象が<br/>リタイアしなかったか"}:::cond
    c4_2 -->|"Yes"| e4_2["③の各アピールが<br/>必ず会心アピールになる"]:::effect
    c4_2 -->|"No"| a3["③実行:ライバル3名に②で<br/>行った直前のアピールの40%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    e4_2 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc3 -->|"Yes"| c5
    lc3 -->|"No、次の対象へ"| c4_2
    c5 -->|"Yes(再実行は最大1回まで)"| c4
    c5 -->|"No"| finish(("終了")):::startend
