flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:<br/>最大アピール力が最も高いライバル1名の<br/>バフ・アゲ効果を2つ解除し、100%の確率で<br/>3ターンの間「執着」状態と<br/>1ターンの間「落胆」状態にする"]:::action --> c3
    c3{"③:②のアピール対象が<br/>バフ・アゲ効果状態ではないか"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>ライバルに自身のエフォートの2.5倍を<br/>固定値として上乗せした750%のアピールを行う"]:::action
    a2 --> c4{"④:②のアピールで<br/>ライバルがリタイアしたか<br/>(かつ再実行が3回未満の場合)"}:::cond
    c4 -->|"Yes"| r1["再度①を実行する<br/>(再実行は最大3回まで)"]:::action --> lc
    c4 -->|"No"| lc{"②のアピール<br/>3回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| finish(("終了")):::startend
