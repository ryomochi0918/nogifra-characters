flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:最大アピール力が最も高いライバル1名の<br/>バフ・アゲ効果を2つ解除し、100%の確率で<br/>3ターンの間「執着」状態と<br/>1ターンの間「落胆」状態にする"]:::effect
    e1 --> c3{"③:②のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに3回、自身のエフォートの<br/>2.5倍を固定値として上乗せした750%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールで<br/>ライバルがリタイアしたか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["再度①を実行する<br/>(再実行は最大3回まで)"]:::effect
    e4 --> lc2
    c4 -->|"No"| lc2{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
