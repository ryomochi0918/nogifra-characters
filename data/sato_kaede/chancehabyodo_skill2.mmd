flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方チームのフロント人数が<br/>3名以下か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率を3倍にし、<br/>①の各アピール中のみ①のアピール対象の<br/>ディフェンスとフィジカルを-50%する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>残りHP割合が最も低いライバルに<br/>600%のアピールを行う"]:::action
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c3{"③:①のアピールで<br/>ライバルがリタイアしたか"}:::cond
    c3 -->|"Yes"| a3["③実行:<br/>最大アピールが最も高いライバルに<br/>自身のエフォート8倍分のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action
    a3 --> lc3{"③のアピール<br/>4回すべて完了?"}:::cond
    lc3 -->|"No、次の回へ"| a3
    lc3 -->|"Yes"| e4
    c3 -->|"No"| e4["④:自身のHPをこのスキルで行った<br/>合計アピールの20%分回復する"]:::effect --> finish(("終了")):::startend
