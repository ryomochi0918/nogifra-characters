flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+30%する"]:::effect
    e1 --> a2["②実行:ライバルに6回、<br/>バフ・アゲ効果を1つ解除し、<br/>自身の最大アピールの15%を<br/>固定値として上乗せした300%の<br/>アピールを行う"]:::action
    a2 --> a3["③実行:ライバルに②のアピールで<br/>発生した会心アピールの<br/>回数をアピール回数とした、<br/>自身のサンクスの7倍分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    a3 --> e4["④:自身のHPをこのスキルで行った<br/>合計アピールの20%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
