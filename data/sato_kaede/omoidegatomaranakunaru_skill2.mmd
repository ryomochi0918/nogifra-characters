flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身の会心率を+30%する"]:::effect --> a2
    a2["②実行:<br/>ライバルのバフ・アゲ効果を1つ解除し、<br/>自身の最大アピールの15%を固定値として上乗せした<br/>300%のアピールを行う"]:::action
    a2 --> lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    lc2 -->|"No、次の回へ"| a2
    lc2 -->|"Yes"| c3{"③:②のアピールで<br/>会心アピールが発生したか"}:::cond
    c3 -->|"Yes"| a3["③実行:<br/>ライバルに②のアピールで発生した<br/>会心アピールの回数をアピール回数とした、<br/>自身のサンクスの7倍分のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action --> e4
    c3 -->|"No"| e4["④:自身のHPをこのスキルで行った<br/>合計アピールの20%分回復する"]:::effect --> finish(("終了")):::startend
