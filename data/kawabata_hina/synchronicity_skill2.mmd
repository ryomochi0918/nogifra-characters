flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身が受けている<br/>バフ・アゲ効果状態が2種類以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ自身の<br/>リフレクト耐性を+20%する"]:::effect
    c2 -->|"No"| c3{"③:自身が受けている<br/>バフ・アゲ効果状態が3種類以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:自身が受けている<br/>バフ・アゲ効果状態が4種類以上か<br/>(①の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["①のアピール倍率が3倍になる(④の<br/>効果による①のアピール倍率の最大は<br/>2550%、③の効果が同時に発動した<br/>場合はアピール倍率5100%まで)"]:::effect
    c4 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに3回、850%のアピールを行う"]:::action
    e4 --> a1
    a1 --> lc1{"①のアピール<br/>3回すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c5 -->|"Yes(再実行は最大2回まで)"| c2
    c5 -->|"No"| a6["⑥実行:最大アピールが<br/>最も高いライバル1名に①で<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    a6 --> finish(("終了")):::startend
