flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身が受けている<br/>バフ・アゲ効果状態が<br/>2種類以上か"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ<br/>自身のリフレクト耐性を+20%する"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③:自身が受けている<br/>バフ・アゲ効果状態が<br/>3種類以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる"]:::effect --> c4
    c3 -->|"No"| c4
    c4{"④:自身が受けている<br/>バフ・アゲ効果状態が<br/>4種類以上か"}:::cond
    c4 -->|"Yes"| e4["①のアピール倍率が3倍になる<br/>(④の効果による①のアピール倍率の<br/>最大は2550%、③の効果が同時に<br/>発動した場合はアピール倍率5100%まで)"]:::effect --> a1
    c4 -->|"No"| a1
    a1["①実行:残りHP割合が最も低い<br/>ライバルに3回、850%の<br/>アピールを行う"]:::action --> lc1
    lc1{"①のアピール3回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c5
    c5{"⑤:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c5 -->|"Yes、再度①を実行<br/>(再実行は最大2回まで)"| c2
    c5 -->|"No、または再実行2回済み"| a6
    a6["⑥実行:最大アピールが最も高い<br/>ライバル1名に①で行った<br/>合計アピールの30%分のアピールを行う<br/>(ディフェンス、メンタルを無視する)<br/>(⑤の再実行が発動した場合は⑤の後)"]:::action --> finish(("終了")):::startend
