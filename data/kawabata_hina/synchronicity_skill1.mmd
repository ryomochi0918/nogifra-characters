flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:自身を2ターンの間<br/>「全開」状態にする"]:::effect --> c3
    c3{"③:自身のスマイルが<br/>②のアピール対象の<br/>スマイル以上か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2
    a2["②実行:ライバル4名に自身のSP上限の<br/>100倍を固定値として上乗せした<br/>950%のアピールを行う"]:::action --> lc2
    lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2 -->|"Yes"| e4["④効果:自身のHPを②で行った<br/>合計アピールの30%分回復する"]:::effect --> a5
    a5["⑤実行:ライバル1名に②で行った<br/>合計アピールの50%分のアピールを行う<br/>(ディフェンス、メンタルを無視する)"]:::action --> c6
    c6{"⑥:このスキル中に<br/>ライバルがリタイアしたか"}:::cond
    c6 -->|"Yes"| e6["自身を2ターンの間<br/>「情熱」状態にする"]:::effect --> finish(("終了")):::startend
    c6 -->|"No"| finish
