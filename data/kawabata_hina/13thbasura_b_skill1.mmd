flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍に"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のサンクスが①の<br/>アピール対象のサンクス以上か"}:::cond
    c3 -->|"Yes"| e3["対象のバフ・アゲ効果を1つ解除し、<br/>「フィジカルダウン」「メンタルダウン」の<br/>効果倍率が1.5倍に"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバルへ100%の確率で<br/>2ターンの間「フィジカルダウン」<br/>「メンタルダウン」状態にし、1000%のアピール"]:::action
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| c4{"④:①の各アピール前に自身の残り<br/>HP割合が対象の残りHP割合以上<br/>だった回数が3回以上発生したか"}:::cond
    c4 -->|"Yes"| e4["最大アピールが最も高いライバル2名を<br/>100%の確率で1ターンの間<br/>「雑音」状態にする"]:::effect --> finish(("終了")):::startend
    c4 -->|"No"| finish
