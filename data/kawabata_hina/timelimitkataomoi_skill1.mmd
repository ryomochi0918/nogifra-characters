flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバルへ2回、<br/>1200%のアピール"]:::action --> a2["②実行:自身を4ターンの間<br/>「魅了」状態にする"]:::action --> c4
    c4{"④:③の効果対象の残りHP割合が<br/>50%未満か(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["該当対象のデバフ・サゲ効果を<br/>1つ解除する"]:::effect --> a3
    c4 -->|"No"| a3["③実行:自身と自身以外の残りHP割合が<br/>最も低い味方2名のHPを自身のHP上限の<br/>20%分回復し、4ターンの間<br/>「堅忍」状態にする"]:::action --> c5
    c5{"⑤:ライバルチームのフロント<br/>人数が4名以上か"}:::cond
    c5 -->|"Yes"| a5["自身と自身以外の最大アピールが<br/>最も高い味方2名を4ターンの間<br/>「威圧」状態にする"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
