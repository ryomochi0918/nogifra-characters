flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバルに2回、1200%の<br/>アピールを行う"]:::action
    a1 --> e2["②:自身を4ターンの間「魅了」<br/>状態にする"]:::effect
    e2 --> c4{"④:③の効果対象の<br/>残りHP割合が50%未満か<br/>(③の効果前)"}:::cond
    c4 -->|"Yes"| e4["③の効果対象のデバフ・サゲ効果を<br/>1つ解除する"]:::effect
    c4 -->|"No"| e3["③:自身と自身以外の残りHP割合が<br/>最も低い味方2名のHPを自身の<br/>HP上限の20%分回復し、4ターンの間<br/>「堅忍」状態にする"]:::effect
    e4 --> e3
    e3 --> lc3{"③の効果<br/>対象3名すべて完了?"}:::cond
    lc3 -->|"Yes"| c5{"⑤:ライバルチームの<br/>フロント人数が4名以上か"}:::cond
    lc3 -->|"No、次の対象へ"| c4
    c5 -->|"Yes"| e5["自身と自身以外の最大アピールが<br/>最も高い味方2名を4ターンの間<br/>「威圧」状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
