flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>合計種類数が3種類以上か"}:::cond
    c2 -->|"Yes"| e2["①の命中率の増加倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e2 --> e1
    e1 --> a3["③実行:残りHP割合が最も高い<br/>ライバル4名に500%のアピールを行う"]:::action
    a3 --> c4{"④:③のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>2種類以上か<br/>(③の各アピール後)"}:::cond
    c4 -->|"Yes"| a4["④実行:同じ対象に500%の<br/>アピールを行う"]:::action
    c4 -->|"No"| lc3{"③のアピール<br/>ライバル4名すべて完了?"}:::cond
    a4 --> lc3
    lc3 -->|"Yes"| c5{"⑤:ライバルチームの<br/>フロント人数が3名以上か"}:::cond
    lc3 -->|"No、次の対象へ"| a3
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバルに3回、自身の最大アピールの<br/>80%を固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
