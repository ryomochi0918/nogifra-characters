flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を4ターンの間<br/>「アピールブースト(笑顔)」<br/>状態にする"]:::effect
    e1 --> c3{"③:②のアピール対象の残りHP割合が<br/>50%以上または自身の残りHP割合が<br/>②のアピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除し、②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに7回、<br/>自身のエフォートの2.5倍を<br/>固定値として上乗せした380%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールでライバルが<br/>リタイアしたか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["自身を2ターンの間「熱血」<br/>状態にする"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>7回すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| e5["⑤:自身を2ターンの間「熱血」<br/>状態にする"]:::effect
    lc2 -->|"No、次の回へ"| c3
    e5 --> c6{"⑥:②のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c6 -->|"Yes"| a6["⑥実行:残りHP割合が最も低い<br/>ライバルに2回、自身のエフォートの<br/>5.5倍を固定値として上乗せした760%の<br/>アピールを行う"]:::action
    c6 -->|"No"| finish(("終了")):::startend
    a6 --> finish
