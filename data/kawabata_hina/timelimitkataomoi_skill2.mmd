flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>命中率を+30%する"]:::effect --> c3
    c3{"③:②のアピール対象の残りHP割合が<br/>50%以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect --> c4
    c3 -->|"No"| c4{"④:ライブ中に自身のスキル2<br/>「最後の牛タン」が2回以上<br/>発動したか"}:::cond
    c4 -->|"Yes"| e4["②の固定値倍率が3倍になる"]:::effect --> a2
    c4 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルへ、対象のHP上限の0.5%分を<br/>固定値として上乗せした800%のアピール"]:::action --> lc1
    lc1{"②のアピール3回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c3
    lc1 -->|"Yes"| a5["⑤実行:自身と自身以外の最大アピールが<br/>最も高い味方2名のHPを②で行った<br/>合計アピールの20%分回復する"]:::action --> finish(("終了")):::startend
