flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+30%する"]:::effect
    e1 --> c3{"③:②のアピール対象の<br/>残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["対象のバフ・アゲ効果を1つ解除する"]:::effect
    c3 -->|"No"| c4{"④:ライブ中に自身のスキル2<br/>「最後の牛タン」が2回以上発動したか<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②による固定値倍率が3倍になる"]:::effect
    c4 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルに3回、対象のHP上限の<br/>0.5%分を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"Yes"| e5["⑤:自身と自身以外の最大アピールが<br/>最も高い味方2名のHPを②で行った<br/>合計アピールの20%分回復する"]:::effect
    lc2 -->|"No、次の回へ"| c3
    e5 --> finish(("終了")):::startend
