flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のリフレクトが<br/>①のアピール対象の<br/>リフレクト以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピールに<br/>自身の残りHPの20%を<br/>固定値として上乗せする"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身が<br/>バフ・アゲ効果状態か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率を<br/>2倍にする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>ライバルへ500%のアピール"]:::action
    a1 --> e4["④:自身と自身以外の<br/>残りHP割合が最も低い味方1名のHPを<br/>①で行った合計アピールの<br/>20%分回復する"]:::effect
    e4 --> lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c5{"⑤:①のアピールで<br/>ライバルがリタイアしたか"}:::cond
    c5 -->|"Yes"| a5["⑤実行:<br/>最大アピールが最も高いライバルへ、<br/>①で行った合計アピールの<br/>50%分のアピール<br/>(ディフェンス、フィジカルを無視する)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
