flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のリフレクトが①の<br/>アピール対象のリフレクト以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の残りHPの20%を<br/>固定値として上乗せする"]:::effect
    c2 -->|"No"| c3{"③:自身がバフ・アゲ効果状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:ライバルに6回、500%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> e4["④:自身と自身以外の残りHP割合が<br/>最も低い味方1名のHPを①で行った<br/>合計アピールの20%分回復する<br/>(①の各アピール後)"]:::effect
    e4 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:①のアピールでライバルが<br/>リタイアしたか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c5 -->|"Yes"| a5["⑤実行:最大アピールが最も高い<br/>ライバルに①で行った合計アピールの<br/>50%分のアピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
