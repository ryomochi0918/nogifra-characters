flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の命中率を<br/>「自身が受けているバフ・アゲ効果・<br/>特殊状態の種類数×10%」分増加する<br/>(命中率の増加上限は50%まで)"]:::effect
    e1 --> a2["②実行(①の条件を満たさない場合でも発動):<br/>ライバル4名へ500%のアピール<br/>(2回目以降のアピールは対象を選び直す)"]:::action
    a2 --> l2{"②のアピール<br/>2回すべて完了?"}:::cond
    l2 -->|"No、次の回へ"| a2
    l2 -->|"Yes"| a3["③実行:<br/>ライバルへ1000%のアピール"]:::action
    a3 --> l3{"③のアピール<br/>2回すべて完了?"}:::cond
    l3 -->|"No、次の回へ"| a3
    l3 -->|"Yes"| c4{"④:このスキルでライバルを<br/>リタイアさせた回数が2回以下か<br/>(再実行は最大1回まで)"}:::cond
    c4 -->|"Yes"| e4["②と③のアピール倍率を<br/>1.5倍にして<br/>再度②からスキルを実行する"]:::effect --> a2
    c4 -->|"No"| e5["⑤:自身のHPを<br/>このスキルで行った合計アピールの<br/>30%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
