flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を「自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>種類数×10%」分増加する(命中率の<br/>増加上限は50%まで)"]:::effect
    e1 --> a2["②実行:ライバル4名に2回、<br/>500%のアピールを行う(2回目以降の<br/>アピールは対象を選び直す)"]:::action
    a2 --> a3["③実行:ライバルに2回、1000%の<br/>アピールを行う"]:::action
    a3 --> c4{"④:このスキルでライバルを<br/>リタイアさせた回数が2回以下か"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)<br/>②と③のアピール倍率を<br/>1.5倍にして再実行"| a2
    c4 -->|"No"| e5["⑤:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
