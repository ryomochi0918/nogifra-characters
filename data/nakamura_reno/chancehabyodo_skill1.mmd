flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が「転倒」状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身のサンクスが①の効果対象の<br/>サンクス以上か<br/>(①の各効果前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①の「転倒」状態にする確率を+40%し、<br/>①の各効果中のみ自身の<br/>サゲ効果耐性貫通を+20%する"]:::effect
    c3 -->|"No"| a1["①実行:ライバルに6回、<br/>自身のサンクスの2倍を<br/>固定値として上乗せした400%の<br/>アピールを行い、60%の確率で<br/>1ターンの間「転倒」状態にする"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:ライバルチームのフロントに<br/>「転倒」状態のライバルが<br/>1名以上居るか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes"| e4["自身のHPをこのスキルで行った<br/>合計アピールの50%分回復する"]:::effect
    c4 -->|"No"| finish(("終了")):::startend
    e4 --> finish
