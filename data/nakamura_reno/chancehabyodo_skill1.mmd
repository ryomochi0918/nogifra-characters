flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>「転倒」状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバルへ、自身のサンクスの2倍を<br/>固定値として上乗せした<br/>400%のアピール"]:::action
    a1 --> c3{"③:自身のサンクスが<br/>①の効果対象のサンクス以上か"}:::cond
    c3 -->|"Yes"| e3["①の「転倒」状態にする確率を+40%し、<br/>①の各効果中のみ<br/>自身のサゲ効果耐性貫通を+20%する"]:::effect --> e1
    c3 -->|"No"| e1["①:60%の確率で<br/>1ターンの間「転倒」状態にする"]:::effect
    e1 --> lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c4{"④:ライバルチームのフロントに<br/>「転倒」状態のライバルが<br/>1名以上居るか"}:::cond
    c4 -->|"Yes"| e4["自身のHPを<br/>このスキルで行った合計アピールの<br/>50%分回復する"]:::effect --> finish(("終了")):::startend
    c4 -->|"No"| finish
