flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が30%以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値を2倍にする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>残りHP割合が最も低いライバルへ、<br/>自身の最大アピールの25%を<br/>固定値として上乗せした<br/>430%のアピール"]:::action
    a1 --> e3["③:自身のHPを<br/>①で行った直前のアピールの<br/>40%分回復する"]:::effect
    e3 --> lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c4{"④:①のアピールで<br/>ライバルがリタイアしたか<br/>(再実行は最大1回まで)"}:::cond
    c4 -->|"Yes"| e4["④:再度①からスキルを実行する"]:::effect --> c2
    c4 -->|"No"| e5["⑤:残りHP割合が80%以上のライバルを<br/>100%の確率で1ターンの間<br/>「転倒」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
