flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が30%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに6回、自身の最大アピールの<br/>25%を固定値として上乗せした430%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> e3["③:自身のHPを①で行った直前の<br/>アピールの40%分回復する<br/>(①の各アピール後)"]:::effect
    e3 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしたか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| e5["⑤:残りHP割合が80%以上のライバルを<br/>100%の確率で1ターンの間「転倒」<br/>状態にする"]:::effect
    e5 --> finish(("終了")):::startend
