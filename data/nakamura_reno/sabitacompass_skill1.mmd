flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:<br/>ライバル4名へ、<br/>自身の最大アピールの20%を<br/>固定値として上乗せした<br/>550%のアピール"]:::action
    a1 --> a2["②実行:<br/>残りHP割合が最も低いライバルへ、<br/>自身の最大アピールの40%を<br/>固定値として上乗せした<br/>1100%のアピール"]:::action
    a2 --> l2{"②のアピール<br/>2回すべて完了?"}:::cond
    l2 -->|"No、次の回へ"| a2
    l2 -->|"Yes"| e3["③:自身を4ターンの間<br/>「アピール力アップ」状態にする"]:::effect
    e3 --> c4{"④:このスキルで<br/>ライバルがリタイアしたか"}:::cond
    c4 -->|"Yes"| a4["④実行:<br/>再度①と②を実行する<br/>(再実行は最大1回まで)"]:::action --> finish(("終了")):::startend
    c4 -->|"No"| e5["⑤:自身を2ターンの間<br/>「集中」状態にする"]:::effect --> finish
