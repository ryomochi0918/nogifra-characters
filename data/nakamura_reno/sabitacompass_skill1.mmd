flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル4名に<br/>自身の最大アピールの20%を<br/>固定値として上乗せした550%の<br/>アピールを行う"]:::action
    a1 --> a2["②実行:残りHP割合が最も低い<br/>ライバルに2回、自身の最大アピールの<br/>40%を固定値として上乗せした1100%の<br/>アピールを行う"]:::action
    a2 --> cr{"④の再実行による<br/>②のアピールか"}:::cond
    cr -->|"Yes"| finish(("終了")):::startend
    cr -->|"No"| e3["③:自身を4ターンの間<br/>「アピール力アップ」状態にする"]:::effect
    e3 --> c4{"④:このスキルでライバルが<br/>リタイアしたか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| a1
    c4 -->|"No"| c5{"⑤:このスキルでライバルが<br/>リタイアしなかったか"}:::cond
    c5 -->|"Yes"| e5["自身を2ターンの間「集中」<br/>状態にする"]:::effect
    c5 -->|"No"| finish
    e5 --> finish
