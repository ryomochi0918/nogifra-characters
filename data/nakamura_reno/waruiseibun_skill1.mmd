flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバル4名を100%の確率で<br/>3ターンの間「ディフェンスダウン」<br/>状態にし、500%のアピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| a3["③実行:ライバルに4回、500%の<br/>アピールを行う(「転倒」状態ではない<br/>ライバルを優先的に選択する)"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a3 --> c5{"⑤:④の効果対象が<br/>デバフ・サゲ効果状態か<br/>(④の各効果前)"}:::cond
    c5 -->|"Yes"| e5["④による「転倒」状態にする確率が<br/>100%になる"]:::effect
    c5 -->|"No"| e4["④:③のアピール対象を80%の確率で<br/>1ターンの間「転倒」状態にする<br/>(③の各アピール後)"]:::effect
    e5 --> e4
    e4 --> lc3{"③のアピール<br/>4回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| a3
