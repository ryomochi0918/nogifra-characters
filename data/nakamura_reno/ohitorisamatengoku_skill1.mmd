flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに5回、<br/>自身のバイタリティの1.5倍を<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> e3["③:自身のHPを直前アピールの<br/>20%分回復する<br/>(①の各アピール後)"]:::effect
    e3 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:自身の残りHP割合が70%以上か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c5 -->|"Yes"| e5["④による「反響」状態の<br/>リフレクト倍率が2倍になる"]:::effect
    c5 -->|"No"| e4["④:自身を4ターンの間「反響」<br/>状態にする"]:::effect
    e5 --> e4
    e4 --> finish(("終了")):::startend
