flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c4a{"④:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(対象ごとに判定)"}:::cond
    c4a -->|"Yes"| e4a["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> a1
    c4a -->|"No"| a1["①実行:<br/>ライバル4名へ、<br/>自身のサンクスの2.5倍を<br/>固定値として上乗せした<br/>550%のアピール"]:::action
    a1 --> e2["②:①のアピール対象を<br/>100%の確率で4ターンの間<br/>「アピール力ダウン」状態にする"]:::effect
    e2 --> c4b{"④:③のアピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    c4b -->|"Yes"| e4b["③のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> a3
    c4b -->|"No"| a3["③実行:<br/>ライバルへ、<br/>自身のサンクスの2.5倍を<br/>固定値として上乗せした<br/>550%のアピール"]:::action
    a3 --> l3{"③のアピール<br/>4回すべて完了?"}:::cond
    l3 -->|"No、次の回へ"| c4b
    l3 -->|"Yes"| finish(("終了")):::startend
