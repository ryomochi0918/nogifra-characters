flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c4{"④:アピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["①の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a1["①実行:ライバル4名に自身のサンクスの<br/>2.5倍を固定値として上乗せした550%の<br/>アピールを行う"]:::action
    e4 --> a1
    a1 --> e2["②:①のアピール対象を100%の確率で<br/>4ターンの間「アピール力ダウン」<br/>状態にする<br/>(①の各アピール後)"]:::effect
    e2 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4_2{"④:アピール対象が<br/>デバフ・サゲ効果状態か<br/>(③の各アピール前)"}:::cond
    lc1 -->|"No、次の対象へ"| c4
    c4_2 -->|"Yes"| e4_2["③の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4_2 -->|"No"| a3["③実行:ライバルに4回、<br/>自身のサンクスの2.5倍を<br/>固定値として上乗せした550%の<br/>アピールを行う"]:::action
    e4_2 --> a3
    a3 --> lc3{"③のアピール<br/>4回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c4_2
