flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3a{"③①の各アピール前:<br/>自身の残りHP割合が50%以上?"}:::cond
    c3a -->|"Yes"| e3a["①のアピールに自身の最大アピールの<br/>30%を固定値として上乗せする"]:::effect
    c3a -->|"No"| a1
    e3a --> a1["①実行:ライバル4名に<br/>600%のアピール(1名ずつ)"]:::action
    a1 --> loop1{"①のアピール4名分<br/>すべて完了?"}:::cond
    loop1 -->|"No、次の回へ"| c3a
    loop1 -->|"Yes"| c3b{"③②の各アピール前:<br/>自身の残りHP割合が50%以上?"}:::cond
    c3b -->|"Yes"| e3b["②のアピールに自身の最大アピールの<br/>30%を固定値として上乗せする"]:::effect
    c3b -->|"No"| a2
    e3b --> a2["②実行:①のアピールが全て終了した後、<br/>残りHP割合が最も高いライバルに<br/>600%のアピール"]:::action
    a2 --> loop2{"②のアピール3回<br/>すべて完了?"}:::cond
    loop2 -->|"No、次の回へ"| c3b
    loop2 -->|"Yes"| e4["④②のアピールが全て終了した後、<br/>自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
