flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e2["②:100%の確率で3ターンの<br/>間「フィジカルダウン」と<br/>「メンタルダウン」状態にする<br/>(①の各アピール前)"]:::effect
    e2 --> a1["①実行:ライバル6名に480%の<br/>アピールを行う"]:::action
    a1 --> c3{"③:①のアピールで①のアピール対象が<br/>リタイアしなかったか<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| a3["③実行:同じ対象に自身の<br/>残りSPの50倍を上乗せした320%の<br/>アピールを行う"]:::action
    c3 -->|"No"| lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    a3 --> lc1
    lc1 -->|"Yes"| a4["④実行:最大アピールが最も<br/>高いライバル1名に①と③で<br/>行った合計アピールの100%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    lc1 -->|"No、次の対象へ"| e2
    a4 --> finish(("終了")):::startend
