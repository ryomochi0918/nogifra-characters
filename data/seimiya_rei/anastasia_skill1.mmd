flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e2["②①の各アピール前:100%の確率で<br/>①のアピール対象を3ターンの間<br/>「フィジカルダウン」と「メンタルダウン」<br/>状態にする<br/>(フィジカルダウン:フィジカルが60%低下する<br/>メンタルダウン:メンタルが60%低下する)"]:::effect
    e2 --> a1["①実行:<br/>ライバル6名へ480%のアピールを行う"]:::action
    a1 --> c3{"③:①のアピールで①のアピール対象が<br/>リタイアしなかったか<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| a3["③実行:同じ対象に自身の残りSPの<br/>50倍を上乗せした320%のアピール"]:::action
    c3 -->|"No"| lc1
    a3 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| e2
    lc1 -->|"Yes"| a4["④実行:①のアピールが全て終了後、<br/>最大アピールが最も高いライバル1名に<br/>①と③で行った合計アピールの<br/>100%分のアピール<br/>(ディフェンス、メンタルを無視する)"]:::action
    a4 --> finish(("終了")):::startend
