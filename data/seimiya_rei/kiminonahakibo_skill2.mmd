flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③:自身の残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①の各アピールに自身の最大アピールの<br/>30%を固定値として上乗せする"]:::effect
    c3 -->|"No"| a1["①実行:ライバル4名に600%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c3_2{"③:自身の残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    lc1 -->|"No、次の対象へ"| c3
    c3_2 -->|"Yes"| e3_2["②の各アピールに自身の最大アピールの<br/>30%を固定値として上乗せする"]:::effect
    c3_2 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルに3回、600%のアピールを行う"]:::action
    e3_2 --> a2
    a2 --> lc2{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"Yes"| e4["④:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    lc2 -->|"No、次の回へ"| c3_2
    e4 --> finish(("終了")):::startend
