flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②①の各アピール前:<br/>自身の残りHP割合が50%以上?"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が1.5倍になる"]:::effect
    c2 -->|"No"| a1
    e2 --> a1["①実行:ライバルに自身のエフォートの<br/>3倍を固定値として上乗せした<br/>400%のアピール"]:::action
    a1 --> c3{"③①の各アピール後:<br/>自身の残りHP割合が50%未満?"}:::cond
    c3 -->|"Yes"| e3["自身のHPを①で行った直前の<br/>アピールの50%分回復する"]:::effect
    c3 -->|"No"| loop
    e3 --> loop{"①のアピール6回<br/>すべて完了?"}:::cond
    loop -->|"No、次の回へ"| c2
    loop -->|"Yes"| e4["④①のアピールが全て終了後、<br/>自身を2ターンの間「反響」状態にする<br/>(反響:リフレクトを+80%し、<br/>受けるアピールが50%減少する)"]:::effect
    e4 --> finish(("終了")):::startend
