flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②①の各アピール前:<br/>自身の残りSPが①のアピール対象の<br/>残りSP以上?<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3
    e2 --> c3{"③①の各アピール前:<br/>自身のスマイルが①のアピール対象の<br/>スマイル以上?<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a1
    e3 --> a1["①実行:ライバル6名に自身のスマイルの<br/>2倍を固定値として上乗せした<br/>600%のアピール(1名ずつ)"]:::action
    a1 --> loop{"①のアピール6名分<br/>すべて完了?"}:::cond
    loop -->|"No、次の回へ"| c2
    loop -->|"Yes"| e4["④①のアピールが全て終了後、<br/>自身と自身以外の残りHP割合が<br/>最も低い味方2名を4ターンの間<br/>「勇気」状態にし、HPをこのスキルで<br/>行った合計アピールの40%分回復する<br/>(勇気:効果発生時の残りSP×40分の<br/>アピールを無効化する)"]:::effect
    e4 --> finish(("終了")):::startend
