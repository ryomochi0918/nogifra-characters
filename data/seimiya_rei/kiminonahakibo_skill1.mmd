flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに6回、<br/>自身のエフォートの3倍を<br/>固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:自身の残りHP割合が50%未満か<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["自身のHPを①で行った直前の<br/>アピールの50%分回復する"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| e4["④:自身を2ターンの間「反響」<br/>状態にする"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e4 --> finish(("終了")):::startend
