flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の会心率と<br/>命中率を「味方フロントの「独占」状態の<br/>合計ターン数×5%」分増加する<br/>(増加上限は+40%まで)"]:::effect --> c4a
    c4a{"④:②の対象がデバフ・<br/>サゲ効果状態か"}:::cond
    c4a -->|"Yes"| e4a["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c4a -->|"No"| a2["②実行:ライバル4名へアピール対象の<br/>HP減少分の5%を固定値(上限は最大<br/>アピールの300%)として上乗せした<br/>550%のアピール"]:::action --> c4b
    c4b{"④:③の対象がデバフ・<br/>サゲ効果状態か"}:::cond
    c4b -->|"Yes"| e4b["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a3
    c4b -->|"No"| a3["③実行:ライバルへ3回、アピール対象の<br/>HP減少分の5%を固定値(上限は最大<br/>アピールの300%)として上乗せした<br/>550%のアピール"]:::action --> finish(("終了")):::startend
