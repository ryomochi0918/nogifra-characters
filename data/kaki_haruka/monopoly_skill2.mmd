flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率と<br/>命中率を「味方フロントの<br/>「独占」状態の合計ターン数×5%」<br/>分増加する(会心率と命中率の<br/>増加上限は+40%まで)"]:::effect
    e1 --> c4{"④:②の各アピール対象が<br/>デバフ・サゲ効果状態か<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:ライバル4名に<br/>アピール対象のHP減少分の5%を<br/>固定値として上乗せした550%の<br/>アピールを行う(固定値の上乗せは<br/>自身の最大アピールの300%まで)"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| c4_2{"④:③の各アピール対象が<br/>デバフ・サゲ効果状態か<br/>(③の各アピール前)"}:::cond
    lc2 -->|"No、次の対象へ"| c4
    c4_2 -->|"Yes"| e4_2["③の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4_2 -->|"No"| a3["③実行:ライバルに3回、<br/>アピール対象のHP減少分の5%を<br/>固定値として上乗せした550%の<br/>アピールを行う(固定値の上乗せは<br/>自身の最大アピールの300%まで)"]:::action
    e4_2 --> a3
    a3 --> lc3{"③のアピール<br/>3回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c4_2
