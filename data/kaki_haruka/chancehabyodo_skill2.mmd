flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:最大アピールが最も高い味方3名を<br/>3ターンの間「命中率アップ」と<br/>「会心率アップ」状態にする"]:::effect
    e1 --> c3{"③:味方フロントの<br/>バフ・アゲ効果・特殊状態の<br/>合計数が15以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル4名に自身のサンクスの<br/>4倍を固定値として上乗せした700%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c3
    c4 -->|"No"| e5["⑤:残りHP割合が最も低い味方1名の<br/>HPを②で行った合計アピールの<br/>30%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
