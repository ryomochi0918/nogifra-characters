flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバルへ2回、<br/>1500%のアピール"]:::action --> c3
    c3{"③:味方チームのフロント人数が<br/>5名以下か"}:::cond
    c3 -->|"Yes"| e3["②の「決心」状態の<br/>ターン数を+1する"]:::effect --> e2
    c3 -->|"No"| e2["②実行:自身を3ターンの間<br/>「決心」状態にする"]:::effect --> c4
    c4{"④:自身が「声援」<br/>状態か"}:::cond
    c4 -->|"No(⑤)"| e5["自身を6ターンの間<br/>「声援」状態にする"]:::effect --> finish(("終了")):::startend
    c4 -->|"Yes(⑥)"| e6["自身と自身以外の最大アピールが<br/>最も高い味方1名のデバフ・サゲ効果を<br/>2つ解除し、4ターンの間<br/>「堅忍」状態にする"]:::effect --> finish
