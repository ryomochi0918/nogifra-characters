flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①の対象の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果<br/>解除数が1つ増加する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル4名のバフ・アゲ効果を<br/>1つ解除し、500~1000%のアピール<br/>(自身の残りHP割合が低いほど<br/>アピール倍率が上昇する)"]:::action --> loop1
    loop1{"①を4名分実行したか"}:::cond
    loop1 -->|"No、次の対象へ"| c2
    loop1 -->|"Yes"| c4
    c4{"④:③の対象の残りHP割合が<br/>70%未満か"}:::cond
    c4 -->|"Yes"| e4["③の回復倍率と<br/>「ディフェンスアップ」の<br/>効果倍率が2倍になる"]:::effect --> e3
    c4 -->|"No"| e3["③実行:自身と自身以外の最大アピールが<br/>最も高い味方1名のHPを①の合計<br/>アピールの35%分回復し、3ターンの間<br/>「ディフェンスアップ」状態にする"]:::effect --> c5
    c5{"⑤:味方チームのフロント人数が<br/>6名以下か"}:::cond
    c5 -->|"Yes"| a5["「7-味方チームのフロント人数」を<br/>アピール回数として、ライバルへ自身の<br/>サンクス4倍分のアピール(ディフェンス、<br/>フィジカルを無視する)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
