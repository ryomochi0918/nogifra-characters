flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果解除数が<br/>1つ増加する"]:::effect
    c2 -->|"No"| a1["①実行:ライバル4名のバフ・アゲ効果を<br/>1つ解除し、500~1000%のアピールを<br/>行う(自身の残りHP割合が<br/>低いほどアピール倍率が上昇する)"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:③の効果対象の<br/>残りHP割合が70%未満か<br/>(③の各効果前)"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["③の回復倍率と「ディフェンスアップ」<br/>の効果倍率が2倍になる"]:::effect
    c4 -->|"No"| e3["③:自身と自身以外の最大アピールが<br/>最も高い味方1名のHPを①で行った<br/>合計アピールの35%分回復し、<br/>3ターンの間「ディフェンスアップ」<br/>状態にする"]:::effect
    e4 --> e3
    e3 --> lc3{"③の効果<br/>対象2名すべて完了?"}:::cond
    lc3 -->|"Yes"| c5{"⑤:⑤の効果を発動する前の<br/>味方チームのフロント人数が6名以下か"}:::cond
    lc3 -->|"No、次の対象へ"| c4
    c5 -->|"Yes"| a5["⑤実行:「7-味方チームの<br/>フロント人数」をアピール回数として、<br/>ライバルに自身のサンクス4倍分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
