flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方フロントの「光輝」状態の<br/>合計ターン数が5ターン以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>2倍になり、①のアピール中のみ、<br/>自身のリフレクト耐性を+20%する"]:::effect
    c2 -->|"No"| a1["①実行:残りHPの割合が最も高い<br/>ライバルに6回、自身の最大アピールの<br/>40%を固定値として上乗せした390%の<br/>アピールを行い、100%の確率で<br/>3ターンの間「心労」状態にする"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:①のアピールで会心アピールが<br/>3回以上発生したか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c3 -->|"Yes"| a3["③実行:残りHPの割合が最も高い<br/>ライバル1名に自身の「光輝」<br/>状態のターン数×自身のエフォートの<br/>固定値を上乗せした780%のアピールを<br/>行う(固定値倍率は上限12倍まで)"]:::action
    c3 -->|"No"| finish(("終了")):::startend
    a3 --> finish
