flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:味方フロントの「光輝」状態の<br/>合計ターン数が5ターン以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>2倍になり、①のアピール中のみ<br/>自身のリフレクト耐性を+20%する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルへ6回、自身の最大アピールの<br/>40%を固定値として上乗せした<br/>390%のアピールを行い、100%の確率で<br/>3ターンの間「心労」状態にする"]:::action --> loop1
    loop1{"①を6回実行したか"}:::cond
    loop1 -->|"No、次の回へ"| c2
    loop1 -->|"Yes"| c3
    c3{"③:①のアピールで会心アピールが<br/>3回以上発生したか"}:::cond
    c3 -->|"Yes"| a3["残りHP割合が最も高いライバル1名へ<br/>自身の「光輝」状態のターン数×エフォート<br/>の固定値(上限12倍)を上乗せした<br/>780%のアピール"]:::action --> finish(("終了")):::startend
    c3 -->|"No"| finish
