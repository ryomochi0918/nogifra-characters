flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"②:①のアピール対象が<br/>特殊状態か"}:::cond
    c1 -->|"Yes"| e1["②実行:①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c2
    c1 -->|"No"| c2{"③:①のアピール対象の<br/>残りHP割合が80%以上か"}:::cond
    c2 -->|"Yes"| e2["③実行:①のアピール対象の<br/>バフ・アゲ効果を1つ解除し、<br/>①のアピール倍率が3倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに、自身のエフォートの<br/>3倍を固定値として上乗せした<br/>850%のアピールを行う"]:::action --> loop1
    loop1{"①のアピール4回<br/>すべて完了?"}:::cond
    loop1 -->|"No、次の回へ"| c1
    loop1 -->|"Yes"| c3{"④:①のアピールで<br/>ライバルがリタイア<br/>しなかったか"}:::cond
    c3 -->|"Yes(リタイアしなかった)"| c4{"④:再実行は最大1回まで<br/>すでに再実行したか"}:::cond
    c4 -->|"No"| r1["④実行:再度①を実行する"]:::action --> c1
    c4 -->|"Yes"| a2
    c3 -->|"No(リタイアした)"| a2["⑤実行:残りHP割合が最も低い<br/>ライバル1名にこのスキルで行った<br/>合計アピールの40%分のアピールを<br/>行う(ディフェンス、<br/>フィジカルを無視する)"]:::action --> finish(("終了")):::startend
