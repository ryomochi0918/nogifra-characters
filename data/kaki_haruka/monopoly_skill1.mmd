flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバル6名に<br/>自身のエフォートの2倍を<br/>固定値として上乗せした550%の<br/>アピールを行い、対象を100%の確率で<br/>3ターンの間「アピール力ダウン」<br/>状態にする"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:味方フロントの「独占」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["自身のデバフ・サゲ効果を2つ解除し、<br/>③による「聖域」状態のターン数を<br/>4ターンにする"]:::effect
    c4 -->|"No"| e3["③:自身のHPを①で行った<br/>合計アピールの30%分回復し、<br/>2ターンの間「聖域」状態にする"]:::effect
    e4 --> e3
    e3 --> finish(("終了")):::startend
