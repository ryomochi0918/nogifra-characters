flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のエフォートが<br/>対象のエフォート以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル6名へ自身のエフォート<br/>の2倍を固定値として上乗せした<br/>550%のアピールを行い、対象を100%の<br/>確率で3ターンの間「アピールカダウン」<br/>状態にする"]:::action --> loop1
    loop1{"①を6回実行したか"}:::cond
    loop1 -->|"No、次の対象へ"| c2
    loop1 -->|"Yes"| e3
    e3["③実行:自身のHPを①の合計アピールの<br/>30%分回復し、2ターンの間<br/>「聖域」状態にする"]:::effect --> c4
    c4{"④:味方フロントの「独占」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    c4 -->|"Yes"| e4["自身のデバフ・サゲ効果を2つ解除し、<br/>③の「聖域」状態のターン数を<br/>4ターンにする"]:::effect --> finish
    c4 -->|"No"| finish(("終了")):::startend
