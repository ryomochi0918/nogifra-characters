flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のスマイルが<br/>対象のスマイル以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の<br/>スマイルの2倍を固定値として<br/>上乗せする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル2名へ3回、<br/>800%のアピール<br/>(2回目以降は対象を選び直す)"]:::action --> loop1
    loop1{"①を対象2名×3回<br/>実行したか"}:::cond
    loop1 -->|"No、次の回へ"| c2
    loop1 -->|"Yes"| a3["③実行:残りHP割合が最も高い<br/>ライバルへ3回、①の合計アピールの<br/>60%分のアピール(ディフェンス、<br/>メンタルを無視する)"]:::action --> finish(("終了")):::startend
