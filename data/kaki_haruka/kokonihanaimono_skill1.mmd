flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身のスマイルの<br/>2倍を固定値として上乗せする"]:::effect
    c2 -->|"No"| a1["①実行:ライバル2名に3回、<br/>800%のアピールを行う(2回目以降の<br/>アピールは対象を選び直す)"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc1 -->|"Yes"| lc1n{"①のアピール<br/>3回すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1n -->|"Yes"| a3["③実行:残りHP割合が最も高い<br/>ライバルに3回、このスキルで<br/>行った合計アピールの60%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    lc1n -->|"No、次の回へ"| c2
    a3 --> finish(("終了")):::startend
