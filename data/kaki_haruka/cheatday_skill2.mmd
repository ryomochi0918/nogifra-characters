flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②/③:①のアピール対象の<br/>残りHP割合が50%未満か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["②:①のアピール倍率が2倍になる"]:::effect
    c2 -->|"No"| e3["③:①の<br/>各アピール中のみ必ず会心アピールになる"]:::effect
    e2 --> a1["①実行:残りHP割合が最も<br/>高いライバルに3回、1400%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> c4{"④:①のアピールでアピールの<br/>失敗またはアピールが0である事が<br/>発生したか<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["このスキルによる残りのアピールは<br/>必ず命中する"]:::effect
    c4 -->|"No"| c5{"⑤:①のアピールでライバルを<br/>リタイアさせたか<br/>(度に積算)<br/>(①の各アピール後)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["①のアピール回数が1回増加し、<br/>このスキルによる残りの<br/>アピールに自身の最大アピールを<br/>固定値として上乗せする(アピールの<br/>追加回数は最大で4回まで、<br/>最大アピールの固定値倍率は<br/>最大400%まで)"]:::effect
    c5 -->|"No"| lc1{"①のアピール<br/>3回(+⑤の追加分)すべて完了?"}:::cond
    e5 --> lc1
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
