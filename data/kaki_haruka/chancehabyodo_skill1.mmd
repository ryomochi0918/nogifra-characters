flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象の<br/>残りHP割合が50%未満か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①によるデバフ・サゲ効果の解除数を<br/>1つ増加させ、①の効果対象のHPを<br/>自身のHP上限の20%分回復する"]:::effect
    c2 -->|"No"| e1["①:自身以外の最大アピールが最も<br/>高い味方3名のデバフ・サゲ効果を<br/>1つ解除し、3ターンの間「興奮」<br/>状態にする"]:::effect
    e2 --> e1
    e1 --> lc1{"①の効果<br/>対象3名すべて完了?"}:::cond
    lc1 -->|"Yes"| a3["③実行:残りHP割合が最も低い<br/>ライバルに6回、370%のアピールを行う"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a3 --> e5["⑤:③のアピールで発生した<br/>会心アピール2回ごとに④の<br/>効果対象が1名増加する(増加人数は<br/>最大3名まで)"]:::effect
    e5 --> e4["④:自身と自身以外の残りHP割合が<br/>最も高い味方1名を3ターンの間<br/>「脚光」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
