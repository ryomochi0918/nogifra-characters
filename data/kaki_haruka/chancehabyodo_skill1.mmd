flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①の対象の残りHP割合が<br/>50%未満か"}:::cond
    c2 -->|"Yes"| e2["①のデバフ・サゲ効果の<br/>解除数を1つ増加させ、対象のHPを<br/>自身のHP上限の20%分回復する"]:::effect --> e1
    c2 -->|"No"| e1["①実行:自身以外の最大アピールが<br/>最も高い味方3名のデバフ・サゲ効果を<br/>1つ解除し、3ターンの間<br/>「興奮」状態にする"]:::effect --> loop1
    loop1{"①を対象3名分実行したか"}:::cond
    loop1 -->|"No、次の対象へ"| c2
    loop1 -->|"Yes"| a3["③実行:残りHP割合が最も低い<br/>ライバルへ6回、370%のアピール"]:::action --> c5
    c5{"⑤:③のアピールで発生した<br/>会心アピール2回ごとに④の対象が<br/>1名増加するか(最大3名まで)"}:::cond
    c5 -->|"Yes"| e5["④の効果対象が<br/>1名増加する"]:::effect --> e4
    c5 -->|"No"| e4["④実行:自身と自身以外の残りHP割合が<br/>最も高い味方1名を3ターンの間<br/>「脚光」状態にする"]:::effect --> finish(("終了")):::startend
