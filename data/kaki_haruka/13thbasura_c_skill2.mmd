flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方フロントのバフ・アゲ効果状態の<br/>合計数がライバルフロントの<br/>バフ・アゲ効果状態の合計数以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>2.5倍になる"]:::effect
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに5回、自身の最大アピールの<br/>20%を固定値として上乗せした700%の<br/>アピールを行い、バフ・アゲ効果を<br/>1つ解除する"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| a3["③実行:バフ・アゲ効果状態ではない<br/>ライバルに①で行った合計アピールの<br/>20%分のアピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc1 -->|"No、次の回へ"| c2
    a3 --> e5["⑤:①と③のアピールで発生した<br/>会心アピールの回数1回毎に④の<br/>効果対象を1名増加する(増加人数は<br/>最大で2名まで)"]:::effect
    e5 --> c6{"⑥:④の効果対象が受けている<br/>バフ・アゲ効果状態の種類数が<br/>2種類以上か<br/>(④の効果前)"}:::cond
    c6 -->|"Yes"| e6["④の「堅忍」状態を「声援」<br/>状態に変更する"]:::effect
    c6 -->|"No"| e4["④:残りHP割合が最も低い味方2名を<br/>3ターンの間「堅忍」状態にする"]:::effect
    e6 --> e4
    e4 --> lc4{"④の効果<br/>対象すべて完了?"}:::cond
    lc4 -->|"Yes"| finish(("終了")):::startend
    lc4 -->|"No、次の対象へ"| c6
