flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身の残りHP割合が<br/>50%未満か"}:::cond
    c2 -->|"Yes"| e2["①のリフレクト耐性の<br/>増加倍率が2倍になる"]:::effect --> e1
    c2 -->|"No"| e1["①実行:自身を2ターンの間<br/>「勇気」と「全開」状態にし、<br/>このスキル中リフレクト耐性を<br/>+20%する"]:::effect --> c4
    c4{"④:自身のスマイルが<br/>対象のスマイル以上か"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a3
    c4 -->|"No"| a3["③実行:ライバル4名へ自身の<br/>最大アピールの35%を固定値として<br/>上乗せした500%のアピール"]:::action --> loop1
    loop1{"③を4名分実行したか"}:::cond
    loop1 -->|"No、次の対象へ"| c4
    loop1 -->|"Yes"| c5
    c5{"⑤:ライバルチームの<br/>フロント人数が3名以下か"}:::cond
    c5 -->|"Yes(③を再実行、最大1回)"| c4
    c5 -->|"No"| a6["⑥実行:残りHP割合が最も高い<br/>ライバルへ2回、自身の残りSPの100倍を<br/>上乗せした1000%のアピール"]:::action --> finish(("終了")):::startend
