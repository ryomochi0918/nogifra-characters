flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%未満か"}:::cond
    c2 -->|"Yes"| e2["①によるリフレクト耐性の<br/>増加倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:自身を2ターンの間「勇気」と<br/>「全開」状態にし、このスキル中、<br/>リフレクト耐性を+20%する"]:::effect
    e2 --> e1
    e1 --> c4{"④:自身のスマイルが③の<br/>アピール対象のスマイル以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:ライバル4名に<br/>自身の最大アピールの35%を<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc3 -->|"Yes"| c5{"⑤:ライバルチームの<br/>フロント人数が3名以下か"}:::cond
    lc3 -->|"No、次の対象へ"| c4
    c5 -->|"Yes(再実行は最大1回まで)"| c4
    c5 -->|"No"| a6["⑥実行:残りHP割合が最も高い<br/>ライバルに2回、自身の残りSPの<br/>100倍を上乗せした1000%の<br/>アピールを行う"]:::action
    a6 --> finish(("終了")):::startend
