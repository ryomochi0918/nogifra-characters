flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:会心値が最も高い<br/>ライバル3名を100%の確率で4ターンの<br/>間「不調」状態にし、自身のHP上限の<br/>5%を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    a1 --> c3{"③:味方チームのフロントの<br/>残りHP割合の合計がライバルチームの<br/>フロントの残りHP割合の合計未満か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象の<br/>バフ・アゲ効果を2つ解除し、<br/>②のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:②のアピール対象が受けている<br/>デバフ・サゲ効果の種類数が<br/>3種類以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率と<br/>固定値倍率が3倍になる"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに4回、自身の残りHPの<br/>8%を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"Yes"| e5["⑤:残りHP割合が最も高い<br/>ライバル3名を100%の確率で2ターンの<br/>間「空腹」状態にする"]:::effect
    lc2 -->|"No、次の回へ"| c3
    e5 --> finish(("終了")):::startend
