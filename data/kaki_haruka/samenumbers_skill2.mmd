flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①実行:会心値が最も高いライバル3名を<br/>100%の確率で4ターンの間<br/>「不調」状態にする<br/>※不調:アピール力が30%低下し、<br/>会心率が50%低下する"]:::effect --> a1["①実行:自身のHP上限の5%を<br/>固定値として上乗せした<br/>800%のアピールを行う"]:::action --> c3
    c3{"③:味方チームのフロントの<br/>残りHP割合の合計が<br/>ライバルチームのフロントの<br/>残りHP割合の合計未満か"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>2つ解除し、②のアピール倍率が<br/>2倍になる"]:::effect --> c4
