flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:このスキル開始時、<br/>味方フロントの「光輝」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    c1 -->|"Yes"| e1["このスキル中、自身の命中率と<br/>会心率を+25%する"]:::effect
    c1 -->|"No"| c3{"③:②のアピール対象が「心労」状態、<br/>または味方フロントの「光輝」状態の<br/>合計ターン数が12ターン以上か<br/>(②の各アピール前)"}:::cond
    e1 --> c3
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が3倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに4回、自身のエフォートの<br/>2倍を固定値として上乗せした540%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c5{"⑤:自身の「光輝」状態のターン数が<br/>9ターン以上か<br/>(②の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["自身のHPを②で行った直前の<br/>アピールの30%分回復する"]:::effect
    c5 -->|"No"| lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    e5 --> lc2
    lc2 -->|"Yes"| a4["④実行:②のアピールで<br/>会心アピールが発生した回数を<br/>アピール回数として、ライバル1名に<br/>②で行った合計アピールの20%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc2 -->|"No、次の回へ"| c3
    a4 --> c5_2{"⑤:自身の「光輝」状態のターン数が<br/>9ターン以上か<br/>(④の各アピール後)"}:::cond
    c5_2 -->|"Yes"| e5_2["自身のHPを④で行った直前の<br/>アピールの30%分回復する"]:::effect
    c5_2 -->|"No"| lc4{"④のアピール<br/>回数分すべて完了?"}:::cond
    e5_2 --> lc4
    lc4 -->|"Yes"| finish(("終了")):::startend
    lc4 -->|"No、次の回へ"| a4
