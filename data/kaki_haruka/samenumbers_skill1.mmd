flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>サゲ効果耐性貫通を+30%する"]:::effect
    e1 --> e2["②:残りHP割合が最も高い<br/>ライバル3名を100%の確率で1ターンの<br/>間「落胆」状態にする"]:::effect
    e2 --> a3["③実行:ライバル1名のバフ・アゲ効果を<br/>1つ解除し、自身の残りHPの25%を<br/>固定値として上乗せした1500%の<br/>アピールを行う"]:::action
    a3 --> c4{"④:③のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c4 -->|"Yes(再実行は最大3回まで)"| a3
    c4 -->|"No"| c6{"⑥:このスキルでライバルが<br/>リタイアしたか<br/>(⑤の各効果前)"}:::cond
    c6 -->|"Yes"| e6["⑤による「防音」状態の<br/>効果倍率が2倍になる"]:::effect
    c6 -->|"No"| e5["⑤:残りHP割合が最も低い味方2名の<br/>デバフ・サゲ効果を2つ解除し、<br/>3ターンの間「防音」状態にする"]:::effect
    e6 --> e5
    e5 --> lc5{"⑤の効果<br/>対象2名すべて完了?"}:::cond
    lc5 -->|"Yes"| finish(("終了")):::startend
    lc5 -->|"No、次の対象へ"| c6
