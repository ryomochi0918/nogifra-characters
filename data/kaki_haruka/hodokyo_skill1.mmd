flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a0["①実行:このスキル中、<br/>自身の命中率とリフレクト耐性を<br/>+30%する"]:::effect --> c1{"③:自身のエフォートが<br/>②のアピール対象のエフォート<br/>以上か"}:::cond
    c1 -->|"Yes"| a1["②実行(強化):残りHP割合が<br/>最も低いライバルに、自身の最大<br/>アピールの20%を固定値として<br/>上乗せした900%のアピールを行う<br/>(アピール倍率と固定値倍率が2倍)"]:::action --> c2
    c1 -->|"No"| a2["②実行(通常):残りHP割合が<br/>最も低いライバルに、自身の最大<br/>アピールの20%を固定値として<br/>上乗せした900%のアピールを行う"]:::action --> c2
    c2{"④:このスキル中に自身の<br/>エフォートが②のアピール対象の<br/>エフォート以上である事が<br/>3回以上発生したか"}:::cond
    c2 -->|"Yes"| e1["④実行:自身を3ターンの間<br/>「神気」状態にする<br/>※神気:アピール力が50%上昇し、<br/>受けるアピールが60%低下する"]:::effect --> loop1
    c2 -->|"No"| loop1{"②のアピール5回<br/>すべて完了?"}:::cond
    loop1 -->|"No、次の回へ"| c1
    loop1 -->|"Yes"| a3["⑤実行:残りHP割合が最も低い<br/>ライバル1名に②で行った合計<br/>アピールの40%分のアピールを<br/>行う(ディフェンス、<br/>フィジカルを無視する)"]:::action --> c3
    c3{"⑥:このスキルで<br/>ライバルがリタイアしたか"}:::cond
    c3 -->|"Yes"| e2["⑥実行:自身を2ターンの間<br/>「倍音」状態にする<br/>※倍音:アピール力が40%上昇し、<br/>リフレクト耐性を+40%する"]:::effect --> finish(("終了")):::startend
    c3 -->|"No"| finish
