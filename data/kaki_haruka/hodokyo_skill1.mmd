flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の命中率と<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに5回、自身の最大アピールの<br/>20%を固定値として上乗せした900%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:このスキル中に自身の<br/>エフォートが②のアピール対象の<br/>エフォート以上である事が<br/>3回以上発生したか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["自身を3ターンの間「神気」<br/>状態にする"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| a5["⑤実行:残りHP割合が最も<br/>低いライバル1名に②で<br/>行った合計アピールの40%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc2 -->|"No、次の回へ"| c3
    a5 --> c6{"⑥:このスキルでライバルが<br/>リタイアしたか"}:::cond
    c6 -->|"Yes"| e6["自身を2ターンの間「倍音」<br/>状態にする"]:::effect
    c6 -->|"No"| finish(("終了")):::startend
    e6 --> finish
