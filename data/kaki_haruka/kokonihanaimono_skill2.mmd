flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身の残りHP割合が<br/>対象の残りHP割合以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になり、<br/>①によるバフ・アゲ効果の<br/>解除数が1つ増加する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルへバフ・アゲ効果を1つ解除し、<br/>460%のアピール"]:::action --> e3
    e3["③効果:自身のHPを直前の<br/>アピールの60%分回復する"]:::effect --> loop1
    loop1{"①を5回実行したか"}:::cond
    loop1 -->|"No、次の回へ"| c2
    loop1 -->|"Yes"| c4
    c4{"④:自身の残りHP割合が<br/>30%以上か"}:::cond
    c4 -->|"No"| finish(("終了")):::startend
    c4 -->|"Yes(①から再実行、最大1回)"| c5
    c5{"⑤:自身の残りHP割合が<br/>70%以上か"}:::cond
    c5 -->|"Yes"| e5["再実行で行われるアピールに<br/>④を発動する前に行った合計アピールの<br/>10%分を固定値として上乗せする"]:::effect --> c2
    c5 -->|"No"| c2
