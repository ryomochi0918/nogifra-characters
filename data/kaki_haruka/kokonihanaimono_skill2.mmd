flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になり、<br/>①によるバフ・アゲ効果の<br/>解除数が1つ増加する"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに5回、バフ・アゲ効果を1つ解除し、<br/>460%のアピールを行う"]:::action
    e2 --> a1
    a1 --> e3["③:自身のHPを①で行った直前の<br/>アピールの60%分回復する<br/>(①の各アピール後)"]:::effect
    e3 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:自身の残りHP割合が<br/>30%以上か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c5{"⑤:自身の残りHP割合が<br/>70%以上か<br/>(④の効果前)"}:::cond
    c4 -->|"No"| finish(("終了")):::startend
    c5 -->|"Yes"| e5["④による再実行で行われるアピールに<br/>④を発動する前に行った合計アピールの<br/>10%分を固定値として上乗せする"]:::effect
    c5 -->|"No"| c2
    e5 --> c2
