flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:アピール対象の<br/>残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["必ず会心アピールになる"]:::effect
    c3 -->|"No"| c4{"④:自身のエフォートが②の<br/>各アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:ライバル6名に<br/>自身のエフォートの2倍を<br/>固定値として上乗せした450%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:②のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も高い<br/>ライバル1名に自身のエフォートの<br/>4倍を固定値として上乗せした900%の<br/>アピールを行う"]:::action
    c5 -->|"No"| e6["⑥:自身のHPをこのスキルで行った<br/>合計アピールの50%分回復する"]:::effect
    a5 --> e6
    e6 --> finish(("終了")):::startend
