flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身と自身以外の最大アピールが<br/>最も高い味方1名を2ターンの間<br/>「勇気」状態にする"]:::effect
    e1 --> a2["②実行:残りHP割合が最も高い<br/>ライバル3名を50%の確率で<br/>1ターンの間「雑音」状態にし、<br/>1100%のアピールを行う"]:::action
    a2 --> c3{"③:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール後)"}:::cond
    c3 -->|"Yes"| a3["③実行:②のアピール対象に1100%の<br/>アピールを行い、100%の確率で<br/>2ターンの間「雑音」状態にする"]:::action
    c3 -->|"No"| lc2{"②のアピール<br/>ライバル3名すべて完了?"}:::cond
    a3 --> lc2
    lc2 -->|"Yes"| a4["④実行:ライバルに3回、自身の<br/>残りSPの50倍を上乗せした700%の<br/>アピールを行う(雑音状態ではない<br/>ライバルを優先する)"]:::action
    lc2 -->|"No、次の対象へ"| a2
    a4 --> e5["⑤:エフォート、サンクス、スマイルが<br/>最も高いライバルそれぞれ1名を<br/>100%の確率で3ターンの間<br/>「アピール力ダウン」状態にする<br/>(効果対象は重複する場合がある)"]:::effect
    e5 --> finish(("終了")):::startend
