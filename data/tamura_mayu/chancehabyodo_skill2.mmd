flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c5{"⑤:①の各アピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c5 -->|"Yes"| e5["①の各アピール倍率が2倍になる"]:::effect
    c5 -->|"No"| c6{"⑥:①の各アピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か<br/>(①の各アピール前)"}:::cond
    e5 --> c6
    c6 -->|"Yes"| e6["①の各アピール倍率と固定値倍率が<br/>2倍になる(⑥の効果による①の<br/>アピール倍率の最大は1100%、<br/>⑤の効果が同時に発動した場合は<br/>アピール倍率2200%まで)"]:::effect
    c6 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバル4名に自身の最大アピールの<br/>25%を固定値として上乗せした550%の<br/>アピールを行い、100%の確率で<br/>4ターンの間「嫉妬」状態にする"]:::action
    e6 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c3{"③:ライバルチームの<br/>フロント人数が3名以上か"}:::cond
    lc1 -->|"No、次の対象へ"| c5
    c3 -->|"Yes"| e3["②による「アピール力アップ」<br/>状態の効果倍率が1.5倍になる"]:::effect
    c3 -->|"No"| e2["②:自身を4ターンの間<br/>「アピール力アップ」状態にする"]:::effect
    e3 --> e2
    e2 --> c5_2{"⑤:④の各アピール対象が<br/>デバフ・サゲ効果状態か<br/>(④の各アピール前)"}:::cond
    c5_2 -->|"Yes"| e5_2["④の各アピール倍率が2倍になる"]:::effect
    c5_2 -->|"No"| c6_2{"⑥:④の各アピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か<br/>(④の各アピール前)"}:::cond
    e5_2 --> c6_2
    c6_2 -->|"Yes"| e6_2["④の各アピール倍率と固定値倍率が<br/>2倍になる(⑥の効果による④の<br/>アピール倍率の最大は1100%、<br/>⑤の効果が同時に発動した場合は<br/>アピール倍率2200%まで)"]:::effect
    c6_2 -->|"No"| a4["④実行:ライバルに3回、<br/>アピール対象のHP上限の0.4%を<br/>固定値として上乗せした550%の<br/>アピールを行い、100%の確率で<br/>4ターンの間「嫉妬」状態にする"]:::action
    e6_2 --> a4
    a4 --> lc4{"④のアピール<br/>3回すべて完了?"}:::cond
    lc4 -->|"Yes"| finish(("終了")):::startend
    lc4 -->|"No、次の回へ"| c5_2
