flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c5a
    c5a{"⑤:①のアピール対象がデバフ・サゲ<br/>効果状態か<br/>(①と④の各アピール前)"}:::cond
    c5a -->|"Yes"| e5a["①のアピール倍率が2倍になる"]:::effect --> c6a
    c5a -->|"No"| c6a{"⑥:①のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か<br/>(①と④の各アピール前)"}:::cond
    c6a -->|"Yes"| e6a["①のアピール倍率と固定値倍率が<br/>2倍になる<br/>(最大1100%、⑤も同時なら最大2200%)"]:::effect --> a1
    c6a -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバル4名へ、自身の最大アピールの<br/>25%を固定値として上乗せした<br/>550%のアピールを行い、100%の<br/>確率で4ターンの間「嫉妬」状態にする"]:::action --> lc1
    lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c5a
    lc1 -->|"Yes"| c3
    c3{"③:ライバルチームのフロント<br/>人数が3名以上か"}:::cond
    c3 -->|"Yes"| e3["②の「アピール力アップ」状態の<br/>効果倍率が1.5倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:自身を4ターンの間<br/>「アピール力アップ」状態にする"]:::action --> c5b
    c5b{"⑤:④のアピール対象がデバフ・サゲ<br/>効果状態か<br/>(①と④の各アピール前)"}:::cond
    c5b -->|"Yes"| e5b["④のアピール倍率が2倍になる"]:::effect --> c6b
    c5b -->|"No"| c6b{"⑥:④のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>3種類以上か<br/>(①と④の各アピール前)"}:::cond
    c6b -->|"Yes"| e6b["④のアピール倍率と固定値倍率が<br/>2倍になる<br/>(最大1100%、⑤も同時なら最大2200%)"]:::effect --> a4
    c6b -->|"No"| a4["④実行:ライバルへ3回、アピール対象の<br/>HP上限の0.4%を固定値として上乗せした<br/>550%のアピールを行い、100%の<br/>確率で4ターンの間「嫉妬」状態にする"]:::action --> lc4
    lc4{"④のアピール<br/>3回すべて完了?"}:::cond
    lc4 -->|"No、次の回へ"| c5b
    lc4 -->|"Yes"| finish(("終了")):::startend
