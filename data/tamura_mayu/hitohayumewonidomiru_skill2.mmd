flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率と<br/>命中率を+20%する"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ①による<br/>会心率と命中率の増加倍率が30%になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに6回、<br/>自身の最大アピールの20%を<br/>固定値として上乗せした550%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールで会心アピールが<br/>発生したか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["②のアピール回数が1回増加する<br/>(アピールの追加回数は最大で3回まで)"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>6回(+④の追加分)すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| c6{"⑥:②のアピールで会心アピールが<br/>4回以上発生したか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c6 -->|"Yes"| e6["⑤のアピール対象が1名増加する<br/>(増加人数は最大で1名まで)"]:::effect
    c6 -->|"No"| a5["⑤実行:残りHP割合が最も<br/>低いライバル1名に②で<br/>行った合計アピールの40%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    e6 --> a5
    a5 --> finish(("終了")):::startend
