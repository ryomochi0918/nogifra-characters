flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果前、自身の残りHP割合が<br/>50%未満か"}:::cond
    c2 -->|"Yes"| e2["①による「光華」状態の<br/>リフレクト耐性の増加倍率が2倍になる"]:::effect --> e1
    c2 -->|"No"| e1["①実行:自身を2ターンの間<br/>「光華」状態にする<br/>※光華:会心率が30%上昇し、<br/>リフレクト耐性が30〜60%上昇する"]:::effect --> c4
    c4{"④:③の各アピール前、自身のサンクスが<br/>③のアピール対象のサンクス以上か<br/>(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と固定値倍率が2倍になり、<br/>③の各アピール中のみ自身の<br/>会心率と会心アピールを+20%する"]:::effect --> a3
    c4 -->|"No"| a3["③実行:ライバル4名に自身のサンクスの<br/>3.5倍を固定値として上乗せした<br/>600%のアピールを行う"]:::action --> loop3
    loop3{"③のアピール4名すべて完了?"}:::cond
    loop3 -->|"No、次の対象へ"| c4
    loop3 -->|"Yes"| c5{"⑤:③のアピールが全て終了後、<br/>ライバルチームのフロント人数が3名以下<br/>または③のアピールで<br/>ライバルがリタイアしたか"}:::cond
    c5 -->|"Yes"| e5["再度③を実行する<br/>(再実行は最大1回まで)"]:::effect --> c4
    c5 -->|"No"| a6["⑥実行:③のアピールが全て終了後<br/>(⑤の再実行が発動した場合は⑤の後)、<br/>最大アピールが最も高いライバル1名に<br/>③のアピールで会心アピールが発生した回数を<br/>アピール回数として、自身のサンクスの<br/>7倍分のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action --> a7
    a7["⑦実行:⑥のアピールが全て終了後、<br/>自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::action --> finish(("終了")):::startend
