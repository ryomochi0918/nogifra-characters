flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%未満か"}:::cond
    c2 -->|"Yes"| e2["①による「光華」状態の<br/>リフレクト耐性の増加倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:自身を2ターンの間「光華」<br/>状態にする"]:::effect
    e2 --> e1
    e1 --> c4{"④:自身のサンクスが③の<br/>アピール対象のサンクス以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と固定値倍率が<br/>2倍になり、③の各アピール中のみ自身の<br/>会心率と会心アピールを+20%する"]:::effect
    c4 -->|"No"| a3["③実行:ライバル4名に自身のサンクスの<br/>3.5倍を固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc3 -->|"Yes"| c5{"⑤:ライバルチームのフロント人数が<br/>3名以下または③のアピールで<br/>ライバルがリタイアしたか"}:::cond
    lc3 -->|"No、次の対象へ"| c4
    c5 -->|"Yes(再実行は最大1回まで)"| c4
    c5 -->|"No"| a6["⑥実行:最大アピールが最も高い<br/>ライバル1名に③のアピールで<br/>会心アピールが発生した<br/>回数をアピール回数として、<br/>自身のサンクスの7倍分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    a6 --> e7["⑦:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    e7 --> finish(("終了")):::startend
