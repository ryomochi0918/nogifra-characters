flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果前、自身の残りHP割合が<br/>65%以上か"}:::cond
    c2 -->|"Yes"| e2["①による「神気」状態を<br/>「円陣」状態に変更する<br/>※円陣:アピール力が40%上昇し、<br/>すべてのデバフ・サゲ効果耐性を+40%し、<br/>受けるアピールが30%低下する"]:::effect --> e1
    c2 -->|"No"| e1["①実行:自身のHPを自身のHP上限の<br/>30%分回復し、自身を3ターンの間<br/>「神気」状態にする<br/>※神気:アピール力が40%上昇し、<br/>受けるアピールが30%低下する"]:::effect --> c3
    c3{"③:①の効果後、自身の「希望」状態の<br/>ターン数が6ターン以上か"}:::cond
    c3 -->|"Yes"| e3["自身を2ターンの間「賢明」状態にする<br/>※賢明:命中率が20%上昇し、<br/>会心率を+20%し、<br/>受けるアピールが20%低下する"]:::effect --> c5
    c3 -->|"No"| c5
    c5{"⑤:④の各アピール前、自身のスマイルが<br/>④のアピール対象のスマイル以上か<br/>(アピールごとに判定)"}:::cond
    c5 -->|"Yes"| e5["④のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a4
    c5 -->|"No"| a4["④実行:③の効果後<br/>(条件を満たさない場合でも発動)、<br/>最大アピールが最も高いライバルに4回、<br/>自身のSP上限の40倍を固定値として<br/>上乗せした300%のアピールを行う"]:::action --> loop4
    loop4{"④のアピール4回すべて完了?"}:::cond
    loop4 -->|"No、次の回へ"| c5
    loop4 -->|"Yes"| a6["⑥実行:④のアピールが全て終了後、<br/>最大アピールが最も高いライバル1名に<br/>④で行った合計アピールの30%分の<br/>アピールを行う<br/>(ディフェンス、メンタルを無視する)"]:::action --> finish(("終了")):::startend
