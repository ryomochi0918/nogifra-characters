flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が65%以上か"}:::cond
    c2 -->|"Yes"| e2["①による「神気」状態を「円陣」<br/>状態に変更する"]:::effect
    c2 -->|"No"| e1["①:自身のHPを自身のHP上限の<br/>30%分回復し、自身を3ターンの間<br/>「神気」状態にする"]:::effect
    e2 --> e1
    e1 --> c3{"③:自身の「希望」状態のターン数が<br/>6ターン以上か"}:::cond
    c3 -->|"Yes"| e3["自身を2ターンの間「賢明」<br/>状態にする"]:::effect
    c3 -->|"No"| c5{"⑤:自身のスマイルが④の<br/>アピール対象のスマイル以上か<br/>(④の各アピール前)"}:::cond
    e3 --> c5
    c5 -->|"Yes"| e5["④のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c5 -->|"No"| a4["④実行:最大アピールが最も高い<br/>ライバルに4回、自身のSP上限の<br/>40倍を固定値として上乗せした300%の<br/>アピールを行う"]:::action
    e5 --> a4
    a4 --> lc4{"④のアピール<br/>4回すべて完了?"}:::cond
    lc4 -->|"Yes"| a6["⑥実行:最大アピールが<br/>最も高いライバル1名に④で<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    lc4 -->|"No、次の回へ"| c5
    a6 --> finish(("終了")):::startend
