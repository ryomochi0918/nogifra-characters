flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%未満か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバル4名に<br/>アピール対象のHP上限3%分を<br/>固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:自身を4ターンの間<br/>「アピール力アップ」と「興奮」<br/>状態にする"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e3 --> c4{"④:味方チームのフロント人数が<br/>ライバルチームのフロント人数以上か"}:::cond
    c4 -->|"Yes"| a4["④実行:ライバルに4回、300%の<br/>アピールを行う"]:::action
    c4 -->|"No"| finish(("終了")):::startend
    a4 --> finish
