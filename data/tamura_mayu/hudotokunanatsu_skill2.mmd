flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e2["②:①の各アピール前、①のアピール倍率と<br/>固定値倍率が自身が受けている<br/>特殊状態の種類数×1倍になる<br/>(アピール倍率と固定値倍率は最大3倍まで、<br/>自身が特殊状態ではない場合は1倍となる)"]:::effect --> c3
    c3{"③:①の各アピール前、自身が受けている<br/>特殊状態の種類数が3種類以上か<br/>(アピールごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象の<br/>バフ・アゲ効果を1つ解除する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:残りHP割合が最も低いライバルに4回、<br/>自身の最大アピールの15%を固定値として<br/>上乗せした250%のアピールを行う"]:::action --> loop1
    loop1{"①のアピール4回すべて完了?"}:::cond
    loop1 -->|"No、次の回へ"| e2
    loop1 -->|"Yes"| c4{"④:①のアピールが全て終了後、<br/>自身の「希望」状態のターン数が<br/>5ターン以上か"}:::cond
    c4 -->|"Yes"| e4["①のアピール倍率と固定値倍率が2倍になり、<br/>再度①を実行する<br/>(再実行は最大1回まで)"]:::effect --> e2
    c4 -->|"No"| c5{"⑤:①のアピールが全て終了後<br/>(④の再実行が発動した場合は④の後)、<br/>①のアピールでライバルがリタイアしたか"}:::cond
    c5 -->|"Yes"| e5["自身のHPを①で行った合計アピールの<br/>20%分回復し、自身のデバフ・サゲ効果を<br/>全て解除する"]:::effect --> finish(("終了")):::startend
    c5 -->|"No"| finish
