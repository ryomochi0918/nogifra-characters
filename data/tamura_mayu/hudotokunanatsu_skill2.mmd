flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e2["②:①のアピール倍率と固定値倍率が<br/>自身が受けている特殊状態の<br/>種類数×1倍になる(アピール倍率と<br/>固定値倍率は最大3倍まで、自身が<br/>特殊状態ではない場合は1倍となる)<br/>(①の各アピール前)"]:::effect
    e2 --> c3{"③:自身が受けている特殊状態の<br/>種類数が3種類以上か<br/>(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに4回、自身の最大アピールの<br/>15%を固定値として上乗せした250%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:自身の「希望」状態のターン数が<br/>5ターン以上か"}:::cond
    lc1 -->|"No、次の回へ"| e2
    c4 -->|"Yes(再実行は最大1回まで)<br/>①のアピール倍率と固定値倍率が<br/>2倍になり再実行"| e2
    c4 -->|"No"| c5{"⑤:①のアピールでライバルが<br/>リタイアしたか"}:::cond
    c5 -->|"Yes"| e5["自身のHPを①で行った<br/>合計アピールの20%分回復し、自身の<br/>デバフ・サゲ効果を全て解除する"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
