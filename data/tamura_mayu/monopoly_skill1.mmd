flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のサンクスが①のアピール<br/>対象のサンクス以上か"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果解除数が<br/>2つ追加され、アピール倍率が<br/>2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ディフェンスが最も高い<br/>ライバル4名のバフ・アゲ効果を<br/>2つ解除し、700%のアピール"]:::action --> a3["③実行:このスキルでバフ・アゲ効果を<br/>解除した回数分、ライバルへ自身の<br/>サンクス5.5倍分のアピール<br/>(ディフェンス、フィジカルを無視、<br/>最大8回まで)"]:::action --> a4["④実行:自身のHPを自身の<br/>アピール力の100%分回復する<br/>(会心率に応じて会心回復が発生)"]:::action --> finish(("終了")):::startend
