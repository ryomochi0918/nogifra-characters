flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果解除数を<br/>2つ追加し、アピール倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ディフェンスが最も高い<br/>ライバル4名のバフ・アゲ効果を<br/>2つ解除し、700%のアピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| a3["③実行:このスキルでバフ・アゲ効果を<br/>解除した回数をアピール回数として、<br/>ライバルに自身のサンクス5.5倍分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する、<br/>アピール回数は最大で8回まで)"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a3 --> e4["④:自身のHPを自身のアピール力の<br/>100%分回復する(会心率に<br/>応じて会心回復が発生)"]:::effect
    e4 --> finish(("終了")):::startend
