flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の効果対象が<br/>デバフ・サゲ効果状態ではないか"}:::cond
    c2 -->|"Yes"| e2["①による状態効果の<br/>効果倍率が2倍に"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>自身と最大アピールが最も高い味方1名を<br/>2ターンの間「アピールブースト(努力)」<br/>「アピールブースト(感謝)」状態に"]:::action
    a1 --> c4{"④:自身のスマイルが③の<br/>アピール対象のスマイル以上か"}:::cond
    c4 -->|"Yes"| e4["③のアピールに自身のSP上限の<br/>200倍を固定値として上乗せ"]:::effect --> a3
    c4 -->|"No"| a3["③実行:<br/>ライバルのバフ・アゲ効果を1つ解除し<br/>950%のアピール"]:::action
    a3 --> lc{"③のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c4
    lc -->|"Yes"| finish(("終了")):::startend
