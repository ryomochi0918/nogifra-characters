flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル2名に自身の<br/>スマイルの6倍を固定値として<br/>上乗せした1600%のアピールを行う"]:::action
    a1 --> e2["②:最大アピールが最も高い<br/>味方1名の残りHP割合または<br/>ライバルチームのフロント人数に<br/>応じて③か④の効果を適用する"]:::effect
    e2 --> c3{"③/④:残りHP割合が50%以上または<br/>ライバルチームのフロント人数が<br/>3人未満か"}:::cond
    c3 -->|"Yes"| e3["③:最大アピールが最も高い<br/>味方2名を3ターンの間「全開」<br/>状態にする(アピール力の<br/>増加倍率は100%となる)"]:::effect
    c3 -->|"No"| e4["④:最大アピールが最も高い<br/>味方1名を3ターンの間「全開」<br/>状態にする(アピール力の<br/>増加倍率は150%となる)"]:::effect
    e3 --> e5["⑤:自身と最大アピールが最も高い<br/>味方1名を2ターンの間「勇気」<br/>状態にし、HPを自身のアピール力の<br/>120%分回復する(会心率に応じて<br/>会心回復が発生する)"]:::effect
    e4 --> e5
    e5 --> finish(("終了")):::startend
