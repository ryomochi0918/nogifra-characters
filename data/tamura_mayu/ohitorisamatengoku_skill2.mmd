flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のスマイルが①のアピール<br/>対象のスマイル以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピールは必ず<br/>会心アピールになる"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    c3 -->|"Yes"| e3["①のアピールに自身のスマイルの<br/>2倍を固定値として上乗せする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバルへ、自身の残りSPの<br/>80倍を上乗せした550%のアピール"]:::action --> c4
    c4{"④:①のアピールが<br/>会心アピールだったか"}:::cond
    c4 -->|"Yes"| e4["①の対象のバフ・アゲ効果を<br/>2つ解除する"]:::effect --> lc1
    c4 -->|"No"| lc1{"①のアピール6回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| a5["⑤実行:自身と自身以外の残りHP割合が<br/>最も低い味方3名のHPを①で行った<br/>合計アピールの50%分回復する"]:::action --> finish(("終了")):::startend
