flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールは必ず会心アピールになる"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピールに自身のスマイルの<br/>2倍を固定値として上乗せする"]:::effect
    c3 -->|"No"| a1["①実行:ライバルに6回、自身の<br/>残りSPの80倍を上乗せした550%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> c4{"④:①のアピールが会心アピールか<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["①のアピール対象のバフ・アゲ効果を<br/>2つ解除する"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| e5["⑤:自身と自身以外の残りHP割合が<br/>最も低い味方3名のHPを①で行った<br/>合計アピールの50%分回復する"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e5 --> finish(("終了")):::startend
