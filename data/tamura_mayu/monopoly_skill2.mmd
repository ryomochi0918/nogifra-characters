flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身の残りHP割合が①の対象の<br/>残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の固定値倍率とアピール倍率が<br/>2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のバイタリティが①のアピール<br/>対象のバイタリティ以上か<br/>(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["バフ・アゲ効果を1つ解除する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバル6名へ、自身の<br/>サンクスの2倍を固定値として<br/>上乗せした600%のアピール"]:::action --> lc1
    lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| a5["⑤実行:自身を3ターンの間<br/>「回避率アップ」状態にする"]:::action --> finish(("終了")):::startend
