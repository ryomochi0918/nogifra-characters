flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の「声援」状態のターン数が<br/>4ターン以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ自身の<br/>会心率を+40%する"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに6回、<br/>自身のエフォートの3.5倍を<br/>固定値として上乗せした480%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:①のアピールで会心アピールが<br/>発生したか<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["①のアピール回数を1回増加する<br/>(アピールの追加回数は最大3回まで)"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>6回(+③の追加分)すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| e4["④:自身のデバフ・サゲ効果を<br/>3つ解除し、HPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e4 --> finish(("終了")):::startend
