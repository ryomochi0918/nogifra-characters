flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>命中率を+20%する"]:::effect --> c3
    c3{"③:自身のスマイルが②のアピール<br/>対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| c4{"④:自身の残りHP割合が<br/>50%以上か<br/>(③の各効果前)"}:::cond
    c3 -->|"No"| a2
    c4 -->|"Yes"| e4["③の「回避率ダウン」状態にする確率が+20%、<br/>③の「回避率ダウン」の効果倍率が<br/>1.5倍になる"]:::effect --> c5
    c4 -->|"No"| c5{"⑤:このスキルが発動する前に自身が<br/>バフ・アゲ効果状態だったか<br/>(③の各効果前)"}:::cond
    c5 -->|"Yes"| e5["③の「回避率ダウン」状態にする確率が+20%、<br/>このスキル中、自身のデバフ耐性<br/>貫通が+20%になる"]:::effect --> e3
    c5 -->|"No"| e3["②のアピール対象を60%の確率で2ターンの間<br/>「回避率ダウン」状態にし、<br/>バフ・アゲ効果を1つ解除する"]:::effect --> a2
    a2["②実行:最大アピールが最も高い<br/>ライバル5名へ、自身の残りSPの<br/>90倍を上乗せした<br/>800%のアピール"]:::action --> lc2
    lc2{"②のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2 -->|"Yes"| a6["⑥実行:残りHP割合が最も低い<br/>味方2名のHPを②で行った合計<br/>アピールの30%分回復する"]:::action --> finish(("終了")):::startend
