flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e1 --> c3{"③:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| c4{"④:自身の残りHP割合が50%以上か<br/>(③の各効果前)"}:::cond
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル5名に自身の残りSPの90倍を<br/>上乗せした800%のアピールを行う"]:::action
    c4 -->|"Yes"| e4["③の「回避率ダウン」状態にする<br/>確率を+20%し、③の「回避率ダウン」<br/>の効果倍率を1.5倍にする"]:::effect
    c4 -->|"No"| c5{"⑤:このスキルが発動する前に自身が<br/>バフ・アゲ効果状態か<br/>(③の各効果前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["③の「回避率ダウン」状態にする<br/>確率を+20%し、このスキル中、<br/>自身のデバフ耐性貫通を+20%する"]:::effect
    c5 -->|"No"| e3["②のアピール対象を60%の確率で<br/>2ターンの間「回避率ダウン」<br/>状態にし、バフ・アゲ効果を<br/>1つ解除する"]:::effect
    e5 --> e3
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc2 -->|"Yes"| e6["⑥:残りHP割合が最も低い味方2名の<br/>HPを②のアピールで行った<br/>合計アピールの30%分回復する"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e6 --> finish(("終了")):::startend
