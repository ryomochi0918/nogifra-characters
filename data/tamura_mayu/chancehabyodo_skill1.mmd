flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1
    c1{"①:自身の残りHP割合が<br/>50%以上か"}:::cond
    c1 -->|"Yes"| e1["このスキル中、自身の命中率を<br/>+20%し、自身を2ターンの間<br/>「牽制」状態にする"]:::effect --> c3
    c1 -->|"No"| c3{"③:自身のエフォートが②のアピール<br/>対象のエフォート以上か"}:::cond
    c3 -->|"Yes"| e3["②の対象のバフ・アゲ効果を1つ解除し、<br/>②のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルへ、自身の最大アピールの<br/>10%を固定値として上乗せした<br/>400%のアピール"]:::action --> c5
    c5{"⑤:②のアピール対象がバフ・アゲ<br/>効果状態ではないか"}:::cond
    c5 -->|"Yes"| e5["対象を100%の確率で4ターンの間<br/>「心労」状態にする"]:::effect --> lc1
    c5 -->|"No"| lc1{"②のアピール6回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c3
    lc1 -->|"Yes"| a4["④実行:最大アピールが最も高い<br/>ライバル1名へこのスキルで行った合計<br/>アピールの60%分のアピール<br/>(ディフェンス、フィジカルを無視)"]:::action --> c5b
    c5b{"⑤:④のアピール対象がバフ・アゲ<br/>効果状態ではないか"}:::cond
    c5b -->|"Yes"| e5b["④の対象を100%の確率で<br/>4ターンの間「心労」状態にする"]:::effect --> finish(("終了")):::startend
    c5b -->|"No"| finish
