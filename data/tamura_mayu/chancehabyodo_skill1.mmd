flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身の残りHP割合が50%以上か"}:::cond
    c1 -->|"Yes"| e1["このスキル中、自身の<br/>命中率を+20%し、自身を2ターンの<br/>間「牽制」状態にする"]:::effect
    c1 -->|"No"| c3{"③:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    e1 --> c3
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除し、②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルに6回、自身の最大アピールの<br/>10%を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c5{"⑤:②の各アピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(②の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["アピール対象を100%の確率で<br/>4ターンの間「心労」状態にする"]:::effect
    c5 -->|"No"| lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    e5 --> lc2
    lc2 -->|"Yes"| a4["④実行:最大アピールが最も<br/>高いライバル1名にこのスキルで<br/>行った合計アピールの60%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc2 -->|"No、次の回へ"| c3
    a4 --> c5_2{"⑤:④の各アピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(④の各アピール後)"}:::cond
    c5_2 -->|"Yes"| e5_2["アピール対象を100%の確率で<br/>4ターンの間「心労」状態にする"]:::effect
    c5_2 -->|"No"| finish(("終了")):::startend
    e5_2 --> finish
