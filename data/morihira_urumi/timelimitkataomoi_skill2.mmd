flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①の対象の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール中のみ<br/>必ず会心アピールになる"]:::effect --> c3
    c2 -->|"No"| c3{"③:ライバルチームのフロント人数が<br/>4名以上、または自身が<br/>「回避率アップ」状態か"}:::cond

    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身が「舞踏」状態か"}:::cond

    c4 -->|"Yes"| e4["①のアピール倍率と固定値倍率が2倍になる<br/>(④による上限:アピール倍率800%、固定値倍率2倍まで。<br/>③と同時発生時はアピール倍率1600%、固定値倍率4倍まで)"]:::effect --> a1
    c4 -->|"No"| a1["①実行:<br/>最大アピールが最も高いライバルへ<br/>基本400%+固定値 エフォートのアピール"]:::action

    a1 --> lc{"①のアピール<br/>3回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c5{"⑤:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c5 -->|"Yes(再実行は最大1回まで)"| c2
    c5 -->|"No"| finish(("終了")):::startend
