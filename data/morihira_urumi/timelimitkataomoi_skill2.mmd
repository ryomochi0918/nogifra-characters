flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の<br/>各アピール中のみ必ず会心アピールになる"]:::effect
    c2 -->|"No"| c3{"③:ライバルチームのフロント人数が<br/>4名以上、または自身が<br/>「回避率アップ」状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:自身が「舞踏」状態か<br/>(①の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["①のアピール倍率と固定値倍率が<br/>2倍になる(④の効果による①の<br/>アピール倍率の最大は800%、<br/>固定値倍率は2倍まで、<br/>③の効果が同時に発生した<br/>場合はアピール倍率1600%、<br/>固定値倍率4倍まで)"]:::effect
    c4 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに3回、自身のエフォートを<br/>固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e4 --> a1
    a1 --> lc1{"①のアピール<br/>3回すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c5 -->|"Yes(再実行は最大1回まで)"| c2
    c5 -->|"No"| finish(("終了")):::startend
