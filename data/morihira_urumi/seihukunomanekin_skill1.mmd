flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①の対象が受けているデバフ・サゲ効果の<br/>種類数が1種類以下または特殊状態か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①による「空腹」状態の効果倍率を1.5倍にし、<br/>①の対象を100%の確率で<br/>2ターンの間「嫉妬」状態にする"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のスマイルが①の対象の<br/>スマイル以上か(対象ごとに判定)"}:::cond

    c3 -->|"Yes"| e3["自身の最大アピールの40%を<br/>固定値として上乗せする"]:::effect --> c4
    c3 -->|"No"| c4{"④:①の対象の残りHP割合が<br/>50%以上か(対象ごとに判定)"}:::cond

    c4 -->|"Yes"| e4["③の固定値倍率が2倍になる"]:::effect --> a1
    c4 -->|"No"| a1["①実行:<br/>残りHP割合が最も高いライバル4名へ<br/>100%の確率で2ターンの間<br/>「空腹」状態にし、600%のアピール"]:::action

    a1 --> e5["⑤:ライバルへ、ライバルチームの<br/>デバフ・サゲ効果状態の合計数を回数として、<br/>バフ・アゲ効果を1つ解除する<br/>(解除は最大で10回まで)"]:::effect
    e5 --> finish(("終了")):::startend
