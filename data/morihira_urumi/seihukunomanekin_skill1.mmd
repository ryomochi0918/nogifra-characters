flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が受けている<br/>デバフ・サゲ効果の種類数が<br/>1種類以下または特殊状態か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①による「空腹」状態の効果倍率を<br/>1.5倍にし、①のアピール対象を<br/>100%の確率で2ターンの間「嫉妬」<br/>状態にする"]:::effect
    c2 -->|"No"| c3{"③:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| c4{"④:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル4名を100%の確率で<br/>2ターンの間「空腹」状態にし、<br/>600%のアピールを行う"]:::action
    c4 -->|"Yes"| e4["③の固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| e3["自身の最大アピールの40%を<br/>固定値として上乗せする"]:::effect
    e4 --> e3
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| e5["⑤:ライバルにライバルチームの<br/>デバフ・サゲ効果状態の合計数を<br/>回数として、バフ・アゲ効果を<br/>1つ解除する(バフ・アゲ効果の<br/>解除は最大で10回まで)"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e5 --> finish(("終了")):::startend
