flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+60%、<br/>会心アピールを+30%、命中率を+10%する"]:::effect
    e1 --> c3{"③:味方チームのフロント人数が<br/>1名か"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象を3名増加する"]:::effect
    c3 -->|"No"| c4{"④:自身の残りHP割合が50%未満か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル1名のバフ・アゲ効果を2つ解除し、<br/>自身の最大アピールの70%を固定値として<br/>上乗せした1000%のアピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>対象すべて完了?"}:::cond
    lc2 -->|"Yes"| a5["⑤実行:最大アピールが最も高い<br/>ライバルに4回、②で行った合計アピールの<br/>40%分のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action
    lc2 -->|"No、次の対象へ"| c4
    a5 --> finish(("終了")):::startend
