flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を2ターンの間「倍音」<br/>状態にする"]:::effect
    e1 --> c3{"③:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに4回、自身のエフォートの<br/>2倍を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"Yes"| a4["④実行:ライバルに2回、<br/>②で行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc2 -->|"No、次の回へ"| c3
    a4 --> c6{"⑥:このスキルでライバルが<br/>リタイアしたか"}:::cond
    c6 -->|"Yes"| e6["⑤による「回避率アップ」状態を<br/>「舞踏」状態に変更する"]:::effect
    c6 -->|"No"| e5["⑤:自身を2ターンの間<br/>「回避率アップ」状態にする"]:::effect
    e6 --> e5
    e5 --> finish(("終了")):::startend
