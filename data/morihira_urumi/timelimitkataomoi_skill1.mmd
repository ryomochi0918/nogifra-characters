flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を2ターンの間<br/>「倍音」状態にする"]:::effect
    e1 --> c3{"③:自身のエフォートが<br/>②の対象のエフォート以上か"}:::cond

    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>残りHP割合が最も低いライバルへ<br/>基本400%+固定値 エフォート×2のアピール"]:::action

    a2 --> lc{"②のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| a4["④実行:ライバルへ2回、<br/>②で行った合計アピールの30%分のアピール<br/>(ディフェンス、フィジカルを無視する)"]:::action

    a4 --> c6{"⑥:このスキルでライバルが<br/>リタイアしたか"}:::cond
    c6 -->|"Yes"| e6["⑤(⑥適用):自身を2ターンの間<br/>「舞踏」状態にする"]:::effect --> finish(("終了")):::startend
    c6 -->|"No"| e5["⑤:自身を2ターンの間<br/>「回避率アップ」状態にする"]:::effect --> finish
