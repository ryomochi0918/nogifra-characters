flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身の命中率を+20%する"]:::effect
    e1 --> c3{"③:②の対象が<br/>デバフ・サゲ効果状態か"}:::cond

    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>残りHP割合が最も低いライバルへ<br/>基本440%+固定値 対象HP上限×0.9%のアピール"]:::action

    a2 --> c4{"④:②の対象が「空腹」状態<br/>または「嫉妬」状態か"}:::cond
    c4 -->|"Yes"| e4["②の対象を100%の確率で<br/>3ターンの間「衰弱」状態にする"]:::effect --> lc
    c4 -->|"No"| lc{"②のアピール<br/>5回すべて完了?"}:::cond

    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| e5["⑤:残りHP割合が最も低い味方3名のHPを<br/>②で行った合計アピールの30%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
