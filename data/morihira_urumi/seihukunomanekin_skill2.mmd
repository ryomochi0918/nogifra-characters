flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e1 --> c3{"③:②のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低いライバルに<br/>5回、アピール対象のHP上限の0.9%を<br/>固定値として上乗せした440%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピール対象が「空腹」<br/>状態または「嫉妬」状態か<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["②のアピール対象を100%の確率で<br/>3ターンの間「衰弱」状態にする"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| e5["⑤:残りHP割合が最も低い味方3名の<br/>HPを②で行った合計アピールの<br/>30%分回復する"]:::effect
    lc2 -->|"No、次の回へ"| c3
    e5 --> finish(("終了")):::startend
