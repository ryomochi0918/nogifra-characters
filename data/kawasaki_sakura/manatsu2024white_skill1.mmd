flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率と<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> a2["②実行:ライバルに5回、<br/>自身のサンクスの4倍を<br/>固定値として上乗せした420%の<br/>アピールを行う"]:::action
    a2 --> c4{"④:②のアピールで会心アピールが<br/>2回以上発生したか"}:::cond
    c4 -->|"Yes"| e4["③の効果対象が2名増加する"]:::effect
    c4 -->|"No"| c5{"⑤:③の効果対象が「舞踏」状態か<br/>(③の各効果前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["③の効果対象のHPを②で行った<br/>合計アピールの50%分回復する"]:::effect
    c5 -->|"No"| e3["③:味方2名を3ターンの間「舞踏」<br/>状態にする(「舞踏」状態ではない<br/>味方を優先的に選択する)"]:::effect
    e5 --> e3
    e3 --> lc3{"③の効果<br/>対象すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の対象へ"| c5
