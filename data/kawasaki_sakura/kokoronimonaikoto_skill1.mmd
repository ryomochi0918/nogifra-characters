flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の各アピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の各アピール対象を100%の確率で<br/>2ターンの間「ディフェンスダウン」<br/>状態にする"]:::effect
    c2 -->|"No"| c3{"③:自身の残りHP割合が①の<br/>各アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに6回、自身のエフォートの<br/>2倍を固定値として上乗せした360%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> e4["④:自身のHPを①で行った直前の<br/>アピールの50%分回復する<br/>(①の各アピール後)"]:::effect
    e4 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c5 -->|"Yes(再実行は最大1回まで)"| c2
    c5 -->|"No"| finish(("終了")):::startend
