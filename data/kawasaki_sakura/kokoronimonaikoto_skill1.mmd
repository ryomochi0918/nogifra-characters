flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール対象の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象を100%の確率で<br/>2ターンの間「ディフェンスダウン」<br/>状態にする"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身の残りHP割合が①のアピール<br/>対象の残りHP割合以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect --> a1
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルへ、自身のエフォートの<br/>2倍を固定値として上乗せした<br/>360%のアピール"]:::action --> e4["自身のHPを①の直前のアピールの<br/>50%分回復する"]:::effect --> lc1
    lc1{"①のアピール6回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c5{"⑤:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c5 -->|"Yes"| a5["再度①を実行(再実行は最大1回まで)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
