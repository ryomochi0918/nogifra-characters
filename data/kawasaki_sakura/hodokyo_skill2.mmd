flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のスマイルが①のアピール<br/>対象のスマイル以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象の残りHP割合が<br/>50%以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象を100%の確率で<br/>2ターンの間「回避率ダウン」<br/>状態にする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバル2名へ<br/>2000%のアピール"]:::action --> c4
    c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c4 -->|"Yes"| a4["再度①を実行(再実行は最大1回まで)"]:::action --> a5
    c4 -->|"No"| a5["⑤実行:最大アピールが最も高い<br/>ライバル2名へ①で行った合計アピールの<br/>40%分のアピール<br/>(ディフェンス、メンタルを無視)"]:::action --> finish(("終了")):::startend
