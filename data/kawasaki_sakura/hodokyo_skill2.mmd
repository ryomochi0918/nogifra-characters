flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール対象を100%の確率で<br/>2ターンの間「回避率ダウン」<br/>状態にする"]:::effect
    c3 -->|"No"| a1["①実行:ライバル2名に2000%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| a5["⑤実行:最大アピールが<br/>最も高いライバル2名に①で<br/>行った合計アピールの40%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    a5 --> finish(("終了")):::startend
