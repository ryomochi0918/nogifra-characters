flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率と<br/>リフレクト耐性を+25%する"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect
    c3 -->|"No"| a2["②実行:ライバル5名に自身のサンクスの<br/>4倍を固定値として上乗せした350%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールで会心アピールが<br/>発生したか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| a4["④実行:②のアピール対象にこの<br/>スキルで行った合計アピールの<br/>10%分のアピールを行う<br/>(ディフェンス・フィジカルを無視する)"]:::action
    c4 -->|"No"| lc2{"②のアピール<br/>ライバル5名すべて完了?"}:::cond
    a4 --> lc2
    lc2 -->|"Yes"| c5{"⑤:このスキルでライバルが<br/>リタイアしなかったか"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバル1名にこのスキルで行った<br/>合計アピールの60%分のアピールを行う<br/>(ディフェンス・フィジカルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
