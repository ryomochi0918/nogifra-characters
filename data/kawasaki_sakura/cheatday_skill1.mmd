flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の会心率と<br/>リフレクト耐性を+25%する"]:::effect --> c3
    c3{"③:自身のサンクスが②のアピール<br/>対象のサンクス以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバル5名へ、自身のサンクスの<br/>4倍を固定値として上乗せした<br/>350%のアピール"]:::action --> c4
    c4{"④:②のアピールで会心アピールが<br/>発生したか(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| a4["該当対象へこのスキルで行った合計<br/>アピールの10%分のアピール<br/>(ディフェンス・フィジカルを無視)"]:::action --> c5
    c4 -->|"No"| c5{"⑤:このスキルでライバルが<br/>リタイアしなかったか"}:::cond
    c5 -->|"Yes"| a5["残りHP割合が最も低いライバル1名へ<br/>このスキルで行った合計アピールの<br/>60%分のアピール<br/>(ディフェンス・フィジカルを無視)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
