flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身と自身以外の最大アピールが<br/>最も高い味方1名を3ターンの間<br/>「堅忍」状態にする"]:::effect
    e1 --> c3{"③:自身の残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルに4回、バフ・アゲ効果を<br/>1つ解除し、自身の残りHPの22%を<br/>固定値として上乗せした670%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> e4["④:自身のHPを直前のアピールの<br/>30%分回復する<br/>(②の各アピール後)"]:::effect
    e4 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"Yes"| c6{"⑥:②のアピールでライバルが<br/>リタイアしたか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c6 -->|"Yes"| e6["⑤のデバフ・サゲ効果解除数を<br/>全てに変更する"]:::effect
    c6 -->|"No"| e5["⑤:自身のデバフ・サゲ効果を<br/>1つ解除し、2ターンの間「魅了」<br/>状態にする"]:::effect
    e6 --> e5
    e5 --> finish(("終了")):::startend
