flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②/③:自身の最大アピールが①の<br/>アピール対象の最大アピール以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["②:①のアピールに自身の最大アピールの<br/>40%を固定値として上乗せする"]:::effect
    c2 -->|"No"| e3["③:①のアピールに自身の残りHPの<br/>20%を固定値として上乗せする"]:::effect
    e2 --> a1["①実行:最大アピールが最も高い<br/>ライバルに4回、610%のアピールを行う"]:::action
    e3 --> a1
    a1 --> e4["④:自身のHPを①で行った直前の<br/>アピールの30%分回復する<br/>(①の各アピール後)"]:::effect
    e4 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| e5["⑤:自身を4ターンの間「翻弄」<br/>状態にする"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e5 --> finish(("終了")):::startend
