flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の各アピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身の残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①の各アピール対象の<br/>バフ・アゲ効果を2つ解除する"]:::effect
    c3 -->|"No"| a1["①実行:ディフェンスが最も低い<br/>ライバルに4回、自身の「遮音」状態の<br/>ターン数×自身の最大アピールの2.5%を<br/>固定値として上乗せした500〜1000%の<br/>アピールを行う(自身の残りHP割合が<br/>高いほど倍率が高くなる)"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしたか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| e5["⑤:自身のHPを①で行った<br/>合計アピールの20%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
