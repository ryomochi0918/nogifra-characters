flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身の残りHP割合が<br/>50%以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象のバフ・アゲ効果を<br/>2つ解除する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ディフェンスが最も低い<br/>ライバルへ、自身の「遮音」状態の<br/>ターン数×自身の最大アピールの2.5%を<br/>固定値として上乗せした500〜1000%の<br/>アピール(自身の残りHP割合が高いほど<br/>倍率上昇)"]:::action --> lc1
    lc1{"①のアピール4回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしたか"}:::cond
    c4 -->|"Yes"| a4["再度①を実行(再実行は最大1回まで)"]:::action --> a5
    c4 -->|"No"| a5["⑤実行:自身のHPを①で行った合計<br/>アピールの20%分回復する<br/>(条件を満たさない場合でも発動)"]:::action --> finish(("終了")):::startend
