flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに6回、<br/>自身のスマイルの3倍を<br/>固定値として上乗せした360%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:①のアピールでライバルが<br/>リタイアしたか<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["残りHP割合が最も低い味方1名の<br/>デバフ・サゲ効果を2つ解除し、HPを<br/>自身のアピール力の150%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| e4["④:最大アピールが最も高い味方1名の<br/>デバフ・サゲ効果を全て解除し、<br/>3ターンの間「集中」状態にし、<br/>HPを①で行った合計アピールの<br/>30%分回復する"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e4 --> finish(("終了")):::startend
