flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のスマイルが①のアピール<br/>対象のスマイル以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバルへ、自身のスマイルの<br/>3倍を固定値として上乗せした<br/>360%のアピール"]:::action --> c3
    c3{"③:①のアピールで<br/>ライバルがリタイアしたか"}:::cond
    c3 -->|"Yes"| e3["残りHP割合が最も低い味方1名の<br/>デバフ・サゲ効果を2つ解除し、HPを<br/>自身のアピール力の150%分回復<br/>(会心率に応じて会心回復が発生)"]:::effect --> lc1
    c3 -->|"No"| lc1{"①のアピール6回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| a4["④実行:最大アピールが最も高い味方1名の<br/>デバフ・サゲ効果を全て解除し、3ターンの間<br/>「集中」状態にし、HPを①で行った合計<br/>アピールの30%分回復する"]:::action --> finish(("終了")):::startend
