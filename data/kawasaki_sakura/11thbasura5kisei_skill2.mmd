flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率に自身が受けている<br/>バフ・アゲ効果状態の種類数×300%の<br/>倍率を上乗せする"]:::effect
    c2 -->|"No"| c3{"③:自身が受けている<br/>バフ・アゲ効果状態の種類数が<br/>2種類以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピールに自身の最大アピールの<br/>40%を固定値として上乗せする"]:::effect
    c3 -->|"No"| c4{"④:自身が受けている<br/>バフ・アゲ効果状態の種類数が<br/>3種類以上か<br/>(①の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["①の各アピール中のみ自身の<br/>命中率を+20%する"]:::effect
    c4 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに4回、500%のアピールを行う"]:::action
    e4 --> a1
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
