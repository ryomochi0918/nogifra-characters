flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ<br/>効果状態か"}:::cond
    c2 -->|"Yes"| e2["①の倍率に自身が受けている<br/>バフ・アゲ効果の種類数×300%を上乗せ"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身が受けているバフ・アゲ<br/>効果の種類数が2種類以上か"}:::cond
    c3 -->|"Yes"| e3["①に自身の最大アピールの<br/>40%を固定値として上乗せ"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身が受けているバフ・アゲ<br/>効果の種類数が3種類以上か"}:::cond
    c4 -->|"Yes"| e4["①の間のみ<br/>自身の命中率を+20%"]:::effect --> a1
    c4 -->|"No"| a1["①実行:<br/>残りHP割合が最も高いライバルへ<br/>500%のアピール"]:::action
    a1 --> lc{"①のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| finish(("終了")):::startend
