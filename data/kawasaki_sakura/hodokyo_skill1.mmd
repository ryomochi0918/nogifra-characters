flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ自身の<br/>サゲ効果耐性貫通を+30%し、①の<br/>アピール倍率と固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が受けている<br/>バフ・アゲ効果の種類数が2種類以下か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール対象が1名増加する<br/>(増加人数は最大で2名まで)"]:::effect
    c3 -->|"No"| a1["①実行:最大アピールが最も<br/>高いライバル3名を100%の確率で<br/>3ターンの間「空腹」状態にし、<br/>自身の最大アピールの25%を<br/>固定値として上乗せした720%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>対象すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の対象へ"| c2
