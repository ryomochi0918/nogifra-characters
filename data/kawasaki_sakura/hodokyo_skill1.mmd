flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のスマイルが①のアピール<br/>対象のスマイル以上か"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ自身の<br/>サゲ効果耐性貫通を+30%し、①の<br/>アピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象が受けている<br/>バフ・アゲ効果の種類数が<br/>2種類以下か"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象が1名増加する<br/>(増加人数は最大2名まで)"]:::effect --> a1
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバル3名(③成立時は最大5名)を<br/>100%の確率で3ターンの間「空腹」<br/>状態にし、自身の最大アピールの<br/>25%を固定値として上乗せした<br/>720%のアピール"]:::action --> finish(("終了")):::startend
