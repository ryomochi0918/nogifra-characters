flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3{"③/④:自身の残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["③:①の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| e4["④:①の各アピール中のみ自身の<br/>リフレクト耐性を+30%する"]:::effect
    e3 --> a1["①実行:ライバル4名に自身のサンクスの<br/>2倍を固定値として上乗せした700%の<br/>アピールを行う"]:::action
    e4 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c3_2{"③/④:自身の残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    lc1 -->|"No、次の対象へ"| c3
    c3_2 -->|"Yes"| e3_2["③:②の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3_2 -->|"No"| e4_2["④:②の各アピール中のみ自身の<br/>リフレクト耐性を+30%する"]:::effect
    e3_2 --> a2["②実行:残りHP割合が最も低い<br/>ライバルに2回、自身のサンクスの<br/>2倍を固定値として上乗せした700%の<br/>アピールを行う"]:::action
    e4_2 --> a2
    a2 --> lc2{"②のアピール<br/>2回すべて完了?"}:::cond
    lc2 -->|"Yes"| e5["⑤:自身を3ターンの間「追走」<br/>状態にし、自身のHPをこのスキルで<br/>行った合計アピールの40%分回復する"]:::effect
    lc2 -->|"No、次の回へ"| c3_2
    e5 --> finish(("終了")):::startend
