flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c34
    c34{"③/④:自身の残りHP割合は<br/>50%以上か(①と②の各アピール前)"}:::cond
    c34 -->|"Yes(③)"| e3["①と②の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c34 -->|"No(④)"| e4["①と②の各アピール中のみ自身の<br/>リフレクト耐性を+30%する"]:::effect --> a1
    a1["①実行:ライバル4名へ、自身の<br/>サンクスの2倍を固定値として<br/>上乗せした700%のアピール"]:::action --> lc1
    lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c34
    lc1 -->|"Yes"| c34b
    c34b{"③/④:自身の残りHP割合は<br/>50%以上か(①と②の各アピール前)"}:::cond
    c34b -->|"Yes(③)"| e3b["①と②の各アピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c34b -->|"No(④)"| e4b["①と②の各アピール中のみ自身の<br/>リフレクト耐性を+30%する"]:::effect --> a2
    a2["②実行:残りHP割合が最も低い<br/>ライバルへ2回、自身のサンクスの<br/>2倍を固定値として上乗せした<br/>700%のアピール"]:::action --> lc2
    lc2{"②のアピール<br/>2回すべて完了?"}:::cond
    lc2 -->|"No、次の回へ"| c34b
    lc2 -->|"Yes"| a5["⑤実行:自身を3ターンの間<br/>「追走」状態にし、自身のHPをこの<br/>スキルで行った合計アピールの<br/>40%分回復する"]:::action --> finish(("終了")):::startend
