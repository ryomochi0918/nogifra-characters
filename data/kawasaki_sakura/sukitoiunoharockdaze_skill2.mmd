flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>会心率を+30%する"]:::effect --> c3
    c3{"③:自身のサンクスが②のアピール<br/>対象のサンクス以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルへ、自身の最大アピールの<br/>40%を固定値として上乗せした<br/>640%のアピール"]:::action --> e4["自身のHPを②の直前のアピールの<br/>30%分回復する"]:::effect --> lc1
    lc1{"②のアピール4回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c3
    lc1 -->|"Yes"| c5{"⑤:②のアピールによって<br/>ライバルがリタイアしたか"}:::cond
    c5 -->|"Yes"| a5["再度②からスキルを実行する<br/>(再実行は最大1回まで)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
