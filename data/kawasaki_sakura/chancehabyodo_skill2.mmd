flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の各アピールが<br/>必ず会心アピールになる"]:::effect
    c2 -->|"No"| c3{"③:自身の残りHP割合が50%未満か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①の各アピール中のみ自身の<br/>リフレクト耐性を+20%する"]:::effect
    c3 -->|"No"| a1["①実行:ライバル6名に自身のスマイルの<br/>4倍を固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> c4{"④:①のアピールが会心アピールか<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["①のアピール対象のバフ・アゲ効果を<br/>2つ解除する"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバルに①で行った合計アピールの<br/>20%分のアピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a5 --> e6["⑥:自身のデバフ・サゲ効果を<br/>全て解除し、自身と自身以外の<br/>残りHP割合が最も低い味方1名の<br/>HPを①で行った合計アピールの<br/>40%分回復する"]:::effect
    e6 --> finish(("終了")):::startend
