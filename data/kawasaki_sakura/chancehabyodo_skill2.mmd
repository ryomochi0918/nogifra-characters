flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール対象がデバフ・サゲ<br/>効果状態か(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の各アピールが<br/>必ず会心アピールになる"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身の残りHP割合が<br/>50%未満か(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①の各アピール中のみ自身の<br/>リフレクト耐性を+20%する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバル6名へ、自身の<br/>スマイルの4倍を固定値として<br/>上乗せした500%のアピール"]:::action --> c4
    c4{"④:①のアピールが会心アピールだったか<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["①のアピール対象のバフ・アゲ効果を<br/>2つ解除する"]:::effect --> lc1
    c4 -->|"No"| lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバルへ①の合計アピールの20%分の<br/>アピール(ディフェンス、メンタルを無視)"]:::action --> a6["⑥実行:自身のデバフ・サゲ効果を全て<br/>解除し、自身と自身以外の残りHP割合が<br/>最も低い味方1名のHPを①の合計<br/>アピールの40%分回復する"]:::action --> finish(("終了")):::startend
