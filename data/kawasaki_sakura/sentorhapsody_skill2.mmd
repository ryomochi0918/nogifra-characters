flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:残りHP割合が最も高い<br/>ライバル4名へ、ライブ中に発動した自身の<br/>スキル2「アクセル全開。」の回数×自身の<br/>HP上限の40%を固定値として上乗せした<br/>830%のアピール(固定値上限は自身の<br/>最大アピールの400%)"]:::action --> c2
    c2{"②:①のアピールで失敗<br/>または0が発生したか"}:::cond
    c2 -->|"Yes"| e2["このスキルによる残りのアピールは<br/>必ず命中する"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c3 -->|"Yes"| a3["残りHP割合が最も低いライバル1名へ<br/>このスキルで行った合計アピールの<br/>30%分のアピール<br/>(ディフェンス、フィジカルを無視)"]:::action --> a4
    c3 -->|"No"| a4["④実行:自身のデバフ・サゲ効果を<br/>2つ解除し、このスキルで行った合計<br/>アピールの30%分回復する"]:::action --> c5
    c5{"⑤:ライブ中に発動した自身のスキル2<br/>「アクセル全開。」の回数が<br/>2回以上か"}:::cond
    c5 -->|"Yes"| a5["自身を2ターンの間<br/>「臨機」状態にする"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
