flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:残りHP割合が最も高い<br/>ライバル4名にライブ中に発動した<br/>自身のスキル2「アクセル全開。」<br/>の回数×自身のHP上限の40%を<br/>固定値として上乗せした830%の<br/>アピールを行う(固定値の上乗せは<br/>自身の最大アピールの400%まで)"]:::action
    a1 --> c2{"②:①のアピールでアピールの<br/>失敗またはアピールが0である事が<br/>発生したか<br/>(①の各アピール後)"}:::cond
    c2 -->|"Yes"| e2["このスキルによる残りのアピールは<br/>必ず命中する"]:::effect
    c2 -->|"No"| lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    e2 --> lc1
    lc1 -->|"Yes"| c3{"③:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の対象へ"| a1
    c3 -->|"Yes"| a3["③実行:残りHP割合が最も低い<br/>ライバル1名にこのスキルで<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c3 -->|"No"| e4["④:自身のデバフ・サゲ効果を<br/>2つ解除し、このスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    a3 --> e4
    e4 --> c5{"⑤:ライブ中に発動した自身の<br/>スキル2「アクセル全開。」の<br/>回数が2回以上か"}:::cond
    c5 -->|"Yes"| e5["自身を2ターンの間「臨機」<br/>状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
