flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+25%する"]:::effect
    e1 --> c3{"③:②のアピール対象の残りHP割合が<br/>50%未満または自身の残りHP割合が<br/>②のアピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ②の<br/>アピール対象のディフェンスと<br/>フィジカルを-50%する"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに4回、自身の最大アピールの<br/>20%を固定値として上乗せした460%の<br/>アピールを行う(このアピールは<br/>ライバルがリタイアするまで対象を<br/>変更せず、リタイア回復が発生した<br/>場合も対象を変更しない)"]:::action
    e3 --> a2
    a2 --> e4["④:自身のHPを②で行った直前の<br/>アピールの30%分回復する<br/>(②の各アピール後)"]:::effect
    e4 --> c5{"⑤:②のアピールで会心アピールが<br/>発生したまたは②のアピール対象の<br/>特殊状態の合計ターン数が<br/>6ターン以上か<br/>(②の各アピール後)"}:::cond
    c5 -->|"Yes"| e5["②のアピール回数が1回増加する<br/>(アピールの追加回数は最大で8回まで)"]:::effect
    c5 -->|"No"| lc2{"②のアピール<br/>4回(+⑤の追加分)すべて完了?"}:::cond
    e5 --> lc2
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
