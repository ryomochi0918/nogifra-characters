flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のバイタリティが<br/>①のアピール対象のバイタリティ<br/>以上か(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバルへ<br/>自身のスマイルの3倍を<br/>固定値として上乗せした<br/>700%のアピール"]:::action
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| e4["④:③のアピールに<br/>「ライバルチームのフロントの<br/>特殊状態の合計ターン数×<br/>自身のSP上限の5倍」を<br/>固定値として上乗せする<br/>(固定値の上乗せは<br/>自身のSP上限の120倍まで)<br/>(③の各アピール前)"]:::effect
    e4 --> c5{"⑤:味方フロントの「瞑想」状態の<br/>合計ターン数が8ターン以上か<br/>(③の各アピール前)"}:::cond
    c5 -->|"Yes"| e5["③のアピール倍率が2倍になり、<br/>③の各アピール中のみ<br/>自身の命中率と会心率を+40%する"]:::effect --> a3
    c5 -->|"No"| a3["③実行:最大アピールが<br/>最も高いライバルへ<br/>600%のアピール"]:::action
    a3 --> lc3{"③のアピール<br/>2回すべて完了?"}:::cond
    lc3 -->|"No、次の回へ"| e4
    lc3 -->|"Yes"| finish(("終了")):::startend
