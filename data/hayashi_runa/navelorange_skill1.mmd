flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のバイタリティが①の<br/>アピール対象のバイタリティ以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに4回、<br/>自身のスマイルの3倍を<br/>固定値として上乗せした700%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| e4["④:③のアピールに「ライバルチームの<br/>フロントの特殊状態の<br/>合計ターン数×自身のSP上限の5倍」<br/>を固定値として上乗せする(固定値の<br/>上乗せは自身のSP上限の120倍まで)<br/>(③の各アピール前)"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e4 --> c5{"⑤:味方フロントの「瞑想」状態の<br/>合計ターン数が8ターン以上か<br/>(③の各アピール前)"}:::cond
    c5 -->|"Yes"| e5["③のアピール倍率が2倍になり、<br/>③の各アピール中のみ自身の<br/>命中率と会心率を+40%する"]:::effect
    c5 -->|"No"| a3["③実行:最大アピールが最も高い<br/>ライバルに2回、600%のアピールを行う"]:::action
    e5 --> a3
    a3 --> lc3{"③のアピール<br/>2回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| e4
