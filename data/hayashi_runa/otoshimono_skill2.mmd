flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバル6名の<br/>バフ・アゲ効果を1つ解除し、<br/>自身のスマイルの4.5倍の固定値を<br/>上乗せした500%のアピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:残りHP割合が最も低い味方2名の<br/>HPを①で行った合計アピールの<br/>30%分回復する"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e3 --> c4{"④:①のアピールでリタイアした<br/>人数が1名以下か"}:::cond
    c4 -->|"Yes"| a4["④実行:残りHP割合が最も<br/>高いライバル3名に①で<br/>行った合計アピールの40%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    c4 -->|"No"| c5{"⑤:このスキルで行ったアピールで<br/>リタイアした人数が1名以下か"}:::cond
    a4 --> c5
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバル1名にこのスキルで行った<br/>合計アピール60%分のアピールを行う<br/>(ディフェンス、メンタルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
