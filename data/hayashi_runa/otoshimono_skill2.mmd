flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル6名のバフ・アゲ<br/>効果を1つ解除し、自身のスマイル<br/>の4.5倍の固定値を上乗せした<br/>500%のアピール"]:::action
    a1 --> e3["③実行:残りHP割合が最も低い<br/>味方2名のHPを①で行った合計<br/>アピールの30%分回復する"]:::effect
    e3 --> c4{"④:①のアピールでリタイアした<br/>人数が1名以下か"}:::cond
    c4 -->|"Yes"| a4["残りHP割合が最も高いライバル<br/>3名へ①で行った合計アピールの<br/>40%分のアピール(ディフェンス、<br/>メンタルを無視する)"]:::action --> c5
    c4 -->|"No"| c5{"⑤:このスキルで行ったアピールで<br/>リタイアした人数が1名以下か<br/>(④のアピールが発動した場合は<br/>④の後)"}:::cond
    c5 -->|"Yes"| a5["残りHP割合が最も低いライバル<br/>1名へこのスキルで行った合計<br/>アピール60%分のアピール<br/>(ディフェンス、メンタルを<br/>無視する)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
