flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>バフ・アゲ効果状態か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ<br/>効果を2つ解除し、①のアピール<br/>倍率と固定値倍率が1.5倍になる"]:::effect --> c4
    c2 -->|"No"| c3{"③:①のアピール対象がバフ・アゲ<br/>効果状態ではないまたは<br/>特殊状態か(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["①の各アピール中のみ自身の<br/>リフレクト耐性を+20%する"]:::effect --> a1
    c4 -->|"No"| a1["①実行:ライバルへ、自身のスマイル<br/>の3倍を固定値として上乗せした<br/>440%のアピールを行い、100%の<br/>確率で2ターンの間「心労」状態<br/>にする"]:::action
    a1 --> lc{"①のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c5{"⑤:ライバルチームの<br/>フロント人数が3名以上か"}:::cond
    c5 -->|"Yes"| a5["再度①を実行<br/>(再実行は1回まで)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
