flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>バフ・アゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を<br/>2つ解除し、①のアピール倍率と<br/>固定値倍率が1.5倍になる"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>バフ・アゲ効果状態ではないまたは<br/>特殊状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["①の各アピール中のみ自身の<br/>リフレクト耐性を+20%する"]:::effect
    c4 -->|"No"| a1["①実行:ライバルに5回、<br/>自身のスマイルの3倍を<br/>固定値として上乗せした440%の<br/>アピールを行い、100%の確率で<br/>2ターンの間「心労」状態にする"]:::action
    e4 --> a1
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:ライバルチームの<br/>フロント人数が3名以上か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c5 -->|"Yes(再実行は最大1回まで)"| c2
    c5 -->|"No"| finish(("終了")):::startend
