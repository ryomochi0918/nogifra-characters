flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方チームのフロントに<br/>デバフ・サゲ効果状態の<br/>メンバーが1名以上居るか"}:::cond
    c2 -->|"Yes"| e2["①による「回避率ダウン」の<br/>効果倍率が5%増加する"]:::effect --> e1
    c2 -->|"No"| e1["①実行:最大アピールが最も高い<br/>ライバル2名を100%の確率で<br/>3ターンの間「回避率ダウン」<br/>状態にする"]:::effect
    e1 --> e3["③実行:味方6名の転倒、落胆、<br/>雑音状態を解除し、デバフ・<br/>サゲ効果を2つ解除する"]:::effect
    e3 --> a4["④実行:ライバル4名へ<br/>700%のアピール"]:::action --> finish(("終了")):::startend
