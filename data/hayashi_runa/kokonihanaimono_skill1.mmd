flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["100%の確率で<br/>2ターンの間「緊張」状態にする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル5名へ600%の<br/>アピールを行い、100%の確率で<br/>3ターンの間「アピールカダウン」<br/>状態にする"]:::action
    a1 --> lc1{"①のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| e3["③実行:自身を3ターンの間<br/>「翻弄」状態にする"]:::effect --> finish(("終了")):::startend
