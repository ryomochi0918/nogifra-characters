flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身の残りHP割合が70%以上か"}:::cond
    c1 -->|"Yes"| e1["このスキル中、自身の命中率と<br/>会心アピールを+25%する"]:::effect
    c1 -->|"No"| c3{"③:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    e1 --> c3
    c3 -->|"Yes"| e3["アピール倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルに5回、550%のアピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールでアピールの失敗<br/>またはアピールが0だったか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["②のアピール回数が1回増加する<br/>(アピールの追加回数は最大で3回まで)"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>5回(+④の追加分)すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| c5{"⑤:②のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes(再実行は最大1回まで)"| c3
    c5 -->|"No"| c6{"⑥:②のアピールでライバルが<br/>リタイアしたか"}:::cond
    c6 -->|"Yes"| a6["⑥実行:残りHP割合が最も<br/>高いライバル2名に②で<br/>行った合計アピールの20%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c6 -->|"No"| finish(("終了")):::startend
    a6 --> finish
