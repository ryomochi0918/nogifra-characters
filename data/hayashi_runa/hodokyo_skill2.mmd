flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象がデバフ・<br/>サゲ効果状態か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象の<br/>バフ・アゲ効果を1つ解除する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル5名へ、自身の最大<br/>アピールの40%を固定値として<br/>上乗せした480%のアピール"]:::action
    a1 --> c4{"④:①のアピールでアピール対象が<br/>デバフ・サゲ効果状態だった<br/>回数が3回以上か"}:::cond
    c4 -->|"Yes"| a4["再度①を実行<br/>(再実行は最大1回まで)"]:::action --> c5
    c4 -->|"No"| c5{"⑤:①のアピールでリタイアした<br/>ライバルが1名以下か<br/>(④の再実行が発動した場合は<br/>④の後)"}:::cond
    c5 -->|"Yes"| a5["ライバル2名へ①で行った合計<br/>アピールの30%分のアピール<br/>(ディフェンス、フィジカルを<br/>無視する)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
