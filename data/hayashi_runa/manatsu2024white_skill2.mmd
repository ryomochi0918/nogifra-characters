flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身が「軽業」状態または<br/>「聖域」状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| c3{"③:自身が「軽業」状態かつ<br/>「聖域」状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに4回、640%のアピールを行う"]:::action
    c3 -->|"Yes"| e3["②の固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| e2["①のアピールに自身が受けている<br/>バフ・アゲ効果・特殊状態の<br/>種類数×自身の残りHPの8%を<br/>固定値として上乗せする"]:::effect
    e3 --> e2
    e2 --> a1
    a1 --> e4["④:自身のHPを①で行った直前の<br/>アピールの50%分回復する<br/>(①の各アピール後)"]:::effect
    e4 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
