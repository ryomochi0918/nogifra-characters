flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:アピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["アピール対象のHP上限1%分を<br/>固定値として上乗せし、<br/>①の各アピール中のみ自身の<br/>命中率を+20%する"]:::effect
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに4回、600%のアピールを行う"]:::action
    e2 --> a1
    a1 --> e3["③:①のアピール対象を100%の確率で<br/>3ターンの間「空腹」状態にする<br/>(①の各アピール後)"]:::effect
    e3 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
