flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:アピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    c2 -->|"Yes"| e2["アピール対象のHP上限1%分を<br/>固定値として上乗せし、①の各<br/>アピール中のみ自身の命中率を<br/>+20%する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルへ600%のアピール"]:::action
    a1 --> e3["①のアピール対象を100%の<br/>確率で3ターンの間<br/>「空腹」状態にする"]:::effect
    e3 --> lc{"①のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| finish(("終了")):::startend
