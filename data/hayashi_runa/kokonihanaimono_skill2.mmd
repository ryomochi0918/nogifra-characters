flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①実行:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e1 --> c3{"③:②のアピール対象が<br/>デバフ状態か"}:::cond
    c3 -->|"Yes"| e3["②のアピールは必ず<br/>会心アピールになる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバルへ、アピール対象が<br/>受けているデバフ・サゲ効果状態の<br/>種類数×350%の倍率を上乗せした<br/>350%のアピール"]:::action
    a2 --> c4{"④:②のアピールが<br/>会心アピールだったか"}:::cond
    c4 -->|"Yes"| e4["②のアピール対象を100%の<br/>確率で4ターンの間<br/>「衰弱」状態にする"]:::effect --> lc
    c4 -->|"No"| lc{"②のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| c5{"⑤:②のアピールでデバフ・サゲ<br/>効果状態が3種類以上のライバルに<br/>3回以上アピールしたか"}:::cond
    c5 -->|"Yes"| a5["再度②を実行<br/>(再実行は最大1回まで)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
