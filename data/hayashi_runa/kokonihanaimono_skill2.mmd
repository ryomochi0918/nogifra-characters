flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e1 --> c3{"③:②のアピール対象がデバフ状態か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピールは必ず会心アピールになる"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに5回、アピール対象が<br/>受けているデバフ・サゲ効果状態の<br/>種類数×350%の倍率を上乗せした350%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールが会心アピールか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["②のアピール対象を100%の確率で<br/>4ターンの間「衰弱」状態にする"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| c5{"⑤:②のアピールで<br/>デバフ・サゲ効果状態が3種類以上の<br/>ライバルに3回以上アピールしたか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes(再実行は最大1回まで)"| c3
    c5 -->|"No"| finish(("終了")):::startend
