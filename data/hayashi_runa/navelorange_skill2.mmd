flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身の残りHP割合が50%以上か"}:::cond
    c1 -->|"Yes"| e1["自身を3ターンの間「神気」<br/>状態にする"]:::effect
    c1 -->|"No"| c3{"③:このスキルが発動する前の<br/>自身の「瞑想」状態のターン数が<br/>6ターン以上か<br/>(②の各アピール前)"}:::cond
    e1 --> c3
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル4名のバフ・アゲ効果を<br/>1つ解除し、自身の最大アピールの<br/>25%を固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②でバフ・アゲ効果の解除に<br/>成功したか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| a4["④実行:②のアピール対象に<br/>自身の残りSPの150倍を<br/>固定値として上乗せした1500%の<br/>アピールを行う"]:::action
    c4 -->|"No"| lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    a4 --> lc2
    lc2 -->|"Yes"| a5["⑤実行:②で特殊状態のライバルを<br/>対象にした回数をアピール回数として、<br/>残りHP割合が最も低いライバル1名に<br/>自身のスマイルの14倍分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    lc2 -->|"No、次の対象へ"| c3
    a5 --> finish(("終了")):::startend
