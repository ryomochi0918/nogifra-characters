flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身の残りHP割合が<br/>50%以上か"}:::cond
    c1 -->|"Yes"| e1["自身を3ターンの間<br/>「神気」状態にする"]:::effect --> c3
    c1 -->|"No(条件を満たさない場合でも②は発動)"| c3{"③:このスキルが発動する前の<br/>自身の「瞑想」状態のターン数が<br/>6ターン以上か(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:最大アピールが<br/>最も高いライバル4名の<br/>バフ・アゲ効果を1つ解除し、<br/>自身の最大アピールの25%を<br/>固定値として上乗せした<br/>800%のアピール"]:::action
    a2 --> c4{"④:②でバフ・アゲ効果の<br/>解除に成功したか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| a4["②のアピール対象に<br/>自身の残りSPの150倍を<br/>固定値として上乗せした<br/>1500%のアピール"]:::action --> lc2
    c4 -->|"No"| lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2 -->|"Yes"| a5["⑤実行:②で特殊状態の<br/>ライバルを対象にした回数を<br/>アピール回数として、<br/>残りHP割合が最も低いライバル1名に<br/>自身のスマイルの14倍分のアピール<br/>(ディフェンス、メンタルを無視する)"]:::action
    a5 --> finish(("終了")):::startend
