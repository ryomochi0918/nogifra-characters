flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+40%し、命中率を+20%する"]:::effect
    e1 --> c3{"③:②のアピール対象の<br/>残りHP割合が30%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が3倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに3回、<br/>アピール対象のHP上限の0.5%分を<br/>固定値として上乗せした1100%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:自身のサンクスが④の<br/>アピール対象のサンクス以上か<br/>(④の各アピール前)"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes"| e5["④のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c5 -->|"No"| a4["④実行:残りHP割合が最も低い<br/>ライバルに3回、自身のHP上限の<br/>40%を固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    e5 --> a4
    a4 --> lc4{"④のアピール<br/>3回すべて完了?"}:::cond
    lc4 -->|"Yes"| c7{"⑦:自身の残りHP割合が50%未満か"}:::cond
    lc4 -->|"No、次の回へ"| c5
    c7 -->|"Yes"| e7["⑥による「反響」の<br/>効果倍率が2倍になる"]:::effect
    c7 -->|"No"| e6["⑥:自身と自身以外の残りHP割合が<br/>最も高い味方1名を2ターンの間<br/>「反響」状態にする"]:::effect
    e7 --> e6
    e6 --> finish(("終了")):::startend
