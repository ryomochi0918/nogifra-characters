flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身のデバフ・サゲ効果を全て解除し、<br/>HPを自身のHP上限の80%分回復する"]:::effect --> c3{"③:自身のサンクスが②のアピール対象の<br/>サンクス以上または自身のバイタリティが<br/>②のアピール対象のバイタリティ以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["③:②のアピール倍率と<br/>固定値が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバル6名へ、自身の残りHPの20%を<br/>固定値として上乗せした820%のアピール"]:::action --> c4{"④:自身の残りHP割合が②のアピール対象の<br/>残りHP割合以上か<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["④:②のアピール対象を100%の確率で<br/>3ターンの間「嫉妬」状態にする<br/>(嫉妬:HPが回復しなくなる)"]:::effect --> lc2
    c4 -->|"No"| lc2{"②のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2 -->|"Yes"| finish(("終了")):::startend
