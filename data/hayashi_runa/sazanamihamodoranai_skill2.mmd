flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身のデバフ・サゲ効果を<br/>全て解除し、HPを自身のHP上限の<br/>80%分回復する"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上<br/>または自身のバイタリティが②の<br/>アピール対象のバイタリティ以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と固定値が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバル6名に自身の残りHPの<br/>20%を固定値として上乗せした820%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["②のアピール対象を100%の確率で<br/>3ターンの間「嫉妬」状態にする"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>ライバル6名すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の対象へ"| c3
