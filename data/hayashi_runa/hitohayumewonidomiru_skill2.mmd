flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e1 --> c3{"③:②の対象が「フィジカルダウン」<br/>状態か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:②の対象が「メンタルダウン」状態か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール倍率が2倍になる"]:::effect
    c4 -->|"No"| c5{"⑤:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["②のアピールに自身の最大アピールの<br/>30%分の固定値を上乗せする"]:::effect
    c5 -->|"No"| a2["②実行:ライバルに5回、400%の<br/>アピールを行う"]:::action
    e5 --> a2
    a2 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"Yes"| c6{"⑥:②のアピールで<br/>デバフ・サゲ効果状態のライバルに<br/>アピールした回数が3回以上か"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c6 -->|"Yes(再実行は最大1回まで)"| c3
    c6 -->|"No"| finish(("終了")):::startend
