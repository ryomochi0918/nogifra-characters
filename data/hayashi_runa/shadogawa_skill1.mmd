flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①実行:自身を2ターンの間<br/>「全開」状態にし、このスキル中、<br/>自身のリフレクト耐性を<br/>+40%する"]:::effect
    e1 --> a2["②実行:ライバルへ4回、自身の<br/>最大アピールの30%を固定値<br/>として上乗せした800%の<br/>アピール"]:::action
    a2 --> c3{"③:味方チームのフロント人数が<br/>ライバルチームのフロント人数<br/>以上か"}:::cond
    c3 -->|"Yes"| e3["自身を2ターンの間<br/>「熱血」状態にする"]:::effect --> a4
    c3 -->|"No"| a4["④実行(条件を満たさない場合<br/>でも発動):残りHP割合が最も<br/>低いライバルへ4回、300%の<br/>アピール"]:::action --> finish(("終了")):::startend
