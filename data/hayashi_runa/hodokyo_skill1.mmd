flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①の<br/>アピール対象のエフォート以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象の<br/>残りHP割合が50%以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象の<br/>バフ・アゲ効果を1つ解除する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルへ、自身のエフォートの<br/>3倍を固定値として上乗せした<br/>430%のアピール"]:::action
    a1 --> lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c5{"⑤:ライバルチームの<br/>フロント人数が4名以上か"}:::cond
    c5 -->|"Yes"| e5["自身を3ターンの間<br/>「威圧」状態にする"]:::effect --> e4
    c5 -->|"No"| e4["④実行:自身のHPをこのスキルで<br/>行った合計アピールの30%分<br/>回復する"]:::effect --> finish(("終了")):::startend
