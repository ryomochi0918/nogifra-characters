flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①のアピール対象のエフォート以上か"}:::cond
    c2 -->|"Yes"| e2["このアピール中のみ自身のデバフ耐性貫通を+50%し、<br/>①のアピール倍率を2倍にする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバルへ100%の確率で2ターンの間<br/>「ディフェンスダウン」状態にし、420%のアピールを行う"]:::action
    a1 --> c3{"③:①のアピール対象の残りHP割合が<br/>50%未満か"}:::cond
    c3 -->|"Yes"| e3["自身を2ターンの間「集中」状態にし、<br/>自身のHPを①で行った直前のアピールの50%分回復する"]:::effect --> lc
    c3 -->|"No"| lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| finish(("終了")):::startend
