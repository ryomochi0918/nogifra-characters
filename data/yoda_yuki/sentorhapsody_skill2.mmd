flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+40%する"]:::effect
    e1 --> c3{"③:②のアピール対象が「混乱」状態か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピールに②のアピール対象の<br/>HP減少分の8%を固定値として上乗せする<br/>(固定値の上乗せは自身の<br/>最大アピールの500%まで)"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに8回、280%のアピールを行う"]:::action
    e3 --> a2
    a2 --> e4["④:②のアピール対象を100%の確率で<br/>4ターンの間「混乱」状態にする<br/>(②の各アピール後)"]:::effect
    e4 --> lc2{"②のアピール<br/>8回すべて完了?"}:::cond
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
