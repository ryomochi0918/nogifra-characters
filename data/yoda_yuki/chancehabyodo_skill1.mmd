flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3a{"③:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(①の各アピール前)"}:::cond
    c3a -->|"Yes"| e3a["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3a -->|"No"| c4a{"④:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(①の各アピール前)"}:::cond
    e3a --> c4a
    c4a -->|"Yes"| e4a["①のアピール倍率と<br/>固定値倍率が1.5倍になる"]:::effect
    c4a -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルに2回、自身のサンクスを<br/>固定値として上乗せした550%の<br/>アピールを行う"]:::action
    e4a --> a1
    a1 --> c3b{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3b -->|"Yes"| e3b["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3b -->|"No"| c4b{"④:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    e3b --> c4b
    c4b -->|"Yes"| e4b["②のアピール倍率と<br/>固定値倍率が1.5倍になる"]:::effect
    c4b -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバル2名に自身のサンクスを<br/>固定値として上乗せした550%の<br/>アピールを行う"]:::action
    e4b --> a2
    a2 --> lc2{"②のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc2 -->|"Yes"| lc1{"①のアピール<br/>2回すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3b
    lc1 -->|"Yes"| c5{"⑤:味方フロントの「根性」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    lc1 -->|"No、次の回へ"| c3a
    c5 -->|"Yes"| e5["自身を3ターンの間<br/>「聖域」状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
