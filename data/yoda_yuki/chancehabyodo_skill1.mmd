flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3a{"③:自身のサンクスが①の対象の<br/>サンクス以上か"}:::cond
    c3a -->|"Yes"| e3a["①の倍率と固定値倍率が2倍に"]:::effect --> c4a
    c3a -->|"No"| c4a{"④:自身の残りHP割合が①の対象の<br/>残りHP割合以上か"}:::cond
    c4a -->|"Yes"| e4a["①の倍率と固定値倍率が1.5倍に"]:::effect --> a1
    c4a -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバルへ基本550%+固定値 自身のサンクス"]:::action
    a1 --> c3b{"③:自身のサンクスが②の対象の<br/>サンクス以上か(②のアピール対象ごとに判定)"}:::cond
    c3b -->|"Yes"| e3b["②の倍率と固定値倍率が2倍に"]:::effect --> c4b
    c3b -->|"No"| c4b{"④:自身の残りHP割合が②の対象の<br/>残りHP割合以上か(②のアピール対象ごとに判定)"}:::cond
    c4b -->|"Yes"| e4b["②の倍率と固定値倍率が1.5倍に"]:::effect --> a2
    c4b -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバル2名へ基本550%+固定値 自身のサンクス"]:::action
    a2 --> lc2{"②のアピール2名<br/>すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3b
    lc2 -->|"Yes"| lc1{"①のアピール2回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c3a
    lc1 -->|"Yes"| c5{"⑤:味方フロントの「根性」状態の<br/>合計ターン数が7ターン以上か"}:::cond
    c5 -->|"Yes"| e5["自身を3ターンの間<br/>「聖域」状態にする"]:::effect --> finish(("終了")):::startend
    c5 -->|"No"| finish
