flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②/③:自身の残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["②:①のアピールに自身のエフォートの<br/>2倍を固定値として上乗せする"]:::effect
    c2 -->|"No"| e3["③:①の各アピール中のみ自身の<br/>リフレクト耐性を+20%する"]:::effect
    e2 --> a1["①実行:ライバルに4回、<br/>自身の最大アピールの30%を<br/>固定値として上乗せした1400%の<br/>アピールを行う(このアピールは<br/>ライバルがリタイアするまで対象を<br/>変更せず、リタイア回復が発生した<br/>場合も対象を変更しない)"]:::action
    e3 --> a1
    a1 --> c4{"④:①のアピールでライバルが<br/>リタイアしなかったか<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["このスキル中①で行うアピール倍率が<br/>半分になる(最低倍率は350%)"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| e5["⑤:自身のHPを①で行った<br/>合計アピールの30%分回復し、自身を<br/>2ターンの間「反響」状態にする"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e5 --> finish(("終了")):::startend
