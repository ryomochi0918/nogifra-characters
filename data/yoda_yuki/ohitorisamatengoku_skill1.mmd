flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["②:①のアピールに自身の<br/>エフォートの2倍を固定値として上乗せ"]:::effect --> a1
    c2 -->|"No(③:50%未満)"| e3["③:①のアピール中のみ<br/>自身のリフレクト耐性を+20%"]:::effect --> a1
    a1["①実行:ライバルへ基本1400%+固定値<br/>自身の最大アピール×30%<br/>(リタイアするまで対象は変更しない)"]:::action
    a1 --> c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c4 -->|"Yes"| e4["①のアピール倍率が半分に<br/>(最低倍率350%)"]:::effect --> lc
    c4 -->|"No"| lc{"①のアピール4回<br/>すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| e5["⑤:自身のHPを①の合計アピールの<br/>30%分回復し、自身を2ターンの間<br/>「反響」状態にする"]:::effect --> finish(("終了")):::startend
