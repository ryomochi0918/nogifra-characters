flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の命中率と<br/>会心率を+25%する"]:::effect
    e1 --> c3{"③:自身のサンクスがアピール対象の<br/>サンクス以上か<br/>(度に積算)<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる<br/>(最大4800%のアピール)"]:::effect
    c3 -->|"No"| c4{"④:自身の「根性」状態のターン数が<br/>7ターン以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["①の命中率と会心率の<br/>増加倍率が40%になる"]:::effect
    c4 -->|"No"| c5{"⑤:自身の「根性」状態のターン数が<br/>8ターン以上か<br/>(②の各アピール前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["②のアピールに自身の最大アピールの<br/>40%を固定値として上乗せする"]:::effect
    c5 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに7回、300%のアピールを行う"]:::action
    e5 --> a2
    a2 --> lc2{"②のアピール<br/>7回すべて完了?"}:::cond
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
