flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率と会心率を+25%する"]:::effect
    e1 --> c3{"③:自身のサンクスが対象の<br/>サンクス以上か(②のアピール対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②の倍率が2倍に<br/>(最大4800%のアピール)"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身の「根性」状態の<br/>ターン数が7ターン以上か"}:::cond
    c4 -->|"Yes"| e4["①の命中率と会心率の<br/>増加倍率が40%に"]:::effect --> c5
    c4 -->|"No"| c5{"⑤:自身の「根性」状態の<br/>ターン数が8ターン以上か"}:::cond
    c5 -->|"Yes"| e5["②のアピールに自身の最大アピールの<br/>40%を固定値として上乗せ"]:::effect --> a2
    c5 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルへ300%のアピール"]:::action
    a2 --> lc{"②のアピール7回<br/>すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| finish(("終了")):::startend
