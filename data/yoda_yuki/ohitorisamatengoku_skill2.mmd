flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3a{"③:自身のエフォートが①のアピール対象の<br/>エフォート以上か<br/>(①の各アピール前)"}:::cond
    c3a -->|"Yes"| e3a["①のアピール対象のバフ・アグ効果を<br/>2つ解除する"]:::effect
    c3a -->|"No"| a1["①実行:ライバル4名に1000%の<br/>アピールを行う"]:::action
    e3a --> a1
    a1 --> c2{"②:①のアピール対象の<br/>残りHP割合が70%以下か<br/>(①の各アピール後)"}:::cond
    c2 -->|"Yes"| c3b{"③:自身のエフォートが②のアピール対象の<br/>エフォート以上か<br/>(②の各アピール前)"}:::cond
    c2 -->|"No"| lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    c3b -->|"Yes"| e3b["②のアピール対象のバフ・アグ効果を<br/>2つ解除する"]:::effect
    c3b -->|"No"| a2["②実行:①の各アピール対象に<br/>1000%のアピールを行う"]:::action
    e3b --> a2
    a2 --> lc1
    lc1 -->|"Yes"| e4["④:自身の状態に応じて⑤か⑥の<br/>効果どちらかを適用する"]:::effect
    e4 --> c5{"⑤/⑥:自身が「反響」状態か"}:::cond
    lc1 -->|"No、次の対象へ"| c3a
    c5 -->|"Yes"| e5["⑤:自身の「反響」状態とデバフ・サゲ効果を<br/>全て解除し、HPを自身のHP上限の50%分回復し、<br/>3ターンの間「残響」状態にする"]:::effect
    c5 -->|"No"| e6["⑥:自身と自身以外の最大アピールが<br/>最も高い味方1名のHPを自身のHP上限の<br/>50%分回復し、3ターンの間「反響」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
    e6 --> finish
