flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c3a{"③:自身のエフォートが①の対象の<br/>エフォート以上か(対象ごとに判定)"}:::cond
    c3a -->|"Yes"| e3a["①の対象のバフ・アグ効果を<br/>2つ解除"]:::effect --> a1
    c3a -->|"No"| a1["①実行:ライバルへ1000%のアピール"]:::action
    a1 --> c2{"②:①のアピール対象の残りHP割合が<br/>70%以下か"}:::cond
    c2 -->|"Yes"| c3b{"③:自身のエフォートが②の対象の<br/>エフォート以上か(対象ごとに判定)"}:::cond
    c3b -->|"Yes"| e3b["②の対象のバフ・アグ効果を<br/>2つ解除"]:::effect --> a2
    c3b -->|"No"| a2["②実行:①の対象へ<br/>1000%のアピール"]:::action
    a2 --> lc{"①のアピール4名<br/>すべて完了?"}:::cond
    c2 -->|"No"| lc
    lc -->|"No、次の対象へ"| c3a
    lc -->|"Yes"| c4{"④:自身が「反響」状態か"}:::cond
    c4 -->|"Yes"| e5["⑤:自身の「反響」状態と<br/>デバフ・サゲ効果を全て解除し、<br/>HPを自身のHP上限の50%分回復し、<br/>3ターンの間「残響」状態にする"]:::effect --> finish(("終了")):::startend
    c4 -->|"No"| e6["⑥:自身と自身以外の最大アピールが<br/>最も高い味方1名のHPを自身のHP上限の<br/>50%分回復し、3ターンの間「反響」状態にする"]:::effect --> finish
