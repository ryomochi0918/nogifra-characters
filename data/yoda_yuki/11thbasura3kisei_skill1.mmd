flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:自身の残りHP割合が70%未満か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect
    c3 -->|"No"| a2["②実行:ライバル6名に自身の<br/>バイタリティの2.5倍を<br/>固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:自身が「反響」状態ではないか"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c5 -->|"Yes"| e5["自身を3ターンの間「反響」<br/>状態にする"]:::effect
    c5 -->|"No"| e4["④:自身のHPを②で行った<br/>合計アピールの30%分回復する"]:::effect
    e5 --> e4
    e4 --> finish(("終了")):::startend
