flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②/③:①の効果対象が<br/>デバフ・サゲ効果状態か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["②:①の効果対象のデバフ・サゲ効果を<br/>2つ解除する"]:::effect
    c2 -->|"No"| e3["③:①による「勇気」状態の<br/>効果倍率と「全開」状態の<br/>アピール力増加倍率が1.5倍になる"]:::effect
    e2 --> e1["①:最大アピールが最も高い<br/>味方2名を2ターンの間「勇気」<br/>と「全開」状態にし、HPを自身の<br/>アピール力の120%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect
    e3 --> e1
    e1 --> lc1{"①の効果<br/>対象2名すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の対象へ"| c2
