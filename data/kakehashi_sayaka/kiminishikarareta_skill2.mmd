flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c5{"⑤:①のアピール対象が「衰弱」状態か<br/>(①の各アピール前)"}:::cond
    c5 -->|"Yes"| e5["①の各アピールは<br/>必ず会心アピールになる"]:::effect
    c5 -->|"No"| a1["①実行:ライバル3名に<br/>アピール対象の残りHPの0.5%を<br/>固定値として上乗せした340%の<br/>アピールを行う"]:::action
    e5 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc1 -->|"Yes"| c2{"②:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の対象へ"| c5
    c2 -->|"Yes(再実行は最大1回まで)"| c5
    c2 -->|"No"| c5_2{"⑤:③のアピール対象が「衰弱」状態か<br/>(③の各アピール前)"}:::cond
    c5_2 -->|"Yes"| e5_2["③の各アピールは<br/>必ず会心アピールになる"]:::effect
    c5_2 -->|"No"| a3["③実行:ライバルに3回、<br/>アピール対象の残りHPの0.5%を<br/>固定値として上乗せした340%の<br/>アピールを行う"]:::action
    e5_2 --> a3
    a3 --> lc3{"③のアピール<br/>3回すべて完了?"}:::cond
    lc3 -->|"Yes"| c4{"④:③のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc3 -->|"No、次の回へ"| c5_2
    c4 -->|"Yes(再実行は最大1回まで)"| c5_2
    c4 -->|"No"| finish(("終了")):::startend
