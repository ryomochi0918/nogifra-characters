flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c5a{"⑤:①のアピール対象が<br/>「衰弱」状態か<br/>(対象ごとに判定)"}:::cond
    c5a -->|"Yes"| e5a["①のアピールは<br/>必ず会心アピールになる"]:::effect --> a1
    c5a -->|"No"| a1["①実行:<br/>ライバルへアピール対象の残りHPの0.5%を<br/>固定値として上乗せした<br/>340%のアピールを行う"]:::action
    a1 --> l1{"①のアピール<br/>3名分すべて完了?"}:::cond
    l1 -->|"No、次の対象へ"| c5a
    l1 -->|"Yes"| c2{"②:①のアピールでライバルが<br/>リタイアしなかったか<br/>(かつ再実行がまだの場合)"}:::cond
    c2 -->|"Yes(再実行は最大1回まで)"| c5a
    c2 -->|"No"| c5b{"⑤:③のアピール対象が<br/>「衰弱」状態か"}:::cond
    c5b -->|"Yes"| e5b["③のアピールは<br/>必ず会心アピールになる"]:::effect --> a3
    c5b -->|"No"| a3["③実行:<br/>ライバルへアピール対象の残りHPの0.5%を<br/>固定値として上乗せした<br/>340%のアピールを行う"]:::action
    a3 --> l3{"③のアピール<br/>3回すべて完了?"}:::cond
    l3 -->|"No、次の回へ"| c5b
    l3 -->|"Yes"| c4{"④:③のアピールでライバルが<br/>リタイアしなかったか<br/>(かつ再実行がまだの場合)"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c5b
    c4 -->|"No"| finish(("終了")):::startend
