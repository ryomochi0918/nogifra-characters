flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①による「衰弱」状態の確率が<br/>100%になる"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル4名に360%のアピールを<br/>行い、80%の確率で3ターンの間<br/>「衰弱」状態にする"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:③のアピール対象が「衰弱」状態か<br/>(③の各アピール前)"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes"| e4["③のアピール倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:ライバルに3回、360%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>3回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c4
