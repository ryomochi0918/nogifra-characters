flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが<br/>①のアピール対象のスマイル以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①による「衰弱」状態の確率が<br/>100%になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>残りHP割合が最も低いライバルへ<br/>360%のアピールを行い、<br/>80%の確率で3ターンの間「衰弱」状態にする"]:::action
    a1 --> l1{"①のアピール<br/>4名分すべて完了?"}:::cond
    l1 -->|"No、次の対象へ"| c2
    l1 -->|"Yes"| c4{"④:③のアピール対象が<br/>「衰弱」状態か"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率が2倍になる"]:::effect --> a3
    c4 -->|"No"| a3["③実行:<br/>ライバルへ360%のアピールを行う"]:::action
    a3 --> l3{"③のアピール<br/>3回すべて完了?"}:::cond
    l3 -->|"No、次の回へ"| c4
    l3 -->|"Yes"| finish(("終了")):::startend
