flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect
    c2 -->|"No"| a1["①実行:ライバル6名に<br/>自身の最大アピールの35%を<br/>固定値として上乗せした760%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| e4["④:①の各アピール前に①の<br/>アピール対象がデバフ状態だった<br/>回数分、③のアピール回数を<br/>1回増加する(アピールの追加回数は<br/>最大で3回まで)"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e4 --> a3["③実行:残りHP割合が最も低い<br/>ライバルに1回、自身の残りSPの<br/>120倍のアピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    a3 --> c6{"⑥:このスキルでライバルが<br/>リタイアしたか<br/>(⑤の各効果前)"}:::cond
    c6 -->|"Yes"| e6["⑤の効果対象のデバフ・サゲ効果を<br/>1つ解除し、3ターンの間「勇気」<br/>状態にする"]:::effect
    c6 -->|"No"| e5["⑤:残りHP割合が最も低い<br/>味方2名のHPをこのスキルで行った<br/>合計アピールの20%分回復する"]:::effect
    e6 --> e5
    e5 --> lc5{"⑤の効果<br/>対象2名すべて完了?"}:::cond
    lc5 -->|"Yes"| finish(("終了")):::startend
    lc5 -->|"No、次の対象へ"| c6
