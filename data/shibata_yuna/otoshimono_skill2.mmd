flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:自身のスマイルが①のアピール<br/>対象のスマイル以上か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["該当対象への①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバル6名へ、自身の<br/>最大アピールの35%を固定値として<br/>上乗せした760%のアピール"]:::action --> e4["④効果:①の対象がデバフ状態だった<br/>回数分、③のアピール回数が増加する<br/>(追加回数は最大3回まで)"]:::effect --> a3["③実行:残りHP割合が最も低い<br/>ライバルへ1回(以上)、自身の残りSPの<br/>120倍のアピール<br/>(ディフェンス、メンタルを無視)"]:::action --> c6
    c6{"⑥:このスキルでライバルが<br/>リタイアしたか"}:::cond
    c6 -->|"Yes"| e6["⑤の効果対象のデバフ・サゲ効果を<br/>1つ解除し、3ターンの間<br/>「勇気」状態にする"]:::effect --> a5
    c6 -->|"No"| a5["⑤実行:残りHP割合が最も低い<br/>味方2名のHPをこのスキルで行った<br/>合計アピールの20%分回復する"]:::action --> finish(("終了")):::startend
