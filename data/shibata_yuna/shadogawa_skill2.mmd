flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上か<br/>(度に積算)<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる<br/>(③の効果によるアピール倍率の<br/>最大は4800%)"]:::effect
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに7回、300%のアピールを行う"]:::action
    e3 --> a1
    a1 --> c4{"④:①の各アピールでライバルが<br/>リタイアしたか<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["①のアピール回数が1回増加する<br/>(アピールの追加回数は最大で4回まで)"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>7回(+④の追加分)すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c3
