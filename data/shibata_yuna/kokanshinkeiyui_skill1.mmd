flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール前、<br/>自身のエフォートが<br/>①のアピール対象のエフォート以上か"}:::cond
    c2 -->|"Yes"| e2["①による「執着」状態の<br/>受けるアピール倍率が2倍になり、<br/>①のアピールに自身のエフォートの<br/>6倍を固定値として上乗せする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバル1名を3ターンの間<br/>「回避率ダウン」と「執着」状態にし、<br/>3000%のアピールを行う"]:::action --> c4
    c4{"④:③の各効果前、<br/>③の効果対象がデバフ・サゲ効果状態<br/>ではないか(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["③の効果対象を2ターンの間<br/>「陽動」状態にする"]:::effect --> e3
    c4 -->|"No"| e3["③実行:味方のデバフ・サゲ効果を<br/>1つ解除する(対象ごとに実行)"]:::effect --> lc1
    lc1{"③の効果対象<br/>味方6名すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c4
    lc1 -->|"Yes"| finish(("終了")):::startend
