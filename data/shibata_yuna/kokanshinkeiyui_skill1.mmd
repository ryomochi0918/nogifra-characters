flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①の<br/>アピール対象のエフォート以上か"}:::cond
    c2 -->|"Yes"| e2["①による「執着」状態の受ける<br/>アピール倍率が2倍になり、<br/>①のアピールに自身のエフォートの<br/>6倍を固定値として上乗せする"]:::effect
    c2 -->|"No"| a1["①実行:最大アピールが最も<br/>高いライバル1名を3ターンの<br/>間「回避率ダウン」と「執着」<br/>状態にし、3000%のアピールを行う"]:::action
    e2 --> a1
    a1 --> c4{"④:③の効果対象が<br/>デバフ・サゲ効果状態ではないか<br/>(③の各効果前)"}:::cond
    c4 -->|"Yes"| e4["③の効果対象を2ターンの間「陽動」<br/>状態にする"]:::effect
    c4 -->|"No"| e3["③:味方6名のデバフ・サゲ効果を<br/>1つ解除する"]:::effect
    e4 --> e3
    e3 --> lc3{"③の効果<br/>対象6名すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の対象へ"| c4
