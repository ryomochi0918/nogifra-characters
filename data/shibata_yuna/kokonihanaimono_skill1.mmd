flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になり、<br/>①による「空腹」状態の効果倍率が<br/>1.5倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバル6名を100%の確率で<br/>2ターンの間「空腹」状態にし、<br/>400%のアピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| a3["③実行:残りHP割合が最も低い<br/>ライバルに2回、自身のサンクスの<br/>3倍を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a3 --> e4["④:味方6名を2ターンの間<br/>「アピールガード(笑顔)」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
