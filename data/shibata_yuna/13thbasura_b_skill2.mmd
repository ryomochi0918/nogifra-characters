flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:自身と自身以外の最大アピールが<br/>最も高い味方1名を2ターンの間<br/>「音響」状態にする"]:::action
    a1 --> c3{"③:自身のリフレクトが②の<br/>アピール対象のリフレクト以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピールに自身のリフレクト×<br/>自身の残りHPの10%分を<br/>固定値として上乗せ"]:::effect --> c4
    c3 -->|"No"| c4{"④:ライバルチームのフロント<br/>人数が4名以上か"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率と<br/>固定値倍率が2倍に"]:::effect --> a2
    c4 -->|"No"| a2["②実行:ライバルへ基本900%+<br/>固定値 自身のスマイル×2.5"]:::action
    a2 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"No、次の回へ"| c3
    lc2 -->|"Yes"| e5["⑤:残りHP割合が最も低い味方1名の<br/>デバフ・サゲ効果を2つ解除し、<br/>HPを②の合計アピールの50%分回復"]:::effect
    e5 --> finish(("終了")):::startend
