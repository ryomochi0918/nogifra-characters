flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のエフォートが①の<br/>各アピール対象のエフォート以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の解除数が2つ増加し、①の<br/>アピールに自身のエフォートの4倍を<br/>固定値として上乗せする"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>バフ・アゲ効果状態ではないか<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率が2.5倍になる"]:::effect
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに3回、バフ・アゲ効果を<br/>2つ解除し、400%のアピールを<br/>行う(このアピールはライバルが<br/>リタイアするまで対象を変更せず、<br/>リタイア回復が発生した場合も<br/>対象を変更しない)"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>3回すべて完了?"}:::cond
    lc1 -->|"Yes"| a4["④実行:残りHP割合が最も低い<br/>ライバル3名のバフ・アゲ効果を<br/>1つ解除し、自身のエフォートの<br/>4倍を固定値として上乗せした500%の<br/>アピールを行う"]:::action
    lc1 -->|"No、次の回へ"| c2
    a4 --> finish(("終了")):::startend
