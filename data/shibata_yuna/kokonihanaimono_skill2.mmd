flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の効果対象の<br/>サンクス以上か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバル4名に2回、<br/>バフ・アゲ効果を1つ解除し、<br/>自身のサンクスの2倍を<br/>固定値として上乗せした600%の<br/>アピールを行う(2回目以降の<br/>アピールは対象を選び直す)"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| lc1n{"①のアピール<br/>2回すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1n -->|"Yes"| e3["③:残りHP割合が最も低い味方3名の<br/>デバフ・サゲ効果を全て解除し、<br/>HPをこのスキルで行った<br/>合計アピールの40%分回復する"]:::effect
    lc1n -->|"No、次の回へ"| c2
    e3 --> finish(("終了")):::startend
