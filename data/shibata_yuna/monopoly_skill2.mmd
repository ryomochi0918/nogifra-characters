flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール対象が受けている<br/>バフ・アゲ効果状態の種類数が<br/>2種類以下か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルへ、バフ・アゲ効果を1つ解除し、<br/>自身のエフォートの2.5倍を固定値として<br/>上乗せした500%のアピール"]:::action --> e3["自身のHPを①で行った直前の<br/>アピールの30%分回復する"]:::effect --> lc1
    lc1{"①のアピール4回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしたか"}:::cond
    c4 -->|"Yes"| a4["再度①を実行(再実行は最大1回まで)"]:::action --> finish(("終了")):::startend
    c4 -->|"No"| finish
