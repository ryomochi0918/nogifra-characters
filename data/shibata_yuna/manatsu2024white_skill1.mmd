flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のサンクスが①の<br/>アピール対象のサンクス以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| c3{"③:②の発動条件を満たした状態で<br/>②の効果対象が「弱音」状態か<br/>(②の各効果前)"}:::cond
    c2 -->|"No"| a1["①実行:フィジカルが最も高い<br/>ライバル5名に600%のアピールを行う"]:::action
    c3 -->|"Yes"| e3["②による「弱音」状態を「緊張」<br/>状態に変更する"]:::effect
    c3 -->|"No"| e2["①のアピール対象を100%の確率で<br/>2ターンの間「弱音」状態にする"]:::effect
    e3 --> e2
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の対象へ"| c2
