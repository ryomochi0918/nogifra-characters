flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>デバフ耐性貫通を+30%する"]:::effect --> c3
    c3{"③:自身のスマイルが②のアピール<br/>対象のスマイル以上か"}:::cond
    c3 -->|"Yes"| e3["②の対象を100%の確率で2ターンの間<br/>「命中率ダウン」状態にする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル5名へ850%のアピール"]:::action --> c5
    c5{"⑤:ライバルチームのフロントに居る<br/>「命中率ダウン」状態のメンバーが<br/>3名以下か"}:::cond
    c5 -->|"Yes"| e5["④の効果対象が1名増加し、④の<br/>「回避率アップ」状態の効果倍率が<br/>1.5倍になる"]:::effect --> a4
    c5 -->|"No"| a4["④実行:自身と自身以外の残りHP割合が<br/>最も低い味方1名(⑤成立時は2名)を<br/>3ターンの間「回避率アップ」状態にする"]:::action --> finish(("終了")):::startend
