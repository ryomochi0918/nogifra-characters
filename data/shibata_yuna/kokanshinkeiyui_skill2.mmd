flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①の各アピール前、<br/>①のアピール対象の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の最大アピールの<br/>20%を固定値として上乗せする"]:::effect --> c3
    c2 -->|"No"| c3{"③:①の各アピール前、<br/>①のアピール対象が受けている<br/>デバフ・サゲ効果状態が3種類以上か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a1
    c3 -->|"No"| a1["①実行:ライバルへ、<br/>アピール対象のHP上限0.7%分を<br/>固定値として上乗せした<br/>600%のアピールを行う"]:::action --> lc1
    lc1{"①のアピール3回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c4{"④:①のアピールで<br/>ライバルがリタイアしなかったか"}:::cond
    c4 -->|"Yes"| a4["再度①を実行する<br/>(再実行は最大1回まで)"]:::action --> e5
    c4 -->|"No"| e5["⑤:残りHP割合が最も低い味方1名の<br/>HPをこのスキルで行った<br/>合計アピールの20%分回復する"]:::effect --> finish(("終了")):::startend
