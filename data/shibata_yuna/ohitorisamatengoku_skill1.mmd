flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:ライバルチームのフロント<br/>人数が4名以下か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルへ、自身のスマイルの2倍を<br/>固定値として上乗せした<br/>400%のアピール"]:::action --> e3["自身のHPを①の直前のアピールの<br/>30%分回復する"]:::effect --> lc1
    lc1{"①のアピール5回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c4{"④:ライバルチームのフロント<br/>人数が2名以下か"}:::cond
    c4 -->|"Yes"| c5{"⑤:ライバルチームのフロント<br/>人数が1名か"}:::cond
    c5 -->|"Yes"| e5["④のアピール倍率と固定値倍率が<br/>4倍になる"]:::effect --> a4
    c5 -->|"No"| a4["ライバル2名へ自身のスマイルの3倍を<br/>固定値として上乗せした<br/>1000%のアピール"]:::action --> finish(("終了")):::startend
    c4 -->|"No"| finish
