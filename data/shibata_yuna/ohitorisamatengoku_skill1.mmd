flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:ライバルチームの<br/>フロント人数が4名以下か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに5回、自身のスマイルの<br/>2倍を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> e3["③:自身のHPを①で行った直前の<br/>アピールの30%分回復する<br/>(①の各アピール後)"]:::effect
    e3 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:ライバルチームの<br/>フロント人数が2名以下か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes"| c5{"⑤:ライバルチームの<br/>フロント人数が1名か"}:::cond
    c4 -->|"No"| finish(("終了")):::startend
    c5 -->|"Yes"| e5["④のアピール倍率と<br/>固定値倍率が4倍になる"]:::effect
    c5 -->|"No"| a4["④実行:ライバル2名に自身のスマイルの<br/>3倍を固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    e5 --> a4
    a4 --> finish
