flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル4名に800%の<br/>アピールを行う"]:::action
    a1 --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール後)"}:::cond
    c2 -->|"Yes"| e2["対象を100%の確率で1ターンの間<br/>「落胆」状態にする"]:::effect
    c2 -->|"No"| lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    e2 --> lc1
    lc1 -->|"Yes"| a3["③実行:ライバルに3回、<br/>自身の最大アピールの30%を<br/>固定値として上乗せした330%の<br/>アピールを行う(「落胆」状態ではない<br/>ライバルを優先的に選択する)"]:::action
    lc1 -->|"No、次の対象へ"| a1
    a3 --> e4["④:自身と自身以外の残りHP割合が<br/>最も低い味方1名のHPをこのスキルで<br/>行った合計アピールの40%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
