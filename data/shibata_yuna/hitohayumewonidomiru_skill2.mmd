flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル4名へ<br/>800%のアピール"]:::action --> c2
    c2{"②:①のアピール対象がデバフ・サゲ<br/>効果状態か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["該当対象を100%の確率で<br/>1ターンの間「落胆」状態にする"]:::effect --> a3
    c2 -->|"No"| a3["③実行:ライバルへ3回、自身の<br/>最大アピールの30%を固定値として<br/>上乗せした330%のアピール<br/>(「落胆」状態ではないライバルを<br/>優先的に選択)"]:::action --> a4["④実行:自身と自身以外の残りHP割合が<br/>最も低い味方1名のHPをこのスキルで<br/>行った合計アピールの40%分<br/>回復する"]:::action --> finish(("終了")):::startend
