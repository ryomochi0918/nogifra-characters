flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:自身を2ターンの間<br/>「命中率アップ」状態にする"]:::action --> c3
    c3{"③:自身の残りHP割合が②のアピール<br/>対象の残りHP割合以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が3倍になる"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身のサンクスが②のアピール<br/>対象のサンクス以上か"}:::cond
    c4 -->|"Yes"| e4["②の対象のバフ・アゲ効果を1つ解除し、<br/>②のアピール倍率が2倍になる"]:::effect --> a2
    c4 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルへ340%のアピール"]:::action --> c5
    c5{"⑤:このスキル中に1度でもアピールの<br/>失敗または0が発生したか"}:::cond
    c5 -->|"Yes"| e5["このスキル中、自身の<br/>命中率を+30%する"]:::effect --> lc1
    c5 -->|"No"| lc1{"②のアピール6回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c3
    lc1 -->|"Yes"| finish(("終了")):::startend
