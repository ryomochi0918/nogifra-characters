flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を2ターンの間<br/>「命中率アップ」状態にする"]:::effect
    e1 --> c3{"③:自身の残りHP割合が<br/>②のアピール対象の<br/>残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が3倍になる"]:::effect
    c3 -->|"No"| c4{"④:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール対象のバフ・アゲ効果を<br/>1つ解除し、②のアピール倍率が<br/>2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルに6回、340%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> c5{"⑤:このスキル中に1度でも<br/>アピールの失敗または<br/>アピールが0だったか"}:::cond
    c5 -->|"Yes"| e5["このスキル中、自身の<br/>命中率を+30%する"]:::effect
    c5 -->|"No"| lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    e5 --> lc2
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
