flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中のみ自身の<br/>命中率を+20%する"]:::effect --> c3
    c3{"③:自身の残りHP割合が②のアピール<br/>対象の残りHP割合以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> c4
    c3 -->|"No"| c4{"④:ライバルチームのフロント<br/>人数が3名以下か"}:::cond
    c4 -->|"Yes"| e4["②の各アピール中のみ①による<br/>命中率の増加倍率が2倍になる"]:::effect --> a2
    c4 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルへ、自身の最大アピールの<br/>25%を固定値として上乗せした<br/>400%のアピール"]:::action --> lc1
    lc1{"②のアピール5回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c3
    lc1 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>味方2名のHPを②で行った合計<br/>アピールの30%分回復する"]:::action --> c6
    c6{"⑥:このスキルによってライバルが<br/>リタイアしなかったか"}:::cond
    c6 -->|"Yes"| a6["再度②からスキルを実行する<br/>(再実行は最大1回まで)"]:::action --> finish(("終了")):::startend
    c6 -->|"No"| finish
