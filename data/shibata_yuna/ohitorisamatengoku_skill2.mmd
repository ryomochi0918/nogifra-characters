flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中のみ自身の<br/>命中率を+20%する"]:::effect
    e1 --> c3{"③:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:ライバルチームの<br/>フロント人数が3名以下か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②の各アピール中のみ①による<br/>命中率の増加倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルに5回、自身の最大アピールの<br/>25%を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"Yes"| e5["⑤:残りHP割合が最も低い味方2名の<br/>HPを②で行った合計アピールの<br/>30%分回復する"]:::effect
    lc2 -->|"No、次の回へ"| c3
    e5 --> c6{"⑥:このスキルによってライバルが<br/>リタイアしなかったか"}:::cond
    c6 -->|"Yes(再実行は最大1回まで)"| c3
    c6 -->|"No"| finish(("終了")):::startend
