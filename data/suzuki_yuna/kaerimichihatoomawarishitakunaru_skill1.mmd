flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間「機敏」状態にし、<br/>このスキル中、自身の<br/>リフレクト耐性を+25%する"]:::effect
    e1 --> c3

    c3{"③:自身のエフォートが②のアピール対象の<br/>エフォート以上か<br/>(対象ごとに判定)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身の「躍動」状態のターン数が<br/>8ターン以上か"}:::cond

    c4 -->|"Yes"| e4["②の各アピール中のみ<br/>自身の命中率と会心率を+25%する"]:::effect --> c5
    c4 -->|"No"| c5{"⑤:②のアピール対象の残りHP割合が<br/>50%未満か<br/>(対象ごとに判定)"}:::cond

    c5 -->|"Yes"| e5["②のアピールにアピール対象の<br/>HP減少分の8%を固定値として上乗せする<br/>(固定値の上乗せは<br/>自身の最大アピールの600%まで)"]:::effect --> a2
    c5 -->|"No"| a2["②実行:<br/>ライバルへ基本500%+<br/>固定値 自身のエフォート×4.5のアピール"]:::action

    a2 --> lc{"②のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| c6{"⑥:②のアピールで<br/>ライバルがリタイアしたか"}:::cond

    c6 -->|"Yes"| a6["⑥実行:<br/>最大アピールが最も高いライバル1名へ、<br/>②で行った合計アピールの40%分のアピール<br/>(ディフェンス、フィジカルを無視する)"]:::action --> a7
    c6 -->|"No"| a7["⑦実行(条件を満たさない場合でも発動):<br/>自身のHPをこのスキルで行った<br/>合計アピールの20%分回復する"]:::effect

    a7 --> finish(("終了")):::startend
