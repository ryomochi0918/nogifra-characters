flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間「機敏」<br/>状態にし、このスキル中、自身の<br/>リフレクト耐性を+25%する"]:::effect
    e1 --> c3{"③:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:自身の「躍動」状態のターン数が<br/>8ターン以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②の各アピール中のみ自身の<br/>命中率と会心率を+25%する"]:::effect
    c4 -->|"No"| c5{"⑤:②のアピール対象の<br/>残りHP割合が50%未満か<br/>(②の各アピール前)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["②のアピールにアピール対象の<br/>HP減少分の8%を固定値として上乗せする<br/>(固定値の上乗せは自身の<br/>最大アピールの600%まで)"]:::effect
    c5 -->|"No"| a2["②実行:ライバルに6回、<br/>自身のエフォートの4.5倍を<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e5 --> a2
    a2 --> lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    lc2 -->|"Yes"| c6{"⑥:②のアピールでライバルが<br/>リタイアしたか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c6 -->|"Yes"| a6["⑥実行:最大アピールが<br/>最も高いライバル1名に②で<br/>行った合計アピールの40%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c6 -->|"No"| e7["⑦:自身のHPをこのスキルで行った<br/>合計アピールの20%分回復する"]:::effect
    a6 --> e7
    e7 --> finish(("終了")):::startend
