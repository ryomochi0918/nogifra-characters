flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の命中率を<br/>「自身が受けているバフ・アゲ効果の<br/>種類数×10%」分増加する<br/>(増加上限は30%まで)"]:::effect --> c3
    c3{"③:自身の残りHP割合が②のアピール<br/>対象の残りHP割合以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルへ500%のアピール"]:::action --> c4
    c4{"④:②のアピールでライバルが<br/>リタイアしたか"}:::cond
    c4 -->|"Yes"| e4["②のアピール回数が1回増加する<br/>(追加回数は最大3回まで)"]:::effect --> lc1
    c4 -->|"No"| lc1{"②のアピールが全て完了?<br/>(基本4回、④で最大+3回)"}:::cond
    lc1 -->|"No、次の回へ"| c3
    lc1 -->|"Yes"| finish(("終了")):::startend
