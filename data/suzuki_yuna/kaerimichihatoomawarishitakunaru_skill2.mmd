flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+30%する"]:::effect
    e1 --> c3{"③:ライブ中に自身のスキル2<br/>「お利口なガール」が<br/>2回以上発動したか<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:自身の「躍動」状態のターン数が<br/>7ターン以上か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピールに自身のエフォートの<br/>5倍を固定値として上乗せする"]:::effect
    c4 -->|"No"| a2["②実行:ライバルに4回、<br/>アピール対象のHP上限0.8%分を<br/>固定値として上乗せした800%の<br/>アピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"Yes"| c5{"⑤:ライバルチームの<br/>フロント人数が3名以下か"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバル2名に2回、自身のエフォートの<br/>4倍を固定値として上乗せした700%の<br/>アピールを行う"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
