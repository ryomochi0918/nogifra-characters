flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身の命中率を+30%する"]:::effect
    e1 --> c3

    c3{"③:ライブ中に自身のスキル2<br/>「お利口なガール」が2回以上発動したか"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身の「躍動」状態のターン数が<br/>7ターン以上か"}:::cond

    c4 -->|"Yes"| e4["②のアピールに<br/>自身のエフォートの5倍を<br/>固定値として上乗せする"]:::effect --> a2
    c4 -->|"No"| a2["②実行:<br/>ライバルへ基本800%+<br/>固定値 アピール対象のHP上限0.8%分の<br/>アピール"]:::action

    a2 --> lc{"②のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c3
    lc -->|"Yes"| c5{"⑤:ライバルチームの<br/>フロント人数が3名以下か"}:::cond

    c5 -->|"Yes"| a5["⑤実行:<br/>残りHP割合が最も低いライバル2名へ2回、<br/>基本700%+固定値 自身のエフォート×4の<br/>アピール"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
