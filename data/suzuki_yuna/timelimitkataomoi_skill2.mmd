flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに5回、自身の残りSPの<br/>20倍を固定値として上乗せした450%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c3{"③:①のアピールでライバルが<br/>リタイアしたか<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["残りHP割合が最も低い味方1名の<br/>デバフ・サゲ効果を2つ解除する"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| e4["④:最大アピールが最も高い味方2名の<br/>デバフ・サゲ効果を全て解除し、<br/>3ターンの間「夢中」状態にし、<br/>HPを①で行った合計アピールの<br/>40%分回復する"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e4 --> finish(("終了")):::startend
