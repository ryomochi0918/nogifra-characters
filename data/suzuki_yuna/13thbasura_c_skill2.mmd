flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e3["③:このスキル中、自身の命中率を<br/>「①でアピール失敗/0だった回数×15%」<br/>上昇させる(上限+60%)"]:::effect
    e3 --> c2a{"②:①のアピール対象が受けている<br/>デバフ・サゲ効果状態が<br/>2種類以上か"}:::cond
    c2a -->|"Yes"| e2a["①のアピール倍率と<br/>固定値倍率が2倍に"]:::effect --> c2b{"②:デバフ・サゲ効果状態が<br/>3種類以上か"}:::cond
    c2a -->|"No"| a1
    c2b -->|"Yes"| e2b["対象を100%の確率で2ターンの間<br/>「ディフェンスダウン」状態にし、<br/>倍率がさらに2倍に(上限3000%)"]:::effect --> a1
    c2b -->|"No"| a1["①実行:ライバルへ基本750%+<br/>固定値 自身のサンクス×3.5"]:::action
    a1 --> lc1{"①のアピール<br/>7回すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2a
    lc1 -->|"Yes"| c4{"④:味方チームのフロント人数が<br/>ライバルチームのフロント人数以上か"}:::cond
    c4 -->|"Yes(再実行、最大1回まで)"| c2a
    c4 -->|"No"| finish(("終了")):::startend
