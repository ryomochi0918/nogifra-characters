flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を2ターンの間「情熱」<br/>状態にする"]:::effect
    e1 --> a2["②実行:ライバル4名に600%の<br/>アピールを行う"]:::action
    a2 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上だった<br/>回数が2回以上または②のアピールで<br/>②のアピール対象がリタイアしたか"}:::cond
    c3 -->|"Yes"| e3["自身を3ターンの間「熱意」<br/>状態にする"]:::effect
    c3 -->|"No"| a4["④実行:残りHP割合が最も高い<br/>ライバル4名に600%のアピールを行う"]:::action
    e3 --> a4
    a4 --> e5["⑤:自身を3ターンの間「熱意」<br/>状態にする"]:::effect
    e5 --> finish(("終了")):::startend
