flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>70%未満か"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の<br/>減少したHPの20%を<br/>固定値として上乗せする"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>バフ・アゲ効果状態ではない、<br/>または特殊状態か"}:::cond
    c3 -->|"Yes"| e3["①のアピール対象を100%の確率で<br/>2ターンの間「空腹」状態にする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>残りHP割合が最も高いライバル4名の<br/>バフ・アゲ効果を1つ解除し、発動回数×1000%を<br/>上乗せした100%のアピール"]:::action
    a1 --> c5{"⑤:自身の残りHP割合が<br/>70%以上か"}:::cond
    c5 -->|"Yes"| e5["④の各アピール中のみ<br/>自身の会心率を+30%する"]:::effect --> a4
    c5 -->|"No"| a4["④実行:<br/>残りHP割合が最も低いライバルへ3回、<br/>自身の減少したHPの50%を固定値として<br/>上乗せした800~1600%のアピール<br/>(残りHP割合が低いほど倍率上昇)"]:::action
    a4 --> c6{"⑥:このスキルで<br/>ライバルがリタイアしたか"}:::cond
    c6 -->|"Yes"| e6["自身と自身以外の残りHP割合が最も低い味方1名の<br/>デバフ・サゲ効果を2つ解除し、<br/>HPを合計アピールの25%分回復する"]:::effect --> finish(("終了")):::startend
    c6 -->|"No"| finish
