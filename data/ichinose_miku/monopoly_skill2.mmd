flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が70%未満か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の減少したHPの<br/>20%を固定値として上乗せする"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>バフ・アゲ効果状態ではないまたは<br/>特殊状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール対象を100%の確率で<br/>2ターンの間「空腹」状態にする"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル4名のバフ・アゲ効果を<br/>1つ解除し、ライブ中に発動した<br/>自身のスキル2「横綱からの檄。」の<br/>回数×1000%の倍率を上乗せした100%の<br/>アピールを行う(初回スキル発動時の<br/>①による倍率は1100%となる)"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:自身の残りHP割合が70%以上か<br/>(④の各アピール前)"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c5 -->|"Yes"| e5["④の各アピール中のみ自身の<br/>会心率を+30%する"]:::effect
    c5 -->|"No"| a4["④実行:残りHP割合が最も低いライバルに<br/>3回、自身の減少したHPの50%を<br/>固定値として上乗せした800~1600%の<br/>アピールを行う(自身の残りHP割合が<br/>低いほど倍率が高くなる)"]:::action
    e5 --> a4
    a4 --> lc4{"④のアピール<br/>3回すべて完了?"}:::cond
    lc4 -->|"Yes"| c6{"⑥:このスキルでライバルが<br/>リタイアしたか"}:::cond
    lc4 -->|"No、次の回へ"| c5
    c6 -->|"Yes"| e6["自身と自身以外の残りHP割合が最も<br/>低い味方1名のデバフ・サゲ効果を<br/>2つ解除し、HPをこのスキルで行った<br/>合計アピールの25%分回復する"]:::effect
    c6 -->|"No"| finish(("終了")):::startend
    e6 --> finish
