flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>①のアピール対象の残りHP割合<br/>以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍に"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバルへ、自身の残りHPの12%を<br/>固定値として上乗せした620%のアピール"]:::action
    a1 --> lc{"①のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| a3["③実行:<br/>ライバル1名へ<br/>①で行った合計アピールの40%分<br/>(ディフェンス・フィジカル無視、必ず命中)"]:::action
    a3 --> c4{"④:味方フロントの「根性」状態の<br/>合計ターン数が9ターン以上か<br/>(かつ再実行がまだの場合)"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| a3
    c4 -->|"No"| finish(("終了")):::startend
