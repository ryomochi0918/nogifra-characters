flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%し、自身を<br/>4ターンの間「勇気」状態にする"]:::effect
    e1 --> c3{"③:自身に「勇気」状態があるか<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに6回、<br/>自身のスマイルの3倍を<br/>固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    lc2 -->|"Yes"| e4["④:自身と自身以外の残りHP割合が<br/>最も低い味方2名のHPをこのスキルで<br/>行った合計アピールの50%分回復する"]:::effect
    lc2 -->|"No、次の回へ"| c3
    e4 --> finish(("終了")):::startend
