flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身のリフレクト耐性を+30%し、<br/>自身を4ターンの間「勇気」状態にする"]:::effect
    e1 --> c3{"③:自身に「勇気」状態が<br/>あるか"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が1.5倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>ライバルへ、自身のスマイルの3倍を<br/>固定値として上乗せした400%のアピール"]:::action
    a2 --> lc{"②のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c3
    lc -->|"Yes"| e4["④実行:<br/>自身と自身以外の残りHP割合が最も低い味方2名の<br/>HPをこのスキルで行った合計アピールの50%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
