flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>70%未満に1度でもなったか"}:::cond
    c2 -->|"Yes"| e2["このスキル中、自身の会心率を+30%、<br/>会心アピールを+70%、<br/>リフレクト耐性を+50%する"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身の残りHP割合が<br/>50%未満か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>ライバル5名へ、自身の最大アピールの20%を<br/>固定値として上乗せした600%のアピール"]:::action
    a1 --> c5{"⑤:自身の残りHP割合が<br/>50%未満か"}:::cond
    c5 -->|"Yes"| e5["④による「遮音」状態の<br/>受けるアピールの低下倍率が2倍になる"]:::effect --> e4
    c5 -->|"No"| e4["④実行:<br/>自身を4ターンの間<br/>「遮音」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
