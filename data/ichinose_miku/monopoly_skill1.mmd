flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が70%未満に<br/>1度でもなったか<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["このスキル中、自身の会心率を+30%、<br/>会心アピールを+70%、<br/>リフレクト耐性を+50%する"]:::effect
    c2 -->|"No"| c3{"③:自身の残りHP割合が50%未満か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:ライバル5名に<br/>自身の最大アピールの20%を<br/>固定値として上乗せした600%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:自身の残りHP割合が50%未満か"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c5 -->|"Yes"| e5["④による「遮音」状態の受ける<br/>アピールの低下倍率が2倍になる"]:::effect
    c5 -->|"No"| e4["④:自身を4ターンの間「遮音」<br/>状態にする"]:::effect
    e5 --> e4
    e4 --> finish(("終了")):::startend
