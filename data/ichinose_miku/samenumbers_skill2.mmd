flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身が「情熱」状態か"}:::cond
    c1 -->|"Yes"| e1["このスキル中、自身の<br/>命中率を+30%する"]:::effect
    c1 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバルに5回、350%のアピールを行う"]:::action
    e1 --> a2
    a2 --> e3["③:このスキル中、自身の<br/>会心率を+30%する"]:::effect
    e3 --> a4["④実行:②のアピール倍率を2倍にして<br/>再度②を実行する<br/>(再実行は最大1回まで)"]:::action
    a4 --> c5{"⑤:このスキル中にアピールの失敗または<br/>アピールが0である事が3回以上発生したか"}:::cond
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も高い<br/>ライバル1名に1000%のアピールを行う"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
