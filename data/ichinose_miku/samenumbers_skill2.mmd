flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c1{"①:自身が「情熱」状態か"}:::cond
    c1 -->|"Yes"| e1["このスキル中、<br/>自身の命中率を+30%する"]:::effect --> a2
    c1 -->|"No"| a2["②実行:<br/>残りHP割合が最も高いライバルに5回、<br/>350%のアピールを行う"]:::action
    a2 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"No、次の回へ"| a2
    lc2 -->|"Yes"| e3["③:このスキル中、<br/>自身の会心率を+30%する"]:::effect
    e3 --> a4["④実行:<br/>②のアピール倍率を2倍にして再度②を実行<br/>(再実行は最大1回まで)"]:::action
    a4 --> lc4{"④で再度実行した②のアピール<br/>5回すべて完了?"}:::cond
    lc4 -->|"No、次の回へ"| a4
    lc4 -->|"Yes"| c5{"⑤:このスキル中にアピールの失敗または<br/>アピールが0である事が<br/>3回以上発生したか"}:::cond
    c5 -->|"Yes"| a5["⑤実行:<br/>残りHP割合が最も高いライバル1名に<br/>1000%のアピールを行う"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
