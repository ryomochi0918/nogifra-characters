flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身のサゲ効果耐性貫通を+20%する"]:::effect
    e1 --> a2["②実行:<br/>ライバル5名へ800%のアピールを行い、<br/>100%の確率で3ターンの間「混乱」状態にする"]:::action
    a2 --> c3{"③:②のアピール対象の<br/>残りHP割合が75%未満か"}:::cond
    c3 -->|"Yes"| e3["②の各アピール対象を100%の確率で<br/>3ターンの間「嫉妬」状態にする"]:::effect --> c4
    c3 -->|"No"| c4{"④:味方がフロントに<br/>3名以上居るか"}:::cond
    c4 -->|"Yes"| e4["最大アピールが最も高いライバル1名を<br/>100%の確率で3ターンの間<br/>「執着」状態にする"]:::effect --> finish(("終了")):::startend
    c4 -->|"No"| finish
