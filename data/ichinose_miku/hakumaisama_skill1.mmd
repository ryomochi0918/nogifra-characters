flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+70%、<br/>会心アピールを+30%する"]:::effect
    e1 --> e2["②:最大アピールが最も高い<br/>ライバル1名のバフ・アゲ効果を<br/>全て解除する"]:::effect
    e2 --> a3["③実行:<br/>②の効果対象へ、自身の最大アピール力の70%を<br/>固定値として上乗せした1200%のアピール"]:::action
    a3 --> c4{"④:対象がリタイアせず<br/>③のアピールが会心アピールだったか"}:::cond
    c4 -->|"Yes(再実行は最大4回まで)"| a3
    c4 -->|"No"| c5{"⑤:③の対象が<br/>リタイアしたか"}:::cond
    c5 -->|"Yes"| a5["ライバル5名のバフ・アゲ効果を<br/>1つ解除し、550%のアピールを行う"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
