flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+70%、<br/>会心アピールを+30%する"]:::effect
    e1 --> e2["②:最大アピールが最も高い<br/>ライバル1名のバフ・アゲ効果を<br/>全て解除する"]:::effect
    e2 --> a3["③実行:②の効果対象に<br/>自身の最大アピール力の70%を<br/>固定値として上乗せした1200%の<br/>アピールを行う"]:::action
    a3 --> c4{"④:③の対象がリタイアせず③の<br/>アピールが会心アピールだったか"}:::cond
    c4 -->|"Yes(再実行は最大4回まで)"| a3
    c4 -->|"No"| c5{"⑤:③の対象がリタイアしたか"}:::cond
    c5 -->|"Yes"| a5["⑤実行:ライバル5名のバフ・アゲ効果を<br/>1つ解除し、550%のアピールを行う"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
