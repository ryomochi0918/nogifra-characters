flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の命中率と<br/>デバフ耐性貫通を+30%する"]:::effect
    e1 --> c3{"③:自身のスマイルが②の<br/>アピール対象のスマイル以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル3名を100%の確率で<br/>2ターンの間「ディフェンスダウン」<br/>状態にし、自身の残りSPの70倍を<br/>固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc2 -->|"Yes"| c4{"④:②のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c4 -->|"Yes(再実行は最大1回まで)"| c3
    c4 -->|"No"| e5["⑤:残りHP割合が最も低い味方4名の<br/>HPを②で行った合計アピールの<br/>25%分回復し、3ターンの間「勇気」<br/>状態にする"]:::effect
    e5 --> finish(("終了")):::startend
