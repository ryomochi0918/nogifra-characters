flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の命中率と<br/>デバフ耐性貫通を+30%する"]:::effect
    e1 --> c3{"③:自身のスマイルが<br/>②のアピール対象のスマイル<br/>以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール対象の<br/>バフ・アゲ効果を1つ解除する"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>残りHP割合が最も高いライバル3名へ、<br/>100%の確率で2ターンの間「ディフェンスダウン」状態にし、<br/>自身の残りSPの70倍を固定値として<br/>上乗せした1000%のアピール"]:::action
    a2 --> c4{"④:②のアピールで<br/>ライバルがリタイアしなかったか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| a2
    c4 -->|"No(リタイアした)"| e5["⑤実行:<br/>残りHP割合が最も低い味方4名のHPを<br/>②で行った合計アピールの25%分回復し、<br/>3ターンの間「勇気」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
