flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を1ターンの間「強運」<br/>状態にし、このスキル中、自身の<br/>命中率を+20%する"]:::effect
    e1 --> c3{"③:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバル4名に<br/>自身のエフォートの3.5倍を<br/>固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| e4["④:自身のHPを②で行った<br/>合計アピールの15%分回復する"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e4 --> a5["⑤実行:残りHP割合が最も<br/>低いライバル1名に②で<br/>行った合計アピールの50%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    a5 --> e6["⑥:自身の「強運」状態を解除し、<br/>自身を2ターンの間「情熱」<br/>状態にする"]:::effect
    e6 --> finish(("終了")):::startend
