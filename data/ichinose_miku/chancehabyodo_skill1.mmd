flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を2ターンの間「倍音」<br/>状態にする"]:::effect
    e1 --> c3{"③:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と固定値倍率を<br/>2倍にし、②の各アピール中のみ自身の<br/>デバフ耐性貫通を+20%する"]:::effect
    c3 -->|"No"| c4{"④:②のアピール対象が<br/>「ディフェンスダウン」状態か<br/>(②の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②による「ディフェンスダウン」<br/>状態の効果倍率が1.5倍になる"]:::effect
    c4 -->|"No"| a2["②実行:ライバル2名に3回、<br/>100%の確率で2ターンの間<br/>「ディフェンスダウン」状態にし、<br/>自身のエフォートの2倍を<br/>固定値として上乗せした400%の<br/>アピールを行う(2回目以降の<br/>アピールは対象を選び直す)"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc2 -->|"Yes"| lc2n{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2n -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバルに4回、②のアピールで<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc2n -->|"No、次の回へ"| c3
    a5 --> finish(("終了")):::startend
