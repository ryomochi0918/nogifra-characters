flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:味方5名を2ターンの間<br/>「アピールブースト(感謝)」<br/>状態にする"]:::effect
    e1 --> c3{"③:②の効果対象の<br/>残りHP割合が50%以上か<br/>(②の各効果前)"}:::cond
    c3 -->|"Yes"| e3["②による「アピール力アップ」状態の<br/>アピール力増加倍率が1.5倍になる"]:::effect
    c3 -->|"No"| e2["②:最大アピールが最も高い味方2名を<br/>2ターンの間「アピール力アップ」<br/>状態にする"]:::effect
    e3 --> e2
    e2 --> c4{"④:②の効果対象の<br/>残りHP割合が50%未満か<br/>(②の各効果後)"}:::cond
    c4 -->|"Yes"| e4["②の効果対象のHPを自身の<br/>アピール力の80%分回復する(会心率に<br/>応じて会心回復が発生)"]:::effect
    c4 -->|"No"| lc2{"②の効果<br/>対象2名すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| e5["⑤:最大アピールが最も高い味方1名が<br/>受けているバフ・アゲ効果状態の<br/>種類数を対象人数としてライバルの<br/>バフ・アゲ効果を1つ解除する<br/>(最大で6名まで)"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e5 --> finish(("終了")):::startend
