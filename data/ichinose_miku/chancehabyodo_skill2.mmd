flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+30%する"]:::effect
    e1 --> c4{"④:自身の残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率を2倍にする"]:::effect
    c4 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル4名に800%のアピールを行う"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| c4_2{"④:自身の残りHP割合が50%以上か<br/>(③の各アピール前)"}:::cond
    lc2 -->|"No、次の対象へ"| c4
    c4_2 -->|"Yes"| e4_2["③のアピール倍率を2倍にする"]:::effect
    c4_2 -->|"No"| a3["③実行:最大アピールが最も高い<br/>ライバル2名に1200%のアピールを行う"]:::action
    e4_2 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル2名すべて完了?"}:::cond
    lc3 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバルに2回、このスキルで<br/>行った合計アピールの50%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc3 -->|"No、次の対象へ"| c4_2
    a5 --> finish(("終了")):::startend
