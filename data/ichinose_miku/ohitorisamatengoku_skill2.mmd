flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①の各アピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:デバフ・サゲ効果状態の種類数が<br/>2種類以上のライバルを1度でも①の<br/>アピール対象に選んだか<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["このスキル中、自身の命中率を+30%する"]:::effect
    c3 -->|"No"| a1["①実行:ライバルに4回、<br/>アピール対象のHP上限1%分の固定値を<br/>上乗せした600%のアピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>4回すべて完了?"}:::cond
    lc1 -->|"Yes"| e4["④:残りHP割合が最も低い味方3名の<br/>デバフ・サゲ効果を2つ解除し、<br/>HPを①で行った合計アピールの<br/>30%分回復する"]:::effect
    lc1 -->|"No、次の回へ"| c2
    e4 --> finish(("終了")):::startend
