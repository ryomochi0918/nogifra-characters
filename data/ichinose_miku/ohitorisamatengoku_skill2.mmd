flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:デバフ・サゲ効果状態の種類数が<br/>2種類以上のライバルを<br/>1度でも対象に選んだか"}:::cond
    c3 -->|"Yes"| e3["このスキル中、<br/>自身の命中率を+30%する"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>ライバルへ、アピール対象のHP上限1%分の<br/>固定値を上乗せした600%のアピール"]:::action
    a1 --> lc{"①のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| e4["④実行:<br/>残りHP割合が最も低い味方3名の<br/>デバフ・サゲ効果を2つ解除し、<br/>HPを①で行った合計アピールの30%分回復する"]:::effect
    e4 --> finish(("終了")):::startend
