flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> target["①:最大アピールが最も高いライバルを<br/>対象に6回アピールする"]:::action
    target --> c2{"②:①の各アピール前<br/>自身がバフ・アゲ効果状態か"}:::cond
    c2 -->|"Yes"| e2["②:①の各アピール中のみ<br/>自身の会心率と命中率を+30%する"]:::effect
    c2 -->|"No"| c3
    e2 --> c3{"③:①の各アピール前<br/>①のアピール対象が受けている<br/>特殊状態の種類数が2種類以上か"}:::cond
    c3 -->|"Yes"| e3["③:①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a1
    e3 --> a1["①:自身の最大アピールの20%を<br/>固定値として上乗せした<br/>530%のアピールを行う"]:::action
    a1 --> cloop{"①のアピール6回すべて完了?"}:::cond
    cloop -->|"No、次の回へ"| c2
    cloop -->|"Yes"| c4{"④:①のアピールが全て終了後<br/>①のアピールでリタイアした<br/>ライバルが1名以下か"}:::cond
    c4 -->|"Yes"| a4["④:残りHP割合が最も低いライバル1名に<br/>①で行った合計アピールの<br/>30%分のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action
    c4 -->|"No"| finish
    a4 --> c5{"⑤:④のアピール後<br/>特殊状態のライバルが<br/>フロントに3名以上居るか"}:::cond
    c5 -->|"Yes"| e5["⑤:自身を4ターンの間<br/>「円陣」状態にする<br/>(※円陣:アピール力が30%上昇し<br/>すべてのデバフ・サゲ効果耐性を+60%し<br/>受けるアピールが40%低下する)"]:::effect
    c5 -->|"No"| finish
    e5 --> finish(("終了")):::startend
