flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ自身の<br/>会心率と命中率を+30%する"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が受けている<br/>特殊状態の種類数が2種類以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバルに6回、自身の最大アピールの<br/>20%を固定値として上乗せした530%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールでリタイアした<br/>ライバルが1名以下か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes"| a4["④実行:残りHP割合が最も<br/>低いライバル1名に①で<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c4 -->|"No"| c5{"⑤:特殊状態のライバルがフロントに<br/>3名以上居るか"}:::cond
    a4 --> c5
    c5 -->|"Yes"| e5["自身を4ターンの間「円陣」<br/>状態にする"]:::effect
    c5 -->|"No"| finish(("終了")):::startend
    e5 --> finish
