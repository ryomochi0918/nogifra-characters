flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②/③:①の効果対象の<br/>残りHP割合が50%以上か<br/>(①の各効果前)"}:::cond
    c2 -->|"Yes"| e2["②:①による「堅忍」状態の<br/>効果倍率が2倍になる"]:::effect
    c2 -->|"No"| e3["③:①による回復倍率が2倍になる"]:::effect
    e2 --> e1["①:残りHP割合が最も低い味方3名を<br/>3ターンの間「堅忍」状態にし、HPを<br/>自身のアピール力の50%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect
    e3 --> e1
    e1 --> lc1{"①の効果<br/>対象3名すべて完了?"}:::cond
    lc1 -->|"Yes"| a4["④実行:残りHP割合が最も高い<br/>ライバル2名を100%の確率で<br/>3ターンの間「混乱」状態にし、<br/>1500%のアピールを行う"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a4 --> finish(("終了")):::startend
