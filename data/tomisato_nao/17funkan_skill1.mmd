flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:最大アピールが最も高い味方4名を<br/>2ターンの間「強運」状態にする"]:::effect
    e1 --> c3{"③:②の効果対象が<br/>「強運」状態か"}:::cond
    c3 -->|"Yes"| e3["②による「威圧」状態の<br/>ディフェンス増加倍率が1.5倍になる"]:::effect --> e2
    c3 -->|"No"| e2["②実行:<br/>残りHP割合が最も低い味方4名のHPを<br/>自身のアピール力の100%分回復し<br/>(会心率に応じて会心回復)、2ターンの間「威圧」状態にする"]:::effect
    e2 --> e4["④実行:<br/>味方6名を2ターンの間<br/>「アピールガード(努力)」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
