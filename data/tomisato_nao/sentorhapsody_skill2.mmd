flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が「空腹」状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピールに自身の残りSPの<br/>50倍を固定値として上乗せする"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル4名に自身の最大アピールの<br/>25%を固定値として上乗せした730%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> c4{"④:①のアピール対象が「空腹」<br/>状態ではないかつ「嫉妬」<br/>状態ではないか<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["①のアピール対象を100%の確率で<br/>2ターンの間「空腹」と「嫉妬」<br/>状態にする"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| c5{"⑤:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c5 -->|"Yes(再実行は最大1回まで)"| c2
    c5 -->|"No"| c6{"⑥:味方チームのフロント人数が<br/>ライバルチームのフロント人数以下か"}:::cond
    c6 -->|"Yes"| a6["⑥実行:最大アピールが最も低い<br/>ライバル1名に自身の残りSPの200倍の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    c6 -->|"No"| finish(("終了")):::startend
    a6 --> finish
