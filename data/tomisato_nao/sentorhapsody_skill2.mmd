flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身のスマイルが<br/>①のアピール対象のスマイル<br/>以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> c3
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>「空腹」状態か"}:::cond
    c3 -->|"Yes"| e3["①のアピールに自身の残りSPの50倍を<br/>固定値として上乗せする"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>残りHP割合が最も低いライバル4名へ、<br/>自身の最大アピールの25%を固定値として<br/>上乗せした730%のアピール"]:::action
    a1 --> c4{"④:①のアピール対象が<br/>「空腹」状態ではない、かつ<br/>「嫉妬」状態ではないか"}:::cond
    c4 -->|"Yes"| e4["①のアピール対象を100%の確率で<br/>2ターンの間「空腹」と「嫉妬」状態にする"]:::effect --> lc
    c4 -->|"No"| lc{"①のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| c5{"⑤:①のアピールで<br/>ライバルがリタイア<br/>しなかったか"}:::cond
    c5 -->|"Yes(再実行は最大1回まで)"| c2
    c5 -->|"No"| c6{"⑥:味方チームのフロント人数が<br/>ライバルチームのフロント人数<br/>以下か"}:::cond
    c6 -->|"Yes"| a6["最大アピールが最も低いライバル1名へ、<br/>自身の残りSPの200倍のアピール<br/>(ディフェンス・メンタル無視)"]:::action --> finish(("終了")):::startend
    c6 -->|"No"| finish
