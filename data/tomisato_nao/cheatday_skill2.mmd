flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身の会心率を+20%する"]:::effect
    e1 --> c3{"③:自身の残りHP割合が<br/>②のアピール対象の残りHP割合<br/>以上か"}:::cond
    c3 -->|"Yes"| e3["②の各アピール時のみ<br/>①による会心率の増加倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>ライバル6名へ、アピール対象のHP上限2~7%分の<br/>固定値を上乗せした400~1400%のアピール<br/>(対象人数が少ないほど倍率上昇)"]:::action
    a2 --> c4{"④:②のアピール対象が<br/>「衰弱」状態か"}:::cond
    c4 -->|"Yes"| e4["②のアピール対象を100%の確率で<br/>2ターンの間「心労」状態にする"]:::effect --> lc
    c4 -->|"No"| lc{"②のアピール<br/>6名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c3
    lc -->|"Yes"| e5["⑤実行:<br/>残りHP割合が最も低い味方1名のHPを<br/>このスキルで行った合計アピールの30%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
