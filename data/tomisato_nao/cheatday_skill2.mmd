flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+20%する"]:::effect
    e1 --> c3{"③:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール時のみ①による<br/>会心率の増加倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバル6名に<br/>アピール対象のHP上限2~7%分の<br/>固定値を上乗せした400~1400%の<br/>アピールを行う(②のアピールを<br/>行う前のアピール対象人数が<br/>少ないほどアピール倍率と<br/>固定値倍率が高くなる)"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピール対象が「衰弱」状態か<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["②のアピール対象を100%の確率で<br/>2ターンの間「心労」状態にする"]:::effect
    c4 -->|"No"| lc2{"②のアピール<br/>ライバル6名すべて完了?"}:::cond
    e4 --> lc2
    lc2 -->|"Yes"| e5["⑤:残りHP割合が最も低い<br/>味方1名のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e5 --> finish(("終了")):::startend
