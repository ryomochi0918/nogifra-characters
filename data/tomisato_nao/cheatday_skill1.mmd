flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身のサゲ効果耐性貫通を+20%する"]:::effect
    e1 --> c3{"③:②のアピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    c3 -->|"Yes"| e3["②のアピールに②のアピール対象の<br/>残りHPの1.5%分の固定値を上乗せする"]:::effect --> c4
    c3 -->|"No"| c4{"④:②のアピール対象が<br/>「衰弱」状態か"}:::cond
    c4 -->|"Yes"| e4["②のアピール対象を100%の確率で<br/>2ターンの間「嫉妬」状態にする"]:::effect --> a2
    c4 -->|"No"| a2["②実行:<br/>ライバルへ620%のアピールを行い、<br/>100%の確率で3ターンの間「衰弱」状態にする"]:::action
    a2 --> lc{"②のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c3
    lc -->|"Yes"| finish(("終了")):::startend
