flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%以上<br/>または自身がバフ・アゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身のエフォートの<br/>3倍を固定値として上乗せする"]:::effect
    c2 -->|"No"| c3{"③:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①と②の固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに5回、自身の最大アピールの<br/>40%を固定値として上乗せした450%の<br/>アピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールでリタイアした<br/>人数が1名以下か"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| e5["⑤:自身のHPを①の合計アピールの<br/>20%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
