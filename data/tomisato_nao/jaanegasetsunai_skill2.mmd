flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%以上、<br/>または自身がバフ・アゲ効果状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身の<br/>エフォートの3倍を固定値として上乗せする"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のエフォートが<br/>①のアピール対象のエフォート<br/>以上か"}:::cond
    c3 -->|"Yes"| e3["①と②の<br/>固定値倍率が2倍になる"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>残りHP割合が最も低いライバルへ、<br/>自身の最大アピールの40%を固定値として<br/>上乗せした450%のアピール"]:::action
    a1 --> lc{"①のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| c4{"④:①のアピールで<br/>リタイアした人数が<br/>1名以下か"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| e5["⑤実行:<br/>自身のHPを①の合計アピールの<br/>20%分回復する"]:::effect --> finish(("終了")):::startend
