flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>①のアピール対象の残りHP割合<br/>以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>残りHP割合が最も高いライバルへ、<br/>自身の最大アピールの50%を固定値として<br/>上乗せした500%のアピール"]:::action
    a1 --> lc{"①のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| c3{"③:①のアピールで<br/>ライバルがリタイア<br/>しなかったか"}:::cond
    c3 -->|"Yes(再実行は最大1回まで)"| c2
    c3 -->|"No"| c4{"④:①のアピールで<br/>ライバルがリタイアしたか"}:::cond
    c4 -->|"Yes"| a4["残りHP割合が最も高いライバル2名へ<br/>①で行った合計アピールの30%分<br/>(ディフェンス・フィジカル無視、必ず命中)"]:::action --> finish(("終了")):::startend
    c4 -->|"No"| finish
