flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:対象が既に「情熱」<br/>状態か"}:::cond
    c2 -->|"Yes"| e2["「情熱」の代わりに<br/>「会心率アップ」状態にする"]:::effect --> c3
    c2 -->|"No"| c3{"③:対象の残りHP割合が<br/>50%未満か"}:::cond
    c3 -->|"Yes"| e3["①の回復倍率が1.5倍に"]:::effect --> a1
    c3 -->|"No"| a1["①実行:<br/>最大アピールが最も高い味方に<br/>自身のアピール力50%分回復+<br/>「情熱」(条件成立時は「会心率アップ」)状態を<br/>2ターン付与"]:::action
    a1 --> lc{"①の対象<br/>2名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| e4["④:味方6名を2ターンの間<br/>「アピールガード(努力)」状態にする"]:::effect
    e4 --> finish(("終了")):::startend
