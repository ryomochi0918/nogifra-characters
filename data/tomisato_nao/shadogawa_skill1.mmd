flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%未満か"}:::cond
    c2 -->|"Yes"| e2["①による「回避率アップ」状態の<br/>効果倍率が1.5倍になる"]:::effect
    c2 -->|"No"| e1["①:自身を3ターンの間<br/>「回避率アップ」状態にする"]:::effect
    e2 --> e1
    e1 --> c4{"④:自身の残りHP割合が50%以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③の各アピール中のみ自身の<br/>リフレクト耐性を+30%し、③の<br/>アピール倍率と固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:ライバル6名のバフ・アゲ効果を<br/>1つ解除し、自身の最大アピールの<br/>30%を固定値として上乗せした850%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc3 -->|"Yes"| e5["⑤:自身のHPをこのスキルで行った<br/>合計アピールの30%分回復する"]:::effect
    lc3 -->|"No、次の対象へ"| c4
    e5 --> finish(("終了")):::startend
