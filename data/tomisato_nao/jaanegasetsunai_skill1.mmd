flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間「音響」<br/>状態にする"]:::effect
    e1 --> c3{"③:自身のエフォートが②の<br/>アピール対象のエフォート以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルに4回、自身のエフォートの<br/>4倍を固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピール対象の<br/>バフ・アゲ効果状態の種類数が<br/>2種類以上か<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| a4["④実行:②のアピール対象に<br/>自身のエフォートの10倍を<br/>固定値として上乗せした1000%の<br/>アピールを行う"]:::action
    c4 -->|"No"| c5{"⑤:②のアピール対象が特殊状態か<br/>(②の各アピール後)"}:::cond
    a4 --> c5
    c5 -->|"Yes"| a5["⑤実行:②のアピール対象に<br/>自身のエフォートの12倍分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c5 -->|"No"| lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    a5 --> lc2
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
