flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間<br/>「音響」状態にする"]:::effect
    e1 --> c3{"③:自身のエフォートが<br/>②のアピール対象のエフォート<br/>以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>最大アピールが最も高いライバルへ、<br/>自身のエフォートの4倍を固定値として<br/>上乗せした400%のアピール"]:::action
    a2 --> c4{"④:②のアピール対象の<br/>バフ・アゲ効果状態の種類数が<br/>2種類以上か"}:::cond
    c4 -->|"Yes"| a4["②のアピール対象へ、自身のエフォートの<br/>10倍を固定値として上乗せした<br/>1000%のアピール"]:::action --> c5
    c4 -->|"No"| c5{"⑤:②のアピール対象が<br/>特殊状態か"}:::cond
    c5 -->|"Yes"| a5["②のアピール対象へ、自身のエフォートの<br/>12倍分のアピール<br/>(ディフェンス・フィジカル無視)"]:::action --> lc
    c5 -->|"No"| lc{"②のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c3
    lc -->|"Yes"| finish(("終了")):::startend
