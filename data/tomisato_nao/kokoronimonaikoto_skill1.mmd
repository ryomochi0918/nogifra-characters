flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②③:①のアピール対象の<br/>残りHP割合が50%以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象を100%の確率で<br/>2ターンの間「執着」状態にする"]:::effect --> a1
    c2 -->|"No"| e3["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a1
    a1["①実行:<br/>残りHP割合が最も低いライバルへ、<br/>自身の最大アピールの30%を固定値として<br/>上乗せした370%のアピール"]:::action
    a1 --> e4["④実行:<br/>自身のHPを①で行った<br/>直前のアピールの20%分回復する"]:::effect
    e4 --> lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| finish(("終了")):::startend
