flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が<br/>50%未満か"}:::cond
    c2 -->|"Yes"| e2["自身のHPを<br/>減少分の40%分回復する"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバルへ、自身のサンクスの3.5倍を<br/>固定値として上乗せした400~800%のアピール<br/>(残りHP割合が低いほど倍率上昇)"]:::action
    a1 --> c3{"③:自身の残りHP割合が80%以上<br/>である事が2回以上発生したか"}:::cond
    c3 -->|"Yes"| e3["①による残りのアピールは<br/>残りHP割合が最も低い時の<br/>倍率になる(800%)"]:::effect --> lc
    c3 -->|"No"| lc{"①のアピール<br/>6回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| c4{"④:①のアピールで<br/>ライバルを1名以上<br/>リタイアさせたか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| finish(("終了")):::startend
