flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%未満か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["自身のHPを減少分の40%分回復する"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに6回、<br/>自身のサンクスの3.5倍を<br/>固定値として上乗せした400~800%の<br/>アピールを行う(自身の残りHP割合が<br/>低いほど倍率が高くなり、②による<br/>回復前の残りHP割合を参照する)"]:::action
    e2 --> a1
    a1 --> c3{"③:自身の残りHP割合が80%以上である<br/>事が2回以上発生したか<br/>(①の各アピール後)"}:::cond
    c3 -->|"Yes"| e3["①による残りのアピールは<br/>残りHP割合が最も低い時の倍率になる<br/>(800%のアピール)"]:::effect
    c3 -->|"No"| lc1{"①のアピール<br/>6回すべて完了?"}:::cond
    e3 --> lc1
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルを<br/>1名以上リタイアさせたか"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| finish(("終了")):::startend
