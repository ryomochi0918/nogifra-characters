flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方チームのフロント人数が<br/>ライバルチームのフロント人数以下、<br/>またはライバルチームのフロント人数が3名以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象を100%の確率で<br/>2ターンの間「空腹」状態にする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバル4名へ、自身のスマイルの3倍を<br/>固定値として上乗せした730%のアピール"]:::action
    a1 --> c4{"④:自身のスマイルが<br/>③のアピール対象のスマイル<br/>以上か"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect --> a3
    c4 -->|"No"| a3["③実行:<br/>残りHP割合が最も低いライバルへ、<br/>自身のスマイルの3倍を固定値として<br/>上乗せした350%のアピール"]:::action
    a3 --> lc{"③のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c4
    lc -->|"Yes"| c5{"⑤:このスキルでリタイアした<br/>ライバルが1名以下か"}:::cond
    c5 -->|"Yes"| a5["残りHP割合が最も低いライバル2名を100%の確率で<br/>2ターンの間「嫉妬」状態にし、①と③の<br/>合計アピールの20%分(ディフェンス・メンタル無視)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
