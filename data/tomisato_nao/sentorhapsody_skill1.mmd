flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:味方チームのフロント人数が<br/>ライバルチームのフロント人数以下<br/>またはライバルチームの<br/>フロント人数が3名以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象を100%の確率で<br/>2ターンの間「空腹」状態にする"]:::effect
    c2 -->|"No"| a1["①実行:ライバル4名に自身のスマイルの<br/>3倍を固定値として上乗せした730%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c4{"④:自身のスマイルが③の<br/>アピール対象のスマイル以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:残りHP割合が最も低い<br/>ライバルに4回、自身のスマイルの<br/>3倍を固定値として上乗せした350%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>4回すべて完了?"}:::cond
    lc3 -->|"Yes"| c5{"⑤:このスキルでリタイアした<br/>ライバルが1名以下か"}:::cond
    lc3 -->|"No、次の回へ"| c4
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバル2名を100%の確率で<br/>2ターンの間「嫉妬」状態にし、<br/>①と③の合計アピールの20%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
