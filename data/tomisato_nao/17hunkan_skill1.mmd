flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:最大アピールが最も高い味方4名を<br/>2ターンの間「強運」状態にする"]:::effect
    e1 --> c3{"③:②の効果対象が「強運」状態か<br/>(②の各効果前)"}:::cond
    c3 -->|"Yes"| e3["②による「威圧」状態の<br/>ディフェンス増加倍率が1.5倍になる"]:::effect
    c3 -->|"No"| e2["②:残りHP割合が最も低い味方4名の<br/>HPを自身のアピール力の100%分回復し<br/>(会心率に応じて会心回復が発生)、<br/>2ターンの間「威圧」状態にする"]:::effect
    e3 --> e2
    e2 --> lc2{"②の効果<br/>対象4名すべて完了?"}:::cond
    lc2 -->|"Yes"| e4["④:味方6名を2ターンの間<br/>「アピールガード(努力)」状態にする"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e4 --> finish(("終了")):::startend
