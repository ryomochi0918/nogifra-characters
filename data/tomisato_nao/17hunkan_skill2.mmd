flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①の各アピール中のみ自身の<br/>命中率を+25%し、<br/>①のアピール倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身のスマイルが①の<br/>アピール対象のスマイル以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:ライバルに5回、100%の確率で<br/>2ターンの間「フィジカルダウン」と<br/>「メンタルダウン」状態にし、<br/>520%のアピールを行う<br/>(「フィジカルダウン」または「メンタルダウン」<br/>状態ではないライバルを優先的に選択し、<br/>各アピール後のライバルが<br/>「フィジカルダウン」または「メンタルダウン」<br/>状態ではない場合、対象を変更しない)"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| c5{"⑤:④の効果対象が<br/>バフ・アゲ効果状態か<br/>(④の各効果前)"}:::cond
    lc1 -->|"No、次の回へ"| c2
    c5 -->|"Yes"| e5["④の効果対象の<br/>デバフ・サゲ効果を1つ解除する"]:::effect
    c5 -->|"No"| e4["④:味方6名のHPを①で行った<br/>合計アピールの10%分回復する"]:::effect
    e5 --> e4
    e4 --> lc4{"④の効果<br/>対象6名すべて完了?"}:::cond
    lc4 -->|"Yes"| finish(("終了")):::startend
    lc4 -->|"No、次の対象へ"| c5
