flowchart TD
    start(("開始")):::startend
    n0["対象決定:<br/>残りHP割合が最も低いライバル"]:::effect

    subgraph loop1 ["①: 対象へ合計5回実行<br/>(基本450%+固定値 自身の最大アピール×40%)"]
        direction TB
        c2{"②: 自身の残りHP割合が50%以上<br/>または<br/>自身がバフ・アゲ効果状態?"}:::cond
        e2["固定値を追加<br/>エフォート×3"]:::effect
        c3{"③: 自身のエフォート ≥<br/>①の対象のエフォート?"}:::cond
        e3["①と②の固定値倍率が<br/>2倍に"]:::effect
        a1["①実行:<br/>対象へアピール"]:::action

        c2 -->|"Yes"| e2 --> c3
        c2 -->|"No"| c3
        c3 -->|"Yes"| e3 --> a1
        c3 -->|"No"| a1
    end

    start --> n0 --> c2
    a1 --> lc{"①のアピール<br/>5回すべて完了?"}:::cond
    lc -->|"No、次の回へ"| c2
    lc -->|"Yes"| c4{"④: ①でリタイアした人数が<br/>1名以下?<br/>(かつ再実行がまだの場合)"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| n0
    c4 -->|"No"| c5["⑤: 自身のHPを<br/>①の合計アピールの20%分回復"]:::action
    c5 --> finish(("終了")):::startend

    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;
