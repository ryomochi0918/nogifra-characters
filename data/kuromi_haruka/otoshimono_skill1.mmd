flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>会心率を+15%する"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ①による<br/>会心率の増加倍率が40%になり、②の<br/>アピール倍率と固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバル6名に自身のサンクスを<br/>固定値として上乗せした500%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc2 -->|"Yes"| c4{"④:②のアピールで会心アピールが<br/>発生したか"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    c4 -->|"Yes"| a4["④実行:②のアピールで会心アピールが<br/>発生した回数をアピール回数として、<br/>ライバル1名に「自身のサンクス×②の<br/>アピールで発生した会心アピールの<br/>回数」を倍率としたアピールを<br/>行う(ディフェンス、フィジカルを<br/>無視し、このアピールはライバルが<br/>リタイアするまで対象を変更せず、<br/>リタイア回復が発生した場合も<br/>対象を変更しない、サンクスの<br/>倍率は最大6倍)"]:::action
    c4 -->|"No"| e5["⑤:自身のHPを②で行った<br/>合計アピールの50%分回復する"]:::effect
    a4 --> e5
    e5 --> finish(("終了")):::startend
