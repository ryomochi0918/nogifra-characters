flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>会心率を+15%する"]:::effect --> c3
    c3{"③:自身のサンクスが②のアピール<br/>対象のサンクス以上か"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ①による会心率の<br/>増加倍率が40%になり、②のアピール<br/>倍率と固定値倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:ライバル6名へ、自身の<br/>サンクスを固定値として上乗せした<br/>500%のアピール"]:::action --> c4
    c4{"④:②のアピールで<br/>会心アピールが発生したか"}:::cond
    c4 -->|"Yes"| a4["会心アピールが発生した回数分、<br/>ライバル1名へ「自身のサンクス×発生<br/>回数」を倍率としたアピール<br/>(ディフェンス、フィジカルを無視、<br/>対象固定、サンクス倍率は最大6倍)"]:::action --> a5
    c4 -->|"No"| a5["⑤実行:自身のHPを②で行った<br/>合計アピールの50%分回復する"]:::action --> finish(("終了")):::startend
