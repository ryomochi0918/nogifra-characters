flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル4名へ、自身の<br/>スマイルの4倍を固定値として<br/>上乗せした700%のアピール"]:::action --> e2["100%の確率で対象を3ターンの間<br/>「心労」状態にする"]:::effect --> c4
    c4{"④:③のアピール対象が<br/>「心労」状態か"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と固定値倍率が<br/>2倍になる"]:::effect --> a3
    c4 -->|"No"| a3["③実行:ライバルへ、自身のスマイルの<br/>2倍を固定値として上乗せした<br/>300%のアピール"]:::action --> lc1
    lc1{"③のアピール3回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c4
    lc1 -->|"Yes"| finish(("終了")):::startend
