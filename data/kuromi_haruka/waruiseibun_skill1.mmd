flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバル4名に自身のスマイルの<br/>4倍を固定値として上乗せした700%の<br/>アピールを行う"]:::action
    a1 --> e2["②:100%の確率で対象を3ターンの間<br/>「心労」状態にする<br/>(①の各アピール後)"]:::effect
    e2 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:③のアピール対象が「心労」状態か<br/>(③の各アピール前)"}:::cond
    lc1 -->|"No、次の対象へ"| a1
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:ライバルに3回、<br/>自身のスマイルの2倍を<br/>固定値として上乗せした300%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>3回すべて完了?"}:::cond
    lc3 -->|"Yes"| finish(("終了")):::startend
    lc3 -->|"No、次の回へ"| c4
