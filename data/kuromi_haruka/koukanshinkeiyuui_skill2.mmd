flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②①の各アピール前:<br/>このスキル中に1度でも<br/>ライバルがリタイアした?"}:::cond
    c2 -->|"Yes"| e2["①のアピールに最大アピールが<br/>最も高い味方1名の最大アピールの<br/>25%を固定値として上乗せする"]:::effect --> c3
    c2 -->|"No"| c3
    c3{"③①の各アピール前:<br/>自身が「興奮」状態?"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる"]:::effect --> c4
    c3 -->|"No"| c4
    c4{"④①の各アピール前:<br/>このスキル中に自身のスマイルが<br/>①のアピール対象のスマイル以上である事が<br/>3回発生した?(3回発生するごと)"}:::cond
    c4 -->|"Yes"| e4["①のアピール回数が3回増加する<br/>(アピールの追加回数は最大で6回まで)"]:::effect --> a1
    c4 -->|"No"| a1["①実行:残りHP割合が最も低いライバルに、<br/>自身のSP上限の60倍を固定値として<br/>上乗せした480%のアピールを行う"]:::action
    a1 --> lp{"①のアピール6回(+④の追加回数)<br/>すべて完了?"}:::cond
    lp -->|"No、次の回へ"| c2
    lp -->|"Yes"| finish(("終了")):::startend
