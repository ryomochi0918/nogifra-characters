flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール対象の残りHP割合が<br/>50%以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身のエフォートの<br/>3倍を固定値として上乗せする"]:::effect --> c3
    c2 -->|"No"| c3{"③:自身のエフォートが①のアピール<br/>対象のエフォート以上か"}:::cond
    c3 -->|"Yes"| e3["①の対象のバフ・アゲ効果を1つ解除し、<br/>①のアピール倍率と②の固定値倍率が<br/>2倍になる"]:::effect --> a1
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル3名へ100%の確率で2ターンの間<br/>「嫉妬」状態にし、950%のアピール"]:::action --> c4
    c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c4 -->|"Yes"| a4["①を再度実行(再実行は最大1回まで)"]:::action --> a5
    c4 -->|"No"| a5["⑤実行:自身のHPを①で行った合計<br/>アピールの25%分回復し、3ターンの間<br/>「翻弄」状態にする"]:::action --> finish(("終了")):::startend
