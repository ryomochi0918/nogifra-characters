flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに自身のエフォートの<br/>3倍を固定値として上乗せする"]:::effect
    c2 -->|"No"| c3{"③:自身のエフォートが①の<br/>アピール対象のエフォート以上か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール対象のバフ・アゲ効果を<br/>1つ解除し、①のアピール倍率と<br/>②の固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル3名を100%の確率で<br/>2ターンの間「嫉妬」状態にし、<br/>950%のアピールを行う"]:::action
    e3 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc1 -->|"Yes"| c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| e5["⑤:自身のHPを①で行った<br/>合計アピールの25%分回復し、<br/>3ターンの間「翻弄」状態にする"]:::effect
    e5 --> finish(("終了")):::startend
