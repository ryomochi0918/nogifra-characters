flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c2{"②:自身の残りHP割合が50%以上か"}:::cond
    c2 -->|"Yes"| e2["自身と自身以外の最大アピールが<br/>最も高い味方1名を3ターンの間<br/>「興奮」状態にする"]:::effect
    c2 -->|"No"| c4{"④:自身のスマイルが③の<br/>アピール対象のスマイル以上か<br/>(③の各アピール前)"}:::cond
    e2 --> c4
    c4 -->|"Yes"| e4["③のアピール倍率と固定値倍率が<br/>2.5倍になる"]:::effect
    c4 -->|"No"| a3["③実行:ライバル3名に3回、<br/>自身のSP上限の30倍を<br/>固定値として上乗せした400%の<br/>アピールを行う(2回目以降の<br/>アピールは対象を選び直す)"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc3 -->|"Yes"| lc3n{"③のアピール<br/>3回すべて完了?"}:::cond
    lc3 -->|"No、次の対象へ"| c4
    lc3n -->|"Yes"| c5{"⑤:③のアピールでライバルが<br/>リタイアしたか"}:::cond
    lc3n -->|"No、次の回へ"| c4
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も<br/>低いライバル2名に③で<br/>行った合計アピールの20%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
