flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:このスキル中、<br/>自身のリフレクト耐性を+30%する"]:::effect
    a1 --> c2{"②①の効果後:<br/>自身の残りHP割合が50%以上?"}:::cond
    c2 -->|"Yes"| e2["②実行:自身と自身以外の<br/>最大アピールが最も高い味方1名を<br/>3ターンの間「興奮」状態にする"]:::effect --> c4
    c2 -->|"No(③は条件を満たさない場合でも発動)"| c4
    c4{"④③の各アピール前:<br/>自身のスマイルが③のアピール対象の<br/>スマイル以上?<br/>(対象ごとに判定)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と固定値倍率が<br/>2.5倍になる"]:::effect --> a3
    c4 -->|"No"| a3["③実行:ライバル3名に3回、<br/>自身のSP上限の30倍を固定値として<br/>上乗せした400%のアピールを行う<br/>(2回目以降のアピールは対象を選び直す)"]:::action
    a3 --> lp{"③のアピール3回すべて完了?"}:::cond
    lp -->|"No、次の回へ"| c4
    lp -->|"Yes"| c5{"⑤③のアピールが全て終了後:<br/>③のアピールでライバルが<br/>リタイアした?"}:::cond
    c5 -->|"Yes"| a5["⑤実行:残りHP割合が最も低い<br/>ライバル2名に③で行った合計アピールの<br/>20%分のアピールを行う<br/>(ディフェンス、メンタルを無視する)"]:::action --> finish
    c5 -->|"No"| finish(("終了")):::startend
