flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>命中率を+40%する"]:::effect
    e1 --> a2["②実行:残りHP割合が最も低い<br/>ライバル2名に最大アピールが最も高い<br/>味方3名の最大アピールの合計45%を<br/>固定値として上乗せした1100%の<br/>アピールを行う"]:::action
    a2 --> e3["③:残りHP割合が最も低い<br/>味方2名のHPをこのスキルで行った<br/>合計アピールの30%分回復し、<br/>4ターンの間「勇気」状態にする"]:::effect
    e3 --> c4{"④:②のアピールでライバルが<br/>リタイアしたか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| a2
    c4 -->|"No"| finish(("終了")):::startend
