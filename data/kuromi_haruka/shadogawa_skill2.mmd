flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>デバフ効果耐性貫通と命中率を+25%する"]:::effect
    e1 --> c3{"③:②のアピール対象の<br/>残りHP割合が50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル5名を100%の確率で2ターンの<br/>間「回避率ダウン」状態にし、<br/>830%のアピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル5名すべて完了?"}:::cond
    lc2 -->|"Yes"| a4["④実行:残りHP割合が最も低い<br/>ライバルに2回、100%の確率で<br/>3ターンの間「執着」状態にし、<br/>1400%のアピールを行う"]:::action
    lc2 -->|"No、次の対象へ"| c3
    a4 --> c5{"⑤:このスキルでリタイアした<br/>ライバルが1名以下か"}:::cond
    c5 -->|"Yes"| a5["⑤実行:ライバルに1回、このスキルで<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    c5 -->|"No"| finish(("終了")):::startend
    a5 --> finish
