flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の<br/>デバフ効果耐性貫通と命中率を<br/>+25%する"]:::effect --> c3
    c3{"③:②のアピール対象の残りHP割合が<br/>50%以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバル5名へ100%の確率で<br/>2ターンの間「回避率ダウン」状態にし、<br/>830%のアピール"]:::action --> a4["④実行:残りHP割合が最も低い<br/>ライバルへ2回、100%の確率で<br/>3ターンの間「執着」状態にし、<br/>1400%のアピール"]:::action --> c5
    c5{"⑤:このスキルでリタイアした<br/>ライバルが1名以下か"}:::cond
    c5 -->|"Yes"| a5["ライバルへ1回、このスキルで行った<br/>合計アピールの30%分のアピール<br/>(ディフェンス、フィジカルを無視)"]:::action --> finish(("終了")):::startend
    c5 -->|"No"| finish
