flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:最大アピールが最も高い<br/>味方3名のデバフ・サゲ効果を全て解除し、<br/>2ターンの間「集中」状態にする"]:::action --> c2
    c2{"②:①の効果対象の残りHP割合が<br/>50%未満か(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["該当対象のHPを自身のアピール力の<br/>80%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect --> c3
    c2 -->|"No"| c3{"③:最大アピールが最も高い味方1名の<br/>バフ・アゲ効果状態の種類数が<br/>3種類以上か"}:::cond
    c3 -->|"Yes"| a3["ライバル3名のバフ・アゲ効果を<br/>1つ解除する"]:::action --> finish(("終了")):::startend
    c3 -->|"No"| finish
