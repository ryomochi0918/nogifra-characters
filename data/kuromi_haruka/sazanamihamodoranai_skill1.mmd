flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:最大アピールが最も高い味方3名の<br/>デバフ・サゲ効果を全て解除し、<br/>2ターンの間「集中」状態にする"]:::effect
    e1 --> c2{"②:①の効果対象の<br/>残りHP割合が50%未満か<br/>(①の各効果後)"}:::cond
    c2 -->|"Yes"| e2["HPを自身のアピール力の80%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect
    c2 -->|"No"| lc1{"①の効果<br/>対象3名すべて完了?"}:::cond
    e2 --> lc1
    lc1 -->|"Yes"| c3{"③:最大アピールが最も高い味方1名の<br/>バフ・アゲ効果状態の種類数が<br/>3種類以上か"}:::cond
    lc1 -->|"No、次の対象へ"| e1
    c3 -->|"Yes"| e3["ライバル3名のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c3 -->|"No"| finish(("終了")):::startend
    e3 --> finish
