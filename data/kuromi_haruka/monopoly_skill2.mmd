flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2
    c2{"②:①のアピール対象が<br/>「混乱」状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と固定値倍率と<br/>固定値の上限値が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:ライバルへ、対象のHP減少分の<br/>6%を固定値として上乗せした<br/>1100%のアピール(固定値上限は<br/>自身の最大アピールの750%)"]:::action --> e3["残りHP割合が最も低い味方1名のHPを<br/>①のアピールで行った合計アピールの<br/>30%分回復する"]:::effect --> lc1
    lc1{"①のアピール2回<br/>すべて完了?"}:::cond
    lc1 -->|"No、次の回へ"| c2
    lc1 -->|"Yes"| c4{"④:このスキルでライバルが<br/>リタイアしなかったか"}:::cond
    c4 -->|"Yes"| a4["再度①からスキルを実行する<br/>(再実行は最大2回まで)"]:::action --> finish(("終了")):::startend
    c4 -->|"No"| finish
