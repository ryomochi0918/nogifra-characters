flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:このスキル中に1度でもライバルが<br/>リタイアしたか<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピールに最大アピールが最も<br/>高い味方1名の最大アピールの25%を<br/>固定値として上乗せする"]:::effect
    c2 -->|"No"| c3{"③:自身が「興奮」状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| c4{"④:このスキル中に自身のスマイルが<br/>①のアピール対象のスマイル以上である<br/>事が3回発生したか<br/>(3回ごと)<br/>(①の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["①のアピール回数が3回増加する<br/>(アピールの追加回数は最大で6回まで)"]:::effect
    c4 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに6回、自身のSP上限の<br/>60倍を固定値として上乗せした480%の<br/>アピールを行う"]:::action
    e4 --> a1
    a1 --> lc1{"①のアピール<br/>6回(+④の追加分)すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
