flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の<br/>残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果の解除数が<br/>1つ増加し、アピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバル4名のバフ・アゲ効果を<br/>2つ解除し、自身のスマイルの2倍を<br/>固定値として上乗せした750%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| e3["③:残りHP割合が最も低い味方2名の<br/>HPを①で行った合計アピールの<br/>40%分回復する"]:::effect
    lc1 -->|"No、次の対象へ"| c2
    e3 --> c4{"④:①のアピールでライバルが<br/>リタイアしなかったか"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| finish(("終了")):::startend
