flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の残りHP割合が<br/>50%以上か<br/>(対象ごとに判定)"}:::cond
    c2 -->|"Yes"| e2["①のバフ・アゲ効果の解除数が1つ増加し、<br/>アピール倍率と固定値倍率が2倍になる"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバルのバフ・アゲ効果を2つ解除し、<br/>自身のスマイルの2倍を固定値として上乗せした<br/>750%のアピールを行う"]:::action
    a1 --> lc{"①のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c2
    lc -->|"Yes"| e3["残りHP割合が最も低い味方2名のHPを<br/>①で行った合計アピールの40%分回復する"]:::effect --> c4
    c4{"④:①のアピールでライバルが<br/>リタイアしなかったか<br/>(かつ再実行がまだの場合)"}:::cond
    c4 -->|"Yes(再実行は最大1回まで)"| c2
    c4 -->|"No"| finish(("終了")):::startend
