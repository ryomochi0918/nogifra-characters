flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバル4名にアピール対象のHP減少分の<br/>4%を固定値として上乗せした650%の<br/>アピールを行う(固定値の上乗せは<br/>自身の最大アピールの500%まで)"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc1 -->|"Yes"| a3["③実行:残りHP割合が最も<br/>高いライバル1名に①で<br/>行った合計アピールの80%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a3 --> finish(("終了")):::startend
