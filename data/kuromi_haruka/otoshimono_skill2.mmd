flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①効果:このスキル中、自身の会心率を<br/>+20%、自身の会心アピールを<br/>+50%する"]:::effect --> c3
    c3{"③:自身のサンクスが②のアピール<br/>対象のサンクス以上か"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ①による会心率の<br/>増加倍率が2倍になる"]:::effect --> a2
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルへ、自身の最大アピールの<br/>30%を固定値として上乗せした<br/>550%のアピール"]:::action --> c4
    c4{"④:②のアピールで<br/>会心アピールが発生したか"}:::cond
    c4 -->|"Yes"| e4["②のアピール回数が1回増加する<br/>(追加回数は最大4回まで)"]:::effect --> c5
    c4 -->|"No"| c5{"⑤:②のアピールでライバルが<br/>リタイアしたか"}:::cond
    c5 -->|"Yes"| e5["自身のHPを自身のアピール力の<br/>200%分回復する<br/>(会心率に応じて会心回復が発生)"]:::effect --> lc1
    c5 -->|"No"| lc1{"②のアピールが全て完了?<br/>(基本4回、④で最大+4回)"}:::cond
    lc1 -->|"No、次の回へ"| c3
    lc1 -->|"Yes"| finish(("終了")):::startend
