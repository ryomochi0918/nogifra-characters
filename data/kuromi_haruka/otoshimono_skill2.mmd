flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+20%、<br/>自身の会心アピールを+50%する"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ①による<br/>会心率の増加倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに4回、自身の最大アピールの<br/>30%を固定値として上乗せした550%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピールで会心アピールが<br/>発生したか<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["②のアピール回数が1回増加する<br/>(アピールの追加回数は最大で4回まで)"]:::effect
    c4 -->|"No"| c5{"⑤:②のアピールでライバルが<br/>リタイアしたか<br/>(②の各アピール後)"}:::cond
    e4 --> c5
    c5 -->|"Yes"| e5["自身のHPを自身のアピール力の<br/>200%分回復する(会心率に<br/>応じて会心回復が発生)"]:::effect
    c5 -->|"No"| lc2{"②のアピール<br/>4回(+④の追加分)すべて完了?"}:::cond
    e5 --> lc2
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の回へ"| c3
