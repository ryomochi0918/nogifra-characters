flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:残りHP割合が最も高い<br/>ライバルに4回、自身のサンクスの<br/>2.5倍を固定値として上乗せした400%の<br/>アピールを行う(このアピールは<br/>ライバルがリタイアするまで対象を<br/>変更せず、リタイア回復が発生した<br/>場合も対象を変更しない)"]:::action
    a1 --> a2["②実行:残りHP割合が最も低い<br/>ライバル4名に自身のサンクスの<br/>2.5倍を固定値として上乗せした720%の<br/>アピールを行う"]:::action
    a2 --> e4["④:③による「アピール力アップ」<br/>の効果倍率は①と②のアピールで<br/>リタイアさせた回数×10%上昇する<br/>(4回リタイアで最大倍率になる)"]:::effect
    e4 --> e5["⑤:③による「追走」の受ける<br/>アピールの低下倍率と回避率の<br/>効果倍率は①と②のアピールで<br/>リタイアさせた回数×5%上昇する<br/>(4回リタイアで最大倍率になる)"]:::effect
    e5 --> e3["③:自身を2ターンの間<br/>「アピール力アップ」と「追走」<br/>状態にする"]:::effect
    e3 --> finish(("終了")):::startend
