flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+25%する"]:::effect
    e1 --> c3{"③:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに6回、自身の最大アピールの<br/>30%を固定値として上乗せした<br/>480%のアピールを行う"]:::action
    e3 --> a2
    a2 --> c4{"④:②のアピール対象の<br/>残りHP割合が30%以下か<br/>(②の各アピール後)"}:::cond
    c4 -->|"Yes"| a4["④実行:②のアピール対象に自身の<br/>スマイルの6倍分のアピールを行う<br/>(ディフェンス、メンタルを無視する)"]:::action
    c4 -->|"No"| lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    a4 --> lc2
    lc2 -->|"Yes"| c5{"⑤:②または④のアピールで<br/>ライバルをリタイアさせたか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c5 -->|"Yes"| e5["自身のHPを②と④で行った<br/>合計アピールの50%分回復する"]:::effect
    c5 -->|"No"| e6["⑥:ライバルチームの残りHP割合が<br/>80%以上のライバルを100%の確率で<br/>1ターンの間「落胆」状態にする"]:::effect
    e5 --> e6
    e6 --> finish(("終了")):::startend
