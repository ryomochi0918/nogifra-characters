flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身のリフレクト耐性を+25%する"]:::effect --> c3{"③:自身の残りHP割合が<br/>②のアピール対象の残りHP割合以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>残りHP割合が最も低いライバルへ、<br/>自身の最大アピールの30%を固定値として<br/>上乗せした480%のアピール"]:::action --> c4{"④:②のアピール対象の<br/>残りHP割合が30%以下か"}:::cond
    c4 -->|"Yes"| a4["自身のスマイルの6倍分のアピール<br/>(ディフェンス、メンタルを無視)"]:::action --> lc2
    c4 -->|"No"| lc2{"②のアピール6回すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2 -->|"Yes"| c5{"⑤:②または④のアピールで<br/>ライバルをリタイアさせたか"}:::cond
    c5 -->|"Yes"| e5["自身のHPを②と④で行った<br/>合計アピールの50%分回復する"]:::effect --> e6
    c5 -->|"No"| e6["⑥:ライバルチームの残りHP割合が80%以上の<br/>ライバルを100%の確率で1ターンの間<br/>「落胆」状態にする"]:::effect --> finish(("終了")):::startend
