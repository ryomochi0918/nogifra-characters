flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象の残りHP割合が<br/>50%以下またはライバルチームの<br/>フロント人数が2名以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率が2倍になる"]:::effect
    c2 -->|"No"| c3{"③:自身の残りHP割合が50%以上<br/>または自身がバフ・アゲ効果状態か<br/>(①の各アピール前)"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率が2倍になる"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も低い<br/>ライバルに6回、450~900%の<br/>アピールを行う(自身の残りHP割合が<br/>高いほど倍率が高くなる)"]:::action
    e3 --> a1
    a1 --> c4{"④:①のアピールでライバルが<br/>リタイアしたか<br/>(①の各アピール後)"}:::cond
    c4 -->|"Yes"| e4["①のアピール回数が1回増加する<br/>(アピールの追加回数は最大で4回まで)"]:::effect
    c4 -->|"No"| lc1{"①のアピール<br/>6回(+④の追加分)すべて完了?"}:::cond
    e4 --> lc1
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
