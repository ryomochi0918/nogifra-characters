flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を3ターンの間「賢明」<br/>状態にする"]:::effect
    e1 --> e3["③:②のアピールに「ライブ中に<br/>発動した自身のスキル1「ギャル俳句」<br/>の回数×アピール対象のHP上限0.1%分」<br/>を固定値として上乗せする(②と<br/>③の固定値の上乗せは合計で<br/>アピール対象のHP上限の1.5%まで)<br/>(②の各アピール前)"]:::effect
    e3 --> c4{"④:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a2["②実行:ライバルに4回、<br/>アピール対象のHP上限0.9%分を<br/>固定値として上乗せした700%の<br/>アピールを行う(初回スキル発動時の<br/>②の固定値はHP上限1%分となる)"]:::action
    e4 --> a2
    a2 --> lc2{"②のアピール<br/>4回すべて完了?"}:::cond
    lc2 -->|"Yes"| a5["⑤実行:ライバル1名に②で<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc2 -->|"No、次の回へ"| e3
    a5 --> finish(("終了")):::startend
