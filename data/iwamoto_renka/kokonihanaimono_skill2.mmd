flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の会心率を+30%する"]:::effect --> c3{"③:自身の残りHP割合が<br/>50%以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率を2倍にし、<br/>②のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身の残りHP割合が②の<br/>アピール対象の残りHP割合以上か<br/>(②の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["②のアピールに自身のエフォートの3倍を<br/>固定値として上乗せする"]:::effect --> a2
    c4 -->|"No"| a2["②実行:<br/>ライバル4名に2回、520%のアピール<br/>(2回目以降のアピールは対象を選び直す)"]:::action --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2 -->|"Yes"| lc2n{"②のアピール<br/>2回すべて完了?"}:::cond
    lc2n -->|"No、次の回へ"| c3
    lc2n -->|"Yes"| e5["⑤:自身と自身以外の残りHP割合が<br/>最も低い味方3名のHPを<br/>②で行った合計アピールの30%分回復する"]:::effect --> finish(("終了")):::startend
