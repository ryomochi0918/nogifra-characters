flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%以上か"}:::cond
    c2 -->|"Yes"| e2["①の効果倍率が2倍になる"]:::effect
    c2 -->|"No"| e1["①:このスキル中、自身の<br/>会心率を+25%、命中率を+15%する"]:::effect
    e2 --> e1
    e1 --> a3["③実行:ライバルに4回、<br/>アピール対象のHP減少分の8%を<br/>固定値として上乗せした400%の<br/>アピールを行う(固定値の上乗せは<br/>自身の最大アピールの500%まで)"]:::action
    a3 --> a4["④実行:残りHP割合が最も高い<br/>ライバル1名に③で会心アピールが<br/>発生した回数×800%の倍率を<br/>上乗せした、2000%のアピールを行う"]:::action
    a4 --> e5["⑤:自身のデバフ・サゲ効果を<br/>全て解除し、HPを自身のHP上限の<br/>50%分回復する"]:::effect
    e5 --> finish(("終了")):::startend
