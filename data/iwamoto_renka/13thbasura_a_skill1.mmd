flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①実行:自身の会心率を+40%し、<br/>命中率を+20%"]:::effect
    e1 --> c3{"③:②のアピール対象の<br/>残りHP割合が30%以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が3倍に"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>ライバルへ基本1100%+<br/>固定値 対象HP上限の0.5%分"]:::action
    a2 --> lc2{"②のアピール<br/>3回すべて完了?"}:::cond
    lc2 -->|"No、次の回へ"| c3
    lc2 -->|"Yes"| c5{"⑤:自身のサンクスが④の<br/>アピール対象のサンクス以上か"}:::cond
    c5 -->|"Yes"| e5["④のアピール倍率と<br/>固定値倍率が2倍に"]:::effect --> a4
    c5 -->|"No"| a4["④実行:<br/>残りHP割合が最も低いライバルへ<br/>基本1000%+固定値 自身のHP上限の40%"]:::action
    a4 --> lc4{"④のアピール<br/>3回すべて完了?"}:::cond
    lc4 -->|"No、次の回へ"| c5
    lc4 -->|"Yes"| c7{"⑦:自身の残りHP割合が<br/>50%未満か"}:::cond
    c7 -->|"Yes"| e7["⑥による「反響」の<br/>効果倍率が2倍に"]:::effect --> a6
    c7 -->|"No"| a6["⑥実行:自身と自身以外の残りHP割合が<br/>最も高い味方1名を2ターンの間<br/>「反響」状態にする"]:::action
    a6 --> finish(("終了")):::startend
