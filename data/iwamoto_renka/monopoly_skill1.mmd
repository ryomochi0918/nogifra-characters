flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を2ターンの間「牽制」<br/>状態にする"]:::effect
    e1 --> c3{"③:ライバルチームの<br/>フロント人数が3人以上か"}:::cond
    c3 -->|"Yes"| e3["②の「落胆」状態にする<br/>確率を+40%する"]:::effect
    c3 -->|"No"| c4{"④:自身の残りHP割合が70%以上か"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["②のアピール対象を1名増加する<br/>(増加人数は最大で1名まで)"]:::effect
    c4 -->|"No"| a2["②実行:最大アピールが最も高い<br/>ライバルに自身のスマイルの3倍を<br/>固定値として上乗せした1500%の<br/>アピールを行い、60%の確率で<br/>1ターンの間「落胆」状態にする"]:::action
    e4 --> a2
    a2 --> e5["⑤:「落胆」状態のライバルを<br/>100%の確率で2ターンの間「空腹」<br/>状態にする"]:::effect
    e5 --> finish(("終了")):::startend
