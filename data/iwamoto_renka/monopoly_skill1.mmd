flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身を2ターンの間「牽制」状態にする"]:::effect --> c3{"③:ライバルチームのフロント人数が<br/>3人以上か"}:::cond
    c3 -->|"Yes"| e3["②の「落胆」状態にする確率を+40%する<br/>(60%→100%)"]:::effect --> c4
    c3 -->|"No"| c4{"④:自身の残りHP割合が<br/>70%以上か"}:::cond
    c4 -->|"Yes"| e4["②のアピール対象を1名増加する<br/>(増加人数は最大1名まで)"]:::effect --> a2
    c4 -->|"No"| a2["②実行:<br/>最大アピールが最も高いライバルへ、<br/>自身のスマイルの3倍を固定値として<br/>上乗せした1500%のアピールを行い、<br/>60%(条件成立時100%)の確率で<br/>1ターンの間「落胆」状態にする"]:::action --> e5["⑤:「落胆」状態のライバルを<br/>100%の確率で2ターンの間<br/>「空腹」状態にする"]:::effect --> finish(("終了")):::startend
