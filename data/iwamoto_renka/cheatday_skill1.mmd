flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>リフレクト耐性を+30%する"]:::effect
    e1 --> c3{"③:自身のHP上限が②のアピール対象の<br/>残りHP以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:ライバルに6回、<br/>自身の最大アピールの30%を<br/>固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>6回すべて完了?"}:::cond
    lc2 -->|"Yes"| c4{"④:自身の残りHP割合が50%以上<br/>または②のアピールでライバルが<br/>リタイアしていなかったか"}:::cond
    lc2 -->|"No、次の回へ"| c3
    c4 -->|"Yes"| a4["④実行:ライバル4名に<br/>自身の最大アピールの60%を<br/>固定値として上乗せした800%の<br/>アピールを行う"]:::action
    c4 -->|"No"| e5["⑤:自身と残りHP割合が最も低い<br/>味方1名のHPをこのスキルで行った<br/>合計アピールの30%分回復し、<br/>3ターンの間「声援」状態にする"]:::effect
    a4 --> e5
    e5 --> finish(("終了")):::startend
