flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身のリフレクト耐性を+30%する"]:::effect --> c3{"③:自身のHP上限が<br/>②のアピール対象の残りHP以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>ライバルへ、自身の最大アピールの30%を<br/>固定値として上乗せした400%のアピール"]:::action --> lc2{"②のアピール6回すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2 -->|"Yes"| c4{"④:自身の残りHP割合が50%以上、<br/>または②のアピールでライバルが<br/>リタイアしていなかったか"}:::cond
    c4 -->|"Yes"| a4["④実行:<br/>ライバル4名へ、自身の最大アピールの60%を<br/>固定値として上乗せした800%のアピール"]:::action --> e5
    c4 -->|"No"| e5["⑤:自身と残りHP割合が最も低い味方1名のHPを<br/>このスキルで行った合計アピールの30%分回復し、<br/>3ターンの間「声援」状態にする"]:::effect --> finish(("終了")):::startend
