flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が<br/>「雑音」状態か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を1つ解除し、<br/>100%の確率で2ターンの間<br/>「フィジカルダウン」と「メンタルダウン」状態にする"]:::effect --> a1
    c2 -->|"No"| a1["①実行:<br/>ライバルへ、自身のスマイルの2.5倍を<br/>固定値として上乗せした400%のアピール"]:::action --> c4{"④:自身のスマイルが③の<br/>効果対象のスマイル以上か"}:::cond
    c4 -->|"Yes"| e3a["③:①のアピール対象を100%の確率で<br/>2ターンの間「雑音」状態にする"]:::effect --> lc1
    c4 -->|"No"| e3b["③:①のアピール対象を80%の確率で<br/>2ターンの間「雑音」状態にする"]:::effect --> lc1
    lc1{"①のアピール5回すべて完了?"}:::cond
    lc1 -->|"No、次の対象へ"| c2
    lc1 -->|"Yes"| finish(("終了")):::startend
