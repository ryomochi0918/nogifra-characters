flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:①のアピール対象が「雑音」状態か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象のバフ・アゲ効果を<br/>1つ解除し、100%の確率で2ターンの<br/>間「フィジカルダウン」と<br/>「メンタルダウン」状態にする"]:::effect
    c2 -->|"No"| a1["①実行:ライバルに5回、<br/>自身のスマイルの2.5倍を<br/>固定値として上乗せした400%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> c4{"④:自身のスマイルが③の効果対象の<br/>スマイル以上か<br/>(③の各効果前)"}:::cond
    c4 -->|"Yes"| e4["③による「雑音」状態の確率が<br/>100%になる"]:::effect
    c4 -->|"No"| e3["③:①のアピール対象を80%の確率で<br/>2ターンの間「雑音」状態にする<br/>(①の各アピール後)"]:::effect
    e4 --> e3
    e3 --> lc1{"①のアピール<br/>5回すべて完了?"}:::cond
    lc1 -->|"Yes"| finish(("終了")):::startend
    lc1 -->|"No、次の回へ"| c2
