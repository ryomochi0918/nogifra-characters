flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果状態か"}:::cond
    c2 -->|"Yes"| e2["①による「全開」状態の<br/>アピール力増加倍率が1.5倍になる"]:::effect
    c2 -->|"No"| e1["①:自身を2ターンの間「全開」<br/>状態にする"]:::effect
    e2 --> e1
    e1 --> c4{"④:自身のスマイルが③の<br/>アピール対象のスマイル以上か<br/>(③の各アピール前)"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c4 -->|"No"| a3["③実行:ライバル4名に自身のスマイルの<br/>3倍を固定値として上乗せした550%の<br/>アピールを行う"]:::action
    e4 --> a3
    a3 --> lc3{"③のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc3 -->|"Yes"| e5["⑤:自身のHPを③で行った<br/>合計アピールの40%分回復する"]:::effect
    lc3 -->|"No、次の対象へ"| c4
    e5 --> a6["⑥実行:ライバルに2回、<br/>③で行った合計アピールの60%分の<br/>アピールを行う(ディフェンス、<br/>メンタルを無視する)"]:::action
    a6 --> finish(("終了")):::startend
