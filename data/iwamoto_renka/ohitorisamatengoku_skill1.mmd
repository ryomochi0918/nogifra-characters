flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身がバフ・アゲ効果状態か"}:::cond
    c2 -->|"Yes"| e1a["①:自身を2ターンの間「全開」状態にする<br/>(アピール力増加倍率1.5倍)"]:::effect --> c4
    c2 -->|"No"| e1b["①:自身を2ターンの間「全開」状態にする"]:::effect --> c4
    c4{"④:自身のスマイルが③の<br/>アピール対象のスマイル以上か"}:::cond
    c4 -->|"Yes"| e4["③のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> a3
    c4 -->|"No"| a3["③実行:<br/>ライバルへ、自身のスマイルの3倍を<br/>固定値として上乗せした550%のアピール"]:::action --> lc3{"③のアピール4名すべて完了?"}:::cond
    lc3 -->|"No、次の対象へ"| c4
    lc3 -->|"Yes"| e5["⑤:自身のHPを③で行った<br/>合計アピールの40%分回復する"]:::effect --> a6["⑥実行:<br/>ライバルへ2回、③で行った合計アピールの<br/>60%分のアピール<br/>(ディフェンス、メンタルを無視)"]:::action --> finish(("終了")):::startend
