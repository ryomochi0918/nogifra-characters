flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、<br/>自身のサゲ効果耐性貫通を+30%する"]:::effect --> c3{"③:自身のサンクスが<br/>②のアピール対象のサンクス以上か"}:::cond
    c3 -->|"Yes"| e3["②のアピールに自身のサンクスの4.5倍を<br/>固定値として上乗せする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>最大アピールが最も高いライバルへ、<br/>100%の確率で3ターンの間「嫉妬」状態にし、<br/>1100%のアピール"]:::action --> e4["④:②のアピール対象を100%の確率で<br/>3ターンの間「心労」状態にする"]:::effect --> lc{"②の対象4名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| c3
    lc -->|"Yes"| e5["⑤:自身のHPを自身の最大HPの20%分回復し、<br/>2ターンの間「反響」状態にする"]:::effect --> finish(("終了")):::startend
