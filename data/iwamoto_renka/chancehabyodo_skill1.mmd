flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:このスキル中、自身の<br/>サゲ効果耐性貫通を+30%する"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②のアピールに自身のサンクスの<br/>4.5倍を固定値として上乗せする"]:::effect
    c3 -->|"No"| a2["②実行:最大アピールが最も<br/>高いライバル4名を100%の確率で<br/>3ターンの間「嫉妬」状態にし、<br/>1100%のアピールを行う"]:::action
    e3 --> a2
    a2 --> e4["④:②のアピール対象を100%の確率で<br/>3ターンの間「心労」状態にする<br/>(②の各アピール後)"]:::effect
    e4 --> lc2{"②のアピール<br/>ライバル4名すべて完了?"}:::cond
    lc2 -->|"Yes"| e5["⑤:自身のHPを自身の最大HPの<br/>20%分回復し、2ターンの間「反響」<br/>状態にする"]:::effect
    lc2 -->|"No、次の対象へ"| c3
    e5 --> finish(("終了")):::startend
