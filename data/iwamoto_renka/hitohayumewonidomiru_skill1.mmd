flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:自身のHPを自身のHP上限の<br/>30%分回復し、自身を4ターンの間<br/>「円陣」と「魅了」状態にする"]:::effect
    e1 --> c3{"③:自身のサンクスが②の<br/>アピール対象のサンクス以上か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の固定値倍率とアピール倍率が<br/>2倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も低い<br/>ライバルに5回、自身のサンクスの<br/>2倍を固定値で上乗せした450%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>5回すべて完了?"}:::cond
    lc2 -->|"Yes"| a4["④実行:②のアピールで<br/>ライバルをリタイアさせた回数を<br/>アピール回数とした、ライバル1名に<br/>自身のサンクスの6倍分を<br/>固定値として上乗せした1200%の<br/>アピールを行う"]:::action
    lc2 -->|"No、次の回へ"| c3
    a4 --> e5["⑤:味方6名のデバフ・サゲ効果を<br/>2つ解除する"]:::effect
    e5 --> finish(("終了")):::startend
