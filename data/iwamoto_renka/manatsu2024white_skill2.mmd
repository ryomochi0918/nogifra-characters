flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身が受けているバフ・アゲ効果状態の<br/>種類数が3種類以上か"}:::cond
    c2 -->|"Yes"| e2["①による命中率と会心率の<br/>増加倍率が2倍に"]:::effect --> e1
    c2 -->|"No"| e1["①:このスキル中、<br/>自身の命中率と会心率を+20%する"]:::effect
    e1 --> a3["③実行:<br/>ライバルへ680%のアピール"]:::action
    a3 --> c4{"④:③のアピールで<br/>会心アピールが発生したか"}:::cond
    c4 -->|"Yes"| e4["③のアピール対象の<br/>バフ・アゲ効果を1つ解除"]:::effect --> lc
    c4 -->|"No"| lc{"③のアピール<br/>4回すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| a3
    lc -->|"Yes"| c5{"⑤:③のアピールで<br/>ライバルがリタイアしなかったか<br/>(かつ再実行がまだの場合)"}:::cond
    c5 -->|"Yes(再実行は最大1回まで)"| a3
    c5 -->|"No"| finish(("終了")):::startend
