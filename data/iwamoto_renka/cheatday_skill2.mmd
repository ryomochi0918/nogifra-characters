flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が①の<br/>アピール対象の残りHP割合以上、または<br/>ライバルチームのフロント人数が<br/>4名以上か"}:::cond
    c2 -->|"Yes"| e2["①のアピール対象の<br/>バフ・アゲ効果を1つ解除する"]:::effect
    c2 -->|"No"| c3{"③:①のアピール対象が<br/>バフ・アゲ効果状態ではないか"}:::cond
    e2 --> c3
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect
    c3 -->|"No"| a1["①実行:残りHP割合が最も高い<br/>ライバル1名のバフ・アゲ効果を1つ解除し、<br/>自身の最大アピールの50%を固定値として<br/>上乗せした2200%のアピールを行う"]:::action
    e3 --> a1
    a1 --> c4{"④:このスキルでリタイアした人数が<br/>1名以下か"}:::cond
    c4 -->|"Yes(再実行は最大3回まで)"| c5{"⑤:このスキル中に①の再実行が<br/>発動していたか"}:::cond
    c4 -->|"No"| a6["⑥実行:残りHP割合が最も低い<br/>ライバル1名にこのスキルで行った<br/>合計アピールの40%分のアピールを行う<br/>(ディフェンス、フィジカルを無視する)"]:::action
    c5 -->|"Yes"| e5["④の「興奮」状態の効果倍率が<br/>①の再実行回数に応じて増加する<br/>(1回:1.5倍、2回以上:2倍)"]:::effect
    c5 -->|"No"| e4["④:自身を3ターンの間<br/>「興奮」状態にする"]:::effect
    e5 --> e4
    e4 --> c2
    a6 --> finish(("終了")):::startend
