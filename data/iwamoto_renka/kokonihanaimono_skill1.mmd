flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> c2{"②:自身の残りHP割合が50%以上か<br/>(①の各アピール前)"}:::cond
    c2 -->|"Yes"| e2["①のアピール倍率と<br/>固定値倍率が2倍になる"]:::effect
    c2 -->|"No"| a1["①実行:ライバル6名に<br/>自身のエフォートの2.5倍を<br/>固定値として上乗せした550%の<br/>アピールを行う"]:::action
    e2 --> a1
    a1 --> lc1{"①のアピール<br/>ライバル6名すべて完了?"}:::cond
    lc1 -->|"Yes"| a3["③実行:残りHP割合が最も<br/>低いライバルに2回、①で<br/>行った合計アピールの50%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    lc1 -->|"No、次の対象へ"| c2
    a3 --> e4["④:味方6名を3ターンの間<br/>「アピールガード(感謝)」状態にする"]:::effect
    e4 --> e5["⑤:このスキルでライバルを<br/>リタイアさせた数だけ、HP割合が<br/>最も高い味方を3ターンの間「反響」<br/>状態にする"]:::effect
    e5 --> finish(("終了")):::startend
