flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> a1["①実行:ライバルに4回、<br/>アピール対象の残りHPの1%分を<br/>固定値として上乗せした600%の<br/>アピールを行う"]:::action
    a1 --> a2["②実行:最大アピールが<br/>最も高いライバル1名に①で<br/>行った合計アピールの30%分の<br/>アピールを行う(ディフェンス、<br/>フィジカルを無視する)"]:::action
    a2 --> c4{"④:①のアピールでライバルが<br/>リタイアしたか"}:::cond
    c4 -->|"Yes"| e4["③の回復倍率が2倍になる"]:::effect
    c4 -->|"No"| e3["③:自身のHPを自身のHP上限の<br/>15%分回復する"]:::effect
    e4 --> e3
    e3 --> finish(("終了")):::startend
