flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:残りHP割合が最も低い味方4名の<br/>デバフ・サゲ効果を2つ解除し、<br/>HPを自身のアピール力の120%分回復し<br/>(会心率に応じて会心回復が発生)、<br/>3ターンの間「堅忍」状態にする"]:::effect
    e1 --> c3{"③:②のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(②の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["②の各アピール中のみ自身の<br/>リフレクト耐性を+50%し、<br/>②のアピール倍率と固定値倍率が<br/>1.5倍になる"]:::effect
    c3 -->|"No"| a2["②実行:残りHP割合が最も高い<br/>ライバル3名に①の効果で回復した<br/>味方の最大アピールの合計20%分を<br/>固定値として上乗せした700%の<br/>アピールを行う"]:::action
    e3 --> a2
    a2 --> lc2{"②のアピール<br/>ライバル3名すべて完了?"}:::cond
    lc2 -->|"Yes"| finish(("終了")):::startend
    lc2 -->|"No、次の対象へ"| c3
