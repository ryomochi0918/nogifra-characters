flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e1["①:残りHP割合が最も低い味方4名の<br/>デバフ・サゲ効果を2つ解除し、<br/>HPを自身のアピール力の120%分回復し<br/>(会心率に応じて会心回復が発生)、<br/>3ターンの間「堅忍」状態にする"]:::effect --> c3{"③:②のアピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    c3 -->|"Yes"| e3["自身のリフレクト耐性を+50%し<br/>(このアピール中のみ)、<br/>②のアピール倍率と固定値倍率を1.5倍にする"]:::effect --> a2
    c3 -->|"No"| a2["②実行:<br/>残りHP割合が最も高いライバルへ、<br/>①の効果で回復した味方の最大アピールの<br/>合計20%分を固定値として上乗せした<br/>700%のアピール"]:::action --> lc2{"②のアピール<br/>3名すべて完了?"}:::cond
    lc2 -->|"No、次の対象へ"| c3
    lc2 -->|"Yes"| finish(("終了")):::startend
