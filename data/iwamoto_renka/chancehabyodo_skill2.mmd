flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e2["②:①の各アピール中のみ自身の<br/>命中率を①のアピール対象が<br/>受けている「デバフ・サゲ効果状態の<br/>種類数×10%」分増加する(命中率の<br/>増加上限は40%まで)<br/>(①の各アピール前)"]:::effect
    e2 --> c3{"③:①のアピール対象が<br/>デバフ・サゲ効果状態か<br/>(①の各アピール前)"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect
    c3 -->|"No"| c4{"④:①のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>2種類以上か<br/>(①の各アピール前)"}:::cond
    e3 --> c4
    c4 -->|"Yes"| e4["①のアピール対象のバフ・アゲ効果を<br/>1つ解除する"]:::effect
    c4 -->|"No"| a1["①実行:最大アピールが最も高い<br/>ライバル4名にアピール対象の残りHPの<br/>1%分を固定値として上乗せした900%の<br/>アピールを行う"]:::action
    e4 --> a1
    a1 --> lc1{"①のアピール<br/>対象すべて完了?"}:::cond
    lc1 -->|"Yes"| e5["⑤:自身のHPを①で行った<br/>合計アピールの20%分回復する"]:::effect
    lc1 -->|"No、次の対象へ"| e2
    e5 --> finish(("終了")):::startend
