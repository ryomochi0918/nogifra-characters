flowchart TD
    classDef startend fill:#FFD93D,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef cond fill:#FF6B6B,stroke:#333,stroke-width:2px,color:#ffffff;
    classDef effect fill:#6EC6E8,stroke:#333,stroke-width:2px,color:#1a1220;
    classDef action fill:#7ED957,stroke:#333,stroke-width:2px,color:#1a1220;

    start(("開始")):::startend --> e2["②:自身の命中率を①のアピール対象が受けている<br/>「デバフ・サゲ効果状態の種類数×10%」分増加する<br/>(このアピール中のみ、増加上限は+40%まで)"]:::effect --> c3{"③:①のアピール対象が<br/>デバフ・サゲ効果状態か"}:::cond
    c3 -->|"Yes"| e3["①のアピール倍率と<br/>固定値倍率を2倍にする"]:::effect --> c4
    c3 -->|"No"| c4{"④:①のアピール対象が受けている<br/>デバフ・サゲ効果状態の種類数が<br/>2種類以上か"}:::cond
    c4 -->|"Yes"| e4b["①のアピール対象の<br/>バフ・アゲ効果を1つ解除する"]:::effect --> a1
    c4 -->|"No"| a1["①実行:<br/>最大アピールが最も高いライバルへ、<br/>アピール対象の残りHPの1%分を<br/>固定値として上乗せした900%のアピール"]:::action --> lc{"①の対象4名すべて完了?"}:::cond
    lc -->|"No、次の対象へ"| e2
    lc -->|"Yes"| e5["⑤:自身のHPを①で行った<br/>合計アピールの20%分回復する"]:::effect --> finish(("終了")):::startend
